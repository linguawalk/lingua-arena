 "grammar": {
  "title": {
   "ko": "Präsens mit gerade / jetzt · am + Infinitiv sein",
   "en": "Present with gerade / jetzt · am + infinitive sein"
  },
  "explain": {
   "ko": "Deutsch hat keine eigene Verlaufsform. Was jetzt passiert, sagt man im Präsens, oft mit gerade, jetzt oder im Moment: Ich arbeite gerade. Umgangssprachlich gibt es auch: Ich bin gerade am Arbeiten (am + Infinitiv als Nomen + sein). Fragen: Was machst du gerade? Was trägt sie?",
   "en": "German has no separate continuous form. What is happening now is said in the present, often with gerade, jetzt or im Moment: Ich arbeite gerade. Colloquially you also hear: Ich bin gerade am Arbeiten (am + infinitive as a noun + sein). Questions: Was machst du gerade? Was trägt sie?"
  },
  "table": {
   "head": [
    "표현 / Form",
    "예문 / Beispiel"
   ],
   "rows": [
    [
     "Präsens + jetzt",
     "Es regnet jetzt."
    ],
    [
     "Präsens + gerade",
     "Ich arbeite gerade."
    ],
    [
     "Präsens + im Moment",
     "Wir hören im Moment Musik."
    ],
    [
     "am + Infinitiv + sein",
     "Ich bin am Kochen."
    ],
    [
     "Frage",
     "Was machst du gerade?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "Es gibt kein »-ing«: Ich arbeite (nicht »Ich bin arbeitend«).",
    "en": "There is no '-ing': Ich arbeite (not 'Ich bin arbeitend')."
   },
   {
    "ko": "Der Satzbau bleibt gleich: gerade steht meist nach dem Verb.",
    "en": "Word order stays the same: gerade usually follows the verb."
   },
   {
    "ko": "»am Kochen sein« ist umgangssprachlich, aber sehr häufig.",
    "en": "'Am Kochen sein' is colloquial but very common."
   }
  ],
