 "grammar": {
  "title": {
   "ko": "Ratschläge: sollte / sollten + Infinitiv; Perfekt",
   "en": "advice: sollte / sollten + infinitive; Perfekt"
  },
  "explain": {
   "ko": "조언은 sollte / solltest / sollten + 동사원형으로 말합니다: Du solltest dein Passwort ändern. 부정은 sollte nicht입니다. 이미 일어난 일은 Perfekt(haben/sein + Partizip II)로 말합니다: Ich habe ein Foto gepostet. Ich habe die App heruntergeladen.",
   "en": "Give advice with sollte / solltest / sollten + infinitive: Du solltest dein Passwort ändern. Negative: sollte nicht. Completed actions use the Perfekt (haben/sein + Partizip II): Ich habe ein Foto gepostet. Ich habe die App heruntergeladen."
  },
  "table": {
   "head": [
    "표현 / Struktur",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "sollte + Inf.",
     "Du solltest dein Passwort ändern."
    ],
    [
     "sollte nicht + Inf.",
     "Du solltest nicht alles teilen."
    ],
    [
     "Perfekt",
     "Ich habe ein Foto gepostet."
    ],
    [
     "질문 / Frage",
     "Hast du die App schon heruntergeladen?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "조언 = sollte(st/n) + 동사원형.",
    "en": "Advice = sollte(st/n) + infinitive."
   },
   {
    "ko": "Perfekt = haben + Partizip II.",
    "en": "Perfekt = haben + Partizip II."
   },
   {
    "ko": "동사원형·Partizip II는 문장 끝.",
    "en": "Infinitive and participle go last."
   }
  ],
