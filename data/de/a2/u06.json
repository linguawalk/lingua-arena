 "grammar": {
  "title": {
   "ko": "Futur I: werden + Infinitiv",
   "en": "Future: werden + infinitive"
  },
  "explain": {
   "ko": "Für Vorhersagen, Angebote und Versprechen benutzt man werden (Position 2) + Infinitiv (am Ende): Es wird morgen heiß werden. Ich werde dir helfen. Konjugation: ich werde, du wirst, er / sie / es wird, wir werden, ihr werdet, sie werden. Im Alltag reicht oft das Präsens: Ich helfe dir. Ich trage deine Tasche. Nach »dass« steht das Verb am Ende: Ich verspreche, dass ich nicht zu spät komme.",
   "en": "For predictions, offers and promises use werden (position 2) + infinitive (at the end): Es wird morgen heiß werden. Ich werde dir helfen. Conjugation: ich werde, du wirst, er / sie / es wird, wir werden, ihr werdet, sie werden. In everyday speech the present often suffices: Ich helfe dir. Ich trage deine Tasche. After »dass« the verb goes to the end: Ich verspreche, dass ich nicht zu spät komme."
  },
  "table": {
   "head": [
    "주어 / Person",
    "긍정 / Positiv",
    "부정 / Negativ"
   ],
   "rows": [
    [
     "ich",
     "ich werde helfen",
     "ich werde nicht helfen"
    ],
    [
     "du",
     "du wirst helfen",
     "du wirst nicht helfen"
    ],
    [
     "er / sie / es",
     "er wird helfen",
     "er wird nicht helfen"
    ],
    [
     "wir",
     "wir werden helfen",
     "wir werden nicht helfen"
    ],
    [
     "sie (Pl.)",
     "sie werden helfen",
     "sie werden nicht helfen"
    ]
   ]
  },
  "notes": [
   {
    "ko": "werden + Infinitiv am Satzende: Ich werde dir morgen helfen.",
    "en": "werden + infinitive at the end: Ich werde dir morgen helfen."
   },
   {
    "ko": "»wahrscheinlich« steht meist nach dem Verb: Es wird wahrscheinlich regnen.",
    "en": "'Wahrscheinlich' usually comes after the verb: Es wird wahrscheinlich regnen."
   },
   {
    "ko": "Ich glaube, ... bzw. Ich denke, ... macht die Aussage vorsichtiger.",
    "en": "Ich glaube, … / Ich denke, … makes a statement more cautious."
   }
  ],
