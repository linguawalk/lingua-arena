 "grammar": {
  "title": {
   "ko": "Präteritum von sein: ich war, du warst…",
   "en": "The past of 'sein': ich war, du warst…"
  },
  "explain": {
   "ko": "Um zu sagen, wo man in der Vergangenheit war oder wie man sich fühlte, benutzt man das Präteritum von sein: ich war, du warst, er / sie / es war, wir waren, ihr wart, sie / Sie waren. Im Gespräch wird sein fast immer im Präteritum benutzt, nicht im Perfekt. Die Verneinung steht nach dem Verb: ich war nicht.",
   "en": "To say where you were or how you felt in the past, use the simple past of sein: ich war, du warst, er / sie / es war, wir waren, ihr wart, sie / Sie waren. In speech sein is almost always used in the simple past, not the perfect. The negative comes after the verb: ich war nicht."
  },
  "table": {
   "head": [
    "주어 / Person",
    "긍정 / Positiv",
    "부정 / Negativ",
    "의문 / Frage"
   ],
   "rows": [
    [
     "ich",
     "ich war",
     "ich war nicht",
     "War ich … ?"
    ],
    [
     "du",
     "du warst",
     "du warst nicht",
     "Warst du … ?"
    ],
    [
     "er / sie / es",
     "er war",
     "er war nicht",
     "War er … ?"
    ],
    [
     "wir",
     "wir waren",
     "wir waren nicht",
     "Waren wir … ?"
    ],
    [
     "sie (Pl.)",
     "sie waren",
     "sie waren nicht",
     "Waren sie … ?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "Zeitangaben der Vergangenheit: gestern, gestern Abend, letztes Wochenende, vor zwei Stunden.",
    "en": "Past time words: gestern, gestern Abend, letztes Wochenende, vor zwei Stunden."
   },
   {
    "ko": "»vor« + Dativ steht vor der Zeitspanne: vor drei Tagen.",
    "en": "'Vor' + dative comes before the length of time: vor drei Tagen."
   },
   {
    "ko": "Kurzantworten: Ja, ich war. / Nein, wir waren nicht.",
    "en": "Short answers: Ja, ich war. / Nein, wir waren nicht."
   }
  ],
