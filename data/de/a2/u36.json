 "grammar": {
  "title": {
   "ko": "höfliche Bitten: Könnten Sie …? Dürfte ich …? Würden Sie …?",
   "en": "polite requests: Könnten Sie …? Dürfte ich …? Würden Sie …?"
  },
  "explain": {
   "ko": "정중한 부탁은 Könnten Sie + 동사원형 …? / Würden Sie + 동사원형 …?를 씁니다 (Konjunktiv II). 허락을 구할 때는 Dürfte ich + 동사원형 …? 또는 Kann ich …?를 씁니다. 수락은 'Natürlich.' / 'Gern.', 거절은 'Leider geht das nicht.'처럼 부드럽게 합니다. bitte를 붙이면 더 정중합니다.",
   "en": "Make polite requests with Könnten Sie + infinitive …? / Würden Sie + infinitive …? (Konjunktiv II). Ask permission with Dürfte ich + infinitive …? or Kann ich …? Accept with 'Natürlich' / 'Gern'; refuse gently: 'Leider geht das nicht.' Adding bitte makes it more polite."
  },
  "table": {
   "head": [
    "표현 / Struktur",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "Könnten Sie + Inf.",
     "Könnten Sie bitte die Tür öffnen?"
    ],
    [
     "Dürfte ich + Inf.",
     "Dürfte ich Ihren Stift leihen?"
    ],
    [
     "Würden Sie + Inf.",
     "Würden Sie bitte das Fenster schließen?"
    ],
    [
     "거절 / Ablehnung",
     "Leider geht das nicht."
    ]
   ]
  },
  "notes": [
   {
    "ko": "부탁 = Könnten Sie …, 허락 = Dürfte ich …",
    "en": "Request = Könnten Sie …; permission = Dürfte ich …"
   },
   {
    "ko": "동사원형은 문장 끝으로 갑니다.",
    "en": "The infinitive goes to the end."
   },
   {
    "ko": "bitte는 문장 안에 넣어도 됩니다.",
    "en": "Bitte can go inside the sentence."
   }
  ],
  "examples": [
   {
    "t": "Könnten Sie bitte die Tür öffnen?",
    "ko": "문을 열어 주시겠어요?",
    "en": "Could you open the door, please?"
   },
   {
    "t": "Dürfte ich Ihren Stift leihen?",
    "ko": "펜을 빌려도 될까요?",
    "en": "Could I borrow your pen?"
   },
   {
    "t": "Würden Sie bitte das Fenster schließen?",
    "ko": "창문을 닫아 주시겠어요?",
    "en": "Would you mind closing the window?"
   },
   {
    "t": "Könnten Sie bitte langsamer sprechen?",
    "ko": "천천히 말씀해 주시겠어요?",
    "en": "Could you speak more slowly?"
   },
   {
    "t": "Leider geht das nicht.",
    "ko": "죄송하지만 안 돼요.",
    "en": "I'm afraid I can't."
   }
  ],
