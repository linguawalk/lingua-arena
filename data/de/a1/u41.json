 "grammar": {
  "title": {
   "ko": "기기 사용 동사와 분리동사",
   "en": "Device verbs and separable verbs"
  },
  "explain": {
   "ko": "기기를 켜고 끌 때는 anmachen / ausmachen을 씁니다. 분리동사는 접두어가 끝으로 갑니다: Ich lade die App herunter. 인터넷은 im Internet이라고 합니다: Ich suche im Internet. 문제 표현: Der Akku ist leer. Es gibt kein WLAN. 도움 요청: Können Sie mir helfen?",
   "en": "Use anmachen / ausmachen to switch devices on and off. Separable verbs send the prefix to the end: Ich lade die App herunter. Online is im Internet: Ich suche im Internet. Problems: Der Akku ist leer. Es gibt kein WLAN. Ask for help: Können Sie mir helfen?"
  },
  "table": {
   "head": [
    "표현 / Struktur",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "anmachen / ausmachen",
     "Mach den Computer an."
    ],
    [
     "herunterladen",
     "Ich lade die App herunter."
    ],
    [
     "im Internet",
     "Ich suche im Internet."
    ],
    [
     "Es gibt kein ~",
     "Es gibt kein WLAN."
    ]
   ]
  },
  "notes": [
   {
    "ko": "분리동사: herunterladen → Ich lade … herunter.",
    "en": "Separable verb: herunterladen → Ich lade … herunter."
   },
   {
    "ko": "kein은 명사를 부정합니다: kein WLAN.",
    "en": "Kein negates a noun: kein WLAN."
   },
   {
    "ko": "im = in dem: im Internet.",
    "en": "im = in dem: im Internet."
   }
  ],
