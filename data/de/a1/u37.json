 "grammar": {
  "title": {
   "ko": "날짜 표현: am + 서수",
   "en": "Dates: am + ordinal"
  },
  "explain": {
   "ko": "날짜는 서수로 말합니다: der erste, der zweite, der dritte, der vierte … 20일까지는 -te, 그 이후는 -ste입니다. '~일에'는 am + 서수 + -en: am dritten März. '~월에'는 im + 월: im Mai. 날짜 질문은 Welches Datum ist heute? 또는 Der Wie vielte ist heute?입니다. 생일은 Wann hast du Geburtstag?로 묻습니다.",
   "en": "Dates use ordinals: der erste, der zweite, der dritte, der vierte … up to 19 add -te, from 20 add -ste. 'On the …' is am + ordinal + -en: am dritten März. 'In month' is im + month: im Mai. Ask the date with Welches Datum ist heute? Ask about birthdays with Wann hast du Geburtstag?"
  },
  "table": {
   "head": [
    "표현 / Struktur",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "am + 서수-en",
     "am dritten März"
    ],
    [
     "im + 월",
     "im Mai"
    ],
    [
     "Wann hast du Geburtstag?",
     "Ich habe am fünften Mai Geburtstag."
    ],
    [
     "Welches Datum?",
     "Heute ist der erste Mai."
    ]
   ]
  },
  "notes": [
   {
    "ko": "불규칙 서수: erste, dritte, siebte, achte.",
    "en": "Irregular ordinals: erste, dritte, siebte, achte."
   },
   {
    "ko": "20 이상: zwanzigste, einunddreißigste.",
    "en": "From 20: zwanzigste, einunddreißigste."
   },
   {
    "ko": "월 이름은 모두 der: der Mai.",
    "en": "All months are masculine: der Mai."
   }
  ],
