 "grammar": {
  "title": {
   "ko": "sein 동사 (ich bin / du bist …)",
   "en": "The verb 'sein' (ich bin / du bist …)"
  },
  "explain": {
   "ko": "sein은 '~이다'를 뜻하는 동사로 불규칙하게 변합니다. 직업 앞에는 관사를 쓰지 않습니다(Ich bin Student).",
   "en": "'Sein' means 'to be' and is irregular. Jobs take no article (Ich bin Student)."
  },
  "table": {
   "head": [
    "주어 / Subject",
    "sein"
   ],
   "rows": [
    [
     "ich",
     "bin"
    ],
    [
     "du",
     "bist"
    ],
    [
     "er / sie / es",
     "ist"
    ],
    [
     "wir",
     "sind"
    ],
    [
     "ihr",
     "seid"
    ],
    [
     "sie / Sie",
     "sind"
    ]
   ]
  },
  "notes": [
   {
    "ko": "du는 친한 사이, Sie(대문자)는 존칭입니다.",
    "en": "Use du with friends, formal Sie (capital S) with strangers."
   },
   {
    "ko": "명사를 부정할 때는 kein을 씁니다: Ich bin kein Arzt.",
    "en": "To negate a noun, use kein: Ich bin kein Arzt."
   },
   {
    "ko": "의문문은 동사가 문장 맨 앞에 옵니다: Bist du Student?",
    "en": "In questions the verb comes first: Bist du Student?"
   }
  ],
  "examples": [
   {
    "t": "Ich bin Student.",
    "ko": "저는 학생이에요.",
    "en": "I am a student."
   },
   {
    "t": "Du bist mein Freund.",
    "ko": "당신은 제 친구예요.",
    "en": "You are my friend."
   },
   {
    "t": "Sie ist Lehrerin.",
    "ko": "그녀는 선생님이에요.",
    "en": "She is a teacher."
   },
   {
    "t": "Wir sind Freunde.",
    "ko": "우리는 친구예요.",
    "en": "We are friends."
   },
   {
    "t": "Sie sind Ärzte.",
    "ko": "그들은 의사예요.",
    "en": "They are doctors."
   }
  ],
