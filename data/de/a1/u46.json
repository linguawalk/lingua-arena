    [
     "Ich möchte ~",
     "Ich möchte Geld wechseln."
    ],
    [
     "Ich habe ~",
     "Ich habe Kopfschmerzen."
    ]
   ]
  },
  "notes": [
   {
    "ko": "zu + der = zur, zu + dem = zum.",
    "en": "zu + der = zur, zu + dem = zum."
   },
