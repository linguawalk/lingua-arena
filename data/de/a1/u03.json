 "grammar": {
  "title": {
   "ko": "소유관사 mein / meine와 haben",
   "en": "Possessive articles (mein / meine) and 'haben'"
  },
  "explain": {
   "ko": "독일어 소유관사는 소유하는 사람(ich, du, er)에 따라 mein / dein / sein으로 정해지고, 뒤에 오는 명사의 성·수에 따라 어미가 붙습니다: 남성·중성 mein, 여성·복수 meine.",
   "en": "German possessives depend on the owner (mein, dein, sein / ihr) and take an ending that matches the noun: mein for masculine and neuter, meine for feminine and plural."
  },
  "table": {
   "head": [
    "명사 / Nomen",
    "나의 / mein",
    "너의 / dein",
    "그의·그녀의 / sein · ihr"
   ],
   "rows": [
    [
     "남성 단수",
     "mein Vater",
     "dein Vater",
     "sein Vater"
    ],
    [
     "여성 단수",
     "meine Mutter",
     "deine Mutter",
     "seine Mutter"
    ],
    [
     "복수",
     "meine Eltern",
     "deine Eltern",
     "seine Eltern"
    ],
    [
     "중성 단수",
     "mein Kind",
     "dein Kind",
     "sein Kind"
    ]
   ]
  },
  "notes": [
   {
    "ko": "'그의'는 sein, '그녀의'는 ihr입니다. 소유자의 성별이 기준입니다.",
    "en": "'His' is sein and 'her' is ihr: the owner's gender decides."
   },
   {
    "ko": "남성·중성 단수는 어미가 없고, 여성·복수는 -e가 붙습니다.",
    "en": "Masculine and neuter singular have no ending; feminine and plural add -e."
   },
   {
    "ko": "haben: ich habe, du hast, er / sie hat, wir haben, sie haben.",
    "en": "haben: ich habe, du hast, er / sie hat, wir haben, sie haben."
   }
  ],
