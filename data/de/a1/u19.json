     "ich",
     "kann",
     "will"
    ],
    [
     "du",
     "kannst",
     "willst"
    ],
    [
     "er / sie",
     "kann",
     "will"
    ],
    [
     "wir",
     "können",
     "wollen"
    ],
    [
     "sie (복수)",
     "können",
     "wollen"
    ]
   ]
  },
  "notes": [
   {
    "ko": "조동사 뒤의 동사는 문장 끝에서 원형입니다.",
    "en": "The verb with a modal goes to the end as an infinitive."
   },
   {
    "ko": "공손한 요청: Ich möchte ... / Können Sie ... ?",
    "en": "Polite requests: Ich möchte ... / Können Sie ... ?"
   },
   {
    "ko": "부정: Ich kann nicht kommen.",
    "en": "Negative: Ich kann nicht kommen."
   }
  ],
