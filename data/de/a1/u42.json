 "grammar": {
  "title": {
   "ko": "외모 표현과 형용사 서술",
   "en": "Describing appearance with predicate adjectives"
  },
  "explain": {
   "ko": "외모를 물을 때는 Wie sieht er aus?라고 합니다. 서술 형용사는 어미가 없습니다: Er ist groß. 명사 앞에서는 어미가 붙습니다: lange Haare, blonde Haare. haben으로 신체 특징을 말합니다: Sie hat lange Haare. 안경은 Er trägt eine Brille. 성격은 Wie ist sie?로 묻습니다.",
   "en": "Ask about appearance with Wie sieht er aus? Predicate adjectives take no ending: Er ist groß. Before a noun they take endings: lange Haare, blonde Haare. Use haben for features: Sie hat lange Haare. Glasses: Er trägt eine Brille. Ask about personality with Wie ist sie?"
  },
  "table": {
   "head": [
    "표현 / Struktur",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "sein + 형용사",
     "Er ist groß."
    ],
    [
     "haben + 특징",
     "Sie hat lange Haare."
    ],
    [
     "tragen",
     "Er trägt eine Brille."
    ],
    [
     "Wie sieht er aus?",
     "Er ist groß und schlank."
    ]
   ]
  },
  "notes": [
   {
    "ko": "서술 형용사에는 어미가 없습니다.",
    "en": "Predicate adjectives take no ending."
   },
   {
    "ko": "복수 명사 앞 형용사는 -e: lange Haare.",
    "en": "Adjectives before plural nouns take -e: lange Haare."
   },
   {
    "ko": "tragen: ich trage, du trägst, er trägt.",
    "en": "tragen: ich trage, du trägst, er trägt."
   }
  ],
