 "grammar": {
  "title": {
   "ko": "감정 표현과 Ich habe …",
   "en": "Feelings and 'Ich habe …'"
  },
  "explain": {
   "ko": "기분은 Ich bin + 형용사로 말합니다: Ich bin müde. 배고픔, 목마름은 haben을 씁니다: Ich habe Hunger. Ich habe Durst. 안부는 Wie geht es dir? 답은 Mir geht es gut / nicht so gut.입니다. sich fühlen은 재귀동사입니다: Ich fühle mich müde. Du fühlst dich …",
   "en": "Say feelings with Ich bin + adjective: Ich bin müde. Hunger and thirst use haben: Ich habe Hunger. Ich habe Durst. Ask Wie geht es dir? Answer Mir geht es gut / nicht so gut. Sich fühlen is reflexive: Ich fühle mich müde. Du fühlst dich …"
  },
  "table": {
   "head": [
    "표현 / Struktur",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "sein + 형용사",
     "Ich bin müde."
    ],
    [
     "haben + Hunger / Durst",
     "Ich habe Hunger."
    ],
    [
     "Wie geht es dir?",
     "Mir geht es gut."
    ],
    [
     "sich fühlen",
     "Ich fühle mich schlecht."
    ]
   ]
  },
  "notes": [
   {
    "ko": "재귀대명사: mich, dich, sich, uns, euch, sich.",
    "en": "Reflexive pronouns: mich, dich, sich, uns, euch, sich."
   },
   {
    "ko": "Hunger / Durst 앞에는 관사가 없습니다.",
    "en": "No article before Hunger / Durst."
   },
   {
    "ko": "Mir geht es gut: 3격 mir 사용.",
    "en": "Mir geht es gut uses the dative mir."
   }
  ],
