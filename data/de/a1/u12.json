 "grammar": {
  "title": {
   "ko": "동사 + gern · mögen + 명사",
   "en": "Verb + 'gern' and 'mögen' + noun"
  },
  "explain": {
   "ko": "좋아하는 행동은 동사 뒤에 gern을 붙여 말합니다: Ich schwimme gern. 좋아하는 대상은 mögen + 명사로 말합니다: Ich mag Musik. 좋아하지 않으면 nicht gern을 씁니다.",
   "en": "Say what you like doing by adding gern after the verb: Ich schwimme gern. For things use mögen + noun: Ich mag Musik. If you don't like it, use nicht gern."
  },
  "table": {
   "head": [
    "문형 / Form",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "동사 + gern",
     "Ich schwimme gern."
    ],
    [
     "mögen + 명사",
     "Ich mag Musik."
    ],
    [
     "er / sie",
     "Sie kocht gern."
    ],
    [
     "부정 · 의문",
     "Ich ... nicht gern. / Schwimmst du gern?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "gern은 동사 뒤에 옵니다: Ich koche gern.",
    "en": "'gern' comes after the verb: Ich koche gern."
   },
   {
    "ko": "더 강하게 말할 때는 sehr gern을 씁니다.",
    "en": "Say sehr gern for 'like a lot'."
   },
   {
    "ko": "mögen: ich mag, du magst, er mag, wir mögen.",
    "en": "mögen: ich mag, du magst, er mag, wir mögen."
   }
  ],
  "examples": [
