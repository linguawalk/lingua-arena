 "grammar": {
  "title": {
   "ko": "예약 표현과 Haben Sie … ?",
   "en": "Booking phrases and 'Haben Sie … ?'"
  },
  "explain": {
   "ko": "예약은 Ich möchte ein Zimmer reservieren.으로, 빈방은 Haben Sie ein Zimmer frei?로 묻습니다. 기간은 für + 4격: für drei Nächte. 가격은 Was kostet das Zimmer pro Nacht?로 묻습니다. 포함 여부는 Ist das Frühstück inbegriffen?라고 합니다. einchecken, auschecken은 분리동사입니다.",
   "en": "Book with Ich möchte ein Zimmer reservieren. Ask for availability with Haben Sie ein Zimmer frei? Duration uses für + accusative: für drei Nächte. Ask the price with Was kostet das Zimmer pro Nacht? Ask what's included with Ist das Frühstück inbegriffen? Einchecken and auschecken are separable."
  },
  "table": {
   "head": [
    "표현 / Struktur",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "Ich möchte ~ reservieren",
     "Ich möchte ein Zimmer reservieren."
    ],
    [
     "Haben Sie ~ frei?",
     "Haben Sie ein Doppelzimmer frei?"
    ],
    [
     "für + 기간",
     "für zwei Nächte"
    ],
    [
     "Ist ~ inbegriffen?",
     "Ist das Frühstück inbegriffen?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "Nacht의 복수는 Nächte입니다.",
    "en": "The plural of Nacht is Nächte."
   },
   {
    "ko": "pro Nacht = 하룻밤에.",
    "en": "pro Nacht = per night."
   },
   {
    "ko": "einchecken: Ich checke um drei Uhr ein.",
    "en": "einchecken: Ich checke um drei Uhr ein."
   }
  ],
