 "grammar": {
  "title": {
   "ko": "nicht / kein과 의문문 어순",
   "en": "Negation with 'nicht' / 'kein' and question word order"
  },
  "explain": {
   "ko": "동사나 형용사의 부정은 nicht, 명사의 부정은 kein-을 씁니다: Ich arbeite nicht. Ich habe keinen Hund. 예/아니오 질문은 동사를 맨 앞에 두고, 의문사 질문은 의문사 + 동사 순서입니다.",
   "en": "Negate a verb or adjective with nicht and a noun with kein-: Ich arbeite nicht. Ich habe keinen Hund. A yes/no question starts with the verb; a question word is followed by the verb."
  },
  "table": {
   "head": [
    "문형 / Form",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "동사 부정",
     "Ich arbeite nicht."
    ],
    [
     "명사 부정",
     "Ich habe keinen Hund."
    ],
    [
     "예/아니오 질문",
     "Arbeitest du?"
    ],
    [
     "의문사 질문",
     "Wo arbeitest du?"
    ],
    [
     "부정 대답",
     "Nein, ich arbeite nicht."
    ]
   ]
  },
  "notes": [
   {
    "ko": "nicht는 보통 문장 끝에 오고, 형용사나 장소 앞에서는 그 앞에 옵니다.",
    "en": "'nicht' usually comes at the end, but before an adjective or a place it goes in front."
   },
   {
    "ko": "kein은 ein의 부정입니다: ein → kein, einen → keinen, eine → keine.",
    "en": "kein negates ein: ein → kein, einen → keinen, eine → keine."
   },
   {
    "ko": "질문에서 동사는 첫 번째(또는 의문사 다음) 자리입니다.",
    "en": "In a question the verb comes first (or right after the question word)."
   }
  ],
  "examples": [
   {
    "t": "Ich trinke keinen Kaffee.",
    "ko": "저는 커피를 마시지 않아요.",
    "en": "I don't drink coffee."
   },
   {
    "t": "Er wohnt nicht in Seoul.",
    "ko": "그는 서울에 살지 않아요.",
    "en": "He doesn't live in Seoul."
   },
   {
    "t": "Lernst du Englisch?",
    "ko": "당신은 영어를 공부해요?",
    "en": "Do you study English?"
   },
   {
    "t": "Arbeitet sie in einer Schule?",
    "ko": "그녀는 학교에서 일해요?",
    "en": "Does she work at a school?"
   },
   {
    "t": "Ich bin kein Arzt.",
    "ko": "저는 의사가 아니에요.",
    "en": "I am not a doctor."
   }
  ],
