 "grammar": {
  "title": {
   "ko": "빈도 부사와 어순",
   "en": "Frequency adverbs and word order"
  },
  "explain": {
   "ko": "빈도 부사는 보통 동사 뒤에 옵니다: Ich gehe oft ins Kino. 문장 맨 앞에 두면 동사가 두 번째로 갑니다: Manchmal koche ich. 순서: immer > oft > manchmal > selten > nie. nie는 그 자체로 부정입니다: Ich trinke nie Kaffee. 질문은 Wie oft …?입니다. 횟수는 einmal / zweimal pro Woche라고 합니다.",
   "en": "Frequency adverbs usually follow the verb: Ich gehe oft ins Kino. At the start of a sentence the verb stays second: Manchmal koche ich. Order: immer > oft > manchmal > selten > nie. Nie is already negative: Ich trinke nie Kaffee. Ask Wie oft …? Counts: einmal / zweimal pro Woche."
  },
  "table": {
   "head": [
    "표현 / Struktur",
    "예 / Beispiel"
   ],
   "rows": [
    [
     "immer / oft",
     "Ich gehe oft ins Kino."
    ],
    [
     "manchmal / selten",
     "Manchmal koche ich."
    ],
    [
     "nie",
     "Ich trinke nie Kaffee."
    ],
    [
     "Wie oft …?",
     "Wie oft gehst du schwimmen?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "부사가 앞에 오면 동사가 바로 뒤: Manchmal koche ich.",
    "en": "When the adverb is first the verb comes next: Manchmal koche ich."
   },
   {
    "ko": "nie 자체가 부정이므로 nicht과 함께 쓰지 않습니다.",
    "en": "Nie is negative; don't add nicht."
   },
   {
    "ko": "einmal pro Woche = 주 1회.",
    "en": "einmal pro Woche = once a week."
   }
  ],
