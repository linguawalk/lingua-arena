     "Wem gehört …?",
     "Wem gehört die Tasche?"
    ],
    [
     "gehört mir / dir",
     "Sie gehört mir."
    ],
    [
     "mein / dein / sein",
     "mein Stift, dein Buch"
    ]
   ]
  },
  "notes": [
   {
    "ko": "3격 대명사: mir, dir, ihm, ihr, uns, euch, ihnen.",
    "en": "Dative pronouns: mir, dir, ihm, ihr, uns, euch, ihnen."
   },
   {
    "ko": "2격: des Lehrers (남성·중성은 -s가 붙습니다).",
    "en": "Genitive: des Lehrers (masculine and neuter add -s)."
   },
   {
    "ko": "Toms 앞에는 관사를 쓰지 않습니다.",
    "en": "There is no article before Toms."
   }
  ],
