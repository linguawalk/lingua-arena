 "grammar": {
  "title": {
   "ko": "aller à · en / à + 교통수단",
   "en": "'Aller à' and transport: 'en' / 'à' + vehicle"
  },
  "explain": {
   "ko": "장소로 갈 때는 aller à + 장소(à + le = au)를 쓰고, 교통수단은 en(bus, train, métro, taxi, voiture) 또는 à(pied, vélo)로 말합니다. 어떻게 가느냐는 Comment allez-vous à ... ?로 묻습니다.",
   "en": "Go somewhere with aller à + place (à + le = au). Say the vehicle with 'en' (bus, train, taxi, voiture) or 'à' (pied, vélo). Ask how with Comment allez-vous à ... ?"
  },
  "table": {
   "head": [
    "표현 / Expression",
    "예 / Exemple"
   ],
   "rows": [
    [
     "aller à + 장소",
     "Je vais à la gare."
    ],
    [
     "à + le = au",
     "Je vais au parc."
    ],
    [
     "en + 탈것",
     "en bus, en train, en taxi"
    ],
    [
     "à + pied / vélo",
     "à pied, à vélo"
    ],
    [
     "prendre + 탈것",
     "Je prends le bus."
    ]
   ]
  },
  "notes": [
   {
    "ko": "aller: je vais, tu vas, il va, nous allons, ils vont.",
    "en": "aller: je vais, tu vas, il va, nous allons, ils vont."
   },
   {
    "ko": "à + le는 au, à + les는 aux가 됩니다: au parc, aux magasins.",
    "en": "à + le becomes au, à + les becomes aux: au parc, aux magasins."
   },
   {
    "ko": "도시 앞에는 à를 씁니다: à Paris, à Séoul.",
    "en": "Use à before a city: à Paris, à Séoul."
   }
  ],
