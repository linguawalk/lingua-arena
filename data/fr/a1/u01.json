 "grammar": {
  "title": {
   "ko": "être 동사 (je suis / tu es …)",
   "en": "The verb 'être' (je suis / tu es …)"
  },
  "explain": {
   "ko": "être는 '~이다'를 뜻하는 동사로 주어에 따라 6가지로 변합니다. 직업·신분 앞에는 보통 관사를 쓰지 않습니다(Je suis étudiant).",
   "en": "'Être' means 'to be' and has six forms. Before a job or status, French usually drops the article (Je suis étudiant)."
  },
  "table": {
   "head": [
    "주어 / Subject",
    "être"
   ],
   "rows": [
    [
     "je",
     "suis"
    ],
    [
     "tu",
     "es"
    ],
    [
     "il / elle",
     "est"
    ],
    [
     "nous",
     "sommes"
    ],
    [
     "vous",
     "êtes"
    ],
    [
     "ils / elles",
     "sont"
    ]
   ]
  },
  "notes": [
   {
    "ko": "tu는 친한 사이, vous는 존칭·복수에 씁니다.",
    "en": "Use tu with friends, vous for formal or plural 'you'."
   },
   {
    "ko": "부정문은 ne ~ pas로 동사를 감쌉니다: Je ne suis pas médecin.",
    "en": "Negation wraps the verb in ne ~ pas: Je ne suis pas médecin."
   },
   {
    "ko": "의문문은 억양을 올리거나 Est-ce que를 붙입니다: Tu es étudiant ? / Est-ce que tu es étudiant ?",
    "en": "For questions, raise your voice or add Est-ce que: Tu es étudiant ? / Est-ce que tu es étudiant ?"
   }
  ],
  "examples": [
   {
    "t": "Je suis étudiant.",
    "ko": "저는 학생이에요.",
    "en": "I am a student."
   },
   {
    "t": "Tu es mon ami.",
    "ko": "당신은 제 친구예요.",
    "en": "You are my friend."
   },
   {
    "t": "Elle est professeure.",
    "ko": "그녀는 선생님이에요.",
    "en": "She is a teacher."
   },
   {
    "t": "Nous sommes amis.",
    "ko": "우리는 친구예요.",
    "en": "We are friends."
   },
   {
    "t": "Ils sont médecins.",
    "ko": "그들은 의사예요.",
    "en": "They are doctors."
   }
  ],
