 "grammar": {
  "title": {
   "ko": "ce / cet / cette / ces et « combien »",
   "en": "Demonstratives (ce / cet / cette / ces) and 'combien'"
  },
  "explain": {
   "ko": "'이 ~'는 ce(남성), cet(모음 앞 남성), cette(여성), ces(복수)입니다. 가격은 C'est combien ? / Combien coûte ... ?로 묻습니다.",
   "en": "'This / that' is ce (m), cet (m before a vowel), cette (f), ces (pl). Ask a price with C'est combien ? / Combien coûte ... ?"
  },
  "table": {
   "head": [
    "지시 형용사 / Démonstratif",
    "예 / Exemple"
   ],
   "rows": [
    [
     "ce + 남성",
     "ce sac"
    ],
    [
     "cet + 모음 앞 남성",
     "cet ami"
    ],
    [
     "cette + 여성",
     "cette chaise"
    ],
    [
     "ces + 복수",
     "ces livres"
    ],
    [
     "-ci / -là",
     "ce sac-ci / ce sac-là"
    ]
   ]
  },
  "notes": [
   {
    "ko": "지시 형용사는 뒤에 오는 명사의 성·수에 맞춥니다.",
    "en": "A demonstrative agrees with the noun that follows: ce, cet, cette, ces."
   },
   {
    "ko": "가격 묻기: C'est combien ? / Combien coûte ce sac ?",
    "en": "Ask the price: C'est combien ? / Combien coûte ce sac ?"
   },
   {
    "ko": "대답: Ça fait cinq euros. / C'est cinq euros.",
    "en": "Answer: Ça fait cinq euros. / C'est cinq euros."
   }
  ],
  "examples": [
