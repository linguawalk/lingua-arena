 "grammar": {
  "title": {
   "ko": "ne … pas · est-ce que · les mots interrogatifs",
   "en": "Negation 'ne … pas', 'est-ce que' and question words"
  },
  "explain": {
   "ko": "부정은 동사를 ne … pas로 감쌉니다: Je ne bois pas. 모음 앞에서는 n'가 됩니다. 의문은 억양을 올리거나 문장 앞에 est-ce que를 붙입니다.",
   "en": "Negate a verb by putting ne … pas around it: Je ne bois pas. Before a vowel ne becomes n'. Make a question by raising your voice or adding est-ce que in front."
  },
  "table": {
   "head": [
    "문형 / Forme",
    "예 / Exemple"
   ],
   "rows": [
    [
     "부정",
     "Je ne travaille pas."
    ],
    [
     "모음 앞",
     "Il n'habite pas ici."
    ],
    [
     "의문 (억양)",
     "Tu travailles ?"
    ],
    [
     "의문 (est-ce que)",
     "Est-ce que tu travailles ?"
    ],
    [
     "부정 대답",
     "Non, je ne travaille pas."
    ]
   ]
  },
  "notes": [
   {
    "ko": "ne는 동사 앞, pas는 동사 뒤에 옵니다: je ne mange pas.",
    "en": "'ne' goes before the verb and 'pas' after it: je ne mange pas."
   },
   {
    "ko": "부정문에서 du / de la / un은 de(d')로 바뀝니다: Je ne bois pas de café.",
    "en": "After a negative, du / de la / un become de (d'): Je ne bois pas de café."
   },
   {
    "ko": "말할 때는 ne를 생략하기도 합니다 (구어): Je bois pas de café.",
    "en": "In casual speech ne is often dropped: Je bois pas de café."
   }
  ],
  "examples": [
   {
    "t": "Je ne bois pas de café.",
    "ko": "저는 커피를 마시지 않아요.",
    "en": "I don't drink coffee."
   },
   {
    "t": "Il n'habite pas à Séoul.",
    "ko": "그는 서울에 살지 않아요.",
    "en": "He doesn't live in Seoul."
   },
   {
    "t": "Tu étudies l'anglais ?",
    "ko": "당신은 영어를 공부해요?",
    "en": "Do you study English?"
   },
   {
    "t": "Est-ce qu'elle travaille dans une école ?",
    "ko": "그녀는 학교에서 일해요?",
    "en": "Does she work at a school?"
   },
   {
    "t": "Je ne suis pas médecin.",
    "ko": "저는 의사가 아니에요.",
    "en": "I am not a doctor."
   }
  ],
