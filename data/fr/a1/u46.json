    "ko": "à + le = au: J'ai mal au ventre.",
    "en": "à + le = au: J'ai mal au ventre."
   },
   {
    "ko": "횟수: une fois, deux fois, trois fois par jour.",
    "en": "Counts: une fois, deux fois, trois fois par jour."
   }
  ],
