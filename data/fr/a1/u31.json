    ],
    [
     "vous",
     "pouvez"
    ],
    [
     "ils / elles",
     "peuvent"
    ]
   ]
  },
  "notes": [
   {
    "ko": "pouvoir 뒤에는 동사원형이 옵니다: Je peux m'asseoir ici ?",
    "en": "Pouvoir is followed by an infinitive: Je peux m'asseoir ici ?"
   },
   {
    "ko": "tu는 친구에게, vous는 정중하게 씁니다.",
    "en": "Use tu with friends and vous to be polite."
   },
   {
    "ko": "거절할 때: Désolé, je ne peux pas.",
    "en": "To refuse: Désolé, je ne peux pas."
   }
  ],
