 "grammar": {
  "title": {
   "ko": "형용사의 성·수 일치와 색깔",
   "en": "Adjective agreement and colors"
  },
  "explain": {
   "ko": "프랑스어 형용사는 꾸미는 명사의 성·수에 맞춥니다: 여성은 -e, 복수는 -s를 붙입니다. 색깔 형용사는 보통 명사 뒤에 오고, grand · petit · nouveau · vieux · bon은 명사 앞에 옵니다.",
   "en": "French adjectives agree with their noun: add -e for feminine and -s for plural. Colors usually follow the noun, while grand, petit, nouveau, vieux and bon come before it."
  },
  "table": {
   "head": [
    "형태 / Forme",
    "예 / Exemple"
   ],
   "rows": [
    [
     "남성 단수",
     "un sac noir"
    ],
    [
     "여성 단수",
     "une table noire (+e)"
    ],
    [
     "남성 복수",
     "des sacs noirs (+s)"
    ],
    [
     "여성 복수",
     "des tables noires (+es)"
    ],
    [
     "명사 앞",
     "un petit sac, un nouveau téléphone"
    ]
   ]
  },
  "notes": [
   {
    "ko": "-e로 끝나는 형용사는 여성형이 같습니다: rouge → rouge.",
    "en": "Adjectives already ending in -e keep the same feminine form: rouge → rouge."
   },
   {
    "ko": "불규칙: blanc → blanche, vieux → vieille, nouveau → nouvelle.",
    "en": "Irregular: blanc → blanche, vieux → vieille, nouveau → nouvelle."
   },
   {
    "ko": "대부분의 형용사는 명사 뒤에 둡니다: un sac rouge.",
    "en": "Most adjectives follow the noun: un sac rouge."
   }
  ],
  "examples": [
   {
    "t": "Mon sac est neuf.",
    "ko": "제 가방은 새것이에요.",
    "en": "My bag is new."
   },
   {
    "t": "La chaise est petite et vieille.",
    "ko": "그 의자는 작고 낡았어요.",
    "en": "The chair is small and old."
   },
   {
    "t": "J'ai un parapluie rouge.",
    "ko": "저는 빨간 우산이 있어요.",
    "en": "I have a red umbrella."
   },
   {
    "t": "Le ciel est bleu.",
    "ko": "하늘은 파래요.",
    "en": "The sky is blue."
   },
   {
    "t": "La soupe est bonne.",
    "ko": "그 수프는 맛있어요.",
    "en": "The soup is good."
   }
  ],
