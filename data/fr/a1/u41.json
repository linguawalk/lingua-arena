     "J'utilise un ordinateur."
    ],
    [
     "envoyer + 메일",
     "Elle envoie un mail."
    ],
    [
     "Il y a ~ ?",
     "Il y a du wifi ici ?"
    ],
    [
     "ne marche pas",
     "Mon téléphone ne marche pas."
    ]
   ]
  },
