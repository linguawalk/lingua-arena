 "grammar": {
  "title": {
   "ko": "questions et négation au passé composé",
   "en": "Questions and negatives in the passé composé"
  },
  "explain": {
   "ko": "Pour poser une question au passé composé, on ajoute est-ce que devant la phrase ou on utilise l'intonation : Est-ce que tu as travaillé ? / Tu as travaillé ? On peut aussi inverser l'auxiliaire et le sujet : As-tu travaillé ? Pour la négation, ne … pas entoure l'auxiliaire : je n'ai pas travaillé. Le participe passé reste inchangé.",
   "en": "To ask a question in the passé composé add est-ce que at the start or just raise your voice: Est-ce que tu as travaillé ? / Tu as travaillé ? You can also invert auxiliary and subject: As-tu travaillé ? For the negative, ne … pas surrounds the auxiliary: je n'ai pas travaillé. The participle does not change."
  },
  "table": {
   "head": [
    "형태 / Forme",
    "예문 / Exemple"
   ],
   "rows": [
    [
     "Est-ce que + sujet + auxiliaire + participe ?",
     "Est-ce que tu as travaillé ?"
    ],
    [
     "Oui, j'ai + participe.",
     "Oui, j'ai travaillé."
    ],
    [
     "Non, je n'ai pas + participe.",
     "Non, je n'ai pas travaillé."
    ],
    [
     "sujet + n'ai pas + participe",
     "Je n'ai pas travaillé."
    ],
    [
     "mot interrogatif + est-ce que",
     "Quand est-ce que tu es arrivé ?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "Le mot interrogatif se place en tête : Où es-tu allé ? Pourquoi est-elle restée ?",
    "en": "The question word comes first: Où es-tu allé ? Pourquoi est-elle restée ?"
   },
   {
    "ko": "Après ne … pas, le participe reste inchangé : je n'ai pas vu (pas « vue »).",
    "en": "After ne … pas the participle stays the same: je n'ai pas vu."
   },
   {
    "ko": "À l'oral, on dit souvent « j'ai pas travaillé » sans ne.",
    "en": "In speech people often drop 'ne': j'ai pas travaillé."
   }
  ],
  "examples": [
   {
    "t": "Tu as travaillé hier ?",
    "ko": "어제 일했어요?",
    "en": "Did you work yesterday?"
   },
   {
    "t": "Je n'ai pas travaillé hier.",
    "ko": "저는 어제 일하지 않았어요.",
    "en": "I didn't work yesterday."
   },
   {
    "t": "Quand es-tu allé à Paris ?",
    "ko": "파리에는 언제 갔어요?",
    "en": "When did you go to Paris?"
   },
   {
    "t": "Pourquoi est-elle restée à la maison ?",
    "ko": "그녀는 왜 집에 있었어요?",
    "en": "Why did she stay at home?"
   },
   {
    "t": "Ils n'ont pas vu le musée.",
    "ko": "그들은 박물관을 보지 않았어요.",
    "en": "They didn't see the museum."
   }
  ],
