 "grammar": {
  "title": {
   "ko": "trop, assez (de) et aussi … que",
   "en": "trop, assez (de) and aussi … que"
  },
  "explain": {
   "ko": "trop는 형용사 앞에서 '지나치게'라는 뜻입니다 (trop chaud). assez는 형용사 앞에서 '충분히' (assez grand), 명사 앞에서는 assez de + 명사입니다 (assez d'argent). trop … pour + 동사원형은 '~하기에는 너무 …'이고, aussi … que는 같은 정도를 비교합니다.",
   "en": "Trop goes before an adjective and means too much (trop chaud). Assez goes before an adjective (assez grand) and assez de goes before a noun (assez d'argent). Trop … pour + infinitive means too … to; aussi … que compares equal things."
  },
  "table": {
   "head": [
    "표현 / Structure",
    "예 / Exemple"
   ],
   "rows": [
    [
     "trop + adj.",
     "Ce café est trop chaud."
    ],
    [
     "assez + adj.",
     "Cette pièce est assez grande."
    ],
    [
     "assez de + nom",
     "Je n'ai pas assez d'argent."
    ],
    [
     "aussi … que",
     "Ce sac est aussi cher que celui-là."
    ]
   ]
  },
  "notes": [
   {
    "ko": "trop / assez는 형용사 앞에 둡니다.",
    "en": "Trop / assez go before the adjective."
   },
   {
    "ko": "명사 앞에서는 de: assez d'argent, trop de bruit.",
    "en": "Before a noun use de: assez d'argent, trop de bruit."
   },
   {
    "ko": "부정 비교: pas aussi bon que.",
    "en": "Negative comparison: pas aussi bon que."
   }
  ],
