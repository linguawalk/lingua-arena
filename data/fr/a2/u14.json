 "grammar": {
  "title": {
   "ko": "adverbes de fréquence et de manière",
   "en": "Adverbs of frequency and manner"
  },
  "explain": {
   "ko": "Les adverbes de fréquence (toujours, d'habitude, souvent, parfois, jamais) se placent généralement après le verbe conjugué : je prends toujours un petit-déjeuner. Avec un temps composé, ils se placent entre l'auxiliaire et le participe : j'ai souvent mangé. Les adverbes de manière se forment souvent avec -ment (rapide → rapidement). L'adverbe de bon est bien.",
   "en": "Frequency adverbs (toujours, d'habitude, souvent, parfois, jamais) usually go after the conjugated verb: je prends toujours un petit-déjeuner. In a compound tense they go between auxiliary and participle: j'ai souvent mangé. Manner adverbs are often formed with -ment (rapide → rapidement). The adverb of bon is bien."
  },
  "table": {
   "head": [
    "종류 / Type",
    "예문 / Exemple"
   ],
   "rows": [
    [
     "동사 뒤 / après le verbe",
     "Je prends toujours un petit-déjeuner."
    ],
    [
     "être 뒤 / après être",
     "Elle est souvent en retard."
    ],
    [
     "문두 / début de phrase",
     "Parfois, je vais au travail à pied."
    ],
    [
     "방법 / manière",
     "Il marche rapidement."
    ],
    [
     "bon → bien",
     "Elle parle bien anglais."
    ]
   ]
  },
  "notes": [
   {
    "ko": "« jamais » s'emploie avec « ne » : Il ne boit jamais de café.",
    "en": "'Jamais' goes with 'ne': Il ne boit jamais de café."
   },
   {
    "ko": "Les adverbes de manière suivent le verbe : Parlez lentement.",
    "en": "Manner adverbs usually follow the verb: Parlez lentement."
   },
   {
    "ko": "Adjectif féminin + -ment : lent → lente → lentement ; prudent → prudemment.",
    "en": "Feminine adjective + -ment: lent → lente → lentement; prudent → prudemment."
   }
  ],
