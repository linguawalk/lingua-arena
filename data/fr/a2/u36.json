 "grammar": {
  "title": {
   "ko": "demandes polies : pourriez-vous … ? je peux … ? ça vous dérange si … ?",
   "en": "polite requests: pourriez-vous … ? je peux … ? ça vous dérange si … ?"
  },
  "explain": {
   "ko": "정중한 부탁은 Pourriez-vous + 동사원형 … ? (조건법)을 씁니다. 허락을 구할 때는 Je peux … ? / Je pourrais … ?, 아주 정중하게는 Ça vous dérange si je + 현재형 … ?를 씁니다. 수락은 'Bien sûr.' / 'Pas du tout.', 거절은 'Je suis désolé, je ne peux pas.'처럼 부드럽게 합니다.",
   "en": "Make polite requests with Pourriez-vous + infinitive … ? (conditional). Ask permission with Je peux … ? / Je pourrais … ? and be very polite with Ça vous dérange si je + present … ? Accept with 'Bien sûr' / 'Pas du tout'; refuse gently: 'Je suis désolé, je ne peux pas.'"
  },
  "table": {
   "head": [
    "표현 / Structure",
    "예 / Exemple"
   ],
   "rows": [
    [
     "Pourriez-vous + inf.",
     "Pourriez-vous ouvrir la porte ?"
    ],
    [
     "Je peux / pourrais + inf.",
     "Je pourrais emprunter votre stylo ?"
    ],
    [
     "Ça vous dérange si",
     "Ça vous dérange si je ferme la fenêtre ?"
    ],
    [
     "거절 / refus",
     "Je suis désolé, je ne peux pas."
    ]
   ]
  },
  "notes": [
   {
    "ko": "부탁 = Pourriez-vous …, 허락 = Je peux …",
    "en": "Request = Pourriez-vous …; permission = Je peux …"
   },
   {
    "ko": "Ça vous dérange si 뒤에는 현재형.",
    "en": "After Ça vous dérange si use the present."
   },
   {
    "ko": "s'il vous plaît를 붙이면 더 정중합니다.",
    "en": "Adding s'il vous plaît makes it more polite."
   }
  ],
  "examples": [
   {
