     "Le wifi ne marche pas."
    ],
    [
     "tu devrais",
     "Tu devrais utiliser un mot de passe sûr."
    ],
    [
     "il ne faut pas",
     "Il ne faut pas partager d'informations personnelles."
    ]
   ]
  },
