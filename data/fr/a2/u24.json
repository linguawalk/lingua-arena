 "grammar": {
  "title": {
   "ko": "passé composé avec déjà, pas encore ; venir de + infinitif",
   "en": "passé composé with déjà and pas encore; venir de + infinitive"
  },
  "explain": {
   "ko": "déjà는 passé composé의 조동사와 과거분사 사이에 놓입니다: j'ai déjà fait. 부정에서는 ne … pas encore를 씁니다: je n'ai pas encore mangé. 방금 일어난 일은 venir de + 동사원형으로 말합니다: il vient d'arriver.",
   "en": "Déjà goes between the auxiliary and the past participle: j'ai déjà fait. In negatives use ne … pas encore: je n'ai pas encore mangé. For something that happened a moment ago use venir de + infinitive: il vient d'arriver."
  },
  "table": {
   "head": [
    "표현 / Structure",
    "예 / Exemple"
   ],
   "rows": [
    [
     "déjà",
     "J'ai déjà fait mes devoirs."
    ],
    [
     "ne … pas encore",
     "Je n'ai pas encore mangé."
    ],
    [
     "venir de + inf.",
     "Il vient d'arriver."
    ],
    [
     "대답 / réponses",
     "Oui, déjà. / Non, pas encore."
    ]
   ]
  },
  "notes": [
   {
    "ko": "déjà는 조동사와 과거분사 사이.",
    "en": "Déjà goes between the auxiliary and the participle."
   },
   {
    "ko": "pas encore = 아직 ~하지 않았다.",
    "en": "Pas encore = not yet."
   },
   {
    "ko": "venir de + 동사원형 = 방금 ~했다.",
    "en": "Venir de + infinitive = has just."
   }
  ],
  "examples": [
