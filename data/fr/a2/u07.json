 "grammar": {
  "title": {
   "ko": "être en train de + infinitif",
   "en": "'Être en train de' + infinitive"
  },
  "explain": {
   "ko": "En français, le présent suffit souvent pour dire ce qui se passe maintenant : je travaille, il pleut. Pour insister sur l'action en cours, on utilise être en train de + infinitif : je suis en train de travailler. Pour la négation, ne … pas entoure être : je ne suis pas en train d'écrire.",
   "en": "In French the plain present often says what is happening now: je travaille, il pleut. To stress that the action is in progress use être en train de + infinitive: je suis en train de travailler. For a negative, ne … pas surrounds être: je ne suis pas en train d'écrire."
  },
  "table": {
   "head": [
    "규칙 / Règle",
    "원형 / Infinitif",
    "en train de"
   ],
   "rows": [
    [
     "présent",
     "travailler",
     "je travaille"
    ],
    [
     "en train de + infinitif",
     "écrire",
     "je suis en train d'écrire"
    ],
    [
     "en train de + infinitif",
     "courir",
     "il est en train de courir"
    ],
    [
     "en train de + infinitif",
     "s'asseoir",
     "elle est en train de s'asseoir"
    ],
    [
     "en train de + infinitif",
     "écouter",
     "nous sommes en train d'écouter"
    ]
   ]
  },
  "notes": [
   {
    "ko": "Mots du moment présent : maintenant, en ce moment, aujourd'hui.",
    "en": "Time words for now: maintenant, en ce moment, aujourd'hui."
   },
   {
    "ko": "Être se conjugue avec le sujet : je suis, elle est, ils sont.",
    "en": "Être agrees with the subject: je suis, elle est, ils sont."
   },
   {
    "ko": "Les verbes d'état (savoir, aimer, vouloir) ne s'emploient guère avec en train de.",
    "en": "State verbs (savoir, aimer, vouloir) are rarely used with en train de."
   }
  ],
