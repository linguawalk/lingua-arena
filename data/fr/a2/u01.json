     "je n'étais pas",
     "Est-ce que j'étais… ?"
    ],
    [
     "tu",
     "tu étais",
     "tu n'étais pas",
     "Tu étais… ?"
    ],
    [
     "il / elle",
     "il était",
     "il n'était pas",
     "Il était… ?"
    ],
    [
     "nous",
     "nous étions",
     "nous n'étions pas",
     "Nous étions… ?"
    ],
    [
     "ils / elles",
     "ils étaient",
     "ils n'étaient pas",
     "Ils étaient… ?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "Mots du passé : hier, hier soir, le week-end dernier, il y a deux heures.",
    "en": "Past time words: hier, hier soir, le week-end dernier, il y a deux heures."
   },
   {
    "ko": "« il y a » + durée se place devant le temps écoulé : il y a trois jours.",
    "en": "'Il y a' comes before the length of time: il y a trois jours."
   },
   {
    "ko": "Réponses courtes : Oui, j'étais. / Non, nous n'étions pas.",
    "en": "Short answers: Oui, j'étais. / Non, nous n'étions pas."
   }
  ],
