 "grammar": {
  "title": {
   "ko": "접두사 un- · re- · dis- · 접미사 -ful · -less · -ment · -tion",
   "en": "prefixes un-, re-, dis- and suffixes -ful, -less, -ment, -tion"
  },
  "explain": {
   "ko": "접두사(앞에 붙는 말)와 접미사(뒤에 붙는 말)를 알면 어휘를 빠르게 늘릴 수 있습니다. 반대: un- (happy → unhappy), dis- (agree → disagree), im- / in- (possible → impossible). 다시: re- (do → redo). 형용사를 만드는 접미사: -ful(full of; helpful), -less(without; careless). 명사를 만드는 접미사: -ment (achieve → achievement), -tion (present → presentation). 접미사를 붙이면 품사가 바뀌므로 문장에서 쓰임을 확인하세요.",
   "en": "Knowing prefixes (added before a word) and suffixes (added after) helps you build vocabulary quickly. Opposites: un- (happy → unhappy), dis- (agree → disagree), im- / in- (possible → impossible). Again: re- (do → redo). Adjective suffixes: -ful (full of; helpful), -less (without; careless). Noun suffixes: -ment (achieve → achievement), -tion (present → presentation). A suffix can change the part of speech, so check how the word is used in the sentence."
  },
  "table": {
   "head": [
    "구조 / Structure",
    "접사 / Affixes",
    "예문 / Example"
   ],
   "rows": [
    [
     "반대 / opposite",
     "un- · dis- · im- · in-",
     "She was unhappy at work."
    ],
    [
     "다시 / again",
     "re-",
     "I have to redo the report."
    ],
    [
     "형용사 / adjective",
     "-ful · -less",
     "The assistant was very helpful."
    ],
    [
     "명사 / noun",
     "-ment · -tion",
     "Graduating is a great achievement."
    ]
   ]
  },
  "notes": [
   {
    "ko": "접두사는 철자를 바꾸지 않고 붙입니다(un + happy = unhappy).",
    "en": "Prefixes do not change the spelling of the word (un + happy = unhappy)."
   },
   {
    "ko": "-ful과 -less는 같은 어근에서 반대 뜻을 만들 수 있습니다(helpful / helpless).",
    "en": "-ful and -less can make opposites from the same root (helpful / helpless)."
   },
   {
    "ko": "모든 단어에 모든 접사가 붙는 것은 아니므로 사전을 확인하세요.",
    "en": "Not every word takes every affix; check a dictionary."
   }
  ],
