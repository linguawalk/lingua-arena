 "grammar": {
  "title": {
   "ko": "수동태 (현재·과거·현재완료·미래)",
   "en": "Passive: present, past, present perfect, future"
  },
  "explain": {
   "ko": "수동태(be + 과거분사)는 행위자보다 행위의 대상이나 결과가 중요할 때, 행위자를 모르거나 말할 필요가 없을 때 씁니다. 시제는 be동사로 바꿉니다: 현재 is made, 과거 was made, 현재완료 has been made, 미래 will be made, 진행 중 is being made. 행위자를 밝혀야 할 때는 by를 씁니다(The telephone was invented by Bell). 자동사(happen, arrive)는 수동태로 쓰지 않습니다.",
   "en": "Use the passive (be + past participle) when the action or its result matters more than who did it, or when the doer is unknown or unimportant. Change the tense through the verb be: is made, was made, has been made, will be made, is being made. Use 'by' to name the doer (The telephone was invented by Bell). Intransitive verbs (happen, arrive) cannot be made passive."
  },
  "table": {
   "head": [
    "시제 / Tense",
    "형태 / Form",
    "예문 / Example"
   ],
   "rows": [
    [
     "현재 / Present",
     "is / are + p.p.",
     "This car is made in Germany."
    ],
    [
     "과거 / Past",
     "was / were + p.p.",
     "My bike was stolen last night."
    ],
    [
     "현재완료 / Present perfect",
     "has / have been + p.p.",
     "The flight has been cancelled."
    ],
    [
     "미래 / Future",
     "will be + p.p.",
     "The parcel will be delivered tomorrow."
    ],
    [
     "진행 / Continuous",
     "is / are being + p.p.",
     "My laptop is being repaired."
    ]
   ]
  },
  "notes": [
   {
    "ko": "행위자가 중요하지 않으면 by를 생략합니다: My bike was stolen.",
    "en": "Leave out 'by' if the doer isn't important: My bike was stolen."
   },
   {
    "ko": "수동태에서도 시제는 be동사가 나타냅니다.",
    "en": "The tense is shown by the verb be."
   },
   {
    "ko": "목적어가 없는 자동사는 수동태가 될 수 없습니다.",
    "en": "Verbs with no object cannot be passive."
   }
  ],
