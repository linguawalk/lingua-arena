   },
   {
    "t": "She speaks English well.",
    "ko": "그녀는 영어를 잘해요."
   },
   {
    "t": "Please speak slowly.",
    "ko": "천천히 말해 주세요."
   },
   {
    "t": "We often watch films.",
    "ko": "우리는 자주 영화를 봐요."
   }
  ],
