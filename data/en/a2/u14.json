 "grammar": {
  "title": {
   "ko": "빈도 부사와 방법 부사",
   "en": "Adverbs of frequency and manner"
  },
  "explain": {
   "ko": "빈도 부사(always, usually, often, sometimes, never)는 보통 일반동사 앞, be동사 뒤에 둡니다. 방법 부사는 '어떻게'를 나타내며 대개 형용사에 -ly를 붙입니다(quick → quickly). good의 부사는 well입니다.",
   "en": "Frequency adverbs (always, usually, often, sometimes, never) usually go before the main verb but after 'be'. Manner adverbs say how something is done and mostly add -ly to the adjective (quick → quickly). The adverb of good is well."
  },
  "table": {
   "head": [
    "종류 / Type",
    "예문 / Example"
   ],
   "rows": [
    [
     "일반동사 앞 / before verb",
     "I always have breakfast."
    ],
    [
     "be 뒤 / after 'be'",
     "She is usually late."
    ],
    [
     "가끔 / sometimes",
     "Sometimes I walk to work."
    ],
    [
     "방법 / manner",
     "He walks quickly."
    ],
    [
     "good → well",
     "She speaks English well."
    ]
   ]
  },
  "notes": [
   {
    "ko": "never는 이미 부정이므로 not과 함께 쓰지 않습니다: I never drink coffee.",
    "en": "Never is already negative: I never drink coffee (not I don't never)."
   },
   {
    "ko": "방법 부사는 동사 뒤에 둡니다: Speak slowly.",
    "en": "Manner adverbs usually follow the verb: Speak slowly."
   },
   {
    "ko": "fast, hard는 형용사와 부사 형태가 같습니다.",
    "en": "Fast and hard have the same form as adjective and adverb."
   }
  ],
  "examples": [
   {
    "t": "I always have breakfast.",
    "ko": "저는 항상 아침을 먹어요."
   },
   {
    "t": "He never drinks coffee.",
