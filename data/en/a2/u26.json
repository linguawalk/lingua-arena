 "grammar": {
  "title": {
   "ko": "현재완료 vs 과거형 (ago, last, in + 연도)",
   "en": "present perfect or past simple (ago, last, in + year)"
  },
  "explain": {
   "ko": "경험이나 지금과 연결된 일에는 현재완료(have + 과거분사)를 쓰고, 언제인지 분명한 과거(two weeks ago, last year, in 2019, yesterday)에는 과거형을 씁니다. 'Have you ever ...?'로 경험을 묻고, 시점을 물으면 'When did you ...?'로 바꿉니다.",
   "en": "Use the present perfect for experiences and links with now, and the past simple for a finished time (two weeks ago, last year, in 2019, yesterday). Ask 'Have you ever ...?' about experience and 'When did you ...?' about the time."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "현재완료 / experience",
     "I have been to Paris twice."
    ],
    [
     "과거형 / finished time",
     "I went to Paris last year."
    ],
    [
     "경험 질문",
     "Have you ever skied?"
    ],
    [
     "시점 질문",
     "When did you go?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "ago, last, yesterday, in 2019가 있으면 과거형.",
    "en": "With ago, last, yesterday or in + year use the past simple."
   },
   {
    "ko": "ever / never / twice는 현재완료와 함께 씁니다.",
    "en": "ever, never and twice go with the present perfect."
   },
   {
    "ko": "처음 경험은 현재완료, 구체적 정보는 과거형으로 이어 갑니다.",
    "en": "Start with the present perfect, then give details in the past simple."
   }
  ],
  "examples": [
