 "grammar": {
  "title": {
   "ko": "접속사 because / so / but / or",
   "en": "linking words: because, so, but and or"
  },
  "explain": {
   "ko": "because는 이유('~해서'), so는 결과('그래서 ~'), but은 반대('하지만'), or는 선택('또는')을 이어 줍니다. because는 이유 앞에, so는 결과 앞에 옵니다. because of 뒤에는 절이 아니라 명사가 옵니다 (because of the rain).",
   "en": "Because gives a reason, so gives a result, but shows contrast and or shows a choice. Because comes before the reason; so comes before the result. After because of use a noun, not a clause (because of the rain)."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "because (이유)",
     "I was late because I missed the bus."
    ],
    [
     "so (결과)",
     "I was ill, so I stayed at home."
    ],
    [
     "but (대조)",
     "I was tired but I studied."
    ],
    [
     "or (선택)",
     "Would you like tea or coffee?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "because + 이유 / so + 결과.",
    "en": "because + reason / so + result."
   },
   {
    "ko": "so와 but 앞에는 쉼표를 자주 씁니다.",
    "en": "A comma often comes before so and but."
   },
   {
    "ko": "because of + 명사: because of the rain.",
    "en": "because of + noun: because of the rain."
   }
  ],
  "examples": [
