     "I have forgotten my password."
    ],
    [
     "현재진행 / present",
     "The Wi-Fi isn't working."
    ],
    [
     "should",
     "You should use a safe password."
    ],
    [
     "shouldn't",
     "You shouldn't share personal information."
    ]
   ]
  },
  "notes": [
   {
    "ko": "충고는 should / shouldn't + 동사원형.",
    "en": "Advice: should / shouldn't + base verb."
   },
   {
    "ko": "문제 설명: have + 과거분사.",
    "en": "Describe problems with have + past participle."
   },
   {
    "ko": "개인 정보와 비밀번호는 보호하세요.",
    "en": "Keep personal information and passwords safe."
   }
  ],
