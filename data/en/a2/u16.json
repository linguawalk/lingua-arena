 "grammar": {
  "title": {
   "ko": "목적격 대명사 · too / enough",
   "en": "Object pronouns · too / enough"
  },
  "explain": {
   "ko": "동사나 전치사 뒤에는 목적격 대명사 me, you, him, her, it, us, them을 씁니다(I like it, give me, for them). too는 '너무 ~한'으로 문제를 나타내고 형용사 앞에 씁니다(too big). enough는 '충분히'이며 형용사 뒤에 씁니다(big enough).",
   "en": "After a verb or preposition use the object pronouns me, you, him, her, it, us, them (I like it, give me, for them). 'Too' means 'more than is good' and goes before the adjective (too big); 'enough' goes after the adjective (big enough)."
  },
  "table": {
   "head": [
    "주어 / Subject",
    "목적어 / Object"
   ],
   "rows": [
    [
     "I",
     "me"
    ],
    [
     "you",
     "you"
    ],
    [
     "he / she",
     "him / her"
    ],
    [
     "it",
     "it"
    ],
    [
     "we / they",
     "us / them"
    ]
   ]
  },
  "notes": [
   {
    "ko": "too + 형용사: too big. 형용사 + enough: big enough.",
    "en": "too + adjective: too big. adjective + enough: big enough."
   },
   {
    "ko": "try ~ on에서 대명사는 사이에 옵니다: try it on (✕ try on it).",
    "en": "With 'try on' a pronoun goes in the middle: try it on (not try on it)."
   },
   {
    "ko": "too는 부정적인 느낌, very는 단순히 정도가 높다는 뜻입니다.",
    "en": "Too has a negative feeling; very only means a high degree."
   }
  ],
  "examples": [
   {
    "t": "I like this jacket. Can I try it on?",
    "ko": "이 재킷이 마음에 들어요. 입어 봐도 돼요?"
   },
   {
    "t": "These trousers are too long.",
    "ko": "이 바지는 너무 길어요."
   },
   {
    "t": "This jacket isn't warm enough.",
    "ko": "이 재킷은 충분히 따뜻하지 않아요."
   },
   {
    "t": "Please give me a bigger size.",
    "ko": "저에게 더 큰 치수를 주세요."
   },
   {
    "t": "I liked the shoes, so I bought them.",
    "ko": "신발이 마음에 들어서 그걸 샀어요."
   }
  ],
