 "grammar": {
  "title": {
   "ko": "규칙 동사의 과거형 -ed",
   "en": "Regular past simple: -ed"
  },
  "explain": {
   "ko": "규칙 동사의 과거형은 동사 끝에 -ed를 붙입니다. 모든 주어에 같은 형태를 씁니다. e로 끝나면 -d만 붙이고(like → liked), 자음 + y는 y를 i로 바꿉니다(study → studied). 짧은 동사는 자음을 하나 더 씁니다(stop → stopped).",
   "en": "Regular verbs add -ed in the past, the same for every subject. If the verb ends in e add only -d (like → liked); consonant + y becomes -ied (study → studied); short verbs double the last consonant (stop → stopped)."
  },
  "table": {
   "head": [
    "규칙 / Rule",
    "원형 / Base",
    "과거형 / Past"
   ],
   "rows": [
    [
     "+ -ed",
     "work",
     "worked"
    ],
    [
     "+ -d (e로 끝남)",
     "like",
     "liked"
    ],
    [
     "y → -ied",
     "study",
     "studied"
    ],
    [
     "자음 겹침 / double",
     "stop",
     "stopped"
    ],
    [
     "+ -ed",
     "visit",
     "visited"
    ]
   ]
  },
  "notes": [
   {
    "ko": "모든 주어에 같은 형태: I worked, she worked, they worked.",
    "en": "Same form for every subject: I worked, she worked, they worked."
   },
   {
    "ko": "-ed 발음은 세 가지: /t/ worked, /d/ played, /ɪd/ visited.",
    "en": "-ed has three sounds: /t/ worked, /d/ played, /ɪd/ visited."
   },
   {
    "ko": "과거를 나타내는 말: yesterday, last week, two days ago.",
    "en": "Past time words: yesterday, last week, two days ago."
   }
  ],
  "examples": [
