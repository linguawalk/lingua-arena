 "grammar": {
  "title": {
   "ko": "did로 만드는 의문문·부정문",
   "en": "'did' for questions and negatives"
  },
  "explain": {
   "ko": "과거의 의문문과 부정문은 did를 씁니다. 의문문은 Did + 주어 + 동사 원형, 부정문은 didn't + 동사 원형입니다. did가 과거를 나타내므로 본동사는 원형으로 씁니다. be동사(was/were)는 did를 쓰지 않습니다.",
   "en": "Make past questions and negatives with 'did'. A question is Did + subject + base verb; a negative is didn't + base verb. 'Did' already shows the past, so the main verb stays in its base form. 'Was / were' does not use 'did'."
  },
  "table": {
   "head": [
    "형태 / Form",
    "예문 / Example"
   ],
   "rows": [
    [
     "Did + 주어 + 원형?",
     "Did you go to Paris?"
    ],
    [
     "Yes, 주어 + did.",
     "Yes, I did."
    ],
    [
     "No, 주어 + didn't.",
     "No, I didn't."
    ],
    [
     "주어 + didn't + 원형",
     "I didn't work."
    ],
    [
     "의문사 + did + 주어 + 원형?",
     "When did you arrive?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "did 뒤에는 동사 원형: Did you go (✕ Did you went).",
    "en": "After 'did' use the base verb: Did you go (not Did you went)."
   },
   {
    "ko": "의문사는 맨 앞에: Where did you go? Why did she stay?",
    "en": "Question words come first: Where did you go? Why did she stay?"
   },
   {
    "ko": "was / were 문장은 did 없이: Were you late? (✕ Did you were late?)",
    "en": "Sentences with was / were do not use did: Were you late?"
   }
  ],
  "examples": [
   {
    "t": "Did you work yesterday?",
    "ko": "어제 일했어요?"
   },
   {
    "t": "I didn't work yesterday.",
    "ko": "저는 어제 일하지 않았어요."
   },
   {
    "t": "When did you go to Paris?",
    "ko": "파리에는 언제 갔어요?"
   },
   {
    "t": "Why did she stay at home?",
    "ko": "그녀는 왜 집에 있었어요?"
   },
   {
    "t": "They didn't see the museum.",
    "ko": "그들은 박물관을 보지 않았어요."
   }
  ],
