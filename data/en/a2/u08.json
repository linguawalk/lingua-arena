 "grammar": {
  "title": {
   "ko": "현재형 vs 현재진행형",
   "en": "Present simple vs present continuous"
  },
  "explain": {
   "ko": "현재형은 습관, 일상, 사실에 씁니다(I usually go by bus). 현재진행형은 지금 하고 있는 일과 일시적인 상황에 씁니다(Today I'm walking). every day, usually 같은 말은 현재형과, now, today, this week 같은 말은 진행형과 어울립니다.",
   "en": "Use the present simple for habits, routines and facts (I usually go by bus). Use the present continuous for what is happening now and for temporary situations (Today I'm walking). Words such as every day and usually go with the simple; now, today and this week go with the continuous."
  },
  "table": {
   "head": [
    "현재형 / Simple",
    "현재진행형 / Continuous"
   ],
   "rows": [
    [
     "습관 / habit",
     "지금·일시적 / now, temporary"
    ],
    [
     "I go by bus.",
     "I'm walking today."
    ],
    [
     "She lives in Seoul.",
     "She's staying at a hotel this week."
    ],
    [
     "every day, usually",
     "now, today, this week"
    ],
    [
     "Do you work?",
     "Are you working?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "he / she / it 뒤에는 -s: She lives, he works.",
    "en": "With he / she / it add -s: She lives, he works."
   },
   {
    "ko": "항상 하는 일과 지금 하는 일을 비교할 때 but을 쓰면 좋습니다.",
    "en": "'But' is useful when you contrast what you usually do with what you are doing now."
   },
   {
    "ko": "live는 사실에는 현재형, 잠시 머물 때는 stay + 진행형을 씁니다.",
    "en": "Use live (simple) for where you really live and stay (continuous) for a short visit."
   }
  ],
