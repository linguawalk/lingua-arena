     "the easiest"
    ],
    [
     "expensive",
     "more expensive",
     "the most expensive"
    ],
    [
     "good",
     "better",
     "the best"
    ]
   ]
  },
  "notes": [
   {
    "ko": "최상급 앞에는 항상 the를 씁니다.",
    "en": "Always use 'the' before a superlative."
   },
   {
    "ko": "in + 장소(in the city), of + 복수(of all the students)로 범위를 말합니다.",
    "en": "Use in + place (in the city) and of + plural (of all the students) to give the group."
   },
   {
    "ko": "비교는 두 개 사이, 최상급은 세 개 이상 사이입니다.",
    "en": "A comparative is for two things; a superlative is for three or more."
   }
  ],
