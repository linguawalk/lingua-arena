 "grammar": {
  "title": {
   "ko": "불만 표현: It doesn't work / I'd like a refund / can I change it",
   "en": "complaints: It doesn't work, I'd like a refund and Can I exchange it?"
  },
  "explain": {
   "ko": "문제는 There's a problem. / It doesn't work. / The ... is broken.으로 말합니다. 요청은 I'd like a refund. 또는 Can I exchange this ...?로 정중하게 합니다. 잘못 받은 물건은 I got the wrong ...로 설명합니다. 영수증(receipt)은 환불·교환의 증거입니다.",
   "en": "Describe a problem with There's a problem, It doesn't work or The ... is broken. Make a polite request with I'd like a refund or Can I exchange this ...? Say you received the wrong item with I got the wrong ... A receipt is your proof of purchase."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "문제 / problem",
     "It doesn't work. The computer is broken."
    ],
    [
     "요청 / request",
     "I'd like a refund."
    ],
    [
     "교환 / exchange",
     "Can I exchange this for a bigger one?"
    ],
    [
     "잘못 / wrong",
     "I got the wrong size."
    ]
   ]
  },
  "notes": [
   {
    "ko": "불만은 정중하게: I'd like ..., Could you ...?",
    "en": "Stay polite: I'd like ..., Could you ...?"
   },
   {
    "ko": "작동 안 함: It doesn't work / won't turn on.",
    "en": "Not working: It doesn't work / won't turn on."
   },
   {
    "ko": "구매 증명: receipt.",
    "en": "Proof of purchase: receipt."
   }
  ],
  "examples": [
