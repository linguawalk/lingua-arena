 "grammar": {
  "title": {
   "ko": "too / (not) enough / (not) as ... as",
   "en": "too, enough and (not) as ... as"
  },
  "explain": {
   "ko": "too는 형용사 앞에서 '너무 ~해서 안 좋다'는 뜻이고, enough는 형용사 뒤(big enough)나 명사 앞(enough money)에서 '충분하다'는 뜻입니다. too ~ to 동사원형은 '~하기엔 너무 ~하다'이고, as ... as는 '~만큼 ...하다'입니다.",
   "en": "Too goes before an adjective and means more than is good (too hot). Enough goes after an adjective (big enough) or before a noun (enough money). Too ... to + verb means 'too ... for something'. As ... as compares equal things."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "too + adj",
     "This coffee is too hot."
    ],
    [
     "adj + enough",
     "This room is big enough."
    ],
    [
     "enough + noun",
     "I don't have enough money."
    ],
    [
     "as ... as",
     "This bag is as expensive as that one."
    ]
   ]
  },
  "notes": [
   {
    "ko": "too는 '지나치게'라는 부정적 뜻이 있습니다.",
    "en": "too suggests there is a problem (more than is good)."
   },
   {
    "ko": "enough는 형용사 뒤, 명사 앞에 옵니다.",
    "en": "enough goes after adjectives, before nouns."
   },
   {
    "ko": "too much + 셀 수 없는 명사 / too many + 복수명사.",
    "en": "too much + uncountable; too many + plural."
   }
  ],
