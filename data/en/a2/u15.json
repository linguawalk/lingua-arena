 "grammar": {
  "title": {
   "ko": "이동 전치사 · 길 안내 명령문",
   "en": "Prepositions of movement · giving directions"
  },
  "explain": {
   "ko": "길을 안내할 때는 명령문(동사 원형으로 시작)을 씁니다: Go straight on. Turn left. 이동을 나타내는 전치사는 along(~을 따라), past(~을 지나), across(~을 가로질러), through(~을 통과)입니다. 위치는 at the corner, next to, opposite로 말합니다.",
   "en": "Use imperatives (start with the base verb) to give directions: Go straight on. Turn left. Prepositions of movement are along, past, across and through. Say where something is with at the corner, next to or opposite."
  },
  "table": {
   "head": [
    "표현 / Expression",
    "예문 / Example"
   ],
   "rows": [
    [
     "go straight on",
     "Go straight on for 200 metres."
    ],
    [
     "turn left / right",
     "Turn left at the traffic lights."
    ],
    [
     "along + 길",
     "Walk along this road."
    ],
    [
     "past + 건물",
     "Go past the bank."
    ],
    [
     "across / through",
     "Cross the bridge. Go through the park."
    ]
   ]
  },
  "notes": [
   {
    "ko": "방향 안내는 명령문: Turn right. (주어를 쓰지 않습니다.)",
    "en": "Directions are imperatives: Turn right. (No subject.)"
   },
   {
    "ko": "'across from'은 '~ 맞은편에', 'next to'는 '~ 옆에'입니다.",
    "en": "'Across from' means opposite; 'next to' means beside."
   },
   {
    "ko": "on foot은 '걸어서', by bus는 '버스로'입니다.",
    "en": "On foot means walking; by bus means using the bus."
   }
  ],
  "examples": [
   {
