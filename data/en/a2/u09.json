 "grammar": {
  "title": {
   "ko": "비교급 -er / more ~ than",
   "en": "Comparatives: -er and more … than"
  },
  "explain": {
   "ko": "두 가지를 비교할 때는 형용사 비교급 + than을 씁니다. 짧은 형용사는 -er을 붙이고(cheap → cheaper), 긴 형용사는 앞에 more를 붙입니다(expensive → more expensive). good → better, bad → worse는 불규칙입니다.",
   "en": "Compare two things with a comparative adjective + than. Short adjectives add -er (cheap → cheaper); long adjectives take more (expensive → more expensive). Good → better and bad → worse are irregular."
  },
  "table": {
   "head": [
    "규칙 / Rule",
    "원형 / Adjective",
    "비교급 / Comparative"
   ],
   "rows": [
    [
     "+ -er",
     "cheap",
     "cheaper"
    ],
    [
     "자음 겹침 + -er",
     "big",
     "bigger"
    ],
    [
     "y → -ier",
     "easy",
     "easier"
    ],
    [
     "more + 형용사",
     "expensive",
     "more expensive"
    ],
    [
     "불규칙 / irregular",
     "good",
     "better"
    ]
   ]
  },
  "notes": [
   {
    "ko": "than은 비교 대상 앞에 씁니다: bigger than my room.",
    "en": "'Than' comes before the thing you compare with: bigger than my room."
   },
   {
    "ko": "나쁜 → worse, 좋은 → better는 외워야 합니다.",
    "en": "Bad → worse and good → better must be learnt."
   },
   {
    "ko": "'than me'처럼 구어에서는 목적격을 씁니다.",
    "en": "In speech we usually say 'than me', not 'than I'."
   }
  ],
  "examples": [
