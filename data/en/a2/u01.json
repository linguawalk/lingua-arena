 "grammar": {
  "title": {
   "ko": "be의 과거형 was / were",
   "en": "Past of 'be': was and were"
  },
  "explain": {
   "ko": "be동사의 과거형은 was와 were입니다. I / he / she / it 뒤에는 was, you / we / they 뒤에는 were를 씁니다. 부정은 was not (wasn't), were not (weren't), 의문문은 Was / Were를 앞으로 보냅니다.",
   "en": "The past of 'be' is was or were. Use 'was' with I, he, she, it and 'were' with you, we, they. Make a negative with wasn't / weren't, and a question by putting Was / Were first."
  },
  "table": {
   "head": [
    "주어 / Subject",
    "긍정 / Positive",
    "부정 / Negative",
    "의문 / Question"
   ],
   "rows": [
    [
     "I",
     "was",
     "wasn't",
     "Was I…?"
    ],
    [
     "you",
     "were",
     "weren't",
     "Were you…?"
    ],
    [
     "he / she / it",
     "was",
     "wasn't",
     "Was she…?"
    ],
    [
     "we",
     "were",
     "weren't",
     "Were we…?"
    ],
    [
     "they",
     "were",
     "weren't",
     "Were they…?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "과거를 나타내는 말: yesterday, last night, last weekend, two hours ago.",
    "en": "Past time words: yesterday, last night, last weekend, two hours ago."
   },
   {
    "ko": "'ago'는 지금부터 거꾸로 센 시간 뒤에 씁니다: three days ago.",
    "en": "'Ago' follows a length of time counted back from now: three days ago."
   },
   {
    "ko": "짧은 대답: Yes, I was. / No, we weren't.",
    "en": "Short answers: Yes, I was. / No, we weren't."
   }
  ],
