 "grammar": {
  "title": {
   "ko": "제2 조건문 If + 과거형, would + 동사원형",
   "en": "second conditional: if + past simple, would + base verb"
  },
  "explain": {
   "ko": "제2 조건문은 현재에 일어날 가능성이 낮거나 상상 속인 상황을 말합니다. If + 과거형, would + 동사원형 구조입니다. 과거형은 시간이 과거라는 뜻이 아니라 '현실이 아님'을 나타냅니다. be동사는 If I were ...처럼 모든 주어에 were를 자주 씁니다.",
   "en": "The second conditional is for unlikely or imaginary situations. Use If + past simple, would + base verb. The past form does not mean past time; it shows the situation is not real. With be, were is common for all subjects (If I were you ...)."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "If + 과거, would + 동사",
     "If I won the lottery, I would travel."
    ],
    [
     "If I were ...",
     "If I were rich, I would buy a big house."
    ],
    [
     "조언 / advice",
     "If I were you, I would see a doctor."
    ],
    [
     "부정 / negative",
     "I wouldn't quit my job."
    ]
   ]
  },
  "notes": [
   {
    "ko": "if절은 과거형, 결과절은 would + 동사원형.",
    "en": "If-clause: past simple; result: would + base verb."
   },
   {
    "ko": "If I were you, I would ...는 조언에 쓰는 표현.",
    "en": "If I were you, I would ... is used to give advice."
   },
   {
    "ko": "will이 아니라 would를 씁니다.",
    "en": "Use would, not will."
   }
  ],
  "examples": [
