 "grammar": {
  "title": {
   "ko": "재귀대명사 myself / yourself ... 와 each other",
   "en": "reflexive pronouns and each other"
  },
  "explain": {
   "ko": "행위의 주체와 대상이 같을 때 재귀대명사를 씁니다: myself, yourself, himself, herself, itself, ourselves, yourselves, themselves. 두 사람이나 그 이상이 서로에게 같은 행동을 할 때는 each other를 씁니다. by + 재귀대명사는 '혼자서'라는 뜻입니다.",
   "en": "Use a reflexive pronoun when the subject and object are the same: myself, yourself, himself, herself, itself, ourselves, yourselves, themselves. Use each other when two or more people do the same thing to one another. By + reflexive pronoun means alone."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "재귀 / reflexive",
     "I hurt myself. He hurt himself."
    ],
    [
     "복수 / plural",
     "We enjoyed ourselves. They did it themselves."
    ],
    [
     "서로 / each other",
     "They help each other."
    ],
    [
     "혼자서 / alone",
     "I travelled by myself."
    ]
   ]
  },
  "notes": [
   {
    "ko": "단수 -self, 복수 -selves.",
    "en": "Singular -self, plural -selves."
   },
   {
    "ko": "each other = 서로.",
    "en": "each other = one another."
   },
   {
    "ko": "enjoy 뒤에는 재귀대명사가 필요합니다.",
    "en": "Enjoy needs a reflexive pronoun when used for fun: enjoy yourself."
   }
  ],
  "examples": [
   {
    "t": "I saw myself in the mirror.",
    "ko": "나는 거울에서 나 자신을 봤어요."
   },
   {
