 "grammar": {
  "title": {
   "ko": "과거 수동태 was / were + 과거분사",
   "en": "past passive: was / were + past participle"
  },
  "explain": {
   "ko": "과거 수동태는 was / were + 과거분사입니다. 과거의 사건에서 행위자보다 결과가 중요할 때 씁니다. 주어가 단수면 was, 복수면 were를 씁니다. 누가 했는지 말하려면 by + 행위자를 씁니다.",
   "en": "The past passive is was / were + past participle. Use it for past events when the result matters more than who did it. Use was with a singular subject and were with a plural subject. Add by + doer to say who did it."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "was + 과거분사",
     "The bridge was built in 1990."
    ],
    [
     "were + 과거분사",
     "Two people were injured."
    ],
    [
     "by + 행위자",
     "It was designed by a famous architect."
    ],
    [
     "의문문 / question",
     "When was this bridge built?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "단수 was, 복수 were.",
    "en": "Singular was, plural were."
   },
   {
    "ko": "행위자가 중요하지 않으면 by를 생략합니다.",
    "en": "Omit by when the doer is not important."
   },
   {
    "ko": "불규칙 과거분사: built, written, stolen, found.",
    "en": "Irregular participles: built, written, stolen, found."
   }
  ],
  "examples": [
