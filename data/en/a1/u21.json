 "grammar": {
  "title": {
   "ko": "출신과 국적 (I'm from… / I'm Korean)",
   "en": "Origin and nationality (I'm from… / I'm Korean)"
  },
  "explain": {
   "ko": "출신은 'be from + 장소'로, 국적은 'be + 국적 형용사'로 말합니다. 나라 이름과 국적 형용사는 항상 대문자로 시작합니다. 사는 곳은 live in + 도시를 씁니다.",
   "en": "Say origin with 'be from + place' and nationality with 'be + nationality adjective'. Country names and nationality words always start with a capital letter. For where you live use live in + city."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "be from + 장소",
     "I am from Korea."
    ],
    [
     "be + 국적",
     "She is French."
    ],
    [
     "Where ... from?",
     "Where are you from?"
    ],
    [
     "live in + 도시",
     "I live in Seoul."
    ]
   ]
  },
  "notes": [
   {
    "ko": "국적 형용사는 대문자로 시작합니다: Korean, French.",
    "en": "Nationality words start with a capital letter: Korean, French."
   },
   {
    "ko": "I'm from Korea와 I'm Korean은 같은 뜻으로 쓸 수 있어요.",
    "en": "I'm from Korea and I'm Korean can mean the same thing."
   },
   {
    "ko": "도시 앞에는 in을 씁니다: I live in Seoul.",
    "en": "Use 'in' before a city: I live in Seoul."
   }
  ],
  "examples": [
   {
    "t": "I am from Korea.",
    "ko": "저는 한국 출신이에요."
   },
   {
    "t": "She is French.",
    "ko": "그녀는 프랑스 사람이에요."
   },
   {
    "t": "Where are you from?",
    "ko": "당신은 어디 출신이에요?"
   },
   {
    "t": "They are not Japanese.",
    "ko": "그들은 일본 사람이 아니에요."
   },
   {
    "t": "I live in Seoul.",
    "ko": "저는 서울에 살아요."
   }
  ],
