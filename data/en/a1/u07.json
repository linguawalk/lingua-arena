 "grammar": {
  "title": {
   "ko": "There is / There are + 위치 전치사",
   "en": "There is / There are + prepositions of place"
  },
  "explain": {
   "ko": "'~이 있다'는 There is(단수) / There are(복수)로 말합니다. 위치는 next to, in front of, on 같은 전치사로 나타내고, 장소는 Where is ~?로 묻습니다.",
   "en": "Say 'there is' with There is (one) / There are (many). Show position with next to, in front of, on, and ask for a place with Where is ~?"
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "There is + 단수",
     "There is a bank."
    ],
    [
     "There are + 복수",
     "There are two parks."
    ],
    [
     "next to",
     "The bank is next to the station."
    ],
    [
     "in front of",
     "The park is in front of the school."
    ],
    [
     "on",
     "on this street"
    ]
   ]
  },
  "notes": [
   {
    "ko": "하나면 There is, 둘 이상이면 There are: There are two banks.",
    "en": "One thing: There is. Two or more: There are. There are two banks."
   },
   {
    "ko": "장소는 Where is ~? 로 묻습니다.",
    "en": "Ask for a place with Where is ~?"
   },
   {
    "ko": "길 안내: Go straight. Turn left. Turn right.",
    "en": "Directions: Go straight. Turn left. Turn right."
   }
  ],
