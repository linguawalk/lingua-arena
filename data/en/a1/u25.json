 "grammar": {
  "title": {
   "ko": "How many / How much, a lot of",
   "en": "How many / How much, a lot of"
  },
  "explain": {
   "ko": "셀 수 있는 명사에는 How many + 복수, 셀 수 없는 명사에는 How much를 씁니다. a lot of는 두 종류 모두에 쓰는 '많은'이에요. 부정문과 의문문에서는 보통 much / many를 씁니다.",
   "en": "Use How many + plural for countable nouns and How much for uncountable nouns. A lot of means 'many / much' and works with both. In negatives and questions use much / many."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "How many + 복수",
     "How many tomatoes?"
    ],
    [
     "How much + 단수/셀 수 없는",
     "How much milk?"
    ],
    [
     "a lot of",
     "a lot of fruit / a lot of eggs"
    ],
    [
     "a kilo / bag of",
     "a kilo of apples"
    ]
   ]
  },
  "notes": [
   {
    "ko": "How many 뒤에는 복수 명사: How many apples?",
    "en": "After How many use a plural noun: How many apples?"
   },
   {
    "ko": "How much는 양과 가격 둘 다 물을 수 있어요.",
    "en": "How much can ask about amount and price."
   },
   {
    "ko": "a lot of는 긍정문에 잘 씁니다.",
    "en": "A lot of is common in positive sentences."
   }
  ],
  "examples": [
   {
    "t": "How many tomatoes are there?",
    "ko": "토마토가 몇 개 있어요?"
   },
   {
    "t": "How much milk is there?",
    "ko": "우유가 얼마나 있어요?"
   },
   {
    "t": "I eat a lot of vegetables.",
    "ko": "저는 채소를 많이 먹어요."
   },
   {
    "t": "A kilo of apples, please.",
    "ko": "사과 1킬로 주세요."
   },
   {
    "t": "How much are the bananas?",
    "ko": "바나나는 얼마예요?"
   }
  ],
