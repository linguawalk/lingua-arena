 "grammar": {
  "title": {
   "ko": "일과 동사와 빈도 부사 (always, usually)",
   "en": "Routine verbs and frequency adverbs (always, usually)"
  },
  "explain": {
   "ko": "일과는 '동사 + at + 시각'으로 말합니다. always, usually 같은 빈도 부사는 일반동사 앞에, be동사 뒤에 둡니다. he / she / it에는 have → has, go → goes를 씁니다.",
   "en": "Say a routine as verb + at + time. Frequency adverbs like always and usually go before ordinary verbs and after 'be'. With he / she / it use have → has and go → goes."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "at + 시각",
     "I get up at seven."
    ],
    [
     "빈도 부사 (일반동사 앞)",
     "I always drink coffee."
    ],
    [
     "he / she / it",
     "has, goes (불규칙)"
    ],
    [
     "be동사 뒤",
     "She is always at home."
    ]
   ]
  },
  "notes": [
   {
    "ko": "빈도 부사(always, usually)는 일반동사 앞에 옵니다.",
    "en": "Frequency adverbs (always, usually) go before an ordinary verb."
   },
   {
    "ko": "have → has, go → goes: He goes to work.",
    "en": "have → has, go → goes: He goes to work."
   },
   {
    "ko": "시각 앞에는 at을 씁니다: at seven o'clock.",
    "en": "Use 'at' before a clock time: at seven o'clock."
   }
  ],
  "examples": [
   {
    "t": "I get up at seven o'clock.",
    "ko": "저는 일곱 시에 일어나요."
   },
   {
    "t": "I have breakfast at eight o'clock.",
    "ko": "저는 여덟 시에 아침을 먹어요."
   },
   {
    "t": "He goes to work at nine o'clock.",
    "ko": "그는 아홉 시에 출근해요."
   },
   {
    "t": "We have dinner with our family.",
    "ko": "우리는 가족과 저녁을 먹어요."
   },
   {
    "t": "She usually goes to bed at eleven o'clock.",
    "ko": "그녀는 보통 열한 시에 자요."
   }
  ],
