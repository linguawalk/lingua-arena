 "grammar": {
  "title": {
   "ko": "옷 입기 (wear, 복수형 옷)",
   "en": "Wearing clothes (wear, plural clothes)"
  },
  "explain": {
   "ko": "옷은 'wear + 옷'으로 말합니다. he / she / it에는 wears를 씁니다. trousers, jeans, shoes, socks는 항상 복수형이어서 are를 씁니다. 색깔은 옷 앞에 둡니다: a red dress.",
   "en": "Say clothes with wear + clothes. With he / she / it use wears. Trousers, jeans, shoes and socks are always plural, so use are. Colours go before the clothes: a red dress."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "wear + 옷",
     "I wear a coat."
    ],
    [
     "he / she / it",
     "She wears a dress."
    ],
    [
     "복수 옷 (are)",
     "My shoes are black."
    ],
    [
     "색깔 + 옷",
     "a red dress"
    ]
   ]
  },
  "notes": [
   {
    "ko": "trousers, jeans, shoes는 복수라서 These ... are를 씁니다.",
    "en": "Trousers, jeans, shoes are plural, so use These ... are."
   },
   {
    "ko": "he / she에는 wears: She wears a hat.",
    "en": "With he / she use wears: She wears a hat."
   },
   {
    "ko": "a / an은 한 개일 때만 씁니다: a coat, a hat.",
    "en": "Use a / an only for one: a coat, a hat."
   }
  ],
