 "grammar": {
  "title": {
   "ko": "this / that / these / those와 How much",
   "en": "this / that / these / those and 'How much'"
  },
  "explain": {
   "ko": "가까운 것은 this(하나) / these(여럿), 먼 것은 that(하나) / those(여럿)로 가리킵니다. 가격은 How much is this? / How much are these?로 묻습니다.",
   "en": "Point to near things with this (one) / these (many) and to far things with that (one) / those (many). Ask a price with How much is this? / How much are these?"
  },
  "table": {
   "head": [
    "지시어 / Word",
    "의미 / Meaning",
    "예 / Example"
   ],
   "rows": [
    [
     "this",
     "가까운 것 하나",
     "This bag is cheap."
    ],
    [
     "that",
     "먼 것 하나",
     "That phone is expensive."
    ],
    [
     "these",
     "가까운 것 여럿",
     "These books are five dollars."
    ],
    [
     "those",
     "먼 것 여럿",
     "Those pens are cheap."
    ]
   ]
  },
  "notes": [
   {
    "ko": "하나는 this / that + is, 여럿은 these / those + are.",
    "en": "One thing: this / that + is. Many things: these / those + are."
   },
   {
    "ko": "가격 묻기: How much is this? / How much are these?",
    "en": "Ask the price: How much is this? / How much are these?"
   },
   {
    "ko": "가격 대답: It's five dollars.",
    "en": "Answer: It's five dollars."
   }
  ],
