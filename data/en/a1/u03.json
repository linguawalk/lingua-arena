 "grammar": {
  "title": {
   "ko": "소유격 my/your/his/her + have/has",
   "en": "Possessives (my, your, his, her…) and 'have / has'"
  },
  "explain": {
   "ko": "my, your, his, her, our, their는 명사 앞에서 '누구의'를 나타냅니다. '가지고 있다'는 have이고, he/she/it 뒤에서는 has가 됩니다.",
   "en": "My, your, his, her, our and their go before a noun to show who it belongs to. 'Have' means to own or to have family; with he/she/it it becomes 'has'."
  },
  "table": {
   "head": [
    "주어 / Subject",
    "소유격 / Possessive",
    "have"
   ],
   "rows": [
    [
     "I",
     "my",
     "have"
    ],
    [
     "you",
     "your",
     "have"
    ],
    [
     "he",
     "his",
     "has"
    ],
    [
     "she",
     "her",
     "has"
    ],
    [
     "we",
     "our",
     "have"
    ],
    [
     "they",
     "their",
     "have"
    ]
   ]
  },
  "notes": [
   {
    "ko": "소유격은 명사 앞에 둡니다: my mother, his sister.",
    "en": "A possessive goes before the noun: my mother, his sister."
   },
   {
    "ko": "he / she / it 뒤에는 has: She has a son.",
    "en": "After he / she / it use 'has': She has a son."
   },
   {
    "ko": "'s로도 소유를 나타냅니다: Tom's father.",
    "en": "'s also shows possession: Tom's father."
   }
  ],
  "examples": [
   {
    "t": "My mother is a teacher.",
    "ko": "제 어머니는 선생님이에요."
   },
   {
    "t": "Is your father a doctor?",
    "ko": "당신의 아버지는 의사예요?"
   },
   {
    "t": "His sister is a student.",
    "ko": "그의 누나는 학생이에요."
   },
   {
    "t": "Her son is five years old.",
    "ko": "그녀의 아들은 다섯 살이에요."
   },
   {
    "t": "Our grandmother has a dog.",
    "ko": "우리 할머니는 개가 있어요."
   }
  ],
