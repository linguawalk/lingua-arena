 "grammar": {
  "title": {
   "ko": "날짜 말하기 (서수와 on)",
   "en": "Saying dates (ordinals and on)"
  },
  "explain": {
   "ko": "월 이름은 항상 대문자로 씁니다: January, May. 월에는 in을, 날짜에는 on을 씁니다: in May, on May third. 날짜는 서수로 읽습니다: 1st = first, 2nd = second, 3rd = third, 4th = fourth.",
   "en": "Month names always start with a capital letter: January, May. Use in with months and on with dates: in May, on May third. Dates are read as ordinal numbers: 1st = first, 2nd = second, 3rd = third, 4th = fourth."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "in + 월",
     "in May"
    ],
    [
     "on + 날짜",
     "on May third"
    ],
    [
     "서수",
     "first, second, third, fourth"
    ],
    [
     "When is ~?",
     "When is your birthday?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "서수는 숫자 뒤에 -th를 붙이는 것이 많지만 first, second, third는 불규칙입니다.",
    "en": "Most ordinals end in -th, but first, second, third are irregular."
   },
   {
    "ko": "월 이름은 대문자로 시작합니다.",
    "en": "Month names start with a capital letter."
   },
   {
    "ko": "날짜 앞의 the는 말할 때 쓸 수 있어요: the third of May.",
    "en": "You can say the third of May."
   }
  ],
