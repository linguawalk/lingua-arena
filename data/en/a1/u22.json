 "grammar": {
  "title": {
   "ko": "언어에 관한 표현 (speak, understand, a little)",
   "en": "Talking about languages (speak, understand, a little)"
  },
  "explain": {
   "ko": "언어는 'speak + 언어'로 말합니다. 'a little'은 '조금', 'well'은 '잘'이라는 뜻이고 동사 뒤에 옵니다. 못 알아들으면 I don't understand라고 말합니다.",
   "en": "Say a language with speak + language. 'a little' and 'well' tell how much or how good, and they come after the verb phrase. If you can't follow, say I don't understand."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "speak + 언어",
     "I speak English."
    ],
    [
     "a little",
     "I speak a little Korean."
    ],
    [
     "well",
     "She speaks English well."
    ],
    [
     "don't understand",
     "I don't understand."
    ]
   ]
  },
  "notes": [
   {
    "ko": "언어 이름은 대문자로 씁니다: English, Korean.",
    "en": "Language names start with a capital letter: English, Korean."
   },
   {
    "ko": "he / she / it에는 speaks를 씁니다.",
    "en": "With he / she / it use speaks."
   },
   {
    "ko": "well은 목적어 뒤에 옵니다: She speaks English well.",
    "en": "'well' comes after the object: She speaks English well."
   }
  ],
  "examples": [
   {
    "t": "I speak English.",
    "ko": "저는 영어를 말해요."
   },
   {
    "t": "She speaks Korean well.",
    "ko": "그녀는 한국어를 잘 말해요."
   },
   {
