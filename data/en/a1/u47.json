 "grammar": {
  "title": {
   "ko": "여행 준비 (I need / bring)",
   "en": "Preparing for a trip (I need / bring)"
  },
  "explain": {
   "ko": "필요한 것은 I need + 명사로, 가져가는 것은 I bring / take + 명사로 말합니다. 권할 때는 Bring + 명사 명령문을 씁니다. 가는 곳은 go to + 장소입니다.",
   "en": "Say what you need with I need + noun and what you bring with I bring / take + noun. To advise use the imperative Bring + noun. A destination is go to + place."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "need + 명사",
     "I need a passport."
    ],
    [
     "bring / take + 명사",
     "I bring a camera."
    ],
    [
     "Bring + 명사",
     "Bring an umbrella."
    ],
    [
     "go to + 장소",
     "We go to the beach."
    ]
   ]
  },
  "notes": [
   {
    "ko": "sunglasses는 항상 복수입니다.",
    "en": "Sunglasses is always plural."
   },
   {
    "ko": "bring은 가져오다, take는 가져가다에 가까워요.",
    "en": "Bring is toward the speaker; take is away."
   },
   {
    "ko": "need 뒤에는 a / an을 써도 돼요: I need a passport.",
    "en": "After need you can use a / an: I need a passport."
   }
  ],
