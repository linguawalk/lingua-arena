 "grammar": {
  "title": {
   "ko": "날씨 말하기: It is + 형용사, in + 계절",
   "en": "Talking about the weather: It is + adjective, in + season"
  },
  "explain": {
   "ko": "날씨를 말할 때 주어는 항상 it입니다: It is sunny. 계절 앞에는 in을 쓰고, 날씨는 What's the weather like?로 묻습니다.",
   "en": "The subject for weather is always 'it': It is sunny. Use 'in' before a season, and ask with What's the weather like?"
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "It is + 날씨",
     "It is sunny."
    ],
    [
     "It is + 날씨 + today",
     "It is rainy today."
    ],
    [
     "in + 계절",
     "in summer"
    ],
    [
     "날씨 묻기",
     "What's the weather like?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "날씨의 주어는 it입니다: It is sunny.",
    "en": "The subject for weather is 'it': It is sunny."
   },
   {
    "ko": "계절 앞에는 in을 씁니다: in winter.",
    "en": "Use 'in' before a season: in winter."
   },
   {
    "ko": "What's the weather like?로 날씨를 묻습니다.",
    "en": "Ask with: What's the weather like?"
   }
  ],
  "examples": [
   {
