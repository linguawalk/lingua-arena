 "grammar": {
  "title": {
   "ko": "Can · Let's · Would you like to",
   "en": "Can · Let's · Would you like to"
  },
  "explain": {
   "ko": "Can은 가능이나 부탁, Let's는 '~하자'는 제안, Would you like ~?는 정중한 권유입니다. 거절할 때는 Sorry, I'm busy.처럼 이유를 덧붙입니다.",
   "en": "'Can' asks about ability or makes a request, 'Let's' makes a suggestion, and 'Would you like ~?' is a polite offer. To decline, add a reason: Sorry, I'm busy."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "쓰임 / Use",
    "예 / Example"
   ],
   "rows": [
    [
     "Can + 주어 + 동사?",
     "가능 · 부탁",
     "Can you come?"
    ],
    [
     "Let's + 동사",
     "제안",
     "Let's go to the park."
    ],
    [
     "Would you like ~?",
     "권유",
     "Would you like some tea?"
    ],
    [
     "대답",
     "수락 · 거절",
     "Yes, I'd love to. / Sorry, I'm busy."
    ]
   ]
  },
  "notes": [
   {
    "ko": "can 뒤에는 동사 원형: Can you come?",
    "en": "After 'can' use the base verb: Can you come?"
   },
   {
    "ko": "Let's는 Let us의 줄임말로 '우리 ~하자'입니다.",
    "en": "Let's = Let us; it means 'we should ~'."
   },
   {
    "ko": "거절할 때는 Sorry, I'm busy.처럼 말합니다.",
    "en": "To decline say something like: Sorry, I'm busy."
   }
  ],
