 "grammar": {
  "explain": {
   "ko": "be동사는 '~이다'를 뜻하는 가장 기본 동사로, 주어에 따라 am / is / are로 모양이 바뀝니다.",
   "en": "'Be' links a subject to its identity or description. It changes form with the subject: am / is / are."
  },
  "table": {
   "head": [
    "주어 / Subject",
    "be"
   ],
   "rows": [
    [
     "I",
     "am"
    ],
    [
     "you",
     "are"
    ],
    [
     "he / she / it",
     "is"
    ],
    [
     "we",
     "are"
    ],
    [
     "they",
     "are"
    ]
   ]
  },
  "notes": [
   {
    "ko": "축약형: I am → I'm, you are → you're, she is → she's.",
    "en": "Contractions: I am → I'm, you are → you're, she is → she's."
   },
   {
    "ko": "의문문은 be동사를 주어 앞으로: Are you a student?",
    "en": "For questions, put 'be' before the subject: Are you a student?"
   },
   {
    "ko": "부정문은 be동사 뒤에 not: I am not a doctor.",
    "en": "For negatives, add 'not' after 'be': I am not a doctor."
   }
  ],
  "examples": [
   {
    "t": "I am a student.",
    "ko": "저는 학생이에요."
   },
   {
    "t": "You are my friend.",
    "ko": "당신은 제 친구예요."
   },
   {
    "t": "She is a teacher.",
    "ko": "그녀는 선생님이에요."
   },
   {
    "t": "We are friends.",
    "ko": "우리는 친구예요."
   },
   {
    "t": "They are doctors.",
    "ko": "그들은 의사예요."
   }
  ],
