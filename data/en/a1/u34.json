 "grammar": {
  "title": {
   "ko": "길 안내 (Turn left / Go straight)",
   "en": "Giving directions (Turn left / Go straight)"
  },
  "explain": {
   "ko": "길 안내는 명령문으로 말합니다: Go straight. Turn left. Cross the road. 위치는 It's on the left / on the right로 말합니다. 장소 앞에는 at을 씁니다: Turn left at the traffic lights.",
   "en": "Directions use imperatives: Go straight. Turn left. Cross the road. Say position with It's on the left / on the right. Use at before the place: Turn left at the traffic lights."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "Go straight",
     "Go straight."
    ],
    [
     "Turn left / right",
     "Turn left at the corner."
    ],
    [
     "on the left / right",
     "It's on the left."
    ],
    [
     "Cross the road",
     "Cross the road."
    ]
   ]
  },
  "notes": [
   {
    "ko": "길 안내에는 주어를 쓰지 않아요. 동사부터 말해요.",
    "en": "In directions the verb comes first with no subject."
   },
   {
    "ko": "on foot은 '걸어서'라는 뜻입니다.",
    "en": "On foot means by walking."
   },
   {
    "ko": "Then으로 다음 단계를 이어 줍니다.",
    "en": "Use Then to link steps."
   }
  ],
