 "grammar": {
  "title": {
   "ko": "관사 a / an / the",
   "en": "Articles: a / an / the"
  },
  "explain": {
   "ko": "a / an은 '하나의 (처음 말하는) 사물' 앞에, the는 서로 알고 있는 특정한 사물 앞에 씁니다. an은 모음 소리 앞에 붙습니다.",
   "en": "Use 'a / an' for one thing mentioned for the first time, and 'the' for a specific thing both people know. 'An' goes before a vowel sound."
  },
  "table": {
   "head": [
    "관사 / Article",
    "쓰임 / Use",
    "예 / Example"
   ],
   "rows": [
    [
     "a",
     "자음 소리 앞 · 처음 말할 때",
     "a book, a pen"
    ],
    [
     "an",
     "모음 소리 앞",
     "an apple, an umbrella"
    ],
    [
     "the",
     "특정한 것",
     "the key, the bag"
    ],
    [
     "(없음)",
     "셀 수 없는 명사 · 복수",
     "water, books"
    ]
   ]
  },
  "notes": [
   {
    "ko": "복수형에는 a / an을 쓰지 않습니다: two books.",
    "en": "Do not use a / an with plurals: two books."
   },
   {
    "ko": "처음에는 a, 다시 말할 때는 the: I have a bag. The bag is new.",
    "en": "First mention: a. Second mention: the. I have a bag. The bag is new."
   },
   {
    "ko": "물처럼 셀 수 없는 명사에는 a / an을 쓰지 않습니다.",
    "en": "Do not use a / an with uncountable nouns such as water."
   }
  ],
  "examples": [
