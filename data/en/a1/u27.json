 "grammar": {
  "title": {
   "ko": "장소 전치사 (in, on, under, next to)",
   "en": "Prepositions of place (in, on, under, next to)"
  },
  "explain": {
   "ko": "in은 안, on은 위(표면에 닿아 있을 때), under는 아래, next to는 옆, behind는 뒤, in front of는 앞, between은 사이를 뜻합니다. 위치를 물을 때는 Where is ...? 로 묻고, It's + 전치사 + 장소로 답합니다.",
   "en": "In means inside, on means on a surface, under means below, next to means beside, behind is at the back, in front of is at the front and between is in the middle of two. Ask Where is ...? and answer It's + preposition + place."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "in (안)",
     "The key is in the bag."
    ],
    [
     "on (위)",
     "The book is on the table."
    ],
    [
     "under / next to",
     "The cat is under the chair."
    ],
    [
     "behind / in front of / between",
     "The park is behind the school."
    ]
   ]
  },
  "notes": [
   {
    "ko": "in은 안, on은 위에 닿아 있을 때 써요.",
    "en": "In is inside; on is touching a surface."
   },
   {
    "ko": "next to는 바로 옆, between은 둘 사이입니다.",
    "en": "Next to is beside; between is in the middle of two."
   },
   {
    "ko": "물건 하나는 is, 여러 개는 are: The books are on the desk.",
    "en": "One thing: is; several: are: The books are on the desk."
   }
  ],
  "examples": [
