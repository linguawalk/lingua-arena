 "grammar": {
  "title": {
   "ko": "don't / doesn't · Do / Does · be 동사의 not",
   "en": "don't / doesn't, Do / Does, and 'not' with be"
  },
  "explain": {
   "ko": "일반동사의 부정은 don't / doesn't + 동사 원형, 의문은 Do / Does + 주어 + 동사 원형입니다. be동사는 do 없이 not을 붙이거나 주어 앞으로 보냅니다.",
   "en": "For ordinary verbs, negatives use don't / doesn't + base verb and questions use Do / Does + subject + base verb. 'Be' needs no 'do': add 'not' or put it before the subject."
  },
  "table": {
   "head": [
    "문장 / Sentence",
    "I / you / we / they",
    "he / she / it"
   ],
   "rows": [
    [
     "부정",
     "I don't work.",
     "She doesn't work."
    ],
    [
     "의문",
     "Do you work?",
     "Does she work?"
    ],
    [
     "be 부정",
     "I am not / you aren't",
     "he isn't"
    ],
    [
     "대답",
     "Yes, I do. / No, I don't.",
     "Yes, she does. / No, she doesn't."
    ]
   ]
  },
  "notes": [
   {
    "ko": "doesn't / Does 뒤에는 동사 원형: She doesn't work.",
    "en": "After doesn't / Does use the base verb: She doesn't work."
   },
   {
    "ko": "be동사는 do 없이: Are you a student? / I am not.",
    "en": "'Be' does not need 'do': Are you a student? / I am not."
   },
   {
    "ko": "의문사는 문장 맨 앞에: Where do you live?",
    "en": "Question words come first: Where do you live?"
   }
  ],
  "examples": [
   {
    "t": "I don't drink coffee.",
    "ko": "저는 커피를 마시지 않아요."
   },
   {
    "t": "He doesn't live in Seoul.",
    "ko": "그는 서울에 살지 않아요."
   },
   {
    "t": "Do you study English?",
    "ko": "당신은 영어를 공부해요?"
   },
   {
    "t": "Does she work at a school?",
    "ko": "그녀는 학교에서 일해요?"
   },
   {
    "t": "I am not a doctor.",
    "ko": "저는 의사가 아니에요."
   }
  ],
