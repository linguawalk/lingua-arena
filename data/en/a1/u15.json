    ],
    [
     "by + 교통수단",
     "by bus, by train"
    ],
    [
     "take + 교통수단",
     "I take a taxi."
    ],
    [
     "걸어서",
     "on foot"
    ]
   ]
  },
  "notes": [
   {
    "ko": "by 뒤에는 a / the를 쓰지 않습니다: by bus.",
