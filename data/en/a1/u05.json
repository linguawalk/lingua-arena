 "grammar": {
  "title": {
   "ko": "일반동사 현재형 (-s / -es)",
   "en": "Present simple (-s / -es)"
  },
  "explain": {
   "ko": "습관이나 사실은 현재형으로 말합니다. I / you / we / they에는 동사 원형을, he / she / it에는 동사 + -s(-es)를 씁니다.",
   "en": "Use the present simple for habits and facts. With I / you / we / they use the base verb; with he / she / it add -s (or -es)."
  },
  "table": {
   "head": [
    "주어 / Subject",
    "동사 / Verb",
    "예 / Example"
   ],
   "rows": [
    [
     "I / you / we / they",
     "work",
     "I work."
    ],
    [
     "he / she / it",
     "works",
     "She works."
    ],
    [
     "-ch, -sh, -s, -x 끝",
     "+ es",
     "watches, teaches"
    ],
    [
     "자음 + y",
     "y → ies",
     "study → studies"
    ]
   ]
  },
  "notes": [
   {
    "ko": "습관과 사실은 현재형: I eat rice every day.",
    "en": "Habits and facts use the present: I eat rice every day."
   },
   {
    "ko": "he / she / it 뒤에는 -s: He lives in Seoul.",
    "en": "After he / she / it add -s: He lives in Seoul."
   },
   {
    "ko": "every day, often, always 같은 빈도 표현과 자주 함께 씁니다.",
    "en": "It often goes with every day, often, always."
   }
  ],
  "examples": [
   {
    "t": "I study English.",
    "ko": "저는 영어를 공부해요."
   },
