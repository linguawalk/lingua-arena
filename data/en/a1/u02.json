 "grammar": {
  "title": {
   "ko": "숫자 1–20과 나이 말하기 (be + 숫자)",
   "en": "Numbers and saying your age (be + number)"
  },
  "explain": {
   "ko": "영어는 나이를 'be동사 + 숫자'로 말합니다 (I am ten). 'years old'는 생략할 수 있습니다. 나이를 물을 때는 How old + be + 주어?",
   "en": "English gives age with 'be' + a number (I am ten). 'Years old' is optional. Ask with: How old + be + subject?"
  },
  "table": {
   "head": [
    "숫자 / Number",
    "영어 / English"
   ],
   "rows": [
    [
     "1 – 5",
     "one, two, three, four, five"
    ],
    [
     "6 – 10",
     "six, seven, eight, nine, ten"
    ],
    [
     "20",
     "twenty"
    ],
    [
     "나이 / Age",
     "I am ten (years old)."
    ]
   ]
  },
  "notes": [
   {
    "ko": "질문: How old are you? — 대답: I'm twenty.",
    "en": "Ask: How old are you? — Answer: I'm twenty."
   },
   {
    "ko": "가족 수는 have로 말합니다: I have two sisters.",
    "en": "Use 'have' for family: I have two sisters."
   },
   {
    "ko": "숫자는 명사 앞에 오고 복수형 -s가 붙습니다: five books.",
    "en": "Numbers come before the noun, which takes plural -s: five books."
   }
  ],
