 "grammar": {
  "title": {
   "ko": "형용사의 위치와 색깔",
   "en": "Adjectives: position and colors"
  },
  "explain": {
   "ko": "형용사는 명사를 꾸미거나 be동사 뒤에서 상태를 말합니다. 명사 앞에 오면 a red bag, be 뒤에 오면 The bag is red.입니다.",
   "en": "Adjectives describe nouns. Before a noun: a red bag. After 'be': The bag is red."
  },
  "table": {
   "head": [
    "위치 / Position",
    "예 / Example"
   ],
   "rows": [
    [
     "명사 앞",
     "a red bag"
    ],
    [
     "be 뒤",
     "The bag is red."
    ],
    [
     "복수",
     "red bags (형용사는 -s가 없음)"
    ],
    [
     "a / an",
     "a big bag, an old bag"
    ]
   ]
  },
  "notes": [
   {
    "ko": "형용사는 명사 앞이나 be동사 뒤에 옵니다.",
    "en": "An adjective goes before a noun or after 'be'."
   },
   {
    "ko": "형용사는 복수형이 없습니다: two red bags.",
    "en": "Adjectives never take plural -s: two red bags."
   },
   {
    "ko": "모음 소리 앞에서는 an을 씁니다: an old bag.",
    "en": "Use 'an' before a vowel sound: an old bag."
   }
  ],
  "examples": [
   {
    "t": "My bag is new.",
    "ko": "제 가방은 새것이에요."
   },
   {
    "t": "The chair is small and old.",
    "ko": "그 의자는 작고 낡았어요."
   },
   {
    "t": "I have a red umbrella.",
    "ko": "저는 빨간 우산이 있어요."
   },
   {
    "t": "The sky is blue.",
    "ko": "하늘은 파래요."
   },
   {
    "t": "The soup is good.",
    "ko": "그 수프는 맛있어요."
   }
  ],
