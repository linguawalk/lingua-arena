 "grammar": {
  "title": {
   "ko": "직업 앞의 a / an, work in / at / for",
   "en": "a / an before jobs; work in / at / for"
  },
  "explain": {
   "ko": "직업 앞에는 a / an을 씁니다: I am a nurse. 일하는 곳은 장소면 in / at, 회사면 for를 씁니다.",
   "en": "Use a / an before a job: I am a nurse. For where you work use 'in / at' for a place and 'for' for a company."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "직업 + a / an",
     "I am a nurse. / I am an engineer."
    ],
    [
     "work in + 장소",
     "I work in an office."
    ],
    [
     "work for + 회사",
     "He works for a company."
    ],
    [
     "work at + 장소",
     "She works at a hospital."
    ]
   ]
  },
  "notes": [
   {
    "ko": "직업 앞에는 a / an을 씁니다: an engineer.",
    "en": "Use a / an before a job: an engineer."
   },
   {
    "ko": "회사는 work for, 장소는 work in / at.",
    "en": "For a company use 'work for'; for a place use 'work in / at'."
   },
   {
    "ko": "직업은 What do you do? / What is your job?로 묻습니다.",
    "en": "Ask with: What do you do? / What is your job?"
   }
  ],
  "examples": [
   {
