 "grammar": {
  "title": {
   "ko": "소유격 's와 whose",
   "en": "Possessive 's and whose"
  },
  "explain": {
   "ko": "사람이나 이름 뒤에 's를 붙이면 '~의'라는 뜻이 됩니다: Tom's bag. 물건의 주인을 물을 때는 Whose + 명사로 묻습니다. mine, yours, his, hers, ours는 뒤에 명사 없이 쓰는 '~의 것'이에요.",
   "en": "Add 's after a name or noun to mean 'of': Tom's bag. Ask who owns something with Whose + noun. Mine, yours, his, hers and ours stand alone, with no noun after them."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "name + 's",
     "Tom's bag"
    ],
    [
     "Whose + 명사",
     "Whose bag is this?"
    ],
    [
     "mine / yours",
     "It's mine. Is it yours?"
    ],
    [
     "his / hers / ours",
     "The book is hers."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'s는 소유를 나타내고, 's는 is의 줄임말이기도 해요.",
    "en": "'s shows possession; 's can also be short for is."
   },
   {
    "ko": "mine, yours 뒤에는 명사를 쓰지 않습니다: It's mine (not mine bag).",
    "en": "Don't put a noun after mine / yours: It's mine."
   },
   {
    "ko": "Whose 뒤에 바로 명사를 씁니다: Whose pen is this?",
    "en": "Put the noun right after Whose: Whose pen is this?"
   }
  ],
  "examples": [
