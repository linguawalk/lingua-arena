 "grammar": {
  "title": {
   "ko": "Can I ...? / Can you ...?",
   "en": "Can I ...? / Can you ...?"
  },
  "explain": {
   "ko": "Can I ...?는 '~해도 될까요?'라는 허락을, Can you ...?는 '~해 주실래요?'라는 부탁을 나타냅니다. 허락할 때는 Yes, of course. / Sure., 거절할 때는 Sorry, you can't. / Sorry, I can't.라고 합니다. please를 붙이면 더 공손해집니다.",
   "en": "Can I ...? asks for permission and Can you ...? asks someone to do something. Say Yes, of course. or Sure. to agree and Sorry, you can't. or Sorry, I can't. to refuse. Add please to be more polite."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "Can I + 동사?",
     "Can I sit here?"
    ],
    [
     "Can you + 동사?",
     "Can you help me?"
    ],
    [
     "허락",
     "Yes, of course. / Sure."
    ],
    [
     "거절",
     "Sorry, you can't."
    ]
   ]
  },
  "notes": [
   {
    "ko": "Can I는 내가 하는 행동, Can you는 상대가 하는 행동입니다.",
    "en": "Can I is about my action; Can you is about the other person's action."
   },
   {
    "ko": "Could로 바꾸면 더 정중해집니다.",
    "en": "Using Could makes it more polite."
   },
   {
    "ko": "부탁에는 please를 붙이면 좋아요.",
    "en": "Add please to a request."
   }
  ],
  "examples": [
   {
    "t": "Can I sit here?",
    "ko": "여기에 앉아도 돼요?"
   },
