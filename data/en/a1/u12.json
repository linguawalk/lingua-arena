 "grammar": {
  "title": {
   "ko": "like / love + 명사 · -ing",
   "en": "like / love + noun or -ing"
  },
  "explain": {
   "ko": "좋아하는 것은 like / love 뒤에 명사나 동사-ing를 붙여 말합니다. he / she / it에는 likes / loves를 씁니다.",
   "en": "Say what you like with like / love + a noun or a verb + -ing. With he / she / it use likes / loves."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "like + 명사",
     "I like music."
    ],
    [
     "like + -ing",
     "I like swimming."
    ],
    [
     "he / she + likes",
     "She likes movies."
    ],
    [
     "부정 · 의문",
     "I don't like ~. / Do you like ~?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "like 뒤에는 명사나 동사-ing: I like swimming.",
    "en": "After 'like' use a noun or verb + -ing: I like swimming."
   },
   {
    "ko": "he / she / it에는 likes: She likes music.",
    "en": "With he / she / it use 'likes': She likes music."
   },
   {
    "ko": "love는 like보다 더 강한 표현입니다.",
    "en": "'Love' is stronger than 'like'."
   }
  ],
  "examples": [
