 "grammar": {
  "title": {
   "ko": "Você poderia ~? · Posso ~? · Você se importaria de ~?",
   "en": "Você poderia ~? · Posso ~? · Você se importaria de ~?"
  },
  "explain": {
   "ko": "공손한 부탁은 'Você poderia + 동사원형, por favor?', 허락은 'Posso + 동사원형?', 정중한 요청은 'Você se importaria de + 동사원형?'로 합니다. 수락: Claro. / Com prazer. 거절: Infelizmente não posso. / Desculpe, agora não dá.",
   "en": "Polite requests: 'Você poderia + infinitive, por favor?'; permission: 'Posso + infinitive?'; very polite: 'Você se importaria de + infinitive?' Accept: Claro. / Com prazer. Decline: Infelizmente não posso. / Desculpe, agora não dá."
  },
  "table": {
   "head": [
    "기능 / Função",
    "표현 / Expressão",
    "예 / Exemplo"
   ],
