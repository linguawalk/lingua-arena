 "grammar": {
  "title": {
   "ko": "demais / suficiente / tão ~ quanto",
   "en": "demais, suficiente and tão ~ quanto"
  },
  "explain": {
   "ko": "'형용사 + demais'는 지나침, '형용사 + o suficiente / 명사 + suficiente'는 충분함입니다: quente demais, grande o suficiente, dinheiro suficiente. 'para + 동사원형'을 이어 쓸 수 있습니다: jovem demais para dirigir. 비교 같음: 'tão ~ quanto'.",
   "en": "'adjective + demais' means too ...; 'adjective + o suficiente / noun + suficiente' means enough: quente demais, grande o suficiente, dinheiro suficiente. Add 'para + infinitive': jovem demais para dirigir. Equality: 'tão ~ quanto'."
  },
  "table": {
   "head": [
    "표현 / Expressão",
    "의미 / Significado",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "~ demais",
     "너무 ~하다",
     "Está quente demais."
    ],
    [
     "~ o suficiente",
     "충분히 ~하다",
     "É grande o suficiente."
    ],
    [
     "~ suficiente (명사)",
     "충분한 ~",
     "Não tenho dinheiro suficiente."
    ],
    [
     "tão ~ quanto",
     "~만큼 ~하다",
     "É tão caro quanto aquele."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'demais'는 형용사 뒤에 위치합니다.",
    "en": "'demais' follows the adjective."
   },
   {
    "ko": "명사 앞에서는 'muito'가 아닌 'demais'를 쓰지 않습니다: dinheiro demais(○).",
    "en": "With a noun: dinheiro demais is fine too."
   },
   {
    "ko": "부정 비교: não é tão bom quanto aquele.",
    "en": "Negative comparison: não é tão bom quanto aquele."
   }
  ],
