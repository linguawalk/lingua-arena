 "grammar": {
  "title": {
   "ko": "não funciona · quero um reembolso · posso trocar?",
   "en": "não funciona · quero um reembolso · posso trocar?"
  },
  "explain": {
   "ko": "문제는 'Não funciona.', 'Está quebrado.', 'Veio o tamanho errado.'로 말합니다. 요구는 'Eu gostaria de um reembolso.', 'Posso trocar isto?'입니다. 점원은 'Sinto muito. Você tem o recibo?'라고 답합니다. 반품: 'Quero devolver isto.'",
   "en": "State the problem: 'Não funciona.', 'Está quebrado.', 'Veio o tamanho errado.' Ask: 'Eu gostaria de um reembolso.', 'Posso trocar isto?' The clerk: 'Sinto muito. Você tem o recibo?' Returning: 'Quero devolver isto.'"
  },
  "table": {
   "head": [
    "상황 / Situação",
    "표현 / Expressão",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "문제",
     "Não funciona / Está quebrado",
     "O computador não funciona."
    ],
    [
     "요구",
     "Eu gostaria de ~",
     "Eu gostaria de um reembolso."
    ],
    [
     "교환",
     "Posso trocar ~?",
     "Posso trocar isto?"
    ],
    [
     "영수증",
     "Tenho o recibo",
     "Aqui está o recibo."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'veio errado'는 '(배송·구매품이) 잘못 왔다'는 뜻입니다.",
    "en": "'veio errado' means the item arrived wrong."
   },
   {
    "ko": "사과를 받으면: Tudo bem, obrigado.",
    "en": "Accepting an apology: Tudo bem, obrigado."
