 "grammar": {
  "title": {
   "ko": "ser / estar no pretérito perfeito: fui, esteve…",
   "en": "Preterite of 'ser' and 'estar': fui, esteve…"
  },
  "explain": {
   "ko": "끝난 과거 시점에 어디에 있었는지, 어땠는지는 estar와 ser의 단순 과거(pretérito perfeito)로 말합니다. estar: estive, esteve, estivemos, estiveram. ser: fui, foi, fomos, foram. 'há + 시간'은 '~ 전에'입니다: há três dias.",
   "en": "To say where someone was or how something was at a finished past moment, use the preterite of estar and ser. Estar: estive, esteve, estivemos, estiveram. Ser: fui, foi, fomos, foram. 'Há + time' means 'ago': há três dias."
  },
  "table": {
   "head": [
    "주어 / Sujeito",
    "긍정 / Afirmativo",
    "부정 / Negativo",
    "의문 / Pergunta"
   ],
   "rows": [
    [
     "eu",
     "estive",
     "não estive",
     "Estive ~?"
    ],
    [
     "você / ele / ela",
     "esteve",
     "não esteve",
     "Esteve ~?"
    ],
    [
     "nós",
     "estivemos",
     "não estivemos",
     "Estivemos ~?"
    ],
    [
     "vocês / eles",
     "estiveram",
     "não estiveram",
     "Estiveram ~?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "과거 시간 표현: ontem, ontem à noite, no fim de semana passado, há duas horas.",
    "en": "Past time words: ontem, ontem à noite, no fim de semana passado, há duas horas."
   },
   {
    "ko": "'há' + 시간 = '~ 전에': há três dias.",
    "en": "'Há' + time = 'ago': há três dias."
   },
   {
    "ko": "짧은 대답: Sim, estive. / Não, não estivemos.",
    "en": "Short answers: Sim, estive. / Não, não estivemos."
   }
  ],
