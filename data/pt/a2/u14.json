 "grammar": {
  "title": {
   "ko": "빈도 부사와 방법 부사 (sempre, nunca · bem, rapidamente)",
   "en": "Frequency and manner adverbs (sempre, nunca · bem, rapidamente)"
  },
  "explain": {
   "ko": "빈도 부사는 보통 동사 앞에 둡니다: Eu sempre tomo café da manhã. Ele nunca bebe café. 방법 부사는 동사 뒤에 둡니다: Ela fala inglês bem. Fale devagar. 형용사에 -mente를 붙여 만들기도 합니다: rápido → rapidamente. 질문은 'Com que frequência você ~?'",
   "en": "Frequency adverbs usually go before the verb: Eu sempre tomo café da manhã. Ele nunca bebe café. Manner adverbs follow the verb: Ela fala inglês bem. Fale devagar. Many add -mente to the adjective: rápido → rapidamente. Ask: 'Com que frequência você ~?'"
  },
  "table": {
   "head": [
    "종류 / Tipo",
    "부사 / Advérbio",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "빈도",
     "sempre, geralmente, às vezes, nunca",
     "Eu sempre tomo café da manhã."
    ],
    [
     "방법",
     "bem, mal, devagar",
     "Ela fala inglês bem."
    ],
    [
     "-mente",
     "rapidamente, cuidadosamente",
     "Ela fala rapidamente."
    ],
    [
     "질문",
     "Com que frequência ~?",
     "Com que frequência você faz exercício?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "'nunca'가 동사 앞이면 não를 쓰지 않습니다: Ele nunca bebe café.",
    "en": "With 'nunca' before the verb, no 'não': Ele nunca bebe café."
   },
   {
    "ko": "'bem'과 'mal'은 동사 바로 뒤에 둡니다.",
    "en": "'bem' and 'mal' go right after the verb."
   },
   {
    "ko": "'devagar'는 형용사에서 만든 부사가 아닙니다.",
    "en": "'devagar' is not formed with -mente."
   }
  ],
