 "grammar": {
  "title": {
   "ko": "과거 의문문과 부정문 (Você foi ~? · não + 동사)",
   "en": "Past questions and negatives (Você foi ~? · não + verb)"
  },
  "explain": {
   "ko": "과거 질문은 어순을 바꾸지 않고 억양만 올리거나 의문사를 앞에 둡니다: Você foi à festa? Quando você chegou? 부정은 não + 동사입니다: Eu não trabalhei. 짧은 대답은 동사를 반복합니다: Sim, fui. / Não, não fui.",
   "en": "Past questions keep word order with a rising tone or a question word first: Você foi à festa? Quando você chegou? Negative: não + verb: Eu não trabalhei. Short answers repeat the verb: Sim, fui. / Não, não fui."
  },
  "table": {
   "head": [
    "종류 / Tipo",
    "형태 / Forma",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "예/아니오 질문",
     "평서문 + ?",
     "Você foi à festa?"
    ],
    [
     "의문사 질문",
     "의문사 + 과거",
     "Quando você chegou?"
    ],
    [
     "부정",
     "não + 과거",
     "Eu não trabalhei ontem."
    ],
    [
     "짧은 대답",
     "동사 반복",
     "Sim, fui. / Não, não fui."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'por que'는 질문, 'porque'는 이유를 말하는 답입니다.",
    "en": "'por que' asks; 'porque' answers."
   },
   {
    "ko": "quanto tempo? = 얼마나 오래?",
    "en": "'quanto tempo?' = how long?"
   },
   {
    "ko": "불규칙 동사 chegar는 규칙: cheguei, chegou.",
    "en": "chegar is regular: cheguei, chegou."
   }
  ],
