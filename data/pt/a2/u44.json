 "grammar": {
  "title": {
   "ko": "정도 부사와 방법 부사 (muito, bastante, demais, rápido, bem)",
   "en": "adverbs of degree and manner (muito, bastante, demais, rápido, bem)"
  },
  "explain": {
   "ko": "정도 부사는 형용사 앞에: muito interessante, bastante difícil, realmente cansado. 방법 부사는 동사 뒤: corre rápido, fala bem, dirija com cuidado. 'demais'는 형용사 뒤에서 지나침을 나타냅니다. 'Como foi a prova?', 'Com que rapidez ele corre?'",
   "en": "Degree adverbs precede the adjective: muito interessante, bastante difícil, realmente cansado. Manner adverbs follow the verb: corre rápido, fala bem, dirija com cuidado. 'demais' follows an adjective to mean too. Ask: Como foi a prova? Com que rapidez ele corre?"
  },
  "table": {
   "head": [
    "종류 / Tipo",
    "부사 / Advérbio",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "정도 + 형용사",
     "muito · bastante · realmente",
     "O filme foi muito interessante."
    ],
    [
     "지나침",
     "~ demais",
     "O café está quente demais."
    ],
    [
     "방법 (동사 뒤)",
     "rápido · devagar · bem",
     "Ele corre rápido."
    ],
    [
     "-mente",
     "cuidadosamente, calmamente",
     "Ele dirige cuidadosamente."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'rápido', 'devagar'는 동사 뒤에서 형용사 형태 그대로 부사로 쓰입니다.",
    "en": "'rápido' and 'devagar' work as adverbs after the verb."
   },
   {
    "ko": "'bem'은 부사, 'bom'은 형용사입니다.",
    "en": "'bem' is the adverb; 'bom' the adjective."
   },
   {
    "ko": "'mal'은 'bem'의 반대 부사입니다.",
    "en": "'mal' is the opposite adverb of 'bem'."
   }
  ],
