 "grammar": {
  "title": {
   "ko": "fazer / estar + 날씨 · vai + 동사 · ir 예보",
   "en": "fazer / estar + weather · vai + verb · forecasts"
  },
  "explain": {
   "ko": "날씨는 'Faz sol / Faz frio / Está nublado / Está chovendo / Está ventando'로 말합니다. 예보는 'vai + 동사원형' 또는 미래형: Amanhã vai chover. Amanhã vai estar ensolarado. 계절: primavera, verão, outono, inverno. 질문: Como vai estar o tempo amanhã?",
   "en": "Weather: 'Faz sol / Faz frio / Está nublado / Está chovendo / Está ventando'. Forecast: 'vai + infinitive' or the future: Amanhã vai chover. Amanhã vai estar ensolarado. Seasons: primavera, verão, outono, inverno. Ask: Como vai estar o tempo amanhã?"
  },
  "table": {
   "head": [
    "표현 / Expressão",
    "의미 / Significado",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "Faz sol / frio",
     "해 / 추위",
     "Faz frio no inverno."
    ],
    [
     "Está nublado / chovendo",
     "흐림 / 비",
     "Está chovendo agora."
    ],
    [
     "vai + 동사",
     "예보",
     "Amanhã vai chover."
    ],
    [
     "A temperatura é de ~ graus",
     "기온",
     "A temperatura é de 20 graus."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'fazer'는 날씨에서 비인칭으로 쓰입니다.",
    "en": "'fazer' is impersonal in weather phrases."
   },
   {
    "ko": "예보: A previsão diz que vai chover.",
    "en": "Forecast: A previsão diz que vai chover."
   },
   {
    "ko": "계절 앞에는 'no / na': no inverno, na primavera.",
    "en": "Seasons take 'no / na': no inverno, na primavera."
   }
  ],
