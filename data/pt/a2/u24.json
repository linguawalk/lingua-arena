 "grammar": {
  "title": {
   "ko": "já / ainda não / acabar de + 동사",
   "en": "já, ainda não and acabar de + verb"
  },
  "explain": {
   "ko": "이미 끝난 일은 'já + 단순 과거', 아직 안 한 일은 'ainda não + 단순 과거', 방금 한 일은 'acabar de + 동사원형'(현재형·단순 과거)입니다: Ele acabou de chegar. 질문: Você já comprou os ingressos? 대답: Já comprei. / Ainda não.",
   "en": "Done: 'já + preterite'; not yet: 'ainda não + preterite'; just now: 'acabar de + infinitive': Ele acabou de chegar. Ask: Você já comprou os ingressos? Answer: Já comprei. / Ainda não."
  },
  "table": {
   "head": [
    "표현 / Expressão",
    "의미 / Significado",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "já + 과거",
     "이미 ~했다",
     "Eu já fiz o dever."
    ],
    [
     "ainda não + 과거",
     "아직 ~않았다",
     "Eu ainda não almocei."
    ],
    [
     "acabar de + 동사",
     "방금 ~했다",
     "Ele acabou de chegar."
    ],
    [
     "Você já ~?",
     "벌써 ~했어요?",
     "Você já comprou os ingressos?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "'ainda não'만으로도 대답이 됩니다: Ainda não.",
    "en": "'Ainda não.' works as a full answer."
   },
   {
    "ko": "'acabar de'는 현재형으로 '방금', 단순 과거로 '방금 전'을 뜻합니다.",
    "en": "'acabar de' in the present: just now; in the past: had just."
   },
   {
    "ko": "'ainda'는 '아직 그대로'일 때 긍정문에도 쓰입니다.",
    "en": "'ainda' also means 'still' in positive sentences."
   }
  ],
