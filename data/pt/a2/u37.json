 "grammar": {
  "title": {
   "ko": "Você gostaria de ~? · Eu adoraria · desculpas educadas",
   "en": "Você gostaria de ~? · Eu adoraria · polite excuses"
  },
  "explain": {
   "ko": "초대는 'Você gostaria de + 동사원형?', 수락은 'Eu adoraria + 동사원형'(기꺼이 가겠다), 거절은 'Sinto muito, estou ocupado / não posso.'입니다. 대안 제안은 'Que tal + 시간·동사?' ('Que tal domingo?'). 감사: 'Obrigado pelo convite.'",
   "en": "Invite: 'Você gostaria de + infinitive?'; accept: 'Eu adoraria + infinitive'; decline: 'Sinto muito, estou ocupado / não posso.' Alternative: 'Que tal + time / verb?' ('Que tal domingo?'). Thanks: 'Obrigado pelo convite.'"
  },
  "table": {
   "head": [
    "기능 / Função",
    "표현 / Expressão",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "초대",
     "Você gostaria de ~?",
     "Você gostaria de jantar comigo?"
    ],
    [
     "수락",
     "Eu adoraria ~",
     "Eu adoraria ir."
    ],
    [
     "거절",
     "Sinto muito, ~",
     "Sinto muito, estou ocupado."
    ],
    [
     "대안",
     "Que tal ~?",
     "Que tal domingo?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "'adoraria'는 조건법이라 공손합니다.",
    "en": "'adoraria' is a polite conditional."
   },
   {
    "ko": "거절할 때는 먼저 'Sinto muito'로 시작합니다.",
    "en": "Begin a refusal with 'Sinto muito'."
   },
   {
    "ko": "'Que tal'은 '~는 어때요?'입니다.",
    "en": "'Que tal' means 'how about'."
   }
  ],
