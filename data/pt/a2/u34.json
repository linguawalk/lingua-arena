 "grammar": {
  "title": {
   "ko": "trabalhar em / para · há + 기간 · que (직업 설명)",
   "en": "trabalhar em / para, há + period, que (job description)"
  },
  "explain": {
   "ko": "직업 소개는 'Eu trabalho numa grande empresa.', 기간은 'há + 기간 + 현재형'(Trabalho aqui há cinco anos)입니다. 직업 설명은 관계사 que: Ela é enfermeira que cuida de pacientes. 면접: 'Tenho uma entrevista amanhã.' 지원: 'Candidatei-me ao emprego.'",
   "en": "Say your job: 'Eu trabalho numa grande empresa.' Duration: 'há + period + present' (Trabalho aqui há cinco anos). Describe a job with 'que': Ela é enfermeira que cuida de pacientes. Interview: 'Tenho uma entrevista amanhã.' Applying: 'Candidatei-me ao emprego.'"
  },
  "table": {
   "head": [
    "표현 / Expressão",
    "의미 / Significado",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "Eu trabalho em / para ~",
     "~에서 일하다",
     "Trabalho numa grande empresa."
    ],
    [
     "há + 기간",
     "~째",
     "Trabalho aqui há cinco anos."
    ],
    [
     "Tenho ~",
     "~이 있다",
     "Tenho uma reunião hoje."
    ],
    [
     "que + 동사",
     "~하는 (사람)",
     "Ela é enfermeira que cuida de pacientes."
    ]
   ]
  },
  "notes": [
   {
    "ko": "em + uma = numa: trabalho numa empresa.",
    "en": "em + uma = numa: trabalho numa empresa."
   },
   {
    "ko": "'Candidatei-me'는 재귀 동사 candidatar-se의 과거형입니다.",
    "en": "'Candidatei-me' is the preterite of the reflexive candidatar-se."
   },
   {
    "ko": "직업에는 관사를 쓰지 않습니다: Sou enfermeira.",
    "en": "No article before a job: Sou enfermeira."
   }
  ],
