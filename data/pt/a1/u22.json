 "grammar": {
  "title": {
   "ko": "언어에 관한 표현 (falar, entender, um pouco)",
   "en": "Talking about languages (falar, entender, um pouco)"
  },
  "explain": {
   "ko": "언어 이름은 소문자로 쓰고 관사가 필요 없습니다: Eu falo inglês. '조금'은 'um pouco de + 언어': Eu falo um pouco de japonês. 부탁할 때는 명령형 + por favor: Fale devagar, por favor. Repita, por favor.",
   "en": "Language names are lower-case and need no article: Eu falo inglês. 'A little' is 'um pouco de + language'. Make requests with the imperative + por favor: Fale devagar, por favor. Repita, por favor."
  },
  "table": {
   "head": [
    "표현 / Expressão",
    "의미 / Significado",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "Eu falo ~",
     "~어를 해요",
     "Eu falo coreano."
    ],
    [
     "um pouco de ~",
     "~어를 조금",
     "Eu falo um pouco de inglês."
    ],
    [
     "Eu não entendo.",
     "이해 못 해요",
     "Desculpe, eu não entendo."
    ],
    [
     "Fale devagar.",
     "천천히 말해 주세요",
     "Fale devagar, por favor."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'falar bem'은 동사 뒤에 bem을 둡니다: Ela fala inglês bem.",
    "en": "'Falar bem': Ela fala inglês bem."
   },
   {
    "ko": "'aprender'는 배우다, 'estudar'는 공부하다입니다.",
    "en": "'Aprender' is to learn; 'estudar' is to study."
   },
   {
    "ko": "뜻을 물을 때: O que esta palavra significa?",
    "en": "Asking meaning: O que esta palavra significa?"
   }
  ],
