 "grammar": {
  "title": {
   "ko": "날씨 말하기: Está + 형용사 · Faz + calor / frio · na + 계절",
   "en": "Talking about the weather: Está + adjective · Faz + calor / frio · na + season"
  },
  "explain": {
   "ko": "날씨는 'Está + 형용사'(Está ensolarado.) 또는 'Faz + 명사'(Faz calor. Faz frio.)로 말합니다. 비가 올 때는 'Está chovendo.'를 씁니다. 계절 앞에는 em과 관사가 합쳐진 no / na를 씁니다: no verão, na primavera.",
   "en": "Describe weather with 'Está + adjective' (Está ensolarado.) or 'Faz + noun' (Faz calor. Faz frio.). For rain use 'Está chovendo.' Seasons take em + article: no verão, na primavera."
  },
  "table": {
   "head": [
    "표현 / Expressão",
    "의미 / Significado",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "Como está o tempo?",
     "날씨가 어때요?",
     "Como está o tempo hoje?"
    ],
    [
     "Está + 형용사",
     "~한 날씨예요",
     "Hoje está ensolarado."
    ],
    [
     "Faz + calor / frio",
     "덥다 / 춥다",
     "No verão faz calor."
    ],
    [
     "no / na + 계절",
     "~에",
     "Na primavera faz sol."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'Faz calor'의 faz는 fazer(하다)에서 온 3인칭 형태입니다.",
    "en": "'Faz' in 'Faz calor' is the 3rd person of fazer."
   },
   {
    "ko": "verão, outono, inverno는 남성이고 primavera는 여성입니다.",
    "en": "verão, outono, inverno are masculine; primavera is feminine."
   },
   {
    "ko": "비: Está chovendo. / 눈: Está nevando.",
    "en": "Rain: Está chovendo. Snow: Está nevando."
   }
  ],
