 "grammar": {
  "title": {
   "ko": "규칙 동사 현재형 (-ar / -er / -ir)",
   "en": "Regular present tense (-ar / -er / -ir)"
  },
  "explain": {
   "ko": "포르투갈어 규칙 동사는 어미(-ar, -er, -ir)를 떼고 주어에 맞는 어미를 붙입니다. falar: falo, fala, falamos, falam. comer: como, come, comemos, comem. 주어가 eu일 때는 항상 -o로 끝납니다.",
   "en": "Regular verbs drop the ending (-ar, -er, -ir) and take the ending for the subject. falar: falo, fala, falamos, falam. comer: como, come, comemos, comem. With 'eu' the form always ends in -o."
  },
  "table": {
   "head": [
    "주어 / Sujeito",
    "-ar (falar)",
    "-er (comer)"
   ],
   "rows": [
    [
     "eu",
     "falo",
     "como"
    ],
    [
     "você / ele / ela",
     "fala",
     "come"
    ],
    [
     "nós",
     "falamos",
     "comemos"
    ],
    [
     "vocês / eles",
     "falam",
     "comem"
    ]
   ]
  },
  "notes": [
   {
    "ko": "eu 형은 -o로 끝납니다: estudo, como, abro.",
    "en": "The 'eu' form ends in -o: estudo, como, abro."
   },
   {
    "ko": "nós 형은 -amos / -emos / -imos입니다.",
    "en": "The 'nós' form ends in -amos / -emos / -imos."
   },
   {
    "ko": "현재형은 습관과 지금의 사실을 말합니다.",
    "en": "The present tense covers habits and facts."
   }
  ],
  "examples": [
