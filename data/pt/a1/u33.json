 "grammar": {
  "title": {
   "ko": "전화 표현 (Posso falar com ~?)",
   "en": "Phone phrases (Posso falar com ~?)"
  },
  "explain": {
   "ko": "전화를 받을 때는 'Alô?', 바꿔 달라고 할 때는 'Posso falar com ~?', 기다리라고 할 때는 'Um momento, por favor.', 부재 시 'Ele não está agora. Quer deixar um recado?'를 씁니다. 나중에 다시 걸 때는 'Eu ligo mais tarde.'",
   "en": "Answer with 'Alô?'; ask for someone with 'Posso falar com ~?'; ask to wait with 'Um momento, por favor.'; if absent: 'Ele não está agora. Quer deixar um recado?' To call back: 'Eu ligo mais tarde.'"
  },
  "table": {
   "head": [
    "상황 / Situação",
    "표현 / Expressão",
    "예 / Exemplo"
   ],
