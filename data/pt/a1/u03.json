 "grammar": {
  "title": {
   "ko": "소유 형용사 meu / minha와 ter",
   "en": "Possessive adjectives (meu / minha) and 'ter'"
  },
  "explain": {
   "ko": "포르투갈어 소유 형용사는 뒤에 오는 명사의 성·수에 맞춥니다: meu / minha / meus / minhas, seu / sua / seus / suas. 소유자가 아니라 명사에 일치한다는 점이 한국어와 다릅니다.",
   "en": "Portuguese possessives agree in gender and number with the noun that follows, not with the owner: meu / minha / meus / minhas, seu / sua / seus / suas."
  },
  "table": {
   "head": [
    "명사 / Substantivo",
    "나의 / meu",
    "너의 / seu",
    "우리의 / nosso"
   ],
   "rows": [
    [
     "남성 단수",
     "meu pai",
     "seu pai",
     "nosso pai"
    ],
    [
     "여성 단수",
     "minha mãe",
     "sua mãe",
     "nossa mãe"
    ],
    [
     "남성 복수",
     "meus pais",
     "seus pais",
     "nossos pais"
    ],
    [
     "여성 복수",
     "minhas irmãs",
     "suas irmãs",
     "nossas irmãs"
    ]
   ]
  },
  "notes": [
   {
    "ko": "seu / sua는 '그의·그녀의·당신의'가 모두 될 수 있어 문맥으로 구분합니다.",
    "en": "'seu / sua' can mean his, her or your; context decides."
   },
   {
    "ko": "소유 형용사 앞에 관사를 붙이기도 합니다: a minha família.",
    "en": "An article is often added before the possessive: a minha família."
   },
   {
    "ko": "ter: tenho, tem, temos, têm.",
    "en": "ter: tenho, tem, temos, têm."
   }
  ],
