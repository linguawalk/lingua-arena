 "grammar": {
  "title": {
   "ko": "기분 표현 (estar + 형용사 · estar com fome / sede)",
   "en": "Feelings (estar + adjective · estar com fome / sede)"
  },
  "explain": {
   "ko": "기분과 상태는 'estar + 형용사'로 말합니다: Eu estou feliz. Ela está cansada. 배고픔과 목마름은 'estar com fome / com sede'입니다. 질문은 'Como você está?' / 'Você está bem?' 형용사는 주어의 성에 일치합니다.",
   "en": "Feelings and states use 'estar + adjective': Eu estou feliz. Ela está cansada. Hunger and thirst: 'estar com fome / com sede'. Ask: 'Como você está?' / 'Você está bem?' Adjectives agree with the subject's gender."
  },
  "table": {
   "head": [
    "표현 / Expressão",
    "의미 / Significado",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "Eu estou + 형용사",
     "나는 ~해요",
     "Eu estou feliz."
    ],
    [
     "estar com fome / sede",
     "배고프다 / 목마르다",
     "Eu estou com fome."
    ],
    [
     "Como você está?",
     "어때요?",
     "Estou bem, obrigado."
    ],
    [
     "não estar ~",
     "~하지 않다",
     "Eu não estou cansado."
    ]
   ]
  },
  "notes": [
   {
    "ko": "일시적 기분에는 ser가 아니라 estar를 씁니다.",
    "en": "Temporary feelings take 'estar', not 'ser'."
   },
   {
    "ko": "'com fome'처럼 estar + com + 명사 표현에는 성 변화가 없습니다.",
    "en": "'estar com fome' is invariable."
   },
   {
    "ko": "위로하는 말: Não se preocupe.",
    "en": "Comforting someone: Não se preocupe."
   }
  ],
  "examples": [
   {
    "t": "Eu estou feliz hoje.",
    "ko": "저는 오늘 행복해요.",
    "en": "I am happy today."
   },
   {
    "t": "Ela está cansada.",
    "ko": "그녀는 피곤해요.",
    "en": "She is tired."
   },
   {
    "t": "Eu estou com fome e com sede.",
    "ko": "저는 배고프고 목말라요.",
    "en": "I am hungry and thirsty."
   },
   {
    "t": "Você está bem?",
    "ko": "당신은 괜찮아요?",
    "en": "Are you OK?"
   },
   {
    "t": "Ele está bravo.",
    "ko": "그는 화났어요.",
    "en": "He is angry."
   }
  ],
