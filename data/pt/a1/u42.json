 "grammar": {
  "title": {
   "ko": "외모 묘사 (ser + 형용사, ter + 머리·눈)",
   "en": "Describing appearance (ser + adjective, ter + hair / eyes)"
  },
  "explain": {
   "ko": "사람의 상태·특징은 'ser + 형용사'로 말합니다: Ele é alto. 머리와 눈은 'ter'로 말합니다: Ela tem cabelo comprido e preto. Ele tem olhos castanhos. 형용사는 성에 일치합니다: alto / alta, bonito / bonita. 질문은 Como ela é?",
   "en": "Describe a person with 'ser + adjective': Ele é alto. Hair and eyes take 'ter': Ela tem cabelo comprido e preto. Ele tem olhos castanhos. Adjectives agree in gender: alto / alta, bonito / bonita. Ask: Como ela é?"
  },
  "table": {
   "head": [
    "표현 / Expressão",
    "의미 / Significado",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "ser + 형용사",
     "~하다",
     "Ele é alto e jovem."
    ],
    [
     "ter + cabelo",
     "머리가 ~하다",
     "Ela tem cabelo comprido e preto."
    ],
    [
     "ter + olhos",
     "눈이 ~하다",
     "Ele tem olhos castanhos."
    ],
    [
     "Como ele / ela é?",
     "어떻게 생겼어요?",
     "Como a sua amiga é?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "머리카락은 보통 단수로 씁니다: cabelo comprido.",
    "en": "Hair is usually singular: cabelo comprido."
   },
   {
    "ko": "눈은 복수입니다: olhos castanhos.",
    "en": "Eyes are plural: olhos castanhos."
   },
   {
    "ko": "형용사는 명사 뒤에서 성·수에 맞춥니다.",
    "en": "Adjectives follow the noun and agree."
   }
  ],
