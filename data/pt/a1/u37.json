 "grammar": {
  "title": {
   "ko": "날짜 말하기 (dia + 숫자 + de + 월)",
   "en": "Saying dates (dia + number + de + month)"
  },
  "explain": {
   "ko": "날짜는 '(dia) + 숫자 + de + 월'로 말합니다: dia três de maio, dez de junho. 1일만 서수 'primeiro'를 씁니다: primeiro de maio. 월 이름은 소문자로 씁니다. '~월에'는 'em + 월': em dezembro. 질문은 Qual é a data de hoje? / Quando é o seu aniversário?",
   "en": "Dates are '(dia) + number + de + month': dia três de maio, dez de junho. Only the 1st uses the ordinal 'primeiro': primeiro de maio. Months are lower-case. 'In a month' is 'em + month': em dezembro. Ask: Qual é a data de hoje? / Quando é o seu aniversário?"
  },
  "table": {
   "head": [
    "표현 / Expressão",
    "의미 / Significado",
    "예 / Exemplo"
   ],
   "rows": [
    [
     "Quando é ~?",
     "~은 언제예요?",
     "Quando é o seu aniversário?"
    ],
    [
     "dia + 숫자 + de + 월",
     "~월 ~일",
     "Dia três de maio."
    ],
    [
     "em + 월",
     "~월에",
     "Meu aniversário é em dezembro."
    ],
    [
     "Qual é a data de hoje?",
     "오늘 날짜는요?",
     "Hoje é dez de junho."
    ]
   ]
  },
  "notes": [
   {
    "ko": "1일만 primeiro, 나머지는 기수입니다.",
    "en": "Only the 1st is ordinal; the rest are cardinal numbers."
   },
   {
    "ko": "월 이름은 포르투갈어에서 소문자입니다: janeiro, maio.",
    "en": "Month names are lower-case in Portuguese: janeiro, maio."
   },
   {
    "ko": "축하: Feliz aniversário!",
    "en": "Congratulations: Feliz aniversário!"
   }
  ],
