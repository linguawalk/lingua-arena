 "grammar": {
  "title": {
   "ko": "출신과 국적 (Eu sou de… / Eu sou coreano)",
   "en": "Origin and nationality (Eu sou de… / Eu sou coreano)"
  },
  "explain": {
   "ko": "출신은 'ser de + 장소'로 말합니다: Eu sou da Coreia (de + a = da), Eu sou do Japão (de + o = do). 국적은 소문자 형용사로 쓰고 성에 일치시킵니다: coreano / coreana, francês / francesa. 질문은 De onde você é?",
   "en": "Origin: 'ser de + place': Eu sou da Coreia (de + a = da), Eu sou do Japão (de + o = do). Nationalities are lower-case adjectives that agree in gender: coreano / coreana, francês / francesa. Ask: De onde você é?"
  },
  "table": {
   "head": [
    "남성 / Masculino",
    "여성 / Feminino",
    "나라 / País"
   ],
   "rows": [
    [
     "coreano",
     "coreana",
     "a Coreia"
    ],
    [
     "francês",
     "francesa",
     "a França"
    ],
    [
     "japonês",
     "japonesa",
     "o Japão"
    ],
    [
     "americano",
     "americana",
     "os Estados Unidos"
    ]
   ]
  },
  "notes": [
   {
    "ko": "국적은 소문자로 씁니다: coreano, francês.",
    "en": "Nationalities are lower-case: coreano, francês."
   },
   {
    "ko": "-ês로 끝나는 국적은 여성형이 -esa입니다: francês → francesa.",
    "en": "Nationalities in -ês form the feminine in -esa: francês → francesa."
   },
   {
    "ko": "도시 앞은 de만 씁니다: Eu sou de Paris.",
    "en": "Before a city use plain 'de': Eu sou de Paris."
   }
  ],
  "examples": [
   {
    "t": "Eu sou da Coreia.",
    "ko": "저는 한국 출신이에요.",
    "en": "I am from Korea."
   },
   {
    "t": "Ela é francesa.",
    "ko": "그녀는 프랑스 사람이에요.",
    "en": "She is French."
   },
   {
    "t": "De onde você é?",
