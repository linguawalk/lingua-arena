 "grammar": {
  "title": {
   "ko": "prefixos · sufixos · mudança de classe · -ção / -mento / -eza",
   "en": "prefixes · suffixes · changing word class · -tion/-ment/-ness"
  },
  "explain": {
   "ko": "Prefixos: 'in- / im- / ir- / des-' formam o oposto (possível → impossível; real → irreal; fazer → desfazer); 're-' = de novo (reutilizar). Sufixos de substantivo: '-ção / -são' (decidir → decisão), '-mento' (gerir → gestão; casar → casamento), '-eza / -dade' (feliz → felicidade; belo → beleza), '-or' (gerente, administrador). Sufixos de adjetivo: '-ável / -ível' (confiar → confiável), '-ivo' (criar → criativo). Verbos: '-ecer / -izar' (forte → fortalecer; moderno → modernizar). Advérbios: '-mente' (eficaz → eficazmente).",
   "en": "Prefixes: 'in- / im- / ir- / des-' form the opposite (possível → impossível; real → irreal; fazer → desfazer); 're-' = again (reutilizar). Noun suffixes: '-ção / -são' (decidir → decisão), '-mento' (gerir → gestão; casar → casamento), '-eza / -dade' (feliz → felicidade; belo → beleza), '-or' (gerente, administrador). Adjective suffixes: '-ável / -ível' (confiar → confiável), '-ivo' (criar → criativo). Verbs: '-ecer / -izar' (forte → fortalecer; moderno → modernizar). Adverbs: '-mente' (eficaz → eficazmente)."
  },
  "table": {
   "head": [
    "접사 / Afixo",
    "예 / Exemplo",
    "예문 / Frase"
   ],
   "rows": [
    [
     "in- · im- · des-",
     "impossível · desfazer",
     "Essa meta é impossível."
    ],
    [
     "re-",
     "reutilizar",
     "Você pode reutilizar a garrafa."
    ],
    [
     "-ção · -mento · -dade",
     "decisão · gestão · felicidade",
     "A decisão foi difícil."
    ],
    [
     "-ável · -ivo · -mente",
     "confiável · criativo · eficazmente",
     "Ele usa o tempo eficazmente."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'In-' vira 'im-' antes de p e b.",
    "en": "'In-' becomes 'im-' before p and b."
   },
   {
    "ko": "'-mente' forma advérbios de adjetivos femininos.",
    "en": "'-mente' forms adverbs from feminine adjectives."
   },
   {
    "ko": "Conhecer as regras ajuda a adivinhar palavras novas.",
    "en": "Knowing the rules helps guess new words."
   }
  ],
