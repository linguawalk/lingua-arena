     "me duele + singular",
     "Me duele la cabeza."
    ],
    [
     "me duelen + plural",
     "Me duelen los pies."
    ],
    [
     "tengo + síntoma",
     "Tengo fiebre. Tengo tos."
    ],
    [
     "debería + Inf.",
     "Debería descansar."
    ]
   ]
  },
  "notes": [
   {
    "ko": "duele = 단수, duelen = 복수",
    "en": "duele = singular, duelen = plural"
   },
