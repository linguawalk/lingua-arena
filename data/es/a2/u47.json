 "grammar": {
  "title": {
   "ko": "preguntas de confirmación: …, ¿verdad? …, ¿no? …, ¿eh?",
   "en": "tag questions: …, ¿verdad? …, ¿no? …, ¿eh?"
  },
  "explain": {
   "ko": "스페인어의 부가의문문은 문장 끝에 ¿verdad?, ¿no?, ¿eh? 같은 짧은 말을 붙입니다. 영어와 달리 주어와 시제에 따라 변하지 않습니다: Vienes mañana, ¿verdad? 대답은 Sí / No입니다. 부정문 질문에 긍정으로 답할 때도 Sí를 씁니다. 억양을 올리면 질문이 됩니다.",
   "en": "Spanish tag questions add a fixed tag: ¿verdad?, ¿no?, ¿eh? Unlike English they never change with subject or tense: Vienes mañana, ¿verdad? Answer with Sí / No. Say Sí to confirm even after a negative statement. Raise your voice to make it a question."
  },
  "table": {
   "head": [
    "표현 / Estructura",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "¿verdad?",
     "Vienes mañana, ¿verdad?"
    ],
    [
     "¿no?",
     "Es bonito aquí, ¿no?"
    ],
    [
     "¿eh?",
     "Lo hacemos así, ¿eh?"
    ],
    [
     "대답 / Respuesta",
     "Sí, voy. / No, no voy."
    ]
   ]
  },
  "notes": [
   {
    "ko": "꼬리 표현은 늘 같음",
    "en": "the tag never changes"
   },
   {
    "ko": "억양을 올리면 질문",
    "en": "raise your voice to ask"
   },
   {
    "ko": "긍정 확인 = Sí",
    "en": "confirm = Sí"
   }
  ],
  "examples": [
   {
    "t": "Vienes mañana, ¿verdad?",
    "ko": "오늘 날씨가 좋네요, 그렇죠?",
    "en": "It's a nice day, isn't it?"
   },
   {
    "t": "Es bonito aquí, ¿no?",
    "ko": "너 학생이지, 아니야?",
