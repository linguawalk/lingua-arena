 "grammar": {
  "title": {
   "ko": "deberías · no deberías · ¿Por qué no …?",
   "en": "deberías · no deberías · ¿Por qué no …?"
  },
  "explain": {
   "ko": "Para dar un consejo amable se usa deber en condicional: debería, deberías, debería, deberíamos, deberíais, deberían + infinitivo. Para sugerir: ¿Por qué no + presente? (¿Por qué no descansas?). Para pedir consejo: ¿Qué debería hacer? Se puede suavizar con «Creo que deberías…».",
   "en": "To give polite advice use 'deber' in the conditional: debería, deberías, debería, deberíamos, deberíais, deberían + infinitive. To suggest: ¿Por qué no + present? (¿Por qué no descansas?). To ask for advice: ¿Qué debería hacer? You can soften it with 'Creo que deberías…'."
  },
  "table": {
   "head": [
    "표현 / Forma",
    "예문 / Ejemplo"
   ],
   "rows": [
    [
     "deberías + inf.",
     "Deberías descansar."
    ],
    [
     "no deberías + inf.",
     "No deberías trabajar hoy."
    ],
    [
     "¿Debería …?",
     "¿Debería ir al médico?"
    ],
    [
     "¿Por qué no + presente?",
     "¿Por qué no pruebas un té?"
    ],
    [
     "¿Qué debería hacer?",
     "Estoy estresado. ¿Qué debería hacer?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "Después de deberías va el infinitivo: deberías salir (no «deberías sales»).",
    "en": "After deberías use the infinitive: deberías salir."
   },
   {
    "ko": "Deberías es más suave que debes: «debes» es una orden, «deberías» es un consejo.",
    "en": "'Deberías' is softer than 'debes': 'debes' is an order, 'deberías' is advice."
   },
   {
    "ko": "«Creo que deberías…» suena todavía más suave.",
    "en": "'Creo que deberías…' sounds softer still."
   }
  ],
  "examples": [
