   {
    "ko": "«hace» + tiempo = «ago»: hace tres días.",
    "en": "'Hace' + time = 'ago': hace tres días."
   },
   {
    "ko": "Respuestas cortas: Sí, estuve. / No, no estuvimos.",
    "en": "Short answers: Sí, estuve. / No, no estuvimos."
   }
  ],
