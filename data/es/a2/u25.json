 "grammar": {
  "title": {
   "ko": "desde + punto en el tiempo · hace + duración · durante + duración",
   "en": "desde + point in time · hace + duration · durante + duration"
  },
  "explain": {
   "ko": "desde는 시작 시점(desde 2020, desde el lunes), desde hace는 기간(desde hace tres años), durante는 끝난 기간(durante dos horas)입니다. hace + 기간 + 부정과거는 '~ 전에'입니다: Llegó hace dos días. llevar + 기간 + 현재분사는 '~째 ~하고 있다'입니다: Llevo dos años estudiando español.",
   "en": "Desde marks the starting point (desde 2020, desde el lunes), desde hace gives the length (desde hace tres años), durante marks a completed period (durante dos horas). Hace + duration + preterite = 'ago': Llegó hace dos días. Llevar + duration + gerund = 'have been … for': Llevo dos años estudiando español."
  },
  "table": {
   "head": [
    "표현 / Estructura",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "desde + fecha",
     "Vivo aquí desde 2020."
    ],
    [
     "desde hace + duración",
     "Vivo aquí desde hace tres años."
    ],
    [
     "hace + duración (ago)",
     "Llegó hace dos días."
    ],
    [
     "durante + duración",
     "Estudié durante dos horas."
    ]
   ]
  },
  "notes": [
   {
    "ko": "desde = 시작 시점",
    "en": "desde = starting point"
   },
   {
    "ko": "desde hace / llevar = 기간",
    "en": "desde hace / llevar = length"
   },
   {
    "ko": "hace = ~ 전에",
    "en": "hace = ago"
   }
  ],
