 "grammar": {
  "title": {
   "ko": "peticiones corteses: ¿Podría + infinitivo? · ¿Le importaría + infinitivo? · ¿Me puede / me deja + infinitivo?",
   "en": "polite requests: ¿Podría + infinitive? · ¿Le importaría + infinitive? · ¿Me puede / me deja + infinitive?"
  },
  "explain": {
   "ko": "정중한 부탁은 ¿Podría + 동사원형 …? 또는 ¿Le importaría + 동사원형 …?로 합니다(조건법). 허락은 ¿Me deja + 동사원형 …? / ¿Puedo …?로 구합니다. 수락은 Claro que sí. / Por supuesto., 거절은 Lo siento, no puedo.처럼 부드럽게 합니다. por favor를 붙이면 더 공손합니다.",
   "en": "Polite requests use ¿Podría + infinitive …? or ¿Le importaría + infinitive …? (conditional). Ask permission with ¿Me deja + infinitive …? / ¿Puedo …? Accept with Claro que sí / Por supuesto; refuse gently: Lo siento, no puedo. Por favor adds politeness."
  },
  "table": {
   "head": [
    "표현 / Estructura",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "¿Podría + Inf.?",
     "¿Podría abrir la puerta, por favor?"
    ],
    [
     "¿Le importaría + Inf.?",
     "¿Le importaría cerrar la ventana?"
    ],
    [
     "¿Me deja + Inf.?",
     "¿Me deja usar su teléfono?"
    ],
    [
     "거절 / Rechazo",
     "Lo siento, no puedo."
    ]
   ]
  },
  "notes": [
   {
    "ko": "부탁 = ¿Podría …? / ¿Le importaría …?",
    "en": "request = ¿Podría …? / ¿Le importaría …?"
   },
   {
    "ko": "허락 = ¿Me deja …? / ¿Puedo …?",
    "en": "permission = ¿Me deja …? / ¿Puedo …?"
   },
   {
    "ko": "대답: Claro que sí / Lo siento, no puedo",
    "en": "reply: Claro que sí / Lo siento, no puedo"
   }
  ],
  "examples": [
