 "grammar": {
  "title": {
   "ko": "예약 표현과 ¿Tiene …?",
   "en": "Booking phrases and '¿Tiene …?'"
  },
  "explain": {
   "ko": "예약은 Quisiera reservar una habitación.으로, 빈방은 ¿Tiene una habitación libre?로 묻습니다. 기간은 para + 기간: para tres noches. 가격은 ¿Cuánto cuesta la habitación por noche? 포함 여부는 ¿Está incluido el desayuno? 입니다. quisiera는 quiero보다 공손한 표현입니다.",
   "en": "Book with Quisiera reservar una habitación. Ask for availability with ¿Tiene una habitación libre? Duration uses para + period: para tres noches. Ask the price with ¿Cuánto cuesta la habitación por noche? Ask what's included with ¿Está incluido el desayuno? Quisiera is more polite than quiero."
  },
  "table": {
   "head": [
    "표현 / Expresión",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "Quisiera reservar ~",
     "Quisiera reservar una habitación."
    ],
    [
     "¿Tiene ~ libre?",
     "¿Tiene una habitación doble libre?"
    ],
    [
     "para + 기간",
     "para dos noches"
    ],
    [
     "¿Está incluido ~?",
     "¿Está incluido el desayuno?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "por noche = 하룻밤에.",
    "en": "por noche = per night."
   },
   {
    "ko": "tener: tengo, tienes, tiene.",
    "en": "tener: tengo, tienes, tiene."
   },
   {
    "ko": "habitación individual / doble = 1인 / 2인실.",
    "en": "habitación individual / doble = single / double."
   }
  ],
  "examples": [
