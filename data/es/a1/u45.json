 "grammar": {
  "title": {
   "ko": "동물과 tener",
   "en": "Animals and 'tener'"
  },
  "explain": {
   "ko": "키우는 동물은 tener + 명사로 말합니다: Tengo un perro. 부정은 No tengo + 무관사: No tengo gato. 복수: los perros, los gatos, los peces (pez → peces). 질문은 ¿Tienes una mascota? 먹이를 줄 때는 dar de comer a + 동물: Doy de comer al perro. a + el = al.",
   "en": "Say what pets you have with tener + noun: Tengo un perro. The negative drops the article: No tengo gato. Plurals: los perros, los gatos, los peces (pez → peces). Ask ¿Tienes una mascota? To feed: dar de comer a + animal: Doy de comer al perro. a + el = al."
  },
  "table": {
   "head": [
    "표현 / Expresión",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "tener + animal",
     "Tengo un perro."
    ],
    [
     "no tengo + animal",
     "No tengo gato."
    ],
    [
     "복수",
     "Tengo dos gatos."
    ],
    [
     "¿Tienes ~?",
     "¿Tienes una mascota?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "pez의 복수는 peces입니다.",
    "en": "The plural of pez is peces."
   },
   {
    "ko": "부정: no tengo gato (un 생략).",
    "en": "Negative: no tengo gato (drop un)."
   },
   {
    "ko": "pasear = 산책시키다 / 산책하다.",
    "en": "pasear = to walk."
   }
  ],
