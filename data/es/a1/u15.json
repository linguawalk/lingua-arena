 "grammar": {
  "title": {
   "ko": "ir a · en + 교통수단",
   "en": "'Ir a' and transport: 'en' + vehicle"
  },
  "explain": {
   "ko": "장소로 갈 때는 ir a + 장소(a + el = al)를 쓰고, 교통수단은 en(autobús, tren, taxi, bicicleta), 걸어서는 a pie로 말합니다. 어떻게 가는지는 ¿Cómo vas a ... ?로 묻습니다.",
   "en": "Go somewhere with ir a + place (a + el = al). Say the vehicle with 'en' (autobús, tren, taxi, bicicleta) and on foot with 'a pie'. Ask how with ¿Cómo vas a ... ?"
  },
  "table": {
   "head": [
    "표현 / Expresión",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "ir a + 장소",
     "Voy a la estación."
    ],
    [
     "a + el = al",
     "Voy al parque."
    ],
    [
     "en + 탈것",
     "en autobús, en tren, en taxi"
    ],
    [
     "a pie",
     "Voy a pie."
    ],
    [
     "tomar + 탈것",
     "Tomo el metro."
    ]
   ]
  },
  "notes": [
   {
    "ko": "ir: voy, vas, va, vamos, van.",
    "en": "ir: voy, vas, va, vamos, van."
   },
   {
    "ko": "a + el는 al이 됩니다: al parque.",
    "en": "a + el becomes al: al parque."
   },
   {
    "ko": "도시 앞에도 a를 씁니다: a Madrid, a Seúl.",
    "en": "Also use a before a city: a Madrid, a Seúl."
   }
  ],
