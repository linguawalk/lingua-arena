 "grammar": {
  "title": {
   "ko": "este / esta / estos / estas와 « cuánto »",
   "en": "Demonstratives (este / esta / estos / estas) and 'cuánto'"
  },
  "explain": {
   "ko": "'이 ~'는 este(남성), esta(여성), estos(남성 복수), estas(여성 복수)입니다. 가격은 ¿Cuánto cuesta ... ?로 묻고, Son ... euros.로 답합니다.",
   "en": "'This' is este (m), esta (f), estos (m pl), estas (f pl). Ask a price with ¿Cuánto cuesta ... ? and answer with Son ... euros."
  },
  "table": {
   "head": [
    "지시 형용사 / Demostrativo",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "este + 남성",
     "este bolso"
    ],
    [
     "esta + 여성",
     "esta silla"
    ],
    [
     "estos + 남성 복수",
     "estos libros"
    ],
    [
     "estas + 여성 복수",
     "estas sillas"
    ],
    [
     "ese / esa (거기)",
     "ese bolso, esa silla"
    ]
   ]
  },
  "notes": [
   {
    "ko": "지시 형용사는 뒤에 오는 명사의 성·수에 맞춥니다.",
    "en": "A demonstrative agrees in gender and number with the noun that follows."
   },
   {
    "ko": "가격 묻기: ¿Cuánto cuesta este bolso? / ¿Cuánto cuestan estos bolígrafos?",
    "en": "Ask the price: ¿Cuánto cuesta este bolso? / ¿Cuánto cuestan estos bolígrafos?"
   },
   {
    "ko": "대답: Son cinco euros. / Cuesta cinco euros.",
    "en": "Answer: Son cinco euros. / Cuesta cinco euros."
   }
  ],
  "examples": [
