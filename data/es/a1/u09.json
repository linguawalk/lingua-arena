 "grammar": {
  "title": {
   "ko": "no · 의문문 ¿ ? · 의문사",
   "en": "Negation with 'no', question marks and question words"
  },
  "explain": {
   "ko": "부정은 동사 바로 앞에 no를 둡니다: No bebo café. 의문문은 어순 그대로 억양을 올리고 ¿ ?로 감쌉니다. 의문사가 있으면 의문사를 맨 앞에 둡니다: ¿Dónde trabajas?",
   "en": "Negate by putting no right before the verb: No bebo café. A yes/no question keeps the word order with rising intonation and is wrapped in ¿ ?. With a question word, put it first: ¿Dónde trabajas?"
  },
  "table": {
   "head": [
    "문형 / Forma",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "부정",
     "No trabajo."
    ],
    [
     "부정 대답",
     "No, no trabajo."
    ],
    [
     "의문 (억양)",
     "¿Trabajas?"
    ],
    [
     "의문사",
     "¿Dónde trabajas?"
    ],
    [
     "이중 부정",
     "No bebo nada."
    ]
   ]
  },
  "notes": [
   {
    "ko": "no는 동사 바로 앞에 옵니다: No como carne.",
    "en": "'no' goes right before the verb: No como carne."
   },
   {
    "ko": "의문문은 문장 앞뒤를 ¿ ?로 감쌉니다.",
    "en": "A question is wrapped in ¿ ? at both ends."
   },
   {
    "ko": "nada, nunca 같은 부정어와 함께 쓸 때도 no를 씁니다: No bebo nada.",
    "en": "Keep no with words like nada and nunca: No bebo nada."
   }
  ],
  "examples": [
   {
    "t": "No bebo café.",
    "ko": "저는 커피를 마시지 않아요.",
    "en": "I don't drink coffee."
   },
   {
