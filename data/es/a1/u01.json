 "grammar": {
  "explain": {
   "ko": "ser는 '~이다'를 뜻하며 신분·직업·출신을 말할 때 씁니다. 주어 대명사는 보통 생략합니다(Soy estudiante).",
   "en": "'Ser' means 'to be' for identity, job and origin. Subject pronouns are usually dropped (Soy estudiante)."
  },
  "table": {
   "head": [
    "주어 / Subject",
    "ser"
   ],
   "rows": [
    [
     "yo",
     "soy"
    ],
    [
     "tú",
     "eres"
    ],
    [
     "él / ella / usted",
     "es"
    ],
    [
     "nosotros",
     "somos"
    ],
    [
     "vosotros",
     "sois"
    ],
    [
     "ellos / ellas / ustedes",
     "son"
    ]
   ]
  },
  "notes": [
   {
    "ko": "위치·일시적 상태를 말할 때는 estar를 씁니다(이후 유닛).",
    "en": "For location and temporary states Spanish uses estar (later units)."
   },
   {
    "ko": "부정문은 no를 동사 앞에: No soy médico.",
    "en": "Negation: put no before the verb: No soy médico."
   },
   {
    "ko": "의문문은 ¿ ? 로 감쌉니다: ¿Eres estudiante?",
    "en": "Questions are wrapped in ¿ ?: ¿Eres estudiante?"
   }
  ],
  "examples": [
   {
    "t": "Soy estudiante.",
    "ko": "저는 학생이에요.",
    "en": "I am a student."
   },
   {
    "t": "Eres mi amigo.",
    "ko": "당신은 제 친구예요.",
    "en": "You are my friend."
   },
   {
    "t": "Ella es profesora.",
    "ko": "그녀는 선생님이에요.",
    "en": "She is a teacher."
   },
   {
    "t": "Somos amigos.",
    "ko": "우리는 친구예요.",
    "en": "We are friends."
   },
   {
    "t": "Ellos son médicos.",
    "ko": "그들은 의사예요.",
    "en": "They are doctors."
   }
  ],
