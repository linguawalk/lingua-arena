 "grammar": {
  "title": {
   "ko": "hay y describir la ciudad",
   "en": "'hay' and describing a town"
  },
  "explain": {
   "ko": "있는 것은 hay + 명사로 말합니다: Hay un parque. Hay una escuela. Hay muchas tiendas. 없으면 No hay + 명사: No hay museo. 위치는 cerca de, al lado de, enfrente de로 말합니다. 형용사: tranquilo, ruidoso, limpio. 질문은 ¿Hay un parque por aquí?",
   "en": "Say what exists with hay + noun: Hay un parque. Hay una escuela. Hay muchas tiendas. Negative: No hay + noun: No hay museo. Location: cerca de, al lado de, enfrente de. Adjectives: tranquilo, ruidoso, limpio. Ask ¿Hay un parque por aquí?"
  },
  "table": {
   "head": [
    "표현 / Expresión",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "hay + nombre",
     "Hay un parque."
    ],
    [
     "no hay + nombre",
     "No hay museo."
    ],
    [
