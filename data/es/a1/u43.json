 "grammar": {
  "title": {
   "ko": "estar + 감정, tener + hambre / sed",
   "en": "'estar' + feeling and 'tener hambre / sed'"
  },
  "explain": {
   "ko": "기분이나 상태는 estar + 형용사로 말합니다: Estoy cansado. 배고픔·목마름은 tener를 씁니다: Tengo hambre. Tengo sed. 안부는 ¿Cómo estás? 답은 Estoy bien / No muy bien.입니다. sentirse는 재귀동사입니다: Me siento cansado. Te sientes …",
   "en": "Feelings and states use estar + adjective: Estoy cansado. Hunger and thirst use tener: Tengo hambre. Tengo sed. Ask ¿Cómo estás? Answer Estoy bien / No muy bien. Sentirse is reflexive: Me siento cansado. Te sientes …"
  },
  "table": {
   "head": [
    "표현 / Expresión",
    "예 / Ejemplo"
   ],
   "rows": [
    [
     "estar + adjetivo",
     "Estoy cansado."
    ],
    [
     "tener hambre / sed",
     "Tengo hambre."
    ],
    [
     "¿Cómo estás?",
     "Estoy bien."
    ],
    [
     "sentirse",
     "Me siento mal."
    ]
   ]
  },
  "notes": [
   {
    "ko": "재귀대명사: me, te, se, nos, os, se.",
    "en": "Reflexive pronouns: me, te, se, nos, os, se."
   },
   {
    "ko": "hambre 앞에는 관사가 없습니다.",
    "en": "No article before hambre."
   },
   {
    "ko": "형용사는 성·수에 일치: cansado / cansada.",
    "en": "Adjectives agree: cansado / cansada."
   }
  ],
