    ]
   ]
  },
  "notes": [
   {
    "ko": "직업 앞에는 관사를 쓰지 않습니다: Es médico.",
    "en": "No article before a job: Es médico."
   },
   {
    "ko": "trabajar de + 직업 / trabajar en + 장소: Trabajo de cocinero en un restaurante.",
    "en": "trabajar de + job / trabajar en + place: Trabajo de cocinero en un restaurante."
   },
   {
    "ko": "직업 묻기: ¿A qué se dedica?",
    "en": "Ask: ¿A qué se dedica?"
   }
  ],
