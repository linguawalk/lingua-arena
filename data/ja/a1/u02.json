 "grammar": {
  "title": {
   "ko": "숫자 1–20과 나이 말하기 (〜歳です)",
   "en": "Numbers and saying your age (〜歳です)"
  },
  "explain": {
   "ko": "일본어는 '숫자 + 歳(さい) + です'로 나이를 말합니다. 10살은 じゅっさい, 20살은 はたち(二十歳)로 특별하게 읽습니다.",
   "en": "Japanese says age as number + 歳(さい) + です. 10 is じゅっさい, and 20 is read specially as はたち (二十歳)."
  },
  "table": {
   "head": [
    "숫자 / Number",
    "읽기 / Reading"
   ],
   "rows": [
    [
     "一〜五",
     "いち・に・さん・よん・ご"
    ],
    [
     "十",
     "じゅう"
    ],
    [
     "二十",
     "にじゅう"
    ],
    [
     "나이 / Age",
     "〜さい (十歳 = じゅっさい, 二十歳 = はたち)"
    ]
   ]
  },
  "notes": [
   {
    "ko": "질문: 何歳ですか。 — 대답: 二十歳です。",
    "en": "Ask: 何歳ですか。 — Answer: 二十歳です。"
   },
   {
    "ko": "사람 수는 ひとり, ふたり, さんにん…으로 셉니다: 兄が二人います。",
    "en": "People are counted ひとり, ふたり, さんにん…: 兄が二人います。"
   },
   {
    "ko": "4는 し/よん, 7은 しち/なな 두 가지로 읽습니다.",
    "en": "4 is read し/よん and 7 is しち/なな."
   }
  ],
  "examples": [
