 "grammar": {
  "title": {
   "ko": "〜が好きです · 〜ことが好きです",
   "en": "Likes: 〜が好きです and 〜ことが好きです"
  },
  "explain": {
   "ko": "好きなものは「名詞 + が好きです」と言います。「とても好き」は「大好きです」です。動作が好きなときは動詞の辞書形に「こと」を付けます：泳ぐことが好きです。「好きではありません」は否定の言い方です。",
   "en": "Say what you like with 'noun + が好きです'; 大好きです means 'love'. To like an activity add こと to the dictionary form: 泳ぐことが好きです. Negative: 好きではありません."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "名詞 + が好きです",
     "私は音楽が好きです。"
    ],
    [
     "名詞 + が大好きです",
     "彼女は映画が大好きです。"
    ],
    [
     "動詞 + ことが好きです",
     "泳ぐことが好きです。"
    ],
    [
     "〜は好きではありません",
     "ゲームは好きではありません。"
    ],
    [
     "〜が好きですか",
     "映画が好きですか。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「が」は好きなものを表します。「を」ではありません。",
    "en": "が marks the thing liked, not を."
   },
   {
    "ko": "「私もです」は「私も好きです」の短い言い方です。",
    "en": "私もです means 'me too'."
   },
   {
    "ko": "誘うときは「一緒にしませんか」と言います。",
    "en": "Invite someone with 一緒にしませんか."
   }
  ],
  "examples": [
