 "grammar": {
  "title": {
   "ko": "〜てもいいですか · 〜てくれませんか · 〜てください",
   "en": "Permission and requests: 〜てもいいですか, 〜てくれませんか"
  },
  "explain": {
   "ko": "許可は「〜てもいいですか」で聞きます：ここに座ってもいいですか。答えは「いいですよ」「すみません、だめです」です。お願いは「〜てくれませんか」「〜てください」です：手伝ってくれませんか。",
   "en": "Ask permission with 〜てもいいですか: ここに座ってもいいですか. Answer いいですよ or すみません、だめです. Ask a favour with 〜てくれませんか or 〜てください."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜てもいいですか",
     "ここに座ってもいいですか。"
    ],
    [
     "〜てくれませんか",
     "手伝ってくれませんか。"
    ],
    [
     "いいですよ",
     "もちろん、いいですよ。"
    ],
    [
     "だめです",
     "すみません、だめです。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「〜てもいい」は許可を求める形です。",
    "en": "〜てもいい asks for permission."
   },
   {
    "ko": "「くれませんか」は「ください」よりやわらかいです。",
    "en": "くれませんか is softer than ください."
   },
   {
    "ko": "断るときは「すみません」を先に言います。",
    "en": "Say すみません first when refusing."
   }
  ],
  "examples": [
