 "grammar": {
  "title": {
   "ko": "これ・それ・あれと「〜は〜です」",
   "en": "これ / それ / あれ and 〜は〜です"
  },
  "explain": {
   "ko": "近くの物は「これ」、相手の近くの物は「それ」、遠くの物は「あれ」と言います。名詞の前では「この・その・あの」を使います。日本語には a や the のような冠詞がありません。物があるときは「あります」を使い、数は「一つ、二つ」などで数えます。",
   "en": "Use これ (near me), それ (near you), あれ (far from both). Before a noun use この / その / あの. Japanese has no articles like a or the. Things take あります, and are counted 一つ, 二つ…"
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "これ",
     "これは本です。"
    ],
    [
     "それ",
     "それは傘ですか。"
    ],
    [
     "あれ",
     "あれは何ですか。"
    ],
    [
     "この + 名詞",
     "このかばんは私のです。"
    ],
    [
     "〜が一つあります",
     "りんごが一つあります。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "日本語には a / the のような冠詞がありません。",
    "en": "Japanese has no articles such as a / the."
   },
   {
    "ko": "物の数え方：一つ、二つ、本は一冊、傘は一本、ペンは一本。",
    "en": "Counting: 一つ, 二つ; books 一冊; umbrellas and pens 一本."
   },
   {
    "ko": "「は」は話題を表します。「これは本です」の「は」は「wa」と読みます。",
    "en": "は marks the topic and is read 'wa' in これは本です。"
   }
  ],
  "examples": [
   {
    "t": "これは本です。",
    "read": "これはほんです。",
    "ko": "이것은 책이에요.",
    "en": "This is a book."
