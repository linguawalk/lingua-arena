 "grammar": {
  "title": {
   "ko": "〜ています · 今 · 〜ていません",
   "en": "Now: 〜ています, 今, 〜ていません"
  },
  "explain": {
   "ko": "今していることは「動詞て形 + います」で言います：勉強しています。質問は「何をしていますか」です。否定は「〜ていません」です。話すときは「い」を省いて「してます」とも言います。",
   "en": "Say what is happening now with the te-form + います: 勉強しています. Ask 何をしていますか. The negative is 〜ていません. In speech the い is often dropped: してます."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜ています",
     "私は勉強しています。"
    ],
    [
     "何をしていますか",
     "今、何をしていますか。"
    ],
    [
     "〜ていません",
     "テレビを見ていません。"
    ],
    [
     "今",
     "今、バスを待っています。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "て形に「います」をつけます。",
    "en": "Add います to the te-form."
   },
   {
    "ko": "「〜ていますか」で聞きます。",
    "en": "Ask with 〜ていますか."
   },
   {
    "ko": "習慣にも使います：毎日走っています。",
    "en": "It can also express habits."
   }
  ],
  "examples": [
   {
