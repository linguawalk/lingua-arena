 "grammar": {
  "title": {
   "ko": "もしもし · お願いします · かけ直します",
   "en": "Phone calls: もしもし, 〜さんをお願いします, かけ直します"
  },
  "explain": {
   "ko": "電話は「もしもし」で始めます。話したい人は「〜さんをお願いします」で言います。待ってもらうときは「少々お待ちください」です。伝言は「伝言をお願いします」、あとで電話するときは「かけ直します」です。",
   "en": "Answer a call with もしもし. Ask for someone with 〜さんをお願いします. Ask someone to wait with 少々お待ちください. Leave a message with 伝言をお願いします and call back with かけ直します."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜さんをお願いします",
     "イさんをお願いします。"
    ],
    [
     "少々お待ちください",
     "少々お待ちください。"
    ],
    [
     "伝言をお願いします",
     "伝言をお願いします。"
    ],
    [
     "かけ直します",
     "あとでかけ直します。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「お願いします」は丁寧なお願いです。",
    "en": "お願いします is a polite request."
   },
   {
    "ko": "電話番号は数字を一つずつ言います。",
    "en": "Say phone numbers one digit at a time."
   },
   {
    "ko": "「いません」は人がいないときに使います。",
    "en": "Use いません when a person is out."
   }
  ],
