 "grammar": {
  "title": {
   "ko": "〜が好きです · 大好き · 嫌い · いちばん好き",
   "en": "Likes and dislikes: 好き, 大好き, 嫌い, いちばん好き"
  },
  "explain": {
   "ko": "好みは「〜が好きです」「〜が大好きです」「〜が嫌いです」で言います。いちばん好きなものは「いちばん好きな〜は…です」です。感想は「おもしろい」「つまらない」です。映画の感想は過去形「おもしろかったです」を使います。",
   "en": "State taste with 〜が好きです, 大好きです, 嫌いです. Favourite: いちばん好きな〜は…です. Opinions: おもしろい, つまらない. For a finished film use the past: おもしろかったです."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜が好きです",
     "音楽が好きです。"
    ],
    [
     "〜が大好きです",
     "コメディ映画が大好きです。"
    ],
    [
     "〜が嫌いです",
     "ホラー映画が嫌いです。"
    ],
    [
     "いちばん好きな〜",
     "いちばん好きな歌手はIUです。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "好きなものには「が」を使います。",
    "en": "Use が with the thing you like."
   },
   {
    "ko": "「大好き」は「好き」より強いです。",
    "en": "大好き is stronger than 好き."
   },
   {
    "ko": "過去は「おもしろかったです」です。",
    "en": "The past is おもしろかったです."
   }
