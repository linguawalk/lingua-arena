 "grammar": {
  "title": {
   "ko": "〜時です · 曜日と「に」",
   "en": "Time: 〜時 and days with に"
  },
  "explain": {
   "ko": "時刻は「数字 + 時」で言います：九時、十時。何時かは「何時ですか」、曜日は「何曜日ですか」と聞きます。時や曜日の後ろには「に」を付けます：月曜日に、九時に。「今日」「明日」「朝」には普通「に」を付けません。",
   "en": "Tell the hour with number + 時: 九時, 十時. Ask 何時ですか and 何曜日ですか. Add に after a time or weekday: 月曜日に, 九時に. Words like 今日, 明日 and 朝 normally take no に."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "数字 + 時",
     "九時"
    ],
    [
     "曜日 + に",
     "月曜日に働きます。"
    ],
    [
     "時刻 + に",
     "九時に始まります。"
    ],
    [
     "今日は〜曜日です",
     "今日は月曜日です。"
    ],
    [
     "何時ですか",
     "今何時ですか。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "四時は「よじ」、七時は「しちじ」、九時は「くじ」と読みます。",
    "en": "Special readings: 四時 よじ, 七時 しちじ, 九時 くじ."
   },
   {
    "ko": "曜日は月・火・水・木・金・土・日です。",
    "en": "Days: 月・火・水・木・金・土・日."
   },
   {
    "ko": "「朝」「夜」「今日」「明日」には「に」を付けません。",
    "en": "Do not add に to 朝, 夜, 今日, 明日."
   }
  ],
