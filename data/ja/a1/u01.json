 "grammar": {
  "title": {
   "ko": "です (정중한 단정 표현)",
   "en": "'です' (the polite copula)"
  },
  "explain": {
   "ko": "'です'는 '~입니다'를 뜻하는 정중한 표현으로, 명사 뒤에 붙으며 주어가 바뀌어도 모양이 변하지 않습니다.",
   "en": "'です' is the polite 'to be'. It follows a noun and never changes with the subject."
  },
  "table": {
   "head": [
    "형태 / Form",
    "의미 / Meaning",
    "예 / Example"
   ],
   "rows": [
    [
     "〜です",
     "~입니다",
     "学生です"
    ],
    [
     "〜じゃありません",
     "~이/가 아닙니다",
     "学生じゃありません"
    ],
    [
     "〜ですか",
     "~입니까?",
     "学生ですか"
    ],
    [
     "〜でした",
     "~이었습니다(과거)",
     "学生でした"
    ]
   ]
  },
  "notes": [
   {
    "ko": "'は'는 'wa'로 읽으며 주제를 나타냅니다: 私は学生です。",
    "en": "は is read 'wa' and marks the topic: 私は学生です。"
   },
   {
    "ko": "의문문은 문장 끝에 か를 붙입니다(물음표는 쓰지 않아도 됩니다).",
    "en": "For questions add か at the end (a question mark is optional)."
   },
   {
    "ko": "'さん'은 다른 사람 이름 뒤에 붙이는 존칭이며, 자기 이름에는 붙이지 않습니다.",
    "en": "Add さん after other people's names; never after your own."
   }
  ],
  "examples": [
   {
    "t": "私は学生です。",
    "read": "わたしはがくせいです。",
    "ko": "저는 학생이에요.",
    "en": "I am a student."
   },
   {
    "t": "あなたは私の友達です。",
    "read": "あなたはわたしのともだちです。",
    "ko": "당신은 제 친구예요.",
    "en": "You are my friend."
   },
   {
    "t": "彼女は先生です。",
    "read": "かのじょはせんせいです。",
    "ko": "그녀는 선생님이에요.",
    "en": "She is a teacher."
   },
   {
    "t": "私たちは友達です。",
    "read": "わたしたちはともだちです。",
    "ko": "우리는 친구예요.",
    "en": "We are friends."
   },
   {
