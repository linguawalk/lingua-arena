 "grammar": {
  "title": {
   "ko": "〜語を話します · 少し · 上手に",
   "en": "Languages: 〜語を話します, 少し, 上手に"
  },
  "explain": {
   "ko": "言語は「〜語を話します」で言います。分かるときは「〜語が分かります」、習うときは「〜語を習っています」です。程度は「少し」「上手に」で言います。お願いは「ゆっくり話してください」です。分からないときは「分かりません」と言います。",
   "en": "Say a language with 〜語を話します; understand is 〜語が分かります and learning is 〜語を習っています. Degree: 少し, 上手に. Ask politely ゆっくり話してください. If you don't follow say 分かりません."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜語を話します",
     "私は韓国語を話します。"
    ],
    [
     "少し話します",
     "日本語を少し話します。"
    ],
    [
     "上手に話します",
     "彼は英語を上手に話します。"
    ],
    [
     "ゆっくり話してください",
     "ゆっくり話してください。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「〜語」は言語の名前につけます。",
    "en": "〜語 is attached to language names."
   },
   {
    "ko": "「少し」「上手に」は動詞の前に置きます。",
    "en": "少し and 上手に go before the verb."
   },
   {
    "ko": "「〜てください」はていねいなお願いです。",
    "en": "〜てください is a polite request."
   }
  ],
