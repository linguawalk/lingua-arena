 "grammar": {
  "title": {
   "ko": "〜ませんか · 〜ましょう · 〜ことができます",
   "en": "Invitations: 〜ませんか, 〜ましょう, 〜ことができます"
  },
  "explain": {
   "ko": "友だちを誘うときは「〜ませんか」を使います：一緒に映画を見ませんか。「〜ましょう」は「しよう」と提案する言い方です：公園に行きましょう。できるかどうかは「〜ことができますか」で聞き、断るときは「すみません、忙しいです」と言います。",
   "en": "Invite with 〜ませんか: 一緒に映画を見ませんか. 〜ましょう means 'let's': 公園に行きましょう. Ask if something is possible with 〜ことができますか, and decline with すみません、忙しいです。"
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "時間がありますか",
     "土曜日は時間がありますか。"
    ],
    [
     "〜ませんか",
     "一緒に映画を見ませんか。"
    ],
    [
     "〜ましょう",
     "公園に行きましょう。"
    ],
    [
     "〜ことができますか",
     "明日会うことができますか。"
    ],
    [
     "すみません、〜は忙しいです",
     "すみません、日曜日は忙しいです。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「〜ませんか」は相手の気持ちを聞く、やわらかい誘い方です。",
    "en": "〜ませんか is a soft way to invite."
   },
   {
    "ko": "「時間があります」は「暇です」と似ています。",
    "en": "時間があります is close to 暇です."
   },
   {
    "ko": "受けるときは「いいですね」、断るときは「すみません、忙しいです」。",
    "en": "Accept with いいですね; decline with すみません、忙しいです。"
   }
  ],
