 "grammar": {
  "title": {
   "ko": "いくつ · どのくらい · 〜キロ · たくさん",
   "en": "The market: いくつ, どのくらい, 〜キロ, たくさん"
  },
  "explain": {
   "ko": "数は「いくつ」で聞き、「四つ」のように答えます。量は「どのくらい」で聞き、「一キロ」「一袋」で答えます。「たくさん」は動詞の前に置きます：果物をたくさん食べます。注文は「トマトを三つください」です。",
   "en": "Ask counts with いくつ and answer 四つ. Ask amounts with どのくらい and answer 一キロ or 一袋. たくさん goes before the verb: 果物をたくさん食べます. Order with トマトを三つください."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "いくつ",
     "トマトはいくつありますか。"
    ],
    [
     "どのくらい",
     "牛乳はどのくらい要りますか。"
    ],
    [
     "数 + つ / キロ",
     "トマト四つ、じゃがいも一キロ"
    ],
    [
     "たくさん",
     "野菜をたくさん食べます。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "数え方は「一つ、二つ、三つ」です。",
    "en": "Count with 一つ, 二つ, 三つ."
   },
   {
    "ko": "「を」と「ください」で物を頼みます。",
    "en": "Ask for things with を and ください."
   },
   {
    "ko": "「たくさん」の反対は「少し」です。",
    "en": "The opposite of たくさん is 少し."
   }
  ],
