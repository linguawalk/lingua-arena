 "grammar": {
  "title": {
   "ko": "〜があります · 〜がありません · 少し",
   "en": "Food and drink: 〜があります / ありません, 少し"
  },
  "explain": {
   "ko": "物があるかないかは「〜があります / 〜がありません」で言います：牛乳があります。量は「少し」、数は「二つ」で言います。場所は「冷蔵庫に〜があります」です。質問は「冷蔵庫に何がありますか」です。食べないものは「〜を食べません」です。",
   "en": "Existence uses 〜があります / 〜がありません: 牛乳があります. Amounts: 少し; numbers: 二つ. Place: 冷蔵庫に〜があります. Ask 冷蔵庫に何がありますか. Things you don't eat use 〜を食べません."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜があります",
     "冷蔵庫に牛乳があります。"
    ],
    [
     "〜がありません",
     "米がありません。"
    ],
    [
     "少しあります",
     "パンが少しあります。"
    ],
    [
     "〜が二つあります",
     "卵が二つあります。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "物には「あります」、人や動物には「います」を使います。",
    "en": "Use あります for things and います for people and animals."
   },
   {
    "ko": "「に」は場所、「が」はあるものを表します。",
    "en": "に marks the place and が marks the thing."
   },
   {
    "ko": "否定は「ありません」です。",
    "en": "The negative is ありません."
   }
  ],
  "examples": [
   {
    "t": "パンが少しあります。",
    "read": "パンがすこしあります。",
    "ko": "저는 빵이 조금 있어요.",
    "en": "I have some bread."
   },
   {
