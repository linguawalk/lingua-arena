 "grammar": {
  "title": {
   "ko": "〜ができます · 〜ことができます · 〜れます",
   "en": "Ability: 〜ができます, 〜ことができます, potential form"
  },
  "explain": {
   "ko": "できることは「〜ができます」や「〜ことができます」で言います：泳ぐことができます。できないときは「〜できません」です。かんたんな言い方は可能形です：走れます、乗れます。質問は「〜できますか」です。",
   "en": "Ability uses 〜ができます or 〜ことができます: 泳ぐことができます. The negative is 〜できません. A shorter way is the potential form: 走れます, 乗れます. Ask 〜できますか."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜ができます",
     "料理ができます。"
    ],
    [
     "〜ことができます",
     "泳ぐことができます。"
    ],
    [
     "〜できません",
     "運転ができません。"
    ],
    [
     "〜できますか",
     "ピアノがひけますか。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「ことができます」の前は辞書形です。",
    "en": "Before ことができます use the dictionary form."
   },
   {
    "ko": "「ができます」の前は名詞です。",
    "en": "Before ができます use a noun."
   },
   {
    "ko": "否定は「できません」です。",
    "en": "The negative is できません."
   }
  ],
  "examples": [
