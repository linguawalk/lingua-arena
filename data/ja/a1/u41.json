 "grammar": {
  "title": {
   "ko": "〜を使います · 〜を送ります · 〜がありますか",
   "en": "Technology: 〜を使います, 〜を送ります, 〜がありますか"
  },
  "explain": {
   "ko": "道具は「〜を使います」で言います：パソコンを使います。メールは「送ります」、アプリは「ダウンロードします」です。「ここにWi-Fiがありますか」と聞きます。動かないときは「〜が動きません」です。",
   "en": "Say what you use with 〜を使います: パソコンを使います. Send email with 送ります and apps with ダウンロードします. Ask ここにWi-Fiがありますか. If something fails say 〜が動きません."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜を使います",
     "パソコンを使います。"
    ],
    [
     "〜を送ります",
     "メールを送ります。"
    ],
    [
     "〜がありますか",
     "Wi-Fiがありますか。"
    ],
    [
     "〜が動きません",
     "スマホが動きません。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「使う」は道具や機械に使います。",
    "en": "使う is used with tools and machines."
   },
   {
    "ko": "「ダウンロードします」はするを使う動詞です。",
    "en": "ダウンロードします is a する verb."
   },
   {
    "ko": "「動きません」は機械が動かないことです。",
    "en": "動きません means a machine does not work."
   }
  ],
