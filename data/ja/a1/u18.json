 "grammar": {
  "title": {
   "ko": "職業 + です · 〜で働いています",
   "en": "Jobs: 職業 + です and 〜で働いています"
  },
  "explain": {
   "ko": "職業は「私は + 職業 + です」と言います。働く場所は「場所 + で + 働いています」です。職業は「お仕事は何ですか」と聞きます。日本語には a / an のような冠詞がありません。",
   "en": "State a job with '私は + job + です'. The workplace is '場所 + で + 働いています'. Ask with お仕事は何ですか. Japanese has no articles like a / an."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "私は + 職業 + です",
     "私は看護師です。"
    ],
    [
     "場所 + で働いています",
     "私は病院で働いています。"
    ],
    [
     "お仕事は何ですか",
     "お仕事は何ですか。"
    ],
    [
     "〜時に会議があります",
     "九時に会議があります。"
    ],
    [
     "会社で働いています",
     "大きい会社で働いています。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "日本語には a / an のような冠詞がありません。",
    "en": "Japanese has no a / an."
   },
   {
    "ko": "「で」は働く場所を表します。住んでいる場所は「に」です。",
    "en": "で marks where you work; に marks where you live."
   },
   {
    "ko": "丁寧に聞くときは「お仕事は何ですか」と言います。",
    "en": "Ask politely with お仕事は何ですか."
   }
  ],
