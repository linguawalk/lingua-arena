 "grammar": {
  "title": {
   "ko": "〜を着ます · 〜をはきます · 色の言い方",
   "en": "Clothes: 着ます, はきます, colours"
  },
  "explain": {
   "ko": "服は「着ます」を使います：コートを着ます。ズボンやくつ下、くつは「はきます」、ぼうしは「かぶります」です。色は名詞の前で「白い」「赤い」のように言います。「黒」は名詞としても使えます。様子は「〜はかわいいです」と言います。",
   "en": "Use 着ます for clothes: コートを着ます. Trousers, socks and shoes take はきます and hats take かぶります. Colours go before nouns: 白い, 赤い; 黒 also works as a noun. Describe with 〜はかわいいです."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜を着ます",
     "コートを着ます。"
    ],
    [
     "〜をはきます",
     "ズボンをはきます。"
    ],
    [
     "〜をかぶります",
     "ぼうしをかぶります。"
    ],
    [
     "色 + 名詞",
     "赤いスカート、白いシャツ"
    ]
   ]
  },
  "notes": [
   {
    "ko": "着る・はく・かぶるは体の場所で使い分けます。",
    "en": "着る, はく and かぶる depend on the body part."
   },
   {
    "ko": "い形容詞は名詞の前で「白い」の形です。",
    "en": "い-adjectives keep their い before a noun."
   },
   {
    "ko": "「黒」は「黒です」と言えます。",
    "en": "黒 works as 黒です."
   }
  ],
  "examples": [
