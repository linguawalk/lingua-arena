 "grammar": {
  "title": {
   "ko": "〜ません · 〜ではありません · 〜か",
   "en": "Negatives and questions: 〜ません, 〜ではありません, 〜か"
  },
  "explain": {
   "ko": "動詞の否定は「ます」を「ません」に変えます：飲みます → 飲みません。名詞の否定は「ではありません」です。質問は文の最後に「か」を付けるだけで、語順は変わりません。",
   "en": "Negate a verb by changing ます to ません: 飲みます → 飲みません. Negate a noun with ではありません. A question just adds か at the end; the word order does not change."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "動詞ます → ません",
     "私はコーヒーを飲みません。"
    ],
    [
     "名詞 + ではありません",
     "私は医者ではありません。"
    ],
    [
     "文 + か",
     "英語を話しますか。"
    ],
    [
     "誰・何・どこ",
     "何を食べますか。"
    ],
    [
     "はい / いいえ",
     "はい、話します。/ いいえ、話しません。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「ません」は「ます」の否定形で、主語が変わっても同じです。",
    "en": "ません is the negative of ます and is the same for every subject."
   },
   {
    "ko": "「ではありません」は話し言葉で「じゃありません」とも言います。",
    "en": "ではありません is also said じゃありません in speech."
   },
   {
    "ko": "質問の答えは「はい、〜ます。」か「いいえ、〜ません。」です。",
    "en": "Answers: はい、〜ます。 or いいえ、〜ません。"
   }
  ],
  "examples": [
   {
    "t": "私はコーヒーを飲みません。",
    "read": "わたしはコーヒーをのみません。",
    "ko": "저는 커피를 마시지 않아요.",
    "en": "I don't drink coffee."
   },
   {
    "t": "彼はソウルに住んでいません。",
    "read": "かれはソウルにすんでいません。",
    "ko": "그는 서울에 살지 않아요.",
    "en": "He doesn't live in Seoul."
   },
   {
    "t": "あなたは英語を勉強しますか。",
    "read": "あなたはえいごをべんきょうしますか。",
    "ko": "당신은 영어를 공부해요?",
    "en": "Do you study English?"
   },
   {
    "t": "彼女は学校で働いていますか。",
    "read": "かのじょはがっこうではたらいていますか。",
    "ko": "그녀는 학교에서 일해요?",
    "en": "Does she work at a school?"
   },
   {
    "t": "私は医者ではありません。",
    "read": "わたしはいしゃではありません。",
    "ko": "저는 의사가 아니에요.",
    "en": "I am not a doctor."
   }
  ],
