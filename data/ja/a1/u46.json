 "grammar": {
  "title": {
   "ko": "〜たいです · 〜をください · 〜が痛い",
   "en": "Bank, post office, pharmacy: 〜たいです, 〜をください, 〜が痛い"
  },
  "explain": {
   "ko": "したいことは「動詞 + たいです」で言います：荷物を送りたいです。物は「〜をください」で頼みます。症状は「頭が痛いです」です。薬は「一日二回飲んでください」と言います。値段は「いくらですか」です。",
   "en": "Say what you want to do with verb stem + たいです: 荷物を送りたいです. Ask for items with 〜をください. Symptoms: 頭が痛いです. Medicine: 一日二回飲んでください. Price: いくらですか."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜たいです",
     "手紙を送りたいです。"
    ],
    [
     "〜をください",
     "切手を二枚ください。"
    ],
    [
     "〜が痛いです",
     "頭が痛いです。"
    ],
    [
     "一日〜回",
     "一日二回飲んでください。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「たい」は動詞のます形の語幹につけます。",
    "en": "Attach たい to the verb stem."
   },
   {
    "ko": "「痛い」は体の部分につけます。",
    "en": "痛い goes with a body part."
   },
   {
    "ko": "「一日二回」は一日に二回の意味です。",
    "en": "一日二回 means twice a day."
   }
  ],
