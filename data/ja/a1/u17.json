 "grammar": {
  "title": {
   "ko": "〜が痛いです · 〜てください",
   "en": "Health: 〜が痛いです and 〜てください"
  },
  "explain": {
   "ko": "痛いところは「体の部分 + が痛いです」と言います：頭が痛いです。症状は「頭痛があります」のように「あります」で言います。「〜てください」は丁寧なお願いや指示です：薬を飲んでください。休んでください。",
   "en": "Say where it hurts with '体の部分 + が痛いです': 頭が痛いです. For symptoms use あります: 頭痛があります. 〜てください is a polite request or instruction: 薬を飲んでください。休んでください。"
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "体 + が痛いです",
     "足が痛いです。"
    ],
    [
     "症状 + があります",
     "頭痛があります。"
    ],
    [
     "具合が悪いです",
     "今日は具合が悪いです。"
    ],
    [
     "動詞て + ください",
     "薬を飲んでください。"
    ],
    [
     "どこが痛いですか",
     "どこが痛いですか。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "日本語では「私の頭が痛い」ではなく、「頭が痛いです」と言います。",
    "en": "Japanese just says 頭が痛いです without 'my'."
   },
   {
    "ko": "医者はよく「飲んでください」「休んでください」と言います。",
    "en": "Doctors often say 飲んでください and 休んでください."
   },
   {
    "ko": "「お大事に」は病気の人に言う挨拶です。",
    "en": "お大事に is what you say to someone who is ill."
   }
  ],
