 "grammar": {
  "title": {
   "ko": "この・その・あの + 名詞 · いくらですか",
   "en": "この / その / あの + noun and いくらですか"
  },
  "explain": {
   "ko": "名詞の前では「この(近く)・その(相手の近く)・あの(遠く)」を使います。値段は「いくらですか」と聞き、「五ドルです」のように答えます。支払いの方法には「で」を使います：カードで、現金で。",
   "en": "Before a noun use この (near), その (near you), あの (far). Ask a price with いくらですか and answer 五ドルです. The payment method takes で: カードで, 現金で."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "この + 名詞",
     "このかばんは安いです。"
    ],
    [
     "あの + 名詞",
     "あの本は高いです。"
    ],
    [
     "いくらですか",
     "これはいくらですか。"
    ],
    [
     "数字 + ドル",
     "五ドルです。"
    ],
    [
     "〜で払います",
     "カードで払います。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「この・その・あの」の後ろには必ず名詞が来ます。",
    "en": "この / その / あの must be followed by a noun."
   },
   {
    "ko": "数字は漢数字で読みます：一、二、三、五、十。",
    "en": "Prices use kanji numbers: 一, 二, 三, 五, 十."
   },
   {
    "ko": "支払いの「で」は手段を表します。",
    "en": "で shows the means of payment."
   }
  ],
  "examples": [
   {
    "t": "これはいくらですか。",
