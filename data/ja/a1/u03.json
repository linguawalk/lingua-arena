 "grammar": {
  "title": {
   "ko": "所有の「の」· います",
   "en": "Possessive の and います"
  },
  "explain": {
   "ko": "日本語は「私の母」のように、持ち主の後ろに「の」を置いて所有を表します。人や動物がいるときは「います」、物があるときは「あります」を使います。自分の家族は「母・父・兄・姉」、他の人の家族は「お母さん・お父さん・お兄さん・お姉さん」と言います。",
   "en": "Japanese shows possession with の after the owner: 私の母. Use います for people and animals, あります for things. Your own family: 母, 父, 兄, 姉; someone else's: お母さん, お父さん, お兄さん, お姉さん."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "私の + 名詞",
     "私の母"
    ],
    [
     "あなたの + 名詞",
     "あなたのお父さん"
    ],
    [
     "彼の・彼女の + 名詞",
     "彼の姉"
    ],
    [
     "〜がいます (人・動物)",
     "妹が一人います。"
    ],
    [
     "家族は 〜人です",
     "家族は四人です。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "自分の家族には「母・父」、相手の家族には「お母さん・お父さん」を使います。",
    "en": "Use 母/父 for your own family and お母さん/お父さん for someone else's."
   },
   {
    "ko": "人の数は「一人、二人、三人…」と数えます。一人は「ひとり」、二人は「ふたり」と読みます。",
    "en": "Count people with 人: 一人 (ひとり), 二人 (ふたり), 三人 (さんにん)."
   },
   {
    "ko": "「は」は話題、「が」は新しい情報を表します。「息子が一人います」。",
    "en": "は marks the topic; が marks new information: 息子が一人います。"
   }
  ],
