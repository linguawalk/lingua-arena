 "grammar": {
  "title": {
   "ko": "〜たいです · 〜なければなりません · 〜てはいけません",
   "en": "Wants and needs: 〜たいです, 〜なければなりません, 〜てはいけません"
  },
  "explain": {
   "ko": "したいことは「動詞 + たいです」で言います。しなければならないことは「〜なければなりません」です。してはいけないことは「〜てはいけません」です。ほしい物は「〜がほしいです」です。",
   "en": "Wishes use verb stem + たいです. Obligations use 〜なければなりません. Prohibitions use 〜てはいけません. Wanted things use 〜がほしいです."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜たいです",
     "泳ぎたいです。"
    ],
    [
     "〜なければなりません",
     "勉強しなければなりません。"
    ],
    [
     "〜てはいけません",
     "ここで走ってはいけません。"
    ],
    [
     "〜がほしいです",
     "コーヒーがほしいです。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「たい」の否定は「〜たくないです」です。",
    "en": "The negative of たい is 〜たくないです."
   },
   {
    "ko": "「なければなりません」は義務を表します。",
    "en": "なければなりません expresses obligation."
   },
   {
    "ko": "禁止には「てはいけません」を使います。",
    "en": "Use てはいけません for prohibition."
   }
  ],
  "examples": [
   {
