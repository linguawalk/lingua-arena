 "grammar": {
  "title": {
   "ko": "〜月〜日 · 誕生日 · 何月何日 · 〜は〜です",
   "en": "Dates: 〜月〜日, 誕生日, 何月何日"
  },
  "explain": {
   "ko": "日付は「月 + 日」で言います：五月三日。月は「一月、二月……十二月」です。日付は「一日、二日、三日、四日……」と特別に読みます。質問は「何月何日ですか」「誕生日はいつですか」です。",
   "en": "Dates are month + day: 五月三日. Months are 一月 to 十二月. Days have special readings: 一日, 二日, 三日, 四日. Ask 何月何日ですか and 誕生日はいつですか."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
