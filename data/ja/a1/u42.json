 "grammar": {
  "title": {
   "ko": "背が高い · 髪が長い · 目が茶色 · どんな人",
   "en": "Describing people: 背が高い, 髪が長い, 目が茶色"
  },
  "explain": {
   "ko": "外見は「〜は + 体の部分 + が + 形容詞です」で言います：彼は背が高いです。彼女は髪が長いです。人を聞くときは「どんな人ですか」です。い形容詞とな形容詞(きれい)があります。",
   "en": "Describe looks with 〜は + body part + が + adjective: 彼は背が高いです. 彼女は髪が長いです. Ask どんな人ですか. There are い-adjectives and な-adjectives (きれい)."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "背が高い / 低い",
     "彼は背が高いです。"
    ],
    [
     "髪が長い",
     "彼女は髪が長いです。"
    ],
    [
     "目が茶色",
     "彼は目が茶色です。"
    ],
    [
     "どんな人",
     "先生はどんな人ですか。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「が」は体の部分につけます。",
    "en": "が attaches to the body part."
   },
   {
    "ko": "「きれい」はな形容詞です。",
    "en": "きれい is a な-adjective."
   },
   {
    "ko": "「どんな人ですか」は外見や性格を聞きます。",
    "en": "どんな人ですか asks about looks or character."
   }
  ],
