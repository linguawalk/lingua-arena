 "grammar": {
  "title": {
   "ko": "〜から来ました · 〜人 · どこ",
   "en": "Countries: 〜から来ました, 〜人, どこ"
  },
  "explain": {
   "ko": "出身は「〜から来ました」や「〜の出身です」で言います。国籍は「国の名前 + 人」で言います：韓国人、フランス人。「どこから来ましたか」と聞きます。住んでいる所は「〜に住んでいます」です。否定は「〜人ではありません」です。",
   "en": "Say origin with 〜から来ました or 〜の出身です and nationality with country + 人: 韓国人, フランス人. Ask どこから来ましたか. For where you live use 〜に住んでいます. The negative is 〜人ではありません."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜から来ました",
     "私は韓国から来ました。"
    ],
    [
     "国 + 人",
     "彼女はフランス人です。"
    ],
    [
     "どこから？",
     "どこから来ましたか。"
    ],
    [
     "〜に住んでいます",
     "私はソウルに住んでいます。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「人」は国籍を作る一番かんたんな言葉です。",
    "en": "人 is the easiest way to make a nationality."
   },
   {
    "ko": "「では(じゃ)ありません」で否定します。",
    "en": "Negate with では(じゃ)ありません."
   },
   {
    "ko": "「に住んでいます」は今の住所です。",
    "en": "に住んでいます gives where you live now."
   }
  ],
  "examples": [
