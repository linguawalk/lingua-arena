 "grammar": {
  "title": {
   "ko": "天気と季節: 〜でしょう・〜そうです",
   "en": "Weather and seasons: 〜でしょう / 〜そうです"
  },
  "explain": {
   "ko": "예보는 〜でしょう(~일 것입니다), 곧 일어날 듯한 일은 〜そうです(~할 것 같습니다)로 말합니다: 明日は晴れるでしょう。雨が降りそうです。 계절의 일반적인 사실은 보통형 + です로 말합니다: 冬は雪が降ります。",
   "en": "Forecast with 〜でしょう and something about to happen with 〜そうです: 明日は晴れるでしょう。雨が降りそうです。 General seasonal facts use the plain present: 冬は雪が降ります。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "예보 / Forecast",
     "〜でしょう",
     "明日は晴れるでしょう。"
    ],
    [
     "곧 / About to",
     "〜そうです",
     "雨が降りそうです。"
    ],
    [
     "계절 / Season",
     "〜は〜が降ります",
     "冬は雪が降ります。"
    ],
    [
     "기온 / Temperature",
     "気温は〜度です",
     "気温は二十度です。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "でしょう는 추측이라 확정보다 부드럽습니다.",
    "en": "でしょう is a soft guess, not a certainty."
   },
   {
    "ko": "そうです 앞은 동사 ます형 어간입니다.",
    "en": "そうです follows the verb stem."
   }
  ],
