 "grammar": {
  "title": {
   "ko": "〜ましたか・〜ませんでした・疑問詞",
   "en": "〜ましたか / 〜ませんでした and question words"
  },
  "explain": {
   "ko": "過去の質問は「〜ましたか」と言います。答えは「はい、〜ました」「いいえ、〜ませんでした」です。疑問詞は、どこ、いつ、なぜ、だれと、何を、どのくらいを使います。疑問詞のあとも「か」で終わります：どこへ行きましたか。",
   "en": "Ask about the past with 〜ましたか. Answer はい、〜ました or いいえ、〜ませんでした. Question words are どこ, いつ, なぜ, だれと, 何を, どのくらい, and the sentence still ends with か: どこへ行きましたか。"
  },
  "table": {
   "head": [
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "〜ましたか",
     "昨日、働きましたか。"
    ],
    [
     "はい、〜ました",
     "はい、働きました。"
    ],
    [
     "いいえ、〜ませんでした",
     "いいえ、働きませんでした。"
    ],
    [
     "いつ・どこ・だれと",
     "パリへいつ行きましたか。"
    ],
    [
     "なぜ",
     "なぜ遅れましたか。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "疑問詞の質問には、「はい／いいえ」ではなく具体的に答えます。",
    "en": "Answer a question-word question with the information, not はい／いいえ."
   },
   {
    "ko": "「なぜ」は「どうして」とも言います。",
    "en": "なぜ can also be said どうして."
   },
   {
    "ko": "「〜から」で理由を言います：仕事でしたから。",
    "en": "Give a reason with 〜から: 仕事でしたから。"
   }
  ],
  "examples": [
   {
    "t": "昨日、働きましたか。",
    "read": "きのう、はたらきましたか。",
    "ko": "어제 일했어요?",
    "en": "Did you work yesterday?"
   },
   {
    "t": "私は昨日、働きませんでした。",
    "read": "わたしはきのう、はたらきませんでした。",
