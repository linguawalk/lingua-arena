 "grammar": {
  "title": {
   "ko": "〜ています（進行・状態）",
   "en": "〜ています (progressive and state)"
  },
  "explain": {
   "ko": "今していることは、動詞の「て形」に「います」をつけて言います：働いています、聞いています。服を着た状態は「着ています」、座った状態は「座っています」と言います。否定は「〜ていません」です。",
   "en": "Say what you are doing now with the て-form + います: 働いています, 聞いています. A worn or seated state is 着ています / 座っています. The negative is 〜ていません."
  },
  "table": {
   "head": [
    "動詞 / Verb",
    "〜ています",
    "例 / Example"
   ],
   "rows": [
    [
     "働く",
     "働いています",
     "私は今、働いています。"
    ],
    [
     "聞く",
     "聞いています",
     "音楽を聞いています。"
    ],
    [
     "着る",
     "着ています",
     "赤いコートを着ています。"
    ],
    [
     "座る",
     "座っています (状態)",
     "椅子に座っています。"
    ],
    [
     "否定",
     "〜ていません",
     "テレビを見ていません。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "今を表す言葉：今、ちょうど今、今のところ。",
    "en": "Words for now: 今, ちょうど今."
   },
   {
    "ko": "服は「着る」、帽子は「かぶる」、靴は「はく」を使います。",
    "en": "Use 着る for clothes, かぶる for hats and はく for shoes."
   },
   {
    "ko": "丁寧に言うときは「〜ています」、友達には「〜てる」を使います。",
    "en": "Politely 〜ています; casually 〜てる."
   }
  ],
