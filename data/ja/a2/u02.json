 "grammar": {
  "title": {
   "ko": "動詞の過去形：〜ました",
   "en": "Verb past tense: 〜ました"
  },
  "explain": {
   "ko": "動詞の過去形は「ます」を「ました」に変えて作ります：働きます → 働きました。否定は「ませんでした」です。する動詞は「勉強します → 勉強しました」、来るは「来ます → 来ました」と、どれも同じ形で変わります。",
   "en": "Make the polite past by changing ます to ました: 働きます → 働きました. The negative is ませんでした. する-verbs (勉強しました) and 来る (来ました) change the same way."
  },
  "table": {
   "head": [
    "動詞 / Verb",
    "ます形 / Present",
    "過去 / Past"
   ],
   "rows": [
    [
     "働く",
     "働きます",
     "働きました"
    ],
    [
     "食べる",
     "食べます",
     "食べました"
    ],
    [
     "勉強する",
     "勉強します",
     "勉強しました"
    ],
    [
     "待つ",
     "待ちます",
     "待ちました"
    ],
    [
     "遊ぶ",
     "遊びます",
     "遊びました"
    ]
   ]
  },
  "notes": [
   {
    "ko": "場所で何かをするときは「で」：公園で遊びました。",
    "en": "Use で for where an action happens: 公園で遊びました。"
   },
   {
    "ko": "動作の対象は「を」で表します：部屋を掃除しました。",
    "en": "Mark the object with を: 部屋を掃除しました。"
   },
   {
    "ko": "人に会いに行くときは「〜を訪ねる」「〜に会う」を使います。",
    "en": "To visit someone use 〜を訪ねる or 〜に会う."
   }
  ],
