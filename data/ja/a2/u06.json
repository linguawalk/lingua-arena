 "grammar": {
  "title": {
   "ko": "〜でしょう・〜ましょうか・약속의 「〜ます」",
   "en": "〜でしょう / 〜ましょうか / promises with 〜ます"
  },
  "explain": {
   "ko": "예측은 「〜でしょう」「〜と思います」로 말합니다: 明日は暑いでしょう. 제안은 「〜ましょうか」: ドアを開けましょうか. 자신이 하겠다고 정했을 때나 약속은 「私が〜ます」: 私が手伝います. 「たぶん」을 붙이면 확신이 조금 낮아집니다.",
   "en": "Predict with 〜でしょう or 〜と思います: 明日は暑いでしょう. Offer with 〜ましょうか: ドアを開けましょうか。 Promise or volunteer with 私が〜ます: 私が手伝います。 たぶん makes a prediction less certain."
  },
  "table": {
   "head": [
    "表現 / Expression",
    "用途 / Use",
    "例 / Example"
   ],
   "rows": [
    [
     "〜でしょう",
     "予測 / prediction",
     "明日は暑いでしょう。"
    ],
    [
     "〜ましょうか",
     "申し出 / offer",
     "ドアを開けましょうか。"
    ],
    [
     "私が〜ます",
     "約束・申し出",
     "私が手伝います。"
    ],
    [
     "たぶん〜でしょう",
     "自信の低い予測",
     "彼はたぶん遅れるでしょう。"
    ],
    [
     "〜ないでしょう",
     "否定の予測",
     "彼は来ないでしょう。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「〜ましょうか」는 상대를 위해 하겠다고 제안할 때 씁니다.",
    "en": "「〜ましょうか」 offers to do something for the listener."
   },
   {
    "ko": "친구에게는 「〜よ」「〜ね」를 붙여 부드럽게 말합니다: 手伝うよ.",
    "en": "To friends add よ / ね to soften: 手伝うよ。"
   },
   {
    "ko": "「〜と思います」는 자신의 생각을 말할 때 씁니다.",
    "en": "「〜と思います」 gives your own opinion."
   }
  ],
