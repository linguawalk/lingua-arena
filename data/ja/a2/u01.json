 "grammar": {
  "title": {
   "ko": "과거형: でした・いました・かったです",
   "en": "Past forms: でした / いました / かったです"
  },
  "explain": {
   "ko": "과거는 명사와 な형용사에는 「でした」, い형용사에는 「〜かったです」, 사람이나 동물이 있었을 때는 「いました」를 씁니다. 부정은 「じゃありませんでした」「〜くなかったです」「いませんでした」입니다.",
   "en": "Talk about the past with でした (nouns and な-adjectives), 〜かったです (い-adjectives) and いました (people and animals). Negatives: じゃありませんでした, 〜くなかったです, いませんでした."
  },
  "table": {
   "head": [
    "品詞 / Type",
    "現在 / Present",
    "過去 / Past"
   ],
   "rows": [
    [
     "名詞・な形容詞",
     "元気です",
     "元気でした"
    ],
    [
     "い形容詞",
     "忙しいです",
     "忙しかったです"
    ],
    [
     "います",
     "います",
     "いました"
    ],
    [
     "否定 (名詞)",
     "雨じゃありません",
     "雨じゃありませんでした"
    ],
    [
     "否定 (い形容詞)",
     "忙しくないです",
     "忙しくなかったです"
    ]
   ]
  },
  "notes": [
   {
    "ko": "과거를 나타내는 말: 昨日(어제), 昨夜(어젯밤), 先週末(지난 주말), 〜前(~ 전).",
    "en": "Past time words: 昨日, 昨夜, 先週末, 〜前."
   },
   {
    "ko": "「〜前」은 지금부터 거슬러 센 시간을 나타냅니다: 二時間前(두 시간 전).",
    "en": "「〜前」 counts back from now: 二時間前."
   },
   {
    "ko": "い형용사의 과거: 「いいです」는 「よかったです」가 됩니다.",
    "en": "The past of いい is よかったです (irregular)."
   }
  ],
