     "〜をお願いします",
     "払い戻しをお願いします。"
    ],
    [
     "교환 / Exchange",
     "〜を交換できますか",
     "これを交換できますか。"
    ],
    [
     "증거 / Proof",
     "レシートを持っています",
     "レシートを持っています。"
    ]
   ]
  },
