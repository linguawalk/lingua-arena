 "grammar": {
  "title": {
   "ko": "苦情と返品: こわれています・交換",
   "en": "Complaints and returns: こわれています / 交換"
  },
  "explain": {
   "ko": "문제는 〜がこわれています・動きません으로 말합니다. 요청은 〜をお願いします, 〜できますか로 합니다: 払い戻しをお願いします。これを交換できますか。 점원은 申し訳ありません이라고 사과합니다.",
   "en": "State a problem with 〜がこわれています / 動きません. Ask with 〜をお願いします or 〜できますか: 払い戻しをお願いします。これを交換できますか。 The clerk apologises with 申し訳ありません。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "문제 / Problem",
     "〜がこわれています",
     "このパソコンはこわれています。"
    ],
