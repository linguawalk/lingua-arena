 "grammar": {
  "title": {
   "ko": "好きなこと・したいこと: 〜のが好き・〜たい",
   "en": "Liking and wanting: 〜のが好き / 〜たい / 〜つもり"
  },
  "explain": {
   "ko": "좋아하는 일은 〜のが好きです, 하고 싶은 일은 〜たいです, 계획은 〜つもりです로 말합니다: 泳ぐのが好きです。旅行したいです。来年、引っ越すつもりです。 〜始める・〜終える・〜やめる는 동사 ます형 어간 또는 〜のを에 붙입니다.",
   "en": "Say what you like with 〜のが好きです, what you want with 〜たいです, and plans with 〜つもりです: 泳ぐのが好きです。旅行したいです。来年、引っ越すつもりです。 〜始める / 〜終える attach to the verb stem."
  },
  "table": {
   "head": [
    "部分 / Part",
    "表現 / Expression",
    "例 / Example"
   ],
   "rows": [
    [
     "좋아함 / Like",
     "〜のが好きです",
     "泳ぐのが好きです。"
    ],
    [
     "싫어함 / Dislike",
     "〜のがきらいです",
     "早く起きるのがきらいです。"
    ],
    [
     "희망 / Want",
     "〜たいです",
     "旅行したいです。"
    ],
    [
     "계획 / Plan",
     "〜つもりです",
     "来年、引っ越すつもりです。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "〜たい는 자신의 희망에만 씁니다.",
    "en": "〜たい is used for your own wishes."
   },
   {
    "ko": "〜つもり 앞은 사전형입니다.",
    "en": "〜つもり follows the dictionary form."
   }
  ],
