     "조건 / Condition",
     "-다면 가능하다",
     "앞당기신다면 가능합니다."
    ],
    [
     "한계 / Limit",
     "최저선은 -이다",
     "최저선은 10퍼센트입니다."
    ],
    [
     "절충 / Compromise",
     "서로 절충하다",
     "서로 절충합시다."
    ]
   ]
  },
