 "grammar": {
  "title": {
   "ko": "서술격 조사 '이다' (-이에요 / -예요)",
   "en": "The copula '이다' (-이에요 / -예요)"
  },
  "explain": {
   "ko": "'이다'는 명사 뒤에 붙어 '~입니다/~이에요'를 뜻합니다. 받침이 있으면 -이에요, 없으면 -예요를 씁니다.",
   "en": "'이다' attaches to a noun to mean 'is/am/are'. Use -이에요 after a final consonant and -예요 after a vowel."
  },
  "table": {
   "head": [
    "받침 / Final consonant",
    "형태 / Form",
    "예 / Example"
   ],
   "rows": [
    [
     "있음 (O)",
     "-이에요",
     "학생이에요"
    ],
    [
     "없음 (X)",
     "-예요",
     "의사예요"
    ],
    [
     "격식체 / Formal",
     "-입니다",
     "학생입니다 / 의사입니다"
    ]
   ]
  },
  "notes": [
   {
    "ko": "'은/는'은 주제를 나타냅니다: 저는 학생이에요.",
    "en": "은/는 marks the topic: 저는 학생이에요."
   },
   {
    "ko": "부정문은 'N이/가 아니에요': 저는 의사가 아니에요.",
    "en": "Negative: N이/가 아니에요: 저는 의사가 아니에요."
   },
   {
    "ko": "의문문은 문장 끝을 올립니다: 학생이에요?",
    "en": "For questions, raise the ending: 학생이에요?"
   }
  ],
  "examples": [
   {
    "t": "저는 학생이에요.",
    "read": "jeoneun haksaengieyo",
    "en": "I am a student."
   },
   {
    "t": "이분은 제 친구예요.",
    "read": "ibuneun je chinguyeyo",
    "en": "This is my friend."
   },
   {
    "t": "그분은 선생님이에요.",
    "read": "geubuneun seonsaengnimieyo",
    "en": "She is a teacher."
   },
   {
    "t": "우리는 친구예요.",
    "read": "urineun chinguyeyo",
    "en": "We are friends."
   },
   {
    "t": "그들은 의사예요.",
    "read": "geudeureun uisayeyo",
    "en": "They are doctors."
   }
  ],
