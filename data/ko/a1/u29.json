 "grammar": {
  "title": {
   "ko": "-의 · 누구 거예요? · 제 거예요",
   "en": "Possession: -의, 누구 거예요?, 제 거예요"
  },
  "explain": {
   "ko": "소유는 '이름 + 의'로 말합니다: 톰의 가방. 누구 것인지는 '누구 거예요?'라고 묻고 '제 거예요', '톰의 거예요'로 답합니다. 구어에서 '의'는 자주 생략합니다: 선생님 책상. '거'는 '것'의 줄임말입니다. 부정은 '-이/가 아니에요'입니다.",
   "en": "Possession is name + 의: 톰의 가방. Ask 누구 거예요? and answer 제 거예요 or 톰의 거예요. In speech 의 is often dropped: 선생님 책상. 거 is a short form of 것. The negative is -이/가 아니에요."
  },
  "table": {
   "head": [
    "표현 / Expression",
    "예 / Example"
   ],
   "rows": [
    [
     "이름 + 의",
     "톰의 가방이에요."
    ],
    [
     "누구 거예요?",
     "이 우산은 누구 거예요?"
    ],
    [
     "제 거예요",
     "그건 제 거예요."
    ],
    [
     "-이/가 아니에요",
     "제 거 아니에요."
    ]
   ]
  },
  "notes": [
   {
    "ko": "'제'는 '저의'의 줄임말입니다.",
    "en": "제 is short for 저의."
   },
   {
    "ko": "'거'는 소유를 나타내는 가벼운 말입니다.",
    "en": "거 is a light word for 'one that belongs to'."
   },
   {
    "ko": "'누구'는 사람을 묻는 말입니다.",
    "en": "누구 asks about a person."
   }
  ],
