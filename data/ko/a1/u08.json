 "grammar": {
  "title": {
   "ko": "~시 · 요일 · 시간 + 에",
   "en": "Time: ~시, days and the particle 에"
  },
  "explain": {
   "ko": "시각은 고유어 수(한, 두, 세, ... 아홉)에 '시'를 붙여 말하고, 분은 한자어 수(십, 삼십)에 '분'을 붙입니다. 요일이나 때 뒤에는 조사 '에'를 붙입니다: 월요일에, 아침에, 아홉 시에.",
   "en": "Tell the hour with a native number + 시 (한 시, 두 시, ... 아홉 시) and minutes with a Sino-Korean number + 분. Add the particle 에 after a day or a time: 월요일에, 아침에, 아홉 시에."
  },
  "table": {
   "head": [
    "표현 / Expression",
    "예 / Example"
   ],
   "rows": [
    [
     "고유어 수 + 시",
     "아홉 시"
    ],
    [
     "한자어 수 + 분",
     "십 분, 삼십 분"
    ],
    [
     "요일 + 에",
     "월요일에 일해요."
    ],
    [
     "아침 / 저녁 + 에",
     "아침에 커피를 마셔요."
    ],
    [
     "오늘 · 내일 (에 없음)",
     "오늘은 월요일이에요."
    ]
   ]
  },
  "notes": [
   {
    "ko": "시는 고유어 수를 씁니다: 한 시, 두 시, 세 시.",
    "en": "Hours use native numbers: 한 시, 두 시, 세 시."
   },
   {
    "ko": "분은 한자어 수를 씁니다: 십 분, 삼십 분.",
