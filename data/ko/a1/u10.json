 "grammar": {
  "title": {
   "ko": "이/그/저 + 명사 · 얼마예요?",
   "en": "Demonstratives with nouns (이/그/저) and 얼마예요?"
  },
  "explain": {
   "ko": "명사 앞에서는 이(가까운 것), 그(듣는 사람 가까이), 저(먼 것)를 씁니다: 이 가방, 저 책. 가격은 '얼마예요?'로 묻고 '오 달러예요'처럼 한자어 수로 대답합니다. 결제 수단에는 조사 '로'를 씁니다: 카드로, 현금으로.",
   "en": "Before a noun use 이 (near), 그 (near you), 저 (far): 이 가방, 저 책. Ask a price with 얼마예요? and answer with a Sino-Korean number: 오 달러예요. Payment method takes 로: 카드로, 현금으로."
  },
  "table": {
   "head": [
    "표현 / Expression",
    "예 / Example"
   ],
   "rows": [
    [
     "이 + 명사",
     "이 가방은 싸요."
    ],
    [
     "저 + 명사",
     "저 책은 비싸요."
    ],
    [
     "얼마예요?",
     "이것은 얼마예요?"
    ],
    [
     "수 + 달러",
     "오 달러예요."
    ],
    [
     "-(으)로 계산하다",
     "카드로 계산해요."
    ]
   ]
  },
  "notes": [
   {
    "ko": "이/그/저 뒤에는 반드시 명사가 옵니다. 혼자 쓰면 이것/그것/저것입니다.",
    "en": "이/그/저 must be followed by a noun; alone use 이것/그것/저것."
   },
   {
    "ko": "가격은 한자어 수로 읽습니다: 일, 이, 삼, 오, 십.",
    "en": "Prices use Sino-Korean numbers: 일, 이, 삼, 오, 십."
   },
   {
    "ko": "받침이 있으면 '으로', 없으면 '로': 현금으로, 카드로.",
    "en": "으로 after a final consonant, 로 after a vowel: 현금으로, 카드로."
   }
  ],
