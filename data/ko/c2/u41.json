     "다른 견해를 가지고 있습니다."
    ],
    [
     "제안 / Propose",
     "-ㄹ지 궁금합니다",
     "중간에서 만날 수 있을지 궁금합니다."
    ],
    [
     "양보 / Concede",
     "양보를 할 용의가 있다",
     "한 가지 양보를 하겠습니다."
    ],
    [
     "합의 / Agree",
     "합의에 이르다",
     "합의에 이를 수 있을 것입니다."
    ]
   ]
  },
