     "-에게 빌려주다: 동생에게 빌려줘요"
    ],
    [
     "저축·지출 / save·spend",
     "저축해요 · 돈을 써요"
    ],
    [
     "은행 / bank",
     "계좌 · 이자 · 수수료 · 현금"
    ]
   ]
  },
