 "grammar": {
  "title": {
   "ko": "-아/어 주시겠어요? (부탁) / -아/어도 될까요? (허락)",
   "en": "-아/어 주시겠어요? (request) / -아/어도 될까요? (permission)"
  },
  "explain": {
   "ko": "정중한 부탁은 동사 어간 + -아/어 주시겠어요?로 합니다: 문을 열어 주시겠어요? 허락을 구할 때는 -아/어도 될까요?(펜을 빌려도 될까요?)를 씁니다. 수락은 '물론이죠.', 거절은 '죄송하지만 안 돼요.'처럼 부드럽게 말합니다. '실례지만', '죄송하지만'을 앞에 붙이면 더 정중합니다.",
   "en": "Polite request: verb stem + -아/어 주시겠어요? (문을 열어 주시겠어요?). Permission: -아/어도 될까요? (펜을 빌려도 될까요?). Accept with 물론이죠; refuse gently with 죄송하지만 안 돼요. Adding 실례지만 / 죄송하지만 first makes it more polite."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "-아/어 주시겠어요?",
     "문을 열어 주시겠어요?"
    ],
    [
     "-아/어도 될까요?",
     "펜을 빌려도 될까요?"
    ],
    [
     "수락 / accept",
     "물론이죠."
    ],
    [
     "거절 / refuse",
     "죄송하지만 안 돼요."
    ]
   ]
  },
  "notes": [
   {
    "ko": "부탁 = -아/어 주시겠어요? / 허락 = -아/어도 될까요?",
    "en": "Request = -아/어 주시겠어요?; permission = -아/어도 될까요?"
   },
   {
    "ko": "'-아/어 주세요'보다 '-아/어 주시겠어요?'가 더 정중합니다.",
    "en": "-아/어 주시겠어요? is more polite than -아/어 주세요."
   },
   {
    "ko": "거절할 때는 이유를 덧붙입니다: 저도 쓰고 있어서요.",
    "en": "Add a reason when you refuse: 저도 쓰고 있어서요."
   }
  ],
