 "grammar": {
  "title": {
   "ko": "-(으)ㄹ래요? (제안) / 기꺼이 / 죄송해요, ~ (거절) / ~은 어때요?",
   "en": "-(으)ㄹ래요? (invite) / 기꺼이 (gladly) / 죄송해요 (refuse) / ~은 어때요? (suggest)"
  },
  "explain": {
   "ko": "초대·제안은 동사 어간 + -(으)ㄹ래요?(저녁 같이 먹을래요?)로 합니다. 수락은 '기꺼이 갈게요.' 또는 '좋아요.', 거절은 '미안해요, 토요일에는 바빠요.'처럼 이유를 덧붙입니다. 대안은 '일요일은 어때요?'로 제안합니다. '시간 돼요?'는 시간이 있는지 묻는 말입니다.",
   "en": "Invite or suggest with verb stem + -(으)ㄹ래요? (저녁 같이 먹을래요?). Accept with 기꺼이 갈게요 or 좋아요; refuse with a reason: 미안해요, 토요일에는 바빠요. Suggest another time: 일요일은 어때요? 시간 돼요? asks whether the person is free."
  },
  "table": {
   "head": [
    "표현 / Pattern",
    "예 / Example"
   ],
   "rows": [
    [
     "초대 / invite",
     "저녁 같이 먹을래요? 토요일에 영화 볼래요?"
    ],
    [
     "수락 / accept",
     "기꺼이 갈게요. 초대해 줘서 고마워요."
    ],
    [
     "거절 / refuse",
     "미안해요, 토요일에는 바빠요."
    ],
    [
     "대안 / alternative",
     "일요일은 어때요?"
    ]
   ]
  },
  "notes": [
   {
    "ko": "-(으)ㄹ래요?는 친한 사이의 제안입니다. 격식 있게는 -(으)시겠어요?",
    "en": "-(으)ㄹ래요? is for friends; formally use -(으)시겠어요?"
   },
   {
    "ko": "거절할 때는 이유를 덧붙입니다.",
    "en": "Give a reason when you refuse."
   },
   {
    "ko": "~은/는 어때요? = ~은 어떨까요?",
    "en": "~은/는 어때요? = how about ...?"
   }
  ],
