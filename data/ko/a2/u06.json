     "예측 / prediction",
     "내일은 더울 거예요."
    ],
    [
     "-(으)ㄹ게요",
     "제안·약속 / offer, promise",
     "제가 도와드릴게요."
    ],
    [
     "-(으)ㄹ까요?",
     "제안하기 / offering",
     "제가 문을 열어 드릴까요?"
    ],
    [
     "아마 + -(으)ㄹ 거예요",
     "불확실한 예측",
     "그는 아마 늦을 거예요."
    ],
    [
     "-지 않을 거예요",
