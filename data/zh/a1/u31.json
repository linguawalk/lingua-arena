 "grammar": {
  "title": {
   "ko": "可以……吗 · 能……吗 · 请 + 动词",
   "en": "Permission and requests: 可以……吗, 能……吗, 请"
  },
  "explain": {
   "ko": "问许可用「可以……吗？」：我可以坐这儿吗？回答「可以」或「对不起，不可以」。请别人帮忙用「能……吗？」或「请……」：你能帮我吗？请等一下。",
   "en": "Ask permission with 可以……吗？: 我可以坐这儿吗？ Answer 可以 or 对不起，不可以. Ask for help with 能……吗？ or 请……: 你能帮我吗？请等一下."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "可以……吗？",
     "我可以坐这儿吗？"
    ],
    [
     "能……吗？",
     "你能帮我吗？"
    ],
    [
     "当然可以",
     "当然可以，请坐。"
    ],
    [
     "不可以",
     "对不起，不可以。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「可以」用来问许可。",
    "en": "可以 asks for permission."
   },
   {
    "ko": "「能」用来请别人做事。",
    "en": "能 asks others to do something."
   },
   {
    "ko": "拒绝时先说「对不起」。",
    "en": "Say 对不起 first when refusing."
   }
  ],
  "examples": [
