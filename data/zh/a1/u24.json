 "grammar": {
  "title": {
   "ko": "有 · 没有 · 一些 · ……吗",
   "en": "Food and drink: 有, 没有, 一些, ……吗"
  },
  "explain": {
   "ko": "说有什么用「有」：我有一些面包。没有用「没有」：我们没有米饭。问用「……有……吗？」：你有牛奶吗？地点用「在……里」：冰箱里有鸡蛋。「一些」表示少量。",
   "en": "Existence uses 有: 我有一些面包. The negative is 没有: 我们没有米饭. Ask with ……有……吗？: 你有牛奶吗？ Place: 冰箱里有鸡蛋. 一些 means a few or some."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "有 + 名词",
     "我有一些面包。"
    ],
    [
     "没有 + 名词",
     "我们没有米饭。"
    ],
    [
     "……有……吗？",
     "你有牛奶吗？"
    ],
    [
     "地点 + 有",
     "冰箱里有鸡蛋。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "否定只用「没有」，不用「不有」。",
    "en": "Negate with 没有, never 不有."
   },
   {
    "ko": "「一些」放在名词前。",
    "en": "一些 goes before the noun."
   },
   {
    "ko": "「吗」放在句子最后。",
    "en": "吗 goes at the end of the sentence."
   }
  ],
