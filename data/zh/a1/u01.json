 "grammar": {
  "title": {
   "ko": "是 (판단동사)",
   "en": "'是' (the verb 'to be')"
  },
  "explain": {
   "ko": "'是'는 '~이다'를 뜻하며 주어가 바뀌어도 모양이 변하지 않습니다. 형용사 앞에는 쓰지 않습니다(이후 유닛).",
   "en": "'是' means 'to be' and never changes with the subject. It is not used before adjectives (later unit)."
  },
  "table": {
   "head": [
    "주어 / Subject",
    "是",
    "예 / Example"
   ],
   "rows": [
    [
     "我",
     "是",
     "我是学生。"
    ],
    [
     "你",
     "是",
     "你是老师。"
    ],
    [
     "他 / 她",
     "是",
     "她是医生。"
    ],
    [
     "我们",
     "是",
     "我们是朋友。"
    ],
    [
     "他们",
     "是",
     "他们是学生。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "부정문은 不是: 我不是医生。",
    "en": "Negative: 不是: 我不是医生。"
   },
   {
    "ko": "의문문은 문장 끝에 吗를 붙입니다: 你是学生吗？",
    "en": "For yes/no questions add 吗 at the end: 你是学生吗？"
   },
   {
    "ko": "간체자를 사용하고, 발음은 병음(pinyin)과 성조 부호로 표기합니다.",
    "en": "Simplified characters are used; pronunciation is written in pinyin with tone marks."
   }
  ],
