 "grammar": {
  "title": {
   "ko": "我是 + 职业 · 在 + 地点 + 工作",
   "en": "Jobs: 我是 + job and 在 + place + 工作"
  },
  "explain": {
   "ko": "说职业，用「我是 + 职业」：我是护士。说在哪儿工作，用「在 + 地点 + 工作」：我在医院工作。问职业用「你做什么工作？」。汉语没有 a / an 这样的冠词。",
   "en": "State a job with 我是 + job: 我是护士. Say where you work with 在 + place + 工作: 我在医院工作. Ask 你做什么工作？ Chinese has no articles like a / an."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "我是 + 职业",
     "我是护士。"
    ],
    [
     "在 + 地点 + 工作",
     "我在医院工作。"
    ],
    [
     "你做什么工作？",
     "你做什么工作？"
    ],
    [
     "时间 + 有会议",
     "我九点有会议。"
    ],
    [
     "在一家 + 公司 + 工作",
     "他在一家大公司工作。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "汉语没有 a / an 这样的冠词。",
    "en": "Chinese has no a / an."
   },
   {
    "ko": "「在」放在动词前面，表示工作的地点。",
    "en": "在 goes before the verb to give the workplace."
   },
   {
    "ko": "公司用量词「家」：一家公司。",
    "en": "Companies take the measure word 家: 一家公司."
   }
  ],
