 "grammar": {
  "title": {
   "ko": "……吗？ · 一起……吧 · 想 · 可以",
   "en": "Invitations: ……吗？, 一起……吧, 想, 可以"
  },
  "explain": {
   "ko": "邀请朋友，可以问「你星期六有空吗？」。提议一起做事，用「我们一起……吧」：我们一起去公园吧。表示想做，用「你想……吗？」。拒绝时说「对不起，我今天很忙」。",
   "en": "Invite with 你星期六有空吗？ Suggest doing something together with 我们一起……吧: 我们一起去公园吧. Ask what someone wants with 你想……吗？ Decline with 对不起，我今天很忙。"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "你有空吗？",
     "星期六你有空吗？"
    ],
    [
     "我们一起……吧",
     "我们一起去公园吧。"
    ],
    [
     "你想……吗？",
     "你想喝杯茶吗？"
    ],
    [
     "可以……吗？",
     "你明天可以见面吗？"
    ],
    [
     "对不起，我很忙",
     "对不起，星期天我很忙。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「吧」表示提议或请求，语气比较柔和。",
    "en": "吧 makes a soft suggestion."
   },
   {
    "ko": "「有空」的意思是有时间。",
    "en": "有空 means to have free time."
   },
   {
    "ko": "答应邀请说「好啊」，拒绝说「对不起，我很忙」。",
    "en": "Accept with 好啊; decline with 对不起，我很忙。"
   }
  ],
