 "grammar": {
  "title": {
   "ko": "很高兴 · 很累 · 很饿 · 没事",
   "en": "Feelings: 很高兴, 很累, 很饿, 没事"
  },
  "explain": {
   "ko": "说心情用「我很 + 形容词」：我很高兴。身体状态也一样：我很累、我很饿、我很渴。问「你没事吧？」回答「我没事」。安慰用「别担心」。否定用「不」：我不饿。",
   "en": "Say feelings with 我很 + adjective: 我很高兴. Body states work the same: 我很累, 我很饿, 我很渴. Ask 你没事吧？ and answer 我没事. Comfort with 别担心. Negate with 不: 我不饿."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "我很……",
     "我很高兴。"
    ],
    [
     "我不……",
     "我不饿。"
    ],
    [
     "你没事吧？",
     "你没事吧？"
    ],
    [
     "别担心",
     "别担心。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "心情形容词前常用「很」。",
    "en": "Feeling adjectives usually take 很."
   },
   {
    "ko": "否定用「不」，不用「很」。",
    "en": "Negate with 不, dropping 很."
   },
   {
    "ko": "「别」表示不要。",
    "en": "别 means don't."
   }
  ],
  "examples": [
