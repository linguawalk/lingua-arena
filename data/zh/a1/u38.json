 "grammar": {
  "title": {
   "ko": "常常 · 有时候 · 很少 · 每天 · 一周两次",
   "en": "How often: 常常, 有时候, 很少, 每天, 一周两次"
  },
  "explain": {
   "ko": "频率词有「每天」「常常」「有时候」「很少」「从不」，放在动词前。次数用「一周两次」。问「你多久锻炼一次？」。「很少」「从不」本身表示否定意思，不再加「不」。",
   "en": "Frequency words: 每天, 常常, 有时候, 很少, 从不 go before the verb. Counts: 一周两次. Ask 你多久锻炼一次？ 很少 and 从不 are already negative, so no extra 不."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "每天",
     "我每天学习。"
    ],
    [
     "常常 / 有时候",
     "我有时候看电影。"
    ],
    [
     "很少 / 从不",
     "我很少看电视。"
    ],
    [
     "一周……次",
     "她一周锻炼两次。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "频率词放在动词前面。",
    "en": "Frequency words go before the verb."
   },
   {
    "ko": "「次」用来数次数。",
    "en": "次 counts occurrences."
   },
   {
    "ko": "「从不」比「很少」更弱。",
    "en": "从不 means never, stronger than 很少."
   }
  ],
