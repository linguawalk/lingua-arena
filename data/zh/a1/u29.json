 "grammar": {
  "title": {
   "ko": "的 · 谁的 · 我的 / 你的 / 他的",
   "en": "Whose is it? 的, 谁的, 我的, 你的"
  },
  "explain": {
   "ko": "说东西是谁的用「名字 + 的 + 东西」：汤姆的包。问用「谁的」：这是谁的包？「的」后面的名词可以省略：这是我的。人称有：我的、你的、他的、她的、我们的。",
   "en": "Show ownership with name + 的 + thing: 汤姆的包. Ask with 谁的: 这是谁的包？ The noun after 的 can be dropped: 这是我的. Possessives: 我的, 你的, 他的, 她的, 我们的."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "名字 + 的 + 东西",
     "这是汤姆的包。"
    ],
    [
     "谁的？",
     "这是谁的包？"
    ],
    [
     "……是我的",
     "那把伞是我的。"
    ],
    [
     "我们的",
     "这个房子是我们的。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「的」连接主人和东西。",
    "en": "的 links the owner and the thing."
   },
   {
    "ko": "「我的」可以单独用：这是我的。",
    "en": "我的 can stand alone: 这是我的."
   },
   {
    "ko": "回答「谁的」用「……的」。",
    "en": "Answer 谁的 with ……的."
   }
  ],
