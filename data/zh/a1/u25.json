 "grammar": {
  "title": {
   "ko": "几 · 多少 · 一斤 · 很多",
   "en": "The market: 几, 多少, 一斤, 很多"
  },
  "explain": {
   "ko": "问数量少用「几」：你要几个西红柿？问量多用「多少」：你要多少牛奶？回答用数字加量词：四个、一公斤、一袋。「很多」放在名词前。买东西说「请给我……」。",
   "en": "Ask small counts with 几: 你要几个西红柿？ Ask amounts with 多少: 你要多少牛奶？ Answer with number + measure word: 四个, 一公斤, 一袋. 很多 goes before the noun. Order with 请给我……."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "几 + 量词",
     "你要几个西红柿？"
    ],
    [
     "多少",
     "你要多少牛奶？"
    ],
    [
     "数字 + 量词",
     "四个西红柿、一公斤土豆"
    ],
    [
     "很多",
     "我吃很多水果。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「几」问十以内的数。",
    "en": "几 asks about numbers under about ten."
   },
   {
    "ko": "「多少」可以问任何数量。",
    "en": "多少 asks about any quantity."
   },
   {
    "ko": "「很多」的反义是「很少」。",
    "en": "The opposite of 很多 is 很少."
   }
  ],
