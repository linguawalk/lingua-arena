 "grammar": {
  "title": {
   "ko": "几月几号 · 生日 · ……月……号",
   "en": "Dates: 几月几号, 生日, ……月……号"
  },
  "explain": {
   "ko": "日期用「月 + 号」：五月三号。月份是「一月、二月……十二月」。问日期用「今天几月几号？」，问生日用「你的生日是几月几号？」。时间点用「在」或直接放在动词前。",
   "en": "Dates are month + 号: 五月三号. Months are 一月 to 十二月. Ask 今天几月几号？ and 你的生日是几月几号？ Time words usually go before the verb."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "……月……号",
     "五月三号。"
    ],
    [
     "几月几号？",
     "今天几月几号？"
    ],
    [
     "生日是……",
     "我的生日是五月三号。"
    ],
    [
     "时间 + 动词",
     "五月十号有聚会。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "口语常说「号」，书面语说「日」。",
    "en": "Speech says 号; writing says 日."
   },
   {
    "ko": "月份是数字加「月」。",
    "en": "Months are number + 月."
   },
   {
    "ko": "时间词放在动词前面。",
    "en": "Time words go before the verb."
   }
  ],
