 "grammar": {
  "title": {
   "ko": "有 · 对面 · 近 · 远 · 安静 · 热闹",
   "en": "My town: 有, 对面, 近, 远, 安静, 热闹"
  },
  "explain": {
   "ko": "说城市里有什么用「有」：附近有一个公园。位置用「在……对面 / 旁边」。距离用「离……很近 / 很远」。描述地方用「很安静」「很热闹」。问「你家附近怎么样？」。",
   "en": "Say what is in town with 有: 附近有一个公园. Position: 在……对面 / 旁边. Distance: 离……很近 / 很远. Describe places with 很安静 or 很热闹. Ask 你家附近怎么样？"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "……有……",
     "附近有一个公园。"
    ],
    [
     "在……对面",
     "银行在邮局对面。"
    ],
    [
     "离……很近 / 很远",
     "学校离这儿很远。"
    ],
    [
     "很安静 / 很热闹",
     "我家附近很安静。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「离」表示两地的距离。",
    "en": "离 marks the distance between two places."
   },
   {
    "ko": "「附近」表示旁边的地方。",
    "en": "附近 means nearby."
   },
   {
    "ko": "「热闹」和「安静」是反义词。",
    "en": "热闹 and 安静 are opposites."
   }
  ],
