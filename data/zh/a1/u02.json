 "grammar": {
  "title": {
   "ko": "숫자 1–20과 나이 말하기 (我〜岁)",
   "en": "Numbers and saying your age (我〜岁)"
  },
  "explain": {
   "ko": "중국어는 '我 + 숫자 + 岁'로 나이를 말하며 동사가 필요 없습니다. 물건·사람을 셀 때 2는 二이 아니라 两(liǎng)을 씁니다.",
   "en": "Chinese states age as 我 + number + 岁 with no verb. When counting things or people, 2 is 两 (liǎng), not 二."
  },
  "table": {
   "head": [
    "숫자 / Number",
    "병음 / Pinyin"
   ],
   "rows": [
    [
     "一 二 三 四 五",
     "yī èr sān sì wǔ"
    ],
    [
     "十",
     "shí"
    ],
    [
     "二十",
     "èrshí"
    ],
    [
     "나이 / Age",
     "我十岁 (wǒ shí suì)"
    ]
   ]
  },
  "notes": [
   {
    "ko": "질문: 你多大了？ — 대답: 我二十岁。",
    "en": "Ask: 你多大了？ — Answer: 我二十岁。"
   },
   {
    "ko": "어린아이에게는 你几岁？를 씁니다.",
    "en": "For young children, use 你几岁？"
   },
   {
    "ko": "양사 个: 我有两个朋友。",
    "en": "Measure word 个: 我有两个朋友。"
   }
  ],
