 "grammar": {
  "title": {
   "ko": "我 + 部位 + 疼 · 有点儿",
   "en": "Health: 我 + body part + 疼 and 有点儿"
  },
  "explain": {
   "ko": "说哪里疼，用「我 + 身体部位 + 疼」：我头疼。「有点儿」表示程度轻：我有点儿头疼。说不舒服用「我今天不舒服」。医生会说「吃药，好好休息」。",
   "en": "Say where it hurts with 我 + body part + 疼: 我头疼. 有点儿 means 'a bit': 我有点儿头疼. For feeling unwell say 我今天不舒服. A doctor says 吃药，好好休息。"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "我 + 部位 + 疼",
     "我腿疼。"
    ],
    [
     "有点儿 + 形容词",
     "我有点儿头疼。"
    ],
    [
     "我不舒服",
     "我今天不舒服。"
    ],
    [
     "吃药",
     "请吃这个药。"
    ],
    [
     "你哪儿疼？",
     "你哪儿疼？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "汉语直接说「我头疼」，不说「我的头疼」。",
    "en": "Chinese says 我头疼, not 我的头疼."
   },
   {
    "ko": "「不舒服」前面不加「很」也可以：我不舒服。",
    "en": "不舒服 works without 很: 我不舒服。"
   },
   {
    "ko": "医生常说「好好休息」。",
    "en": "Doctors often say 好好休息."
   }
  ],
