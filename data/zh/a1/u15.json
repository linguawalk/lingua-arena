 "grammar": {
  "title": {
   "ko": "坐 / 骑 + 交通工具 + 去",
   "en": "Transport: 坐 / 骑 + vehicle + 去"
  },
  "explain": {
   "ko": "坐交通工具用「坐 + 交通工具」：坐公共汽车、坐火车。骑自行车用「骑」。去某个地方用「去 + 地点」。把它们放在一起：我坐公共汽车上班。问方法用「怎么去？」。",
   "en": "Take a vehicle with 坐 + vehicle: 坐公共汽车, 坐火车. Ride a bike with 骑. Go somewhere with 去 + place. Together: 我坐公共汽车上班. Ask how with 怎么去？"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "坐 + 交通工具",
     "我坐地铁。"
    ],
    [
     "骑 + 自行车",
     "我骑自行车去学校。"
    ],
    [
     "去 + 地点",
     "我去机场。"
    ],
    [
     "怎么去？",
     "怎么去机场？"
    ],
    [
     "一张票",
     "我有一张票。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "汉语的顺序是「坐 + 交通工具 + 去 + 地点」，交通工具在前。",
    "en": "Order is 坐 + vehicle + 去 + place; the vehicle comes first."
   },
   {
    "ko": "走路去用「走路去」，不用「坐」。",
    "en": "On foot is 走路去, with no 坐."
   },
   {
    "ko": "票用量词「张」：一张票。",
    "en": "Tickets take the measure word 张: 一张票."
   }
  ],
