 "grammar": {
  "title": {
   "ko": "买票 · 单程 / 往返 · 几点开 · 站台",
   "en": "Tickets: 买票, 单程 / 往返, 几点开, 站台"
  },
  "explain": {
   "ko": "买票用「我想买一张去首尔的票」。问「单程还是往返？」。问时间用「几点开？」，回答「十点开」。问价钱用「多少钱？」。站台用「三号站台」。票用量词「张」。",
   "en": "Buy with 我想买一张去首尔的票. You may be asked 单程还是往返？ Ask the time with 几点开？ and answer 十点开. Ask the price with 多少钱？ Platform: 三号站台. Tickets take the measure word 张."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
