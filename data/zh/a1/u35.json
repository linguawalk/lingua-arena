     "往返票，谢谢。"
    ],
    [
     "几点开？",
     "火车几点开？"
    ],
    [
     "……号站台",
     "三号站台。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "车票的量词是「张」。",
    "en": "The measure word for tickets is 张."
