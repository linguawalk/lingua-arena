 "grammar": {
  "title": {
   "ko": "说 + 语言 · 会 · 一点儿",
   "en": "Languages: 说, 会, 一点儿"
  },
  "explain": {
   "ko": "说语言用「说 + 语言」：我说英语。会不会用「会」：我会说一点儿日语。学习用「学」。程度用「很好」「一点儿」。请别人说慢点用「请说慢一点儿」。不懂时说「我不懂」。",
   "en": "Say a language with 说 + language: 我说英语. Ability uses 会: 我会说一点儿日语. Learning uses 学. Degree: 很好, 一点儿. Ask 请说慢一点儿. If you don't follow say 我不懂."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "说 + 语言",
     "我说韩语。"
    ],
    [
     "会说一点儿",
     "我会说一点儿日语。"
    ],
    [
     "说得很好",
     "他英语说得很好。"
    ],
    [
     "请说慢一点儿",
     "请说慢一点儿。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「语」跟在语言名后：英语、韩语。",
    "en": "语 follows language names: 英语, 韩语."
   },
   {
    "ko": "「一点儿」放在动词后面。",
    "en": "一点儿 goes after the verb."
   },
   {
    "ko": "「请」使请求更有礼貌。",
    "en": "请 makes a request polite."
   }
  ],
