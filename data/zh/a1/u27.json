 "grammar": {
  "title": {
   "ko": "在 · 上面 · 下面 · 里面 · 旁边 · 后面",
   "en": "Where things are: 在, 上面, 下面, 里面, 旁边, 后面"
  },
  "explain": {
   "ko": "说东西的位置用「东西 + 在 + 地点」：书在桌子上。位置词有：上面、下面、里面、旁边、前面、后面、中间。问位置用「……在哪儿？」。",
   "en": "Say where something is with thing + 在 + place: 书在桌子上. Position words: 上面, 下面, 里面, 旁边, 前面, 后面, 中间. Ask ……在哪儿？"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "在……上面",
     "书在桌子上面。"
    ],
    [
     "在……下面",
     "猫在椅子下面。"
    ],
    [
     "在……旁边",
     "银行在邮局旁边。"
    ],
    [
     "……在哪儿？",
     "我的钥匙在哪儿？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「在」表示位置。",
    "en": "在 marks a location."
   },
   {
    "ko": "位置词放在名词后面：桌子上面。",
    "en": "Position words follow the noun: 桌子上面."
   },
   {
    "ko": "「中间」表示两个东西之间。",
    "en": "中间 means between two things."
   }
  ],
