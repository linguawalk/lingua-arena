 "grammar": {
  "title": {
   "ko": "喜欢 · 很喜欢 · 讨厌 · 最喜欢",
   "en": "Likes and dislikes: 喜欢, 很喜欢, 讨厌, 最喜欢"
  },
  "explain": {
   "ko": "说喜欢用「喜欢 + 名词」：我喜欢音乐。更强用「很喜欢」「爱」。不喜欢用「不喜欢」「讨厌」。最喜欢的用「最喜欢的……是……」。感想用「有意思」「无聊」。",
   "en": "Likes use 喜欢 + noun: 我喜欢音乐. Stronger: 很喜欢, 爱. Dislikes: 不喜欢, 讨厌. Favourite: 最喜欢的……是…… Opinions: 有意思, 无聊."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "喜欢 + 名词",
     "我喜欢音乐。"
    ],
    [
