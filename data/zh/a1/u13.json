 "grammar": {
  "title": {
   "ko": "时间 + 动词 · 总是 / 通常",
   "en": "Routine: time + verb, 总是 / 通常"
  },
  "explain": {
   "ko": "描述一天的作息，用「时间 + 动词」：我七点起床。时间词放在动词前面，不需要介词。「总是」「通常」放在动词前面表示频率：我总是喝咖啡。吃饭说「吃早饭、吃午饭、吃晚饭」。",
   "en": "Describe a routine with time + verb: 我七点起床. Time words go before the verb, no preposition. 总是 and 通常 also go before the verb: 我总是喝咖啡. Meals: 吃早饭, 吃午饭, 吃晚饭。"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "时间 + 动词",
     "我七点起床。"
    ],
    [
     "时间 + 吃早饭",
     "我八点吃早饭。"
    ],
    [
     "时间 + 去上班",
     "他九点去上班。"
    ],
    [
     "总是 + 动词",
     "我总是喝咖啡。"
    ],
    [
     "通常 + 动词",
     "她通常十一点睡觉。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "时间放在动词前：我七点起床，不是「起床七点」。",
    "en": "Time goes before the verb: 我七点起床, not 起床七点."
   },
   {
    "ko": "问时间用「几点」：你几点起床？",
    "en": "Ask the time with 几点: 你几点起床？"
   },
   {
    "ko": "「和家人」表示和家人一起：我和家人吃晚饭。",
    "en": "和家人 means with family: 我和家人吃晚饭。"
   }
  ],
