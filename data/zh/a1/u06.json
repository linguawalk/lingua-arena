 "grammar": {
  "title": {
   "ko": "请给我 · 可以……吗？",
   "en": "Ordering: 请给我 and 可以……吗？"
  },
  "explain": {
   "ko": "点餐时最自然的说法是「请给我 + 数量 + 名词」。两样东西用「和」连接：沙拉和汤。礼貌地请求用「可以……吗？」：我可以看一下菜单吗？服务员会问「你想要什么？」。",
   "en": "To order say 请给我 + quantity + noun. Join two items with 和: 沙拉和汤. Make a polite request with 可以……吗？ The server asks 你想要什么？"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "用法 / Use"
   ],
   "rows": [
    [
     "请给我 + 名词",
     "点餐 · 请求"
    ],
    [
     "A 和 B",
     "两样东西"
    ],
    [
     "可以……吗？",
     "礼貌地请求"
    ],
    [
     "你想要什么？",
     "服务员问"
    ],
    [
     "请给我账单",
     "结账"
    ]
   ]
  },
  "notes": [
   {
    "ko": "数量放在名词前面：一杯咖啡、一份沙拉。",
    "en": "The quantity goes before the noun: 一杯咖啡, 一份沙拉."
   },
   {
    "ko": "「和」连接名词：面包和水。",
    "en": "和 joins nouns: 面包和水。"
   },
   {
    "ko": "「再……一点儿」表示再要一些：再给我一点儿水。",
    "en": "再……一点儿 asks for more: 再给我一点儿水。"
   }
  ],
