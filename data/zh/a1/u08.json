 "grammar": {
  "title": {
   "ko": "几点 · 星期几 · 时间词的位置",
   "en": "Time: 几点, 星期几 and where time words go"
  },
  "explain": {
   "ko": "说时刻用「数字 + 点」：九点、十点。问时间用「现在几点？」，问星期用「今天星期几？」。汉语的时间词放在动词前面，不需要介词：我星期一工作，我早上喝咖啡。",
   "en": "Tell the hour with number + 点: 九点, 十点. Ask 现在几点？ and 今天星期几？ Time words go before the verb with no preposition: 我星期一工作, 我早上喝咖啡。"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "数字 + 点",
     "九点"
    ],
    [
     "现在几点？",
     "现在九点。"
    ],
    [
     "今天星期几？",
     "今天星期一。"
    ],
    [
     "时间词 + 动词",
     "我星期一工作。"
    ],
    [
     "早上 / 晚上 + 动词",
     "我早上喝咖啡。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "时间词放在动词前面，不要说「在星期一」。",
    "en": "Time words go before the verb; don't say 在星期一."
   },
   {
    "ko": "星期一到星期六，星期日叫「星期天」。",
    "en": "Monday to Saturday are 星期一 to 星期六; Sunday is 星期天."
   },
   {
    "ko": "「半」表示半小时：九点半。",
    "en": "半 means half past: 九点半。"
   }
  ],
