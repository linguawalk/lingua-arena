 "grammar": {
  "title": {
   "ko": "想 · 要 · 得 · 不能 · 别",
   "en": "Wants and needs: 想, 要, 得, 不能, 别"
  },
  "explain": {
   "ko": "想做的事用「想 + 动词」：我想游泳。必须做的事用「得 + 动词」或「需要 + 动词」：我得学习。不可以做用「不能 + 动词」：这里不能跑。不想用「不想」：我不想休息。",
   "en": "Wishes use 想 + verb: 我想游泳. Obligations use 得 + verb or 需要 + verb: 我得学习. Prohibitions use 不能 + verb: 这里不能跑. Not wanting uses 不想: 我不想休息."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "想 + 动词",
     "我想游泳。"
    ],
    [
     "得 + 动词",
     "我得学习。"
    ],
    [
     "不想 + 动词",
     "我不想休息。"
    ],
    [
     "不能 + 动词",
     "这里不能跑。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「得」读 děi，表示必须。",
    "en": "得 is read děi here and means must."
   },
   {
    "ko": "「不想」表示没有愿望。",
    "en": "不想 means not wanting."
   },
   {
    "ko": "「不能」表示不允许。",
    "en": "不能 means not allowed."
   }
  ],
  "examples": [
