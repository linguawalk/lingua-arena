 "grammar": {
  "title": {
   "ko": "地点 + 有 + 东西 · 在",
   "en": "Describing a home: 地点 + 有 + 东西 and 在"
  },
  "explain": {
   "ko": "说房间里有什么，用「地点 + 有 + 东西」：客厅里有一个沙发。说东西在哪儿，用「东西 + 在 + 地点」：床在卧室里。数量用量词：两个房间、一张床。",
   "en": "Say what is in a room with place + 有 + thing: 客厅里有一个沙发. Say where a thing is with thing + 在 + place: 床在卧室里. Use measure words for counts: 两个房间, 一张床。"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "地点 + 有 + 东西",
     "卧室里有一张床。"
    ],
    [
     "东西 + 在 + 地点",
     "床在卧室里。"
    ],
    [
     "在 + ……旁边",
     "厨房在客厅旁边。"
    ],
    [
     "几个房间",
     "有三个房间。"
    ],
    [
     "很 + 形容词",
     "我的房间很小。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「有」放在地点后面，「在」放在东西后面。",
    "en": "有 follows the place; 在 follows the thing."
   },
   {
    "ko": "房间用「个」，床用「张」，沙发用「个」。",
    "en": "Rooms take 个, beds take 张, sofas take 个."
   },
   {
    "ko": "「里」表示「在……里面」：卧室里。",
    "en": "里 means 'inside': 卧室里。"
   }
  ],
