 "grammar": {
  "title": {
   "ko": "喂 · 请问……在吗 · 留言 · 一会儿再打",
   "en": "Phone calls: 喂, 请问……在吗, 留言, 一会儿再打"
  },
  "explain": {
   "ko": "接电话先说「喂」。找人用「请问……在吗？」。请对方等用「请稍等」。对方不在可以说「请留言」或「我一会儿再打」。号码用「电话号码是多少？」。",
   "en": "Answer a call with 喂. Ask for someone with 请问……在吗？ Ask them to wait with 请稍等. If out, 请留言 or 我一会儿再打. Ask 电话号码是多少？"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "请问……在吗？",
     "请问李先生在吗？"
    ],
    [
     "请稍等",
     "请稍等。"
    ],
    [
     "请留言",
     "请留言。"
    ],
    [
     "一会儿再打",
     "我一会儿再打。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「请问」是礼貌的开头。",
    "en": "请问 is a polite opening."
   },
   {
    "ko": "「不在」表示人不在。",
    "en": "不在 means the person is out."
   },
   {
    "ko": "电话号码一个一个数字地说。",
    "en": "Say phone numbers digit by digit."
   }
  ],
  "examples": [
