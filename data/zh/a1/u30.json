 "grammar": {
  "title": {
   "ko": "会 · 不会 · 会……吗",
   "en": "Ability: 会, 不会, 会……吗"
  },
  "explain": {
   "ko": "会做某事用「会 + 动词」：我会游泳。不会用「不会」：我不会开车。问用「你会……吗？」：你会做饭吗？程度用「得」：他跑得很快。",
   "en": "Ability uses 会 + verb: 我会游泳. The negative is 不会: 我不会开车. Ask 你会……吗？: 你会做饭吗？ Degree uses 得: 他跑得很快."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "会 + 动词",
     "我会游泳。"
    ],
    [
     "不会 + 动词",
     "我不会开车。"
    ],
    [
     "你会……吗？",
     "你会弹钢琴吗？"
    ],
    [
     "动词 + 得 + 形容词",
     "他跑得很快。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「会」表示学过的能力。",
    "en": "会 expresses a learned ability."
   },
   {
    "ko": "否定用「不会」。",
    "en": "Negate with 不会."
   },
   {
    "ko": "「得」后面说明程度。",
    "en": "得 introduces how well."
   }
  ],
