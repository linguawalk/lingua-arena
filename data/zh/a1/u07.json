 "grammar": {
  "title": {
   "ko": "在 · 有 · 方位词",
   "en": "Location: 在, 有 and position words"
  },
  "explain": {
   "ko": "说明某个地方在哪儿，用「东西 + 在 + 地点」：银行在车站旁边。说明某地有什么，用「地点 + 有 + 东西」：学校前面有一个公园。问路用「……在哪儿？」。",
   "en": "To say where something is use thing + 在 + place: 银行在车站旁边. To say what is somewhere use place + 有 + thing: 学校前面有一个公园. Ask with ……在哪儿？"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "东西 + 在 + 地点",
     "车站在这条街上。"
    ],
    [
     "地点 + 有 + 东西",
     "这里有一家银行。"
    ],
    [
     "旁边 / 前面",
     "银行在车站旁边。"
    ],
    [
     "往左 / 往右拐",
     "请往右拐。"
    ],
    [
     "……在哪儿？",
     "医院在哪儿？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「在」说明位置，「有」说明存在，不要混用。",
    "en": "在 gives a location and 有 states existence; don't mix them up."
   },
   {
    "ko": "方位词放在地点名词后面：学校前面、车站旁边。",
    "en": "Position words follow the noun: 学校前面, 车站旁边."
   },
   {
    "ko": "指路：请一直走，请往左拐，请往右拐。",
    "en": "Directions: 请一直走, 请往左拐, 请往右拐。"
   }
  ],
