 "grammar": {
  "title": {
   "ko": "先…然后…最后 · 请 + 动词 · 别 + 动词",
   "en": "Cooking: 先, 然后, 最后, 请, 别"
  },
  "explain": {
   "ko": "说做饭的步骤用「先……然后……最后……」：先煮水，然后加鸡蛋，最后加盐。请别人做事用「请 + 动词」：请切西红柿。不要做用「别 + 动词」：别加太多盐。",
   "en": "Give steps with 先……然后……最后……: 先煮水，然后加鸡蛋，最后加盐. Ask for an action with 请 + verb: 请切西红柿. Say not to with 别 + verb: 别加太多盐."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "请 + 动词",
     "请切西红柿。"
    ],
    [
     "别 + 动词",
     "别加太多盐。"
    ],
    [
     "先……",
     "先煮水。"
    ],
    [
     "然后 / 最后",
     "然后加鸡蛋，最后加盐。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "顺序词放在动词前面。",
    "en": "Sequence words go before the verb."
   },
   {
    "ko": "「别」表示不要做。",
    "en": "别 means do not."
   },
   {
    "ko": "「太多」表示过多。",
    "en": "太多 means too much."
   }
  ],
  "examples": [
