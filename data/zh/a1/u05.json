 "grammar": {
  "title": {
   "ko": "主语 + 动词 + 宾语 · 在 + 地点",
   "en": "Verb + object word order and 在 + place"
  },
  "explain": {
   "ko": "汉语的基本语序是：主语 + 动词 + 宾语。动词不随人称变化：我吃、他吃。表示做事的地点用「在 + 地点 + 动词」：我在学校工作。表示居住的地点用「住在 + 地点」：我住在首尔。",
   "en": "Basic word order is subject + verb + object. Verbs do not change with the subject. Show where you do something with 在 + place + verb: 我在学校工作. For where you live: 住在 + place."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "主语 + 动词 + 宾语",
     "我学习英语。"
    ],
    [
     "在 + 地点 + 动词",
     "我在学校工作。"
    ],
    [
     "住在 + 地点",
     "我住在首尔。"
    ],
    [
     "每天 + 动词",
     "她每天喝咖啡。"
    ],
    [
     "说 + 语言",
     "他说英语。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "动词不随主语变化：我喝、他喝、我们喝。",
    "en": "Verbs never change with the subject: 我喝, 他喝, 我们喝."
   },
   {
    "ko": "「在」放在动词前面表示地点。",
    "en": "在 goes before the verb to give the place."
   },
   {
    "ko": "时间词放在动词前：我每天学习英语。",
    "en": "Time words go before the verb: 我每天学习英语。"
   }
  ],
