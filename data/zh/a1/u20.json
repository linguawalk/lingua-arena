 "grammar": {
  "title": {
   "ko": "自我介绍 · 我叫 · 来自 · 因为……所以……",
   "en": "Self-introduction: 我叫, 来自, 因为……所以……"
  },
  "explain": {
   "ko": "自我介绍按顺序说：名字、国家、住的地方、工作、爱好。名字用「我叫……」，国家用「我来自……」，住的地方用「我住在……」，工作用「我在……工作」。说明原因用「因为……所以……」。",
   "en": "A self-introduction goes name, country, home, job, hobby: 我叫……, 我来自……, 我住在……, 我在……工作. Give a reason with 因为……所以……: 因为我喜欢英语，所以我每天学习。"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "我叫 + 名字",
     "我叫智秀。"
    ],
    [
     "我来自 + 国家",
     "我来自韩国。"
    ],
    [
     "我住在 + 地点",
     "我住在首尔。"
    ],
    [
     "我在 + 地点 + 工作",
     "我在学校工作。"
    ],
    [
     "因为……所以……",
     "因为我喜欢英语，所以我学习。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「来自」说明出生地或国家，「住在」说明现在住的地方。",
    "en": "来自 gives your origin; 住在 gives where you live now."
   },
   {
    "ko": "第一次见面说「很高兴认识你」。",
    "en": "Say 很高兴认识你 when you first meet."
   },
   {
    "ko": "「因为」和「所以」常常一起用。",
    "en": "因为 and 所以 are often used together."
   }
  ],
  "examples": [
