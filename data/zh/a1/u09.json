 "grammar": {
  "title": {
   "ko": "不 · 没 · 吗",
   "en": "Negatives and questions: 不, 没, 吗"
  },
  "explain": {
   "ko": "动词和形容词的否定用「不」：我不喝咖啡。「是」的否定是「不是」。「有」的否定是「没有」。一般疑问句只要在句末加「吗」，语序不变：你学习英语吗？",
   "en": "Negate verbs and adjectives with 不: 我不喝咖啡. The negative of 是 is 不是; of 有 is 没有. A yes/no question just adds 吗 at the end, with the same word order: 你学习英语吗？"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "不 + 动词",
     "我不喝咖啡。"
    ],
    [
     "不是 + 名词",
     "我不是医生。"
    ],
    [
     "没有 + 名词",
     "我没有手机。"
    ],
    [
     "句子 + 吗？",
     "你说英语吗？"
    ],
    [
     "谁 · 什么 · 哪儿",
     "你在哪儿工作？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「不」用在现在和将来，「没」用在「有」前面。",
    "en": "不 is for present/future; 没 goes before 有."
   },
   {
    "ko": "「不」在第四声前读 bú：不是 bú shì。",
    "en": "不 becomes bú before a 4th tone: 不是 bú shì."
   },
   {
    "ko": "回答「吗」的问题：「是的，我说。」或「不，我不说。」",
    "en": "Answers: 是的，我说。 or 不，我不说。"
   }
  ],
