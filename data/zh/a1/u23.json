 "grammar": {
  "title": {
   "ko": "穿 + 衣服 · 颜色 · 量词件/条/双",
   "en": "Clothes: 穿, colours, measure words 件/条/双"
  },
  "explain": {
   "ko": "说穿衣服用「穿」：我穿外套。帽子用「戴」。衣服用量词：一件衬衫、一条裤子、一双鞋。颜色放在名词前：白衬衫、红裙子。描述用「很漂亮」。",
   "en": "Say what you wear with 穿: 我穿外套. Hats take 戴. Clothes take measure words: 一件衬衫, 一条裤子, 一双鞋. Colours go before the noun: 白衬衫, 红裙子. Describe with 很漂亮."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "穿 + 衣服",
     "我穿外套。"
    ],
    [
     "戴 + 帽子",
     "他戴帽子。"
    ],
    [
     "一件 / 一条 / 一双",
     "一件衬衫、一条裤子、一双鞋"
    ],
    [
     "颜色 + 名词",
     "红裙子、白衬衫"
    ]
   ]
  },
  "notes": [
   {
    "ko": "上衣用「件」，裤子裙子用「条」，鞋用「双」。",
    "en": "Use 件 for tops, 条 for trousers and skirts, 双 for shoes."
   },
   {
    "ko": "帽子用「戴」，不用「穿」。",
    "en": "Hats use 戴, not 穿."
   },
   {
    "ko": "「的」可以连接颜色和名词：黑色的鞋。",
    "en": "的 can link colour and noun: 黑色的鞋."
   }
  ],
