 "grammar": {
  "title": {
   "ko": "我来自…… · 是……人 · 你来自哪里",
   "en": "Countries: 我来自……, 是……人, 你来自哪里"
  },
  "explain": {
   "ko": "说国籍用「国家名 + 人」：韩国人、法国人。问来自哪里用「你来自哪里？」，回答「我来自……」。说住的地方用「住在……」。否定用「不是……人」。",
   "en": "Nationality is country + 人: 韩国人, 法国人. Ask 你来自哪里？ and answer 我来自……. For where you live use 住在……. The negative is 不是……人."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "我来自 + 国家",
     "我来自韩国。"
    ],
    [
     "国家 + 人",
     "她是法国人。"
    ],
    [
     "你来自哪里？",
     "你来自哪里？"
    ],
    [
     "我住在 + 地点",
     "我住在首尔。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「人」跟在国家名后面表示国籍。",
    "en": "人 after a country name gives the nationality."
   },
   {
    "ko": "否定用「不是」。",
    "en": "Negate with 不是."
   },
   {
    "ko": "「住在」说明现在住的地方。",
    "en": "住在 gives where you live now."
   }
  ],
  "examples": [
