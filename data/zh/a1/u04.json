 "grammar": {
  "title": {
   "ko": "这 / 那 + 量词",
   "en": "这 / 那 and measure words"
  },
  "explain": {
   "ko": "近处的东西用「这」，远处的用「那」。汉语数东西时，数词和名词之间要有量词：一本书、一把雨伞、两支笔。汉语没有 a / the 这样的冠词。",
   "en": "Use 这 (near) and 那 (far). Between a number and a noun Chinese needs a measure word: 一本书, 一把雨伞, 两支笔. Chinese has no articles such as a or the."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "这 / 那 + 是 + 名词",
     "这是书。"
    ],
    [
     "数词 + 量词 + 名词",
     "一本书"
    ],
    [
     "本 (书)",
     "一本书"
    ],
    [
     "把 (伞、椅子)",
     "一把雨伞"
    ],
    [
     "个 (通用)",
     "一个苹果"
    ]
   ]
  },
  "notes": [
   {
    "ko": "汉语没有 a / the 这样的冠词。",
    "en": "Chinese has no articles such as a / the."
   },
   {
    "ko": "量词因名词而不同：书用「本」，伞和椅子用「把」，笔用「支」。",
    "en": "Measure words depend on the noun: 本 for books, 把 for umbrellas and chairs, 支 for pens."
   },
   {
    "ko": "不知道量词时可以用通用量词「个」。",
    "en": "When unsure use the general measure word 个."
   }
  ],
  "examples": [
   {
    "t": "这是一本书。",
    "read": "Zhè shì yì běn shū.",
    "ko": "이것은 책이에요.",
    "en": "This is a book."
   },
   {
    "t": "她有一个苹果。",
    "read": "Tā yǒu yí gè píngguǒ.",
    "ko": "그녀는 사과가 하나 있어요.",
    "en": "She has an apple."
