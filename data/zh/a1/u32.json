 "grammar": {
  "title": {
   "ko": "在 + 动词 · 正在 · 没在",
   "en": "Now: 在 + verb, 正在, 没在"
  },
  "explain": {
   "ko": "正在做的事用「在 + 动词」或「正在 + 动词」：我在学习。问用「你在做什么？」。否定用「没在 + 动词」或「没有 + 动词」：我没在看电视。「现在」放在句首。",
   "en": "Actions in progress use 在 + verb or 正在 + verb: 我在学习. Ask 你在做什么？ The negative is 没在 + verb: 我没在看电视. 现在 goes early in the sentence."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "在 + 动词",
     "我在学习。"
    ],
    [
     "正在 + 动词",
     "我正在忙。"
    ],
    [
     "你在做什么？",
     "你现在在做什么？"
    ],
    [
     "没在 + 动词",
     "我没在看电视。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「在」放在动词前面。",
    "en": "在 goes before the verb."
   },
   {
    "ko": "「正」强调正在发生。",
    "en": "正 stresses that it is happening right now."
   },
   {
    "ko": "「呢」可以放在句末。",
    "en": "呢 can end the sentence."
   }
  ],
  "examples": [
