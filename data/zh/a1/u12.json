 "grammar": {
  "title": {
   "ko": "喜欢 + 名词 / 动词",
   "en": "Likes: 喜欢 + noun / verb"
  },
  "explain": {
   "ko": "说喜欢什么，用「喜欢 + 名词」：我喜欢音乐。喜欢做某事，用「喜欢 + 动词」：我喜欢游泳。程度更高用「非常喜欢」。否定用「不喜欢」：他不喜欢足球。",
   "en": "Say what you like with 喜欢 + noun: 我喜欢音乐. To like an activity use 喜欢 + verb: 我喜欢游泳. For 'really like' say 非常喜欢. The negative is 不喜欢: 他不喜欢足球。"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "喜欢 + 名词",
     "我喜欢音乐。"
    ],
    [
     "喜欢 + 动词",
     "我喜欢游泳。"
    ],
    [
     "非常喜欢",
     "她非常喜欢电影。"
    ],
    [
     "不喜欢",
     "他不喜欢足球。"
    ],
    [
     "你喜欢……吗？",
     "你喜欢电影吗？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「喜欢」后面可以直接接名词或动词，不需要「的」。",
    "en": "喜欢 takes a noun or verb directly, with no 的."
   },
   {
    "ko": "「我也是」表示「我也喜欢」。",
    "en": "我也是 means 'me too'."
   },
   {
    "ko": "邀请别人：我们一起去吧。",
    "en": "Invite someone with 我们一起去吧。"
   }
  ],
