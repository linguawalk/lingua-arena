 "grammar": {
  "title": {
   "ko": "需要 · 带 · 去 + 地点",
   "en": "Holidays: 需要, 带, 去 + place"
  },
  "explain": {
   "ko": "需要的东西用「需要 + 名词」：我需要护照。带东西用「带 + 名词」：我带相机。请别人带用「请带……」。去地方用「去 + 地点」：我们去海边。戴眼镜用「戴」。",
   "en": "Needs use 需要 + noun: 我需要护照. Bring things with 带: 我带相机. Ask someone to bring with 请带…… Go to places with 去: 我们去海边. Glasses take 戴."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "需要 + 名词",
     "我需要护照。"
    ],
    [
     "带 + 名词",
     "我带相机。"
    ],
    [
     "请带……",
     "请带雨伞。"
    ],
    [
     "去 + 地点",
     "我们去海边。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「需要」比「想要」更正式。",
    "en": "需要 is more formal than 想要."
   },
   {
    "ko": "「带」可以说拿着东西去。",
    "en": "带 means to take along."
   },
   {
    "ko": "雨伞的量词是「把」。",
    "en": "Umbrellas take 把."
   }
  ],
