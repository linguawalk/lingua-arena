 "grammar": {
  "title": {
   "ko": "我想…… · 请给我…… · ……疼 · 一天两次",
   "en": "Bank, post office, pharmacy: 我想……, 请给我……, ……疼"
  },
  "explain": {
   "ko": "想做的事用「我想 + 动词」：我想寄包裹。要东西用「请给我……」。身体不舒服用「……疼」：我头疼。吃药用「一天吃两次」。问价钱用「多少钱？」。",
   "en": "Say what you want with 我想 + verb: 我想寄包裹. Ask for things with 请给我…… Symptoms use ……疼: 我头疼. Medicine: 一天吃两次. Price: 多少钱？"
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "我想 + 动词",
     "我想寄一封信。"
    ],
    [
     "请给我……",
     "请给我两张邮票。"
    ],
    [
     "……疼",
     "我头疼。"
    ],
    [
     "一天……次",
     "一天吃两次。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "「想」后面接动词。",
    "en": "想 is followed by a verb."
   },
   {
    "ko": "信的量词是「封」。",
    "en": "Letters take 封."
   },
   {
    "ko": "「一天两次」说明次数。",
    "en": "一天两次 gives frequency."
   }
  ],
