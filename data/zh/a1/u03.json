 "grammar": {
  "title": {
   "ko": "的 · 有",
   "en": "Possession: 的 and 有"
  },
  "explain": {
   "ko": "汉语用「我的妈妈」这样的结构表示所属：所有者 + 的 + 名词。家人之间常常省略「的」：我妈妈、我爸爸。表示「拥有」用「有」，否定用「没有」。",
   "en": "Chinese shows possession as owner + 的 + noun: 我的妈妈. With close family 的 is often dropped: 我妈妈, 我爸爸. To have something use 有; the negative is 没有."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "我的 + 名词",
     "我的书"
    ],
    [
     "你的 + 名词",
     "你的朋友"
    ],
    [
     "他的 / 她的 + 名词",
     "她的哥哥"
    ],
    [
     "家人: 省略的",
     "我妈妈、我爸爸"
    ],
    [
     "有 / 没有",
     "我有一个姐姐。/ 我没有哥哥。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "家人称呼不用「的」也可以：我妈妈、你爸爸。",
    "en": "With family words 的 can be dropped: 我妈妈, 你爸爸."
   },
   {
    "ko": "数家人用「个」或「口」：我家有四口人。",
    "en": "Count family members with 个 or 口: 我家有四口人。"
   },
   {
    "ko": "「有」的否定是「没有」，不能说「不有」。",
    "en": "The negative of 有 is 没有, never 不有."
   }
  ],
