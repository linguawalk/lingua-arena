 "grammar": {
  "title": {
   "ko": "很高 · 头发 · 眼睛 · 长什么样",
   "en": "Describing people: 很高, 头发, 眼睛, 长什么样"
  },
  "explain": {
   "ko": "描述人用「他 + 很 + 形容词」：他很高。头发和眼睛用「她的头发很长」「他的眼睛是棕色的」。问外貌用「他长什么样？」。形容词前常加「很」。",
   "en": "Describe people with 他 + 很 + adjective: 他很高. For hair and eyes: 她的头发很长, 他的眼睛是棕色的. Ask looks with 他长什么样？ Adjectives usually take 很."
  },
  "table": {
   "head": [
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "他很高",
     "他很高。"
    ],
    [
     "头发很长",
     "她的头发很长。"
    ],
    [
     "眼睛是棕色的",
     "他的眼睛是棕色的。"
    ],
    [
     "长什么样？",
     "她长什么样？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "形容词前常用「很」。",
    "en": "Adjectives usually take 很."
   },
   {
    "ko": "颜色后面常加「的」。",
    "en": "Colours usually take 的."
   },
   {
    "ko": "「帅」只形容男人。",
    "en": "帅 is used for men."
   }
  ],
