 "grammar": {
  "title": {
   "ko": "搭配：做决定、做作业、努力、取得进步、遵守诺言、错过机会",
   "en": "Collocations: 做决定 / 做作业 / 努力 / 取得进步 / 遵守诺言 / 错过机会"
  },
  "explain": {
   "ko": "汉语的名词和动词有固定的搭配。“决定”用“做”，“作业”用“做”，“进步”用“取得”，“诺言”用“遵守”，“机会”用“错过”，“风险”用“冒”，“听讲”用“注意”。形容词也有搭配：交通拥堵、刮大风、下大雨。搭配不对，听起来就不自然，所以要整体记住。",
   "en": "Chinese noun–verb pairs are fixed. 决定 goes with 做, 作业 with 做, 进步 with 取得, 诺言 with 遵守, 机会 with 错过, 风险 with 冒. Adjective partners too: 交通拥堵, 刮大风, 下大雨. Mismatched pairs sound unnatural, so learn them as chunks."
  },
  "table": {
   "head": [
    "名词 / Noun",
    "动词 / Verb",
    "例子 / Example"
   ],
   "rows": [
    [
     "决定",
     "做",
     "他很快做出了决定。"
    ],
    [
     "作业・工作",
     "做",
     "我每天做作业。"
    ],
    [
     "进步・成绩",
     "取得",
     "你取得了很大的进步。"
    ],
    [
     "诺言・机会",
     "遵守・错过",
     "他遵守了诺言。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“遵守诺言”的反义是“违背诺言”。",
    "en": "The opposite of 遵守诺言 is 违背诺言."
   },
   {
    "ko": "“交通”用“拥堵”，“风”用“大”。",
    "en": "交通 pairs with 拥堵 and 风 with 大."
   },
   {
    "ko": "“取得进步”比“有进步”更书面。",
    "en": "取得进步 is more formal than 有进步."
   }
  ],
