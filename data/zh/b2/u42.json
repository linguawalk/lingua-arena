 "grammar": {
  "title": {
   "ko": "学习用语：正在……、要是……就……、掌握、为了",
   "en": "Learning: 正在…… / 要是……就…… / 掌握 / 为了"
  },
  "explain": {
   "ko": "正在做的事用“正在……”：我正在学法语。假设用“要是……就……”：要是有更多时间，我就学做饭。掌握技能用“掌握”，考证用“考”，目标用“为了”：为了五年内拿到资格证，我在学习。也可以说“学无止境”。",
   "en": "Ongoing: 正在……: 我正在学法语. Hypotheticals: 要是……就……: 要是有更多时间，我就学做饭. Skills: 掌握; certificates: 考; goals: 为了: 为了五年内拿到资格证，我在学习. Also 学无止境."
  },
  "table": {
   "head": [
    "用法 / Use",
    "结构 / Form",
    "例子 / Example"
   ],
   "rows": [
    [
     "正在 / Ongoing",
     "正在＋动词",
     "我正在学法语。"
    ],
    [
     "假设 / Hypothetical",
     "要是……就……",
     "要是有时间，我就学做饭。"
    ],
    [
     "技能 / Skill",
     "掌握＋技能",
     "我正在掌握新技能。"
    ],
    [
     "目的 / Goal",
     "为了……",
     "为了考资格证，我在学习。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“要是……就……”表示不一定能实现的假设。",
    "en": "要是……就…… is a hypothesis that may not come true."
   },
   {
    "ko": "“掌握”表示学会并能运用。",
    "en": "掌握 means to master and apply."
   },
   {
    "ko": "“学无止境”表示学习没有尽头。",
    "en": "学无止境 means learning never ends."
   }
  ],
