 "grammar": {
  "title": {
   "ko": "构词：不、非、无、未、再、-性、-化、-者",
   "en": "Word formation: 不 / 非 / 无 / 未 / 再 / -性 / -化 / -者"
  },
  "explain": {
   "ko": "汉语用前缀和后缀构成新词。表示否定的前缀有“不、非、无、未”：可能→不可能，现实→不现实，关心→无关心，成年→未成年。“再”表示重复：再利用、再开始。后缀“性”构成名词（创造性、可能性），“化”表示变成（现代化、绿化），“者”表示人（管理者、读者）。名词加“地”可以变成副词：有效地。",
   "en": "Chinese forms words with prefixes and suffixes. Negation: 不／非／无／未: 可能→不可能, 现实→不现实, 成年→未成年. 再 means again: 再利用. 性 forms nouns of quality (创造性, 可能性), 化 means 'making into' (现代化), 者 means person (管理者). Adding 地 makes adverbs: 有效地."
  },
  "table": {
   "head": [
    "词缀 / Affix",
    "意思 / Meaning",
    "例子 / Example"
   ],
   "rows": [
    [
     "不・非・无・未",
     "否定 / negation",
     "不可能、非正式、无关心、未成年"
    ],
    [
     "再",
     "重复 / again",
     "再利用、再开始"
    ],
    [
     "-性",
     "性质 / quality",
     "创造性、可能性"
    ],
    [
     "-化・-者",
     "变成・人 / become · person",
     "现代化、管理者"
    ]
   ]
  },
  "notes": [
   {
    "ko": "用哪个否定前缀，要靠习惯记忆。",
    "en": "Which negative prefix to use is learned by usage."
   },
   {
    "ko": "“性”“化”“者”都放在词的后面。",
    "en": "性, 化 and 者 all follow the root."
   },
   {
    "ko": "形容词加“地”可以放在动词前面。",
    "en": "地 lets an adjective modify a verb."
   }
  ],
