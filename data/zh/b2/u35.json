 "grammar": {
  "title": {
   "ko": "会议：议程、提议、同意、投票、确定、结束",
   "en": "Meetings: 议程 / 提议 / 同意 / 投票 / 确定 / 结束"
  },
  "explain": {
   "ko": "开会时，主持人先说：“现在开始开会，今天的议程有三项。”提议用“我提议……”，同意用“我们同意……”，决定用“决定……／确定……”：截止日期定在下周五。征求意见用“请大家提出意见”，结束用“今天的会议到此结束”。会议记录用简短的句子，写清楚决定的事。",
   "en": "A chair opens with 现在开始开会，今天的议程有三项. Propose: 我提议……; agree: 我们同意……; decide: 决定／确定……: 截止日期定在下周五. Ask for views with 请大家提出意见; close with 今天的会议到此结束. Minutes use short sentences stating decisions."
  },
  "table": {
   "head": [
    "阶段 / Stage",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "开始 / Opening",
     "现在开始开会",
     "今天的议程有三项。"
    ],
    [
     "提议 / Proposal",
     "我提议……",
     "我提议一个新日程。"
    ],
    [
     "同意 / Agreement",
     "我们同意……",
     "我们同意了预算。"
    ],
    [
     "结束 / Closing",
     "会议到此结束",
     "我们来确认后续工作。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“同意”后面可以直接接名词。",
    "en": "同意 can take a noun directly."
   },
   {
    "ko": "“定在”表示确定时间。",
    "en": "定在 fixes a time."
   },
   {
    "ko": "会议记录里常用“决定”“同意”。",
    "en": "Minutes often use 决定 and 同意."
   }
  ],
