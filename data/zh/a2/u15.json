 "grammar": {
  "title": {
   "ko": "指路：一直走、往左拐、过桥、在……对面",
   "en": "Directions: 一直走 / 往左拐 / 过桥 / 在……对面"
  },
  "explain": {
   "ko": "指路用“往 + 方向 + 动词”：一直往前走，往左拐。“在……”表示在哪儿拐：在下一个红绿灯往左拐。经过地方用“经过”，过桥、过马路用“过”，穿过用“穿过”。“在……对面”表示在马路另一边：公园在马路对面。",
   "en": "Give directions with 往 + direction + verb: 一直往前走, 往左拐. Use 在……to say where to turn: 在下一个红绿灯往左拐. 经过 means 'pass', 过 means 'cross' (a bridge, a road), 穿过 means 'go through'. 在……对面 means across from: 公园在马路对面."
  },
  "table": {
   "head": [
    "说法 / Expression",
    "意思 / Meaning",
    "例子 / Example"
   ],
   "rows": [
    [
     "一直往前走",
     "go straight",
     "一直往前走。"
    ],
    [
     "往左 / 右拐",
     "turn left / right",
     "在红绿灯往左拐。"
    ],
    [
     "过 + 地方",
     "cross",
     "请过桥。"
    ],
    [
     "经过 + 地方",
     "pass",
     "经过银行。"
    ],
    [
     "在……对面",
     "across from",
     "公园在马路对面。"
    ]
   ]
  },
  "notes": [
   {
