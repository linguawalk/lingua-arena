 "grammar": {
  "title": {
   "ko": "附加疑问: ……，是吧？・……，对吧？",
   "en": "Question tags: ……吧？ / ……，对吧？"
  },
  "explain": {
   "ko": "상대의 확인을 구할 때는 문장 끝에 ……吧? / ……，是吧? / ……，对吧?를 붙입니다: 今天天气真好，是吧？你是学生，对吧？ 대답은 是的 / 对 / 不是 / 不对입니다. 부정문에는 他不是学生，对吧?",
   "en": "Ask for confirmation by adding ……吧? / ……，是吧? / ……，对吧?: 今天天气真好，是吧？你是学生，对吧？ Answer 是的 / 对 / 不是 / 不对。 Negative: 他不是学生，对吧?"
  },
  "table": {
   "head": [
    "部分 / Part",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "확인 / Check",
     "……，对吧？",
     "你是学生，对吧？"
    ],
