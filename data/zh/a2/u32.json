 "grammar": {
  "title": {
   "ko": "在医院: ……疼・应该・得",
   "en": "At the doctor's: 应该 and 得"
  },
  "explain": {
   "ko": "증상은 我 + 증상(头疼・咳嗽・发烧)로 말합니다. 조언은 应该(~하는 게 좋다), 의무는 得(~해야 한다), 금지는 别 + 동사입니다: 你应该去看医生。你得在家休息。别吃冷的。",
   "en": "Symptoms: 我头疼 / 咳嗽 / 发烧. Advice: 应该; necessity: 得; prohibition: 别 + verb: 你应该去看医生。你得在家休息。别吃冷的。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "증상 / Symptom",
     "我 + 症状",
     "我头疼。"
    ],
    [
     "조언 / Advice",
     "你应该 + 动词",
     "你应该去看医生。"
    ],
    [
     "의무 / Have to",
     "你得 + 动词",
     "你得在家休息。"
    ],
    [
     "금지 / Don't",
     "别 + 动词",
     "别吃冷的。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "疼은 신체 부위 뒤에 붙입니다: 头疼, 肚子疼.",
    "en": "疼 follows the body part: 头疼, 肚子疼."
   },
   {
    "ko": "一天两次: 하루 두 번.",
    "en": "一天两次 = twice a day."
   }
  ],
