 "grammar": {
  "title": {
   "ko": "喜欢・想・打算 + 动词",
   "en": "Liking and wanting: 喜欢 / 想 / 打算 + verb"
  },
  "explain": {
   "ko": "좋아하는 것은 喜欢 + 동사, 하고 싶은 것은 想 + 동사, 계획은 打算 + 동사, 결심은 决定 + 동사로 말합니다. 중국어는 동사 뒤에 -ing 형이 따로 없습니다: 我喜欢做饭。我想去旅行。我打算明年搬家。",
   "en": "Liking: 喜欢 + verb; wanting: 想 + verb; planning: 打算 + verb; deciding: 决定 + verb. No -ing form is needed: 我喜欢做饭。我想去旅行。我打算明年搬家。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "좋아함 / Like",
     "喜欢 + 动词",
     "我喜欢做饭。"
    ],
    [
     "싫어함 / Dislike",
     "讨厌 + 动词",
     "我讨厌早起。"
    ],
    [
     "바람 / Want",
     "想 + 动词",
     "我想去旅行。"
    ],
    [
     "계획 / Plan",
     "打算 + 动词",
     "我打算明年搬家。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "喜欢 뒤의 동사에는 了를 붙이지 않습니다.",
    "en": "Do not add 了 after 喜欢."
   },
   {
    "ko": "打算은 想보다 구체적인 계획입니다.",
    "en": "打算 is more concrete than 想."
   }
  ],
