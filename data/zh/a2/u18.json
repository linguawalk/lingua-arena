 "grammar": {
  "title": {
   "ko": "经历：动词 + 过、没……过；已经、还没、刚",
   "en": "Experience: verb + 过 / 没……过; 已经 / 还没 / 刚"
  },
  "explain": {
   "ko": "说过去有过的经历，在动词后加“过”：你去过巴黎吗？没有的话用“没……过”：我没吃过寿司。说次数，放在“过”后面：他去过两次日本。“已经……了”表示做完了：我已经看了那部电影。“还没……”表示还没做：我还没吃午饭。“刚”表示刚才：我刚到。",
   "en": "Talk about experience with verb + 过: 你去过巴黎吗？ The negative is 没……过: 我没吃过寿司。 Put the count after 过: 他去过两次日本。 已经……了 means 'already': 我已经看了那部电影。 还没…… means 'not yet': 我还没吃午饭。 刚 means 'just': 我刚到。"
  },
  "table": {
   "head": [
    "结构 / Form",
    "意思 / Meaning",
    "例子 / Example"
   ],
   "rows": [
    [
     "动词 + 过",
     "有过经历",
     "我去过巴黎。"
    ],
    [
     "没 + 动词 + 过",
     "没有经历",
     "我没吃过寿司。"
    ],
    [
     "动词 + 过 + 次数",
     "几次",
     "他去过两次日本。"
    ],
    [
     "已经……了",
     "已经",
     "我已经看了那部电影。"
    ],
    [
     "还没……",
     "还没",
     "我还没吃午饭。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“过”表示以前有过这种经历，不说具体时间。",
    "en": "过 shows you have had the experience, without a specific time."
   },
   {
    "ko": "次数放在动词后面：去过两次。",
    "en": "Put the count after the verb: 去过两次。"
   },
   {
    "ko": "“刚……”表示刚刚发生：我刚到。",
    "en": "刚…… means 'just': 我刚到。"
   }
  ],
