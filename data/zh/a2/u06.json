 "grammar": {
  "title": {
   "ko": "会 + 动词、我来……吧、要我……吗？",
   "en": "Predictions and offers: 会 / 我来……吧 / 要我……吗？"
  },
  "explain": {
   "ko": "预测用“会 + 动词”：明天会很热。否定用“不会”：他不会来。不太确定时加“可能”：他可能会迟到。主动帮忙用“我来……”：我来帮你。询问对方需要不需要，用“要我……吗？”：要我开门吗？答应别人用“答应”：我答应你，不会迟到。",
   "en": "Predict with 会 + verb: 明天会很热. The negative is 不会: 他不会来. Add 可能 when unsure: 他可能会迟到. Offer help with 我来……: 我来帮你. Ask whether help is wanted with 要我……吗？: 要我开门吗？ Promise with 答应: 我答应你，不会迟到。"
  },
  "table": {
   "head": [
    "结构 / Form",
    "说明 / Meaning",
    "例子 / Example"
   ],
   "rows": [
    [
     "会 + 动词",
     "预测",
     "明天会很热。"
    ],
    [
     "不会 + 动词",
     "否定的预测",
     "他不会来。"
    ],
    [
     "可能 + 会",
     "不确定",
     "他可能会迟到。"
    ],
    [
     "我来 + 动词",
     "主动帮忙",
     "我来帮你。"
    ],
    [
     "要我……吗？",
     "问要不要帮忙",
     "要我开门吗？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“会”表示将来可能发生的事，也可以表示“学会了”，这里只学将来的意思。",
    "en": "会 here means 'will'; it can also mean 'know how to'."
   },
   {
    "ko": "对朋友可以加“吧”：我来吧。",
    "en": "With friends you can add 吧: 我来吧。"
   },
   {
    "ko": "“我觉得……”表示自己的看法。",
    "en": "我觉得…… gives your own opinion."
   }
  ],
  "examples": [
