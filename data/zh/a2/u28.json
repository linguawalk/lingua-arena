 "grammar": {
  "title": {
   "ko": "几个・一点儿・很多",
   "en": "A few, a little, a lot of: 几个 / 一点儿 / 很多"
  },
  "explain": {
   "ko": "셀 수 있는 것은 几个(몇 개) · 很多 · 不多, 셀 수 없는 것은 一点儿(조금) · 很多 · 没多少로 말합니다: 我有几个朋友。我喝一点儿牛奶。我没有多少时间。 질문은 多少 / 几 입니다.",
   "en": "Countable: 几个, 很多, 不多. Uncountable: 一点儿, 很多, 没多少: 我有几个朋友。我喝一点儿牛奶。我没有多少时间。 Ask 多少 / 几。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "몇 개 / A few",
     "几个 + 名词",
     "我有几个朋友。"
    ],
    [
     "조금 / A little",
     "一点儿 + 名词",
     "我喝一点儿牛奶。"
    ],
    [
     "많이 / A lot of",
     "很多 + 名词",
     "他有很多书。"
    ],
    [
     "별로 / Not many, not much",
     "不多・没多少",
     "我没有多少时间。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "几 + 양사: 几个, 几本.",
    "en": "几 takes a measure word: 几个, 几本."
   },
   {
    "ko": "一点儿은 양사 없이 명사 앞에 씁니다.",
    "en": "一点儿 goes straight before the noun."
   }
  ],
