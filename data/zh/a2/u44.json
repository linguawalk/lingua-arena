 "grammar": {
  "title": {
   "ko": "程度和方式: 很・挺・太・……得……",
   "en": "Adverbs: 很 / 挺 / 太 / 得"
  },
  "explain": {
   "ko": "정도는 很(매우) · 挺(꽤) · 真(정말) · 太(너무)를 형용사 앞에 두고, 동작의 방식은 동사 + 得 + 형용사로 말합니다: 这部电影很有意思。考试挺难的。他跑得快。她英语说得好。 命令은 开车要小心입니다.",
   "en": "Degree words go before the adjective: 很, 挺 (fairly), 真, 太. Manner: verb + 得 + adjective: 他跑得快。她英语说得好。 Advice: 开车要小心。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "정도 / Degree",
     "很・挺・真・太 + 形容词",
     "考试挺难的。"
    ],
    [
     "방식 / Manner",
     "动词 + 得 + 形容词",
     "他跑得快。"
    ],
    [
     "능숙 / Skill",
     "语言 + 说得好",
     "她英语说得好。"
    ],
    [
     "당부 / Advice",
     "……要小心",
     "开车要小心。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "得 뒤에 정도를 나타내는 말이 옵니다.",
    "en": "After 得 comes the description of how."
   },
   {
    "ko": "목적어가 있으면 동사를 되풀이합니다: 她说英语说得好.",
    "en": "With an object, repeat the verb: 她说英语说得好."
   }
  ],
