 "grammar": {
  "title": {
   "ko": "会 / 能 / 可以 / 得 / 不能 / 不用",
   "en": "会 / 能 / 可以 / 得 / 不能 / 不用"
  },
  "explain": {
   "ko": "学会的本领用“会”：我会游泳。有条件、有能力用“能”。允许用“可以”：这里可以拍照。必须做的事用“必须”或“得”：我明天得早起。禁止用“不能”：这里不能抽烟。不需要做用“不用”：星期天不用工作。问是否允许：我可以……吗？",
   "en": "A learned skill is 会: 我会游泳. 能 is for ability under conditions. Permission is 可以: 这里可以拍照. Obligation is 必须 or 得: 我明天得早起. Prohibition is 不能: 这里不能抽烟. 'Not necessary' is 不用: 星期天不用工作. Ask permission with 我可以……吗？"
  },
  "table": {
   "head": [
    "说法 / Pattern",
    "意思 / Meaning",
    "例子 / Example"
   ],
   "rows": [
    [
     "会 + 动词",
     "能力",
     "我会游泳。"
    ],
    [
     "必须 / 得 + 动词",
     "义务",
     "我们必须保持安静。"
    ],
    [
     "不能 + 动词",
     "禁止",
     "这里不能抽烟。"
    ],
    [
     "可以 + 动词",
     "允许",
     "这里可以拍照。"
    ],
    [
     "不用 + 动词",
     "不需要",
     "星期天不用工作。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“不能”和“不用”意思完全不同。",
    "en": "「不能」 and 「不用」 mean very different things."
   },
   {
    "ko": "问可以不可以，用“可以……吗？”",
    "en": "Ask permission with 可以……吗？"
   },
   {
    "ko": "过去的能力用“小时候会……”或“以前会……”。",
    "en": "Past ability: 小时候会……, 以前会……"
   }
  ],
