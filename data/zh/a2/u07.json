 "grammar": {
  "title": {
   "ko": "正在做：在 + 动词、动词 + 着",
   "en": "Happening now: 在 + verb / verb + 着"
  },
  "explain": {
   "ko": "说现在正在做的事，在动词前加“在”或“正在”：我现在在工作。身体或衣服的状态用“动词 + 着”：她穿着红外套，她坐着。否定用“没在”：他们没在看电视。问现在在做什么：你现在在做什么？",
   "en": "To say what is happening now put 在 or 正在 before the verb: 我现在在工作. For a state of body or clothing use verb + 着: 她穿着红外套. The negative is 没在: 他们没在看电视. Ask: 你现在在做什么？"
  },
  "table": {
   "head": [
    "结构 / Form",
    "说明 / Meaning",
    "例子 / Example"
   ],
   "rows": [
    [
     "在 + 动词",
     "正在做",
     "我现在在工作。"
    ],
    [
     "正在 + 动词",
     "正在做（强调）",
     "我正在写邮件。"
    ],
    [
     "动词 + 着",
     "状态",
     "她穿着红外套。"
    ],
    [
     "没在 + 动词",
     "否定",
     "他们没在看电视。"
    ],
    [
     "在做什么？",
     "问现在",
     "你现在在做什么？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "表示现在的词：现在、正在、此刻。",
    "en": "Words for now: 现在, 正在, 此刻."
   },
   {
    "ko": "穿衣服、戴帽子、穿鞋用不同的动词：穿、戴、穿。",
    "en": "Clothing verbs differ: 穿 for clothes and shoes, 戴 for hats."
   },
   {
    "ko": "对朋友可以加“呢”：我在看电视呢。",
    "en": "With friends add 呢: 我在看电视呢。"
   }
  ],
