 "grammar": {
  "title": {
   "ko": "频率和方式：总是、经常、有时、从不；动词 + 得 + 形容词",
   "en": "Frequency and manner: 总是 / 经常 / 有时 / 从不; verb + 得 + adjective"
  },
  "explain": {
   "ko": "说多久做一次，用频率副词，放在动词前：总是 > 通常 > 经常 > 有时 > 从不。“从不”后面不再加“不”。说做得怎么样，用“动词 + 得 + 形容词”：她英语说得很好。有宾语时重复动词：我唱歌唱得不好。请别人改变方式：请说慢一点。",
   "en": "Frequency adverbs go before the verb: 总是 > 通常 > 经常 > 有时 > 从不. 从不 already negates; do not add 不. To say how well something is done use verb + 得 + adjective: 她英语说得很好. With an object repeat the verb: 我唱歌唱得不好. Ask for a change of manner with 请……一点: 请说慢一点。"
  },
  "table": {
   "head": [
    "类型 / Type",
    "副词 / Adverb",
    "例子 / Example"
   ],
   "rows": [
    [
     "频率 100%",
     "总是",
     "我总是吃早饭。"
    ],
    [
     "频率 80%",
     "通常 / 经常",
     "我们经常看电影。"
    ],
    [
     "频率 30%",
     "有时",
     "我有时走路上班。"
    ],
    [
     "频率 0%",
     "从不",
     "他从不喝咖啡。"
    ],
    [
     "方式",
     "动词 + 得 + 形容词",
     "她英语说得很好。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "频率副词一般放在动词前面。",
    "en": "Frequency adverbs usually go before the verb."
   },
   {
    "ko": "“好”表示做得好，“不好”表示做得不好。",
    "en": "好 means done well; 不好 means done poorly."
   },
   {
    "ko": "“一点”表示请求变化：慢一点、快一点。",
    "en": "一点 asks for a change: 慢一点, 快一点."
   }
  ],
