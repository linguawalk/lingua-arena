 "grammar": {
  "title": {
   "ko": "太……了・够・不够",
   "en": "Too and enough: 太……了 / 够 / 不够"
  },
  "explain": {
   "ko": "지나친 정도는 太 + 형용사 + 了(너무 ~하다), 충분함은 够 + 형용사 / 足够的 + 명사, 부족함은 不够로 말합니다: 太烫了。够大。钱不够。 비교는 和……一样입니다.",
   "en": "Too: 太 + adjective + 了: 太烫了。 Enough: 够 + adjective / 足够的 + noun; not enough: 不够: 够大。钱不够。 Compare with 和……一样。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "너무 / Too",
     "太 + 形容词 + 了",
     "这杯咖啡太烫了。"
    ],
    [
     "충분 / Enough",
     "够 + 形容词",
     "这个房间够大。"
    ],
    [
     "부족 / Not enough",
     "……不够",
     "我的钱不够。"
    ],
    [
     "같음 / As ... as",
     "和……一样",
     "这个包和那个一样贵。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "太……了는 부정적인 느낌으로 자주 쓰입니다.",
    "en": "太……了 often sounds negative."
   },
   {
    "ko": "太 뒤에는 보통 了가 따라옵니다.",
    "en": "太 is usually followed by 了."
   }
  ],
