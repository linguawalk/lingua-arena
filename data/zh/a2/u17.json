 "grammar": {
  "title": {
   "ko": "邀请和约定：有空吗？想……吗？……吧",
   "en": "Arrangements: 有空吗？ / 想……吗？ / ……吧"
  },
  "explain": {
   "ko": "问对方有没有时间，用“你有空吗？”：星期六你有空吗？邀请用“你想……吗？”：你想去看电影吗？提议一起做，用“……吧”：我们去喝咖啡吧。已经约好的事用“明天见朋友”这样的现在式。拒绝时说“可惜……”：可惜星期六我不能去。",
   "en": "Ask about availability with 你有空吗？: 星期六你有空吗？ Invite with 你想……吗？: 你想去看电影吗？ Suggest doing something together with ……吧: 我们去喝咖啡吧。 Arranged plans use plain verbs: 明天见朋友。 Decline with 可惜……: 可惜星期六我不能去。"
  },
  "table": {
   "head": [
    "说法 / Pattern",
    "意思 / Meaning",
    "例子 / Example"
   ],
   "rows": [
    [
     "你有空吗？",
