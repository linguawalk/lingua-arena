 "grammar": {
  "title": {
   "ko": "比较：A 比 B + 形容词、更、没有",
   "en": "Comparison: A 比 B + adjective / 更 / 没有"
  },
  "explain": {
   "ko": "比较两个东西，用“A 比 B + 形容词”：火车比飞机便宜。形容词前不能用“很”，可以用“更”：这家酒店比那家更好。说差别多少，放在形容词后面：我哥哥比我大两岁。否定用“A 没有 B + 形容词”：火车没有飞机快。",
   "en": "Compare two things with A 比 B + adjective: 火车比飞机便宜. Do not use 很 before the adjective; 更 is fine: 这家酒店比那家更好. Put the difference after the adjective: 我哥哥比我大两岁. The negative is A 没有 B + adjective: 火车没有飞机快."
  },
  "table": {
   "head": [
    "结构 / Form",
    "说明 / Meaning",
    "例子 / Example"
   ],
   "rows": [
    [
     "A 比 B + 形容词",
     "比较",
     "我的房间比你的房间大。"
    ],
    [
     "A 比 B + 更 + 形容词",
     "更……",
     "这家酒店比那家更好。"
    ],
    [
     "A 比 B + 形容词 + 数量",
     "差多少",
     "我哥哥比我大两岁。"
    ],
    [
     "A 没有 B + 形容词",
     "不如",
     "火车没有飞机快。"
    ],
    [
     "哪个更……？",
     "问哪个",
     "哪个更便宜？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "汉语的形容词比较时不变形：大 → 比……大。",
    "en": "Chinese adjectives do not change in comparisons: 大 → 比……大."
   },
   {
    "ko": "“比”前面是主语，后面是比较的对象。",
    "en": "Put the subject before 比 and the thing compared after it."
   },
   {
    "ko": "问两个中哪个，用“哪个更……？”",
    "en": "Ask which of two with 哪个更……？"
   }
  ],
