 "grammar": {
  "title": {
   "ko": "旅行的动作: 入住・上车・下车",
   "en": "Phrasal verbs for travel"
  },
  "explain": {
   "ko": "여행 동작은 办理入住, 退房, 上车, 下车, 出发, 换乘로 말합니다. 탈것은 上・下 + 车로, 장소는 在……下车 / 换乘로 말합니다: 我上了公共汽车。请在下一站下车。",
   "en": "Travel actions: 办理入住, 退房, 上车, 下车, 出发, 换乘. Get on / off: 上车 / 下车; place: 在……下车 / 换乘: 我上了公共汽车。请在下一站下车。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "타다 / Get on",
     "上车",
     "我上了公共汽车。"
    ],
    [
     "내리다 / Get off",
     "在……下车",
     "请在下一站下车。"
    ],
    [
     "출발 / Set off",
     "……点出发",
     "我们一早就出发了。"
    ],
    [
     "환승 / Change",
     "在……换乘",
     "请在首尔站换乘。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "기차나 비행기는 坐를 써서 말합니다: 坐火车.",
    "en": "For trains and planes use 坐: 坐火车."
   },
   {
    "ko": "下车는 장소 앞에 在를 둡니다.",
    "en": "Put 在 before the place with 下车."
   }
  ],
