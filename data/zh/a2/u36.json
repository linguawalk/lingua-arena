 "grammar": {
  "title": {
   "ko": "礼貌的请求: 能……吗・可以……吗・请",
   "en": "Polite requests: 能……吗 / 可以……吗 / 请"
  },
  "explain": {
   "ko": "정중한 부탁은 请 + 동사, 你能……吗?, 你可以……吗?로, 허락을 구할 때는 我可以……吗?로 말합니다. 승낙은 当然可以, 거절은 恐怕不行 / 对不起，不行으로 합니다: 请再说一遍。我可以借你的笔吗？恐怕不行。",
   "en": "Polite requests: 请 + verb, 你能……吗?; asking permission: 我可以……吗? Agree: 当然可以。 Decline: 恐怕不行 / 对不起，不行: 请再说一遍。我可以借你的笔吗？恐怕不行。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "부탁 / Request",
     "请 + 动词",
     "请再说一遍。"
    ],
    [
     "정중한 부탁 / Polite request",
     "你能……吗？",
     "你能帮我一下吗？"
    ],
    [
     "허락 / Permission",
     "我可以……吗？",
     "我可以借你的笔吗？"
    ],
    [
     "승낙·거절 / Yes, no",
     "当然可以・恐怕不行",
     "恐怕不行。"
    ]
   ]
  },
  "notes": [
   {
    "ko": "请은 문장 앞에 붙입니다.",
    "en": "请 goes at the start."
   },
   {
    "ko": "거절은 对不起나 恐怕로 부드럽게 합니다.",
    "en": "Soften a refusal with 对不起 or 恐怕."
   }
  ],
