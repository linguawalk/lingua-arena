 "grammar": {
  "title": {
   "ko": "已经・还没・刚",
   "en": "Already, yet and just: 已经 / 还没 / 刚"
  },
  "explain": {
   "ko": "已经……了(이미 ~했다), 还没(有)……(아직 ~하지 않았다), 刚……(막 ~했다)로 말합니다: 我已经做完作业了。我还没吃午饭。他刚到。 질문은 ……了吗? / ……了没有?, 대답은 是的，已经……了 / 还没有입니다.",
   "en": "已经……了 = already, 还没(有)…… = not yet, 刚…… = just: 我已经做完作业了。我还没吃午饭。他刚到。 Ask ……了吗? / ……了没有?; answer 已经……了 / 还没有。"
  },
  "table": {
   "head": [
    "部分 / Part",
    "说法 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "이미 / Already",
     "已经……了",
     "我已经做完作业了。"
    ],
    [
     "아직 / Not yet",
     "还没(有)……",
     "我还没吃午饭。"
    ],
    [
     "막 / Just",
     "刚……",
     "他刚到。"
    ],
    [
     "질문 / Question",
     "……了没有？",
     "你买票了没有？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "还没有로 간단히 대답할 수 있습니다.",
    "en": "You can answer simply 还没有。"
   },
   {
    "ko": "刚 뒤에는 了를 붙이지 않는 것이 보통입니다.",
    "en": "刚 usually does not take 了."
   }
  ],
