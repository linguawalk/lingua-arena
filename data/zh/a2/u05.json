 "grammar": {
  "title": {
   "ko": "计划：打算 + 动词、不打算、要……了",
   "en": "Plans: 打算 + verb / 不打算 / 要……了"
  },
  "explain": {
   "ko": "说计划，用“打算 + 动词”：我明天打算工作。否定用“不打算”：他们不打算旅行。很快就要发生的事用“要……了”：马上要下雨了。还没决定时，用“可能”：可能我们去海边。时间词放在句子前面：明天、今晚、下个星期。",
   "en": "State plans with 打算 + verb: 我明天打算工作. The negative is 不打算: 他们不打算旅行. Use 要……了 for something about to happen: 马上要下雨了. When undecided use 可能: 可能我们去海边. Put time words early: 明天, 今晚, 下个星期."
  },
  "table": {
   "head": [
    "结构 / Form",
    "说明 / Meaning",
    "例子 / Example"
   ],
   "rows": [
    [
     "打算 + 动词",
     "计划",
     "我明天打算工作。"
    ],
    [
     "不打算 + 动词",
     "不计划",
     "他们不打算旅行。"
    ],
    [
     "要……了",
     "马上发生",
     "马上要下雨了。"
    ],
    [
     "可能 + 动词",
     "还没决定",
     "可能我们去海边。"
    ],
    [
     "你打算做什么？",
     "问计划",
     "明天你打算做什么？"
    ]
   ]
  },
  "notes": [
   {
    "ko": "表示将来的时间词：明天、今晚、下个星期、马上。",
    "en": "Future time words: 明天, 今晚, 下个星期, 马上."
   },
   {
    "ko": "“还没……”表示现在还没做：我还没决定。",
    "en": "「还没……」 means 'not yet': 我还没决定。"
   },
   {
    "ko": "“打算”表示自己的想法，不一定已经决定。",
    "en": "打算 states your own intention."
   }
  ],
