 "grammar": {
  "title": {
   "ko": "개사 총정리: 在・从・到・对・向・取决于・期待",
   "en": "Preposition review: 在 / 从 / 到 / 对 / 向 / 取决于"
  },
  "explain": {
   "ko": "时间用“在”“从……到……”：星期一早上九点。地点用“在”：在办公室见面。截止时间用“……以前”：星期五以前交报告。取决于：结果取决于天气。期待：我期待周末的到来。擅长：他擅长数学。参加：我参加了马拉松。",
   "en": "Time: 在 / 从……到……. Place: 在. Deadline: ……以前. Depends: 取决于. Look forward: 期待. Good at: 擅长. Take part: 参加."
  },
  "table": {
   "head": [
    "구조 / 结构",
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "시간 / 时间",
     "在……・从……到……",
     "星期一早上九点"
    ],
    [
     "장소 / 地点",
     "在……",
     "在办公室见面"
    ],
    [
     "기한 / 期限",
     "……以前",
     "星期五以前交"
    ],
    [
     "의존 / 取决于",
     "取决于……",
     "取决于天气"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“从……到……”表示一段时间或距离。",
    "en": "从……到…… marks a span of time or distance."
   },
   {
    "ko": "“擅长”后面接动词或名词。",
    "en": "擅长 is followed by a verb or noun."
   },
   {
    "ko": "“参加”用于活动和比赛。",
    "en": "参加 is used for events and competitions."
   }
  ],
