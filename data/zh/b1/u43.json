 "grammar": {
  "title": {
   "ko": "감정 표현: 觉得……・对……感兴趣・令人……",
   "en": "Expressing feelings: 觉得…… / 对……感兴趣 / 令人……"
  },
  "explain": {
   "ko": "说自己的感受，用“觉得……”“感到……”：我觉得很无聊。说对象的特点，用形容词：那部电影很无聊。说兴趣，用“对……感兴趣”。说原因，用“……让我……”：结果让我很吃惊。令人……表示使人产生某种感受：结果令人吃惊。",
   "en": "Own feelings: 觉得…… / 感到……. Qualities of things: adjectives: 那部电影很无聊. Interest: 对……感兴趣. Cause: ……让我……. 令人…… means 'makes people feel…'."
  },
  "table": {
   "head": [
    "구조 / 结构",
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "감정 / 感受",
     "觉得……",
     "觉得很无聊"
    ],
    [
     "성질 / 性质",
     "……很有意思",
     "历史很有意思"
    ],
    [
     "흥미 / 兴趣",
     "对……感兴趣",
     "对历史感兴趣"
    ],
    [
     "놀람 / 吃惊",
     "令人吃惊",
     "结果令人吃惊"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“对”引出感兴趣的对象。",
    "en": "对 introduces the object of interest."
   },
   {
    "ko": "“令人……”多用于书面语。",
    "en": "令人…… is mostly written."
   },
   {
    "ko": "“很”可以放在形容词前面。",
    "en": "很 can precede adjectives."
   }
  ],
