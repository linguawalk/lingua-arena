 "grammar": {
  "title": {
   "ko": "단어 만들기: 不・无・重・……性・……者・……化",
   "en": "Word formation: 不 / 无 / 重 / ……性 / ……者"
  },
  "explain": {
   "ko": "汉语里有很多前缀和后缀。“不”“无”表示否定：幸福→不幸福，责任→无责任。“重”表示再一次：重做。“……性”“……化”“……者”构成名词：安全→安全性，现代→现代化，学习→学习者。知道这些规律就可以猜出生词的意思。",
   "en": "Chinese has many prefixes and suffixes. 不 / 无 are negative: 不幸福, 无助. 重 means again: 重做. ……性 / ……化 / ……者 make nouns: 安全性, 现代化, 学习者. These rules help you guess new words."
  },
  "table": {
   "head": [
    "구조 / 结构",
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "부정 / 否定",
     "不・无",
     "不幸福・无助"
    ],
    [
     "다시 / 再次",
     "重……",
     "重做"
    ],
    [
     "명사 / 名词",
     "……性・……化",
     "安全性・现代化"
    ],
    [
     "사람 / 人",
     "……者",
     "学习者"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“无”常用于书面语。",
    "en": "无 is mostly used in writing."
   },
   {
    "ko": "“重”读 chóng 时表示重复。",
    "en": "重 pronounced chóng means to repeat."
   },
   {
    "ko": "“……者”表示做某事的人。",
    "en": "……者 means a person who does something."
   }
  ],
