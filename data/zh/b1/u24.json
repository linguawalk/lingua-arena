 "grammar": {
  "title": {
   "ko": "과거의 후회와 추측: 本来应该・本来可以・可能……了・一定……了・不可能",
   "en": "Regret and guesses about the past: 本来应该 / 一定……了 / 不可能"
  },
  "explain": {
   "ko": "对没做的事感到后悔，用“本来应该……”：我本来应该早点出发的。过去本来可以做的事，用“本来可以……”：你本来可以给我打电话的。对过去的推测：“可能……了”表示不太肯定，“一定……了”表示很肯定，“不可能……”表示没有可能：他不可能说谎。",
   "en": "Regret: 本来应该……. Missed possibility: 本来可以……. Guesses about the past: 可能……了 (maybe), 一定……了 (surely), 不可能…… (impossible)."
  },
  "table": {
   "head": [
    "구조 / 结构",
    "表达 / Expression",
    "例子 / Example"
   ],
   "rows": [
    [
     "후회 / 后悔",
     "本来应该……",
     "本来应该早点出发"
    ],
    [
     "가능 / 可能",
     "本来可以……",
     "本来可以给我打电话"
    ],
    [
     "추측 / 推测",
     "可能……了",
     "他可能迷路了"
    ],
    [
     "확신 / 肯定",
     "一定……了",
     "她一定很累了"
    ]
   ]
  },
  "notes": [
   {
    "ko": "“本来……”说明实际上没有这样做。",
    "en": "本来…… implies it was not actually done."
   },
   {
    "ko": "“不可能”表示强烈的否定推测。",
    "en": "不可能 is a strong negative guess."
   },
   {
    "ko": "“可能”用于不太肯定的时候。",
    "en": "可能 is for uncertainty."
   }
  ],
