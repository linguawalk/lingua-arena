  "context": {
    "explanation_en": "说习惯的频率用「常常」「有时候」「从不」。",
    "explanation_ko": "습관의 빈도를 말할 때는 '常常'(자주), '有时候'(가끔), '从不'(전혀 안)를 씁니다.",
    "key_expressions": [
      {
        "en": "我常常吃早饭。",
        "ko": "저는 자주 아침을 먹어요."
      },
      {
        "en": "我有时候迟到。",
        "ko": "저는 가끔 지각해요."
      },
      {
        "en": "我从不抽烟。",
        "ko": "저는 전혀 담배를 안 피워요."
      }
    ]
  },
