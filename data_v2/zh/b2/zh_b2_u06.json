  "context": {
    "explanation_en": "「于是」表示紧接着发生的事，强调时间顺序。「他很累，于是决定休息一下」。",
    "explanation_ko": "'于是'는 바로 이어서 일어난 일을 나타내며, 시간 순서를 강조합니다. '他很累，于是决定休息一下'(그는 피곤해서, 그래서 잠시 쉬기로 결정했어요).",
    "key_expressions": [
      {
        "en": "他很累，于是决定休息一下。",
        "ko": "그는 피곤해서, 그래서 잠시 쉬기로 결정했어요."
      },
      {
        "en": "下雨了，于是我们取消了计划。",
        "ko": "비가 와서, 그래서 계획을 취소했어요."
      },
      {
        "en": "我不知道路，于是问了路人。",
        "ko": "길을 몰라서, 그래서 행인에게 물어봤어요."
      }
    ]
  },
