    "key_expressions": [
      {
        "en": "反正我已经决定了。",
        "ko": "어차피 저는 이미 결정했어요."
      },
      {
        "en": "反正明天不上班，晚点睡也没关系。",
        "ko": "어차피 내일 출근 안 하니까 늦게 자도 괜찮아요."
      },
      {
        "en": "反正他不会听我的。",
        "ko": "어차피 그는 제 말을 안 들을 거예요."
      }
    ]
  },
