  "context": {
    "explanation_en": "「一...就...」表示一件事发生后立刻发生另一件事。「我一到家就睡觉了」。",
    "explanation_ko": "'一...就...'는 한 가지 일이 일어난 후 바로 다른 일이 일어남을 나타냅니다. '我一到家就睡觉了'(집에 도착하자마자 잤어요).",
    "key_expressions": [
      {
        "en": "我一到家就睡觉了。",
        "ko": "집에 도착하자마자 잤어요."
      },
      {
        "en": "他一看到我就笑了。",
        "ko": "그는 저를 보자마자 웃었어요."
      },
      {
        "en": "一下课，学生就走了。",
        "ko": "수업이 끝나자마자 학생들이 갔어요."
      }
    ]
  },
