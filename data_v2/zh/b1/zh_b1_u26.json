  "context": {
    "explanation_en": "「无论...都...」表示条件如何变化，结果都不变。「无论多忙，我都会锻炼」。",
    "explanation_ko": "'无论...都...'는 조건이 어떻게 변하든 결과가 변하지 않음을 나타냅니다. '无论多忙，我都会锻炼'(아무리 바빠도 운동해요).",
    "key_expressions": [
      {
        "en": "无论多忙，我都会锻炼。",
        "ko": "아무리 바빠도 운동해요."
      },
      {
        "en": "无论天气怎么样，我们都去。",
        "ko": "날씨가 어떻든 우리는 가요."
      },
      {
        "en": "无论谁说，我都不听。",
        "ko": "누가 말하든 저는 안 들어요."
      }
    ]
  },
