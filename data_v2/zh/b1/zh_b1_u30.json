    "key_expressions": [
      {
        "en": "由于天气不好，比赛取消了。",
        "ko": "날씨가 안 좋아서 경기가 취소됐어요."
      },
      {
        "en": "由于交通堵塞，我迟到了。",
        "ko": "교통 정체로 인해 지각했어요."
      },
      {
        "en": "由于疫情，很多活动取消了。",
        "ko": "전염병으로 인해 많은 행사가 취소됐어요."
      }
    ]
  },
