  "context": {
    "explanation_en": "To report what someone said, use « -다고 해요 » (they say that ~). For example, « 내일 비가 온다고 해요 » (They say it will rain tomorrow).",
    "explanation_ko": "누군가가 한 말을 전달할 때는 '-다고 해요'를 씁니다. 예: '내일 비가 온다고 해요'.",
    "key_expressions": [
      {
        "en": "They say it will rain tomorrow.",
        "ko": "내일 비가 온다고 해요."
      },
      {
        "en": "She said she's busy.",
        "ko": "그녀는 바쁘다고 해요."
      },
      {
        "en": "He said he already ate.",
        "ko": "그는 이미 먹었다고 해요."
      }
    ]
  },
