      "id": "ko_b1_u05_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a sentence with a present-tense relative clause using «-는» + noun.",
        "ko": "'-는' + 명사를 사용해서 현재 관형형 문장을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "neun_modifier",
          "label_ko": "관형형 -는",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "Did you use a verb ending in '는' before a noun?",
          "type": "pattern_regex",
          "target": "는\\s*\\S+",
