  "context": {
    "explanation_en": "« -는 대로 » means as soon as ~ or exactly as ~. For example, « 도착하는 대로 전화할게요 » (I'll call as soon as I arrive).",
    "explanation_ko": "'-는 대로'는 '~하자마자' 또는 '~한 그대로'를 의미합니다. 예: '도착하는 대로 전화할게요'.",
    "key_expressions": [
      {
        "en": "I'll call as soon as I arrive.",
        "ko": "도착하는 대로 전화할게요."
      },
      {
        "en": "Please do it exactly as I said.",
        "ko": "제가 말하는 대로 해 주세요."
      },
      {
        "en": "I'll let you know as soon as I find out.",
        "ko": "알게 되는 대로 알려드릴게요."
      }
    ]
  },
