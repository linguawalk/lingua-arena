      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write at least five sentences about your Korean grammar learning progress, including a conditional with «-으면», a causative with «-게 하다», and a guess with «-나 보다» or «-기 마련이다».",
        "ko": "조건 '-으면', 사동 '-게 하다', 추측 '-나 보다' 또는 '-기 마련이다'를 포함해서 한국어 문법 학습 발전에 대해 다섯 문장 이상 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "b1_review",
          "label_ko": "B1 문법 종합",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "Did you use '으면' or '면' (if)?",
