  "context": {
    "explanation_en": "« -되 » is a formal way to concede a point while adding a condition (though ~, ~). For example, « 좋되 조건이 있어요 » (It's good, but there's a condition).",
    "explanation_ko": "'-되'는 한 점을 인정하면서 조건을 더하는 격식 있는 방법입니다(~하되). 예: '좋되 조건이 있어요'.",
    "key_expressions": [
      {
        "en": "It's good, but there's a condition.",
        "ko": "좋되 조건이 있어요."
      },
      {
        "en": "You may go, but come back early.",
        "ko": "가되 일찍 돌아오세요."
      },
      {
        "an": "x",
        "en": "It's allowed, but only for today.",
        "ko": "허용하되 오늘만이에요."
      }
    ]
  },
