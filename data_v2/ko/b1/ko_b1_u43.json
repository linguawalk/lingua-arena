  "context": {
    "explanation_en": "« -기 » turns a verb into a noun, often used for ongoing or general activities. For example, « 운동하기가 힘들어요 » (Exercising is hard).",
    "explanation_ko": "'-기'는 동사를 명사로 바꾸며 흔히 진행 중이거나 일반적인 활동에 사용됩니다. 예: '운동하기가 힘들어요'.",
    "key_expressions": [
      {
        "en": "Exercising is hard.",
        "ko": "운동하기가 힘들어요."
      },
      {
        "en": "Learning Korean is fun.",
        "ko": "한국어를 배우기가 재미있어요."
      },
      {
        "an": "x",
        "en": "Waking up early is difficult.",
        "ko": "일찍 일어나기가 어려워요."
      }
    ]
  },
