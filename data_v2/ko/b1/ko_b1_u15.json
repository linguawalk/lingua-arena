  "context": {
    "explanation_en": "« -게 하다 » is a more general causative form (to make/let someone do). For example, « 부모님이 저를 유학 가게 했어요 » (My parents made me study abroad).",
    "explanation_ko": "'-게 하다'는 더 일반적인 사동 표현입니다(~하게 하다). 예: '부모님이 저를 유학 가게 했어요'.",
    "key_expressions": [
      {
        "en": "My parents made me study abroad.",
        "ko": "부모님이 저를 유학 가게 했어요."
      },
      {
        "en": "The teacher made us wait.",
        "ko": "선생님이 저희를 기다리게 했어요."
      },
      {
        "en": "I let my child watch TV.",
        "ko": "아이에게 텔레비전을 보게 해요."
      }
    ]
  },
