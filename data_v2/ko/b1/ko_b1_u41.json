    "title": "Formal Written Style -다체",
    "title_ko": "격식체 -다체",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "« -다체 » is the formal written style ending in « -다/-았다/-ㄴ다 », used in essays, news, and reports. For example, « 오늘 회의가 열린다 » (Today a meeting is held).",
    "explanation_ko": "'-다체'는 '-다/-았다/-ㄴ다'로 끝나는 격식 있는 문어체로, 에세이·뉴스·보고서에 사용됩니다. 예: '오늘 회의가 열린다'.",
    "key_expressions": [
      {
        "en": "Today a meeting is held.",
        "ko": "오늘 회의가 열린다."
      },
      {
        "en": "The economy grew last year.",
        "ko": "작년에 경제가 성장했다."
      },
      {
        "en": "This report explains the results.",
        "ko": "이 보고서는 결과를 설명한다."
      }
    ]
  },
  "tasks": [
    {
      "id": "ko_b1_u41_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a formal written-style sentence ending in «-다» (report/essay style).",
        "ko": "'-다'로 끝나는 격식 문어체 문장(보고서·에세이체)을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "da_style",
          "label_ko": "-다체",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "Does the sentence end with 다?",
          "type": "pattern_regex",
          "target": "다[.]$",
