  "context": {
    "explanation_en": "« 다르다 » (different) vs « 틀리다 » (wrong) are often confused; « 다르다 » compares, « 틀리다 » judges correctness.",
    "explanation_ko": "'다르다'(different)와 '틀리다'(wrong)는 자주 혼동됩니다. '다르다'는 비교, '틀리다'는 정확성을 판단합니다.",
    "key_expressions": [
      {
        "en": "Our opinions are different.",
        "ko": "저희 의견이 달라요."
      },
      {
        "en": "This answer is wrong.",
        "ko": "이 답이 틀려요."
      },
      {
        "an": "x",
        "en": "It's not wrong, it's just different.",
        "ko": "틀린 게 아니라 다른 거예요."
      }
    ]
  },
  "tasks": [
