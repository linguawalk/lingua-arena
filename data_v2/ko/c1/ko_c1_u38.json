  "context": {
    "explanation_en": "Register shift means using different vocabulary for formal vs casual contexts, like « 죄송합니다 » (formal apology) vs « 미안해 » (casual apology).",
    "explanation_ko": "격식 전환은 격식/비격식 맥락에 따라 다른 어휘를 사용하는 것을 의미합니다. 예: '죄송합니다'(격식) vs '미안해'(비격식).",
    "key_expressions": [
      {
        "en": "I sincerely apologize (formal).",
        "ko": "정말 죄송합니다."
      },
      {
        "en": "Sorry (casual).",
        "ko": "미안해."
      },
      {
        "an": "x",
        "en": "I would like to request your assistance (formal).",
        "ko": "도움을 요청드립니다."
      }
    ]
  },
