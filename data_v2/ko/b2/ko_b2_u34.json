  "context": {
    "explanation_en": "« -을/ㄹ 따름이다 » is a more formal way of saying only ~ / nothing but ~ (similar to 뿐이다). For example, « 최선을 다할 따름이에요 » (I'll only do my best, nothing more).",
    "explanation_ko": "'-을/ㄹ 따름이다'는 '뿐이다'의 더 격식 있는 표현입니다. 예: '최선을 다할 따름이에요'.",
    "key_expressions": [
      {
        "en": "I'll only do my best, nothing more.",
        "ko": "최선을 다할 따름이에요."
      },
      {
        "en": "I'm just grateful, nothing more to say.",
        "ko": "그저 감사할 따름이에요."
      },
      {
        "an": "x",
        "en": "It's just regrettable, nothing else to say.",
        "ko": "안타까울 따름이에요."
      }
    ]
  },
