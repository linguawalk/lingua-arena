  "context": {
    "explanation_en": "« -는 데 반해 » means in contrast to ~ (a more formal version of whereas). For example, « 그는 성실한 데 반해 그녀는 게을러요 » (In contrast to him being diligent, she is lazy).",
    "explanation_ko": "'-는 데 반해'는 '반면(더 격식 있는 whereas)'을 의미합니다. 예: '그는 성실한 데 반해 그녀는 게을러요'.",
    "key_expressions": [
      {
        "en": "In contrast to him being diligent, she is lazy.",
        "ko": "그는 성실한 데 반해 그녀는 게을러요."
      },
      {
        "en": "In contrast to prices rising, wages have stayed the same.",
        "ko": "물가가 오르는 데 반해 임금은 그대로예요."
      },
      {
        "an": "x",
        "en": "In contrast to demand increasing, supply has decreased.",
        "ko": "수요가 늘어나는 데 반해 공급은 줄었어요."
      }
    ]
  },
