  "context": {
    "explanation_en": "« -기에 » is a formal/literary way to give a reason (because ~). For example, « 날씨가 춥기에 외투를 입었어요 » (Because it was cold, I wore a coat).",
    "explanation_ko": "'-기에'는 격식체·문어체로 이유(때문에)를 말합니다. 예: '날씨가 춥기에 외투를 입었어요'.",
    "key_expressions": [
      {
        "en": "Because it was cold, I wore a coat.",
        "ko": "날씨가 춥기에 외투를 입었어요."
      },
      {
        "en": "Because it seemed important, I wrote it down.",
        "ko": "중요해 보이기에 적어 뒀어요."
      },
      {
        "an": "x",
        "en": "Because I was curious, I asked.",
        "ko": "궁금하기에 물어봤어요."
      }
    ]
  },
