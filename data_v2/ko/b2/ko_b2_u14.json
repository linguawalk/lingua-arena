  "context": {
    "explanation_en": "« -는 마당에 » means in the situation where ~ / given that things have come to this point. For example, « 이렇게 된 마당에 포기할 수밖에 없어요 » (Given things have come to this, we have no choice but to give up).",
    "explanation_ko": "'-는 마당에'는 '이런 상황에서(~인 마당에)'를 의미합니다. 예: '이렇게 된 마당에 포기할 수밖에 없어요'.",
    "key_expressions": [
      {
        "en": "Given things have come to this, we have no choice but to give up.",
        "ko": "이렇게 된 마당에 포기할 수밖에 없어요."
      },
      {
        "en": "Given that we're leaving anyway, let's say goodbye properly.",
        "ko": "떠나는 마당에 제대로 인사해요."
      },
      {
        "an": "x",
        "en": "Given that it's already broken, let's just buy a new one.",
        "ko": "이미 고장 난 마당에 새로 사요."
      }
    ]
  },
