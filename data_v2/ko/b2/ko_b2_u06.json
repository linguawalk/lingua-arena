  "context": {
    "explanation_en": "« -는 반면에 » means whereas ~ / on the other hand ~. For example, « 도시는 편리한 반면에 복잡해요 » (The city is convenient, whereas it's crowded).",
    "explanation_ko": "'-는 반면에'는 '반면(그와 반대로)'을 의미합니다. 예: '도시는 편리한 반면에 복잡해요'.",
    "key_expressions": [
      {
        "en": "The city is convenient, whereas it's crowded.",
        "ko": "도시는 편리한 반면에 복잡해요."
      },
      {
        "en": "He's smart, whereas he's a bit lazy.",
        "ko": "그는 똑똑한 반면에 좀 게을러요."
      },
      {
        "an": "x",
        "en": "This job pays well, whereas it's very stressful.",
        "ko": "이 일은 급여가 좋은 반면에 스트레스가 심해요."
      }
    ]
  },
