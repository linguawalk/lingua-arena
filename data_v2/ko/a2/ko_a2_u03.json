    "title": "Future Plans Deepening (-을 거예요, 여행 계획)",
    "title_ko": "미래 계획 심화",
    "focus_axis": "expression"
  },
  "context": {
    "explanation_en": "To describe detailed future plans, combine « -을 거예요 » with time expressions. For example, « 다음 주에 부산에 여행 갈 거예요 » (Next week, I'm going to travel to Busan).",
    "explanation_ko": "구체적인 미래 계획을 말할 때는 '-을 거예요'와 시간 표현을 결합합니다. 예: '다음 주에 부산에 여행 갈 거예요'.",
    "key_expressions": [
      {
        "en": "Next week I'm going to travel to Busan.",
        "ko": "다음 주에 부산에 여행 갈 거예요."
      },
      {
        "en": "I'm going to study Korean this year.",
        "ko": "올해 한국어를 공부할 거예요."
      },
      {
        "en": "I'm planning to move next month.",
        "ko": "다음 달에 이사할 거예요."
      }
    ]
  },
  "tasks": [
    {
      "id": "ko_a2_u03_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a detailed future plan using a time expression + «-을 거예요».",
        "ko": "시간 표현 + '-을 거예요'를 사용해서 구체적인 미래 계획을 써 보세요."
      },
      "target_elements": [
        {
          "type": "expression",
          "id": "future_detail",
          "label_ko": "미래 계획 심화 표현",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "Does it end with 거예요?",
