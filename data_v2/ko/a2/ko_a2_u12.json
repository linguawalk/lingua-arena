    "level": "a2",
    "unit": 12,
    "title": "Shopping / Price Comparison (-보다 더/덜)",
    "title_ko": "쇼핑·가격 비교",
    "focus_axis": "expression"
  },
  "context": {
    "explanation_en": "To compare prices, use « ~이/가 ~보다 더/덜 비싸요 » (~ is more/less expensive than ~). For example, « 이게 저것보다 더 싸요 » (This is cheaper than that).",
    "explanation_ko": "가격을 비교할 때는 '~이/가 ~보다 더/덜 비싸요'를 씁니다. 예: '이게 저것보다 더 싸요'.",
    "key_expressions": [
      {
        "en": "This is cheaper than that.",
        "ko": "이게 저것보다 더 싸요."
      },
      {
        "en": "This brand is more expensive than that one.",
        "ko": "이 브랜드가 저것보다 더 비싸요."
      },
      {
        "en": "Is there a cheaper option?",
        "ko": "더 싼 거 있어요?"
      }
    ]
  },
  "tasks": [
