      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a price comparison using «~이/가 ~보다 더/덜».",
        "ko": "'~이/가 ~보다 더/덜'을 사용해서 가격 비교 문장을 써 보세요."
      },
      "target_elements": [
        {
