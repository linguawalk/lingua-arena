          "min_matches": 1,
          "points": 50,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "Does the sentence end in 았어요 or 었어요?",
          "type": "pattern_regex",
          "target": "(았어요|었어요)[.]?$",
