    "title": "Connecting Past Actions (-고, 순서)",
    "title_ko": "과거 행동 연결하기",
    "focus_axis": "expression"
  },
  "context": {
    "explanation_en": "To connect sequential past actions, use « -고 » between clauses. For example, « 밥을 먹고 학교에 갔어요 » (I ate and then went to school).",
    "explanation_ko": "순차적인 과거 행동을 연결할 때는 절 사이에 '-고'를 씁니다. 예: '밥을 먹고 학교에 갔어요'.",
    "key_expressions": [
      {
        "en": "I ate and then went to school.",
        "ko": "밥을 먹고 학교에 갔어요."
      },
      {
        "en": "I woke up and then took a shower.",
        "ko": "일어나고 샤워했어요."
      },
      {
        "en": "I finished work and then went home.",
        "ko": "일을 끝내고 집에 갔어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "ko_a2_u02_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write two connected past actions using «-고» (and then).",
        "ko": "'-고'(그리고)를 사용해서 연결된 두 과거 행동을 써 보세요."
      },
      "target_elements": [
        {
          "type": "expression",
          "id": "connect_past",
          "label_ko": "과거 연결 표현",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "Did you use '고' as a connector?",
