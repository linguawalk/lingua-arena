  "context": {
    "explanation_en": "To guess about the weather, use « -을/ㄹ 것 같아요 » (it seems like ~). For example, « 내일 비가 올 것 같아요 » (It seems like it will rain tomorrow).",
    "explanation_ko": "날씨를 추측할 때는 '-을/ㄹ 것 같아요'를 씁니다. 예: '내일 비가 올 것 같아요'.",
    "key_expressions": [
      {
        "en": "It seems like it will rain tomorrow.",
        "ko": "내일 비가 올 것 같아요."
      },
      {
        "en": "It seems like it will be hot today.",
        "ko": "오늘 더울 것 같아요."
      },
      {
        "en": "Do you think it will snow?",
        "ko": "눈이 올 것 같아요?"
      }
    ]
  },
