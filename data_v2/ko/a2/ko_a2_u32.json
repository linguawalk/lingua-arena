  "context": {
    "explanation_en": "To describe sequence in transportation, use « -기 전에 » (before ~) and « -은/ㄴ 후에 » (after ~). For example, « 버스를 타기 전에 표를 사요 » (I buy a ticket before taking the bus).",
    "explanation_ko": "교통수단 이용 순서를 말할 때는 '-기 전에'(~하기 전에)와 '-은/ㄴ 후에'(~한 후에)를 씁니다. 예: '버스를 타기 전에 표를 사요'.",
    "key_expressions": [
      {
        "en": "I buy a ticket before taking the bus.",
        "ko": "버스를 타기 전에 표를 사요."
      },
      {
        "en": "After getting off the subway, I walk.",
        "ko": "지하철에서 내린 후에 걸어요."
      },
      {
        "en": "What do you do before leaving home?",
        "ko": "집을 나가기 전에 뭐 해요?"
      }
    ]
  },
