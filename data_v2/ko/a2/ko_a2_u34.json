  "context": {
    "explanation_en": "To express annoyance, use « ~아서/어서 짜증나요 » (~ is annoying because ~). For example, « 시끄러워서 짜증나요 » (It's annoying because it's noisy).",
    "explanation_ko": "짜증을 표현할 때는 '~아서/어서 짜증나요'를 씁니다. 예: '시끄러워서 짜증나요'.",
    "key_expressions": [
      {
        "en": "It's annoying because it's noisy.",
        "ko": "시끄러워서 짜증나요."
      },
      {
        "en": "The bus is late, and that's annoying.",
        "ko": "버스가 늦게 와서 짜증나요."
      },
      {
        "en": "What's bothering you?",
        "ko": "뭐가 짜증나요?"
      }
    ]
  },
