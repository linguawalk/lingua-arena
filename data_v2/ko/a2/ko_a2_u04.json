    "key_expressions": [
      {
        "en": "Shall we go together?",
        "ko": "같이 갈까요?"
      },
      {
        "en": "Shall we eat lunch now?",
        "ko": "지금 점심 먹을까요?"
      },
      {
        "en": "Shall we meet tomorrow?",
        "ko": "내일 만날까요?"
      }
    ]
  },
