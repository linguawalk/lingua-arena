  "context": {
    "explanation_en": "To make a more formal or group suggestion, use « -읍시다/-ㅂ시다 » (Let's ~). For example, « 시작합시다 » (Let's begin).",
    "explanation_ko": "더 격식 있거나 단체 제안을 할 때는 '-읍시다/-ㅂ시다'를 씁니다. 예: '시작합시다'.",
    "key_expressions": [
      {
        "en": "Let's begin.",
        "ko": "시작합시다."
      },
      {
        "en": "Let's take a break.",
        "ko": "잠깐 쉽시다."
      },
      {
        "en": "Let's work hard together.",
        "ko": "같이 열심히 합시다."
      }
    ]
  },
