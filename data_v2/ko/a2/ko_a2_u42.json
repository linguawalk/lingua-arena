  "context": {
    "explanation_en": "To express an intention about money, use « -으려고/려고 해요 » (I intend to ~). For example, « 돈을 모으려고 해요 » (I intend to save money).",
    "explanation_ko": "돈에 대한 의도를 말할 때는 '-으려고/려고 해요'를 씁니다. 예: '돈을 모으려고 해요'.",
    "key_expressions": [
      {
        "en": "I intend to save money.",
        "ko": "돈을 모으려고 해요."
      },
      {
        "en": "I'm trying to spend less this month.",
        "ko": "이번 달에 돈을 덜 쓰려고 해요."
      },
      {
        "en": "What are you trying to buy?",
        "ko": "뭘 사려고 해요?"
      }
    ]
  },
