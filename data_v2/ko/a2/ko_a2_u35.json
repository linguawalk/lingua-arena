    "key_expressions": [
      {
        "en": "You're really good at this!",
        "ko": "정말 잘하시네요!"
      },
      {
        "en": "This is delicious!",
        "ko": "이거 맛있네요!"
      },
      {
        "en": "Your Korean has improved a lot!",
        "ko": "한국어가 많이 늘었네요!"
      }
    ]
  },
