  "context": {
    "explanation_en": "To give a reason, use « -아서/어서 » (because ~). For example, « 배가 고파서 밥을 먹었어요 » (Because I was hungry, I ate).",
    "explanation_ko": "이유를 말할 때는 '-아서/어서'를 씁니다. 예: '배가 고파서 밥을 먹었어요'.",
    "key_expressions": [
      {
        "en": "Because I was hungry, I ate.",
        "ko": "배가 고파서 밥을 먹었어요."
      },
      {
        "en": "Because it's raining, I'm not going out.",
        "ko": "비가 와서 안 나가요."
      },
      {
        "en": "Because I was tired, I went to sleep early.",
        "ko": "피곤해서 일찍 잤어요."
      }
    ]
  },
