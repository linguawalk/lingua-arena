  "context": {
    "explanation_en": "To describe a neighborhood positively, use « ~기 좋아요 » (~ is good for ~ing). For example, « 여기는 살기 좋아요 » (This is a good place to live).",
    "explanation_ko": "동네를 긍정적으로 묘사할 때는 '~기 좋아요'를 씁니다. 예: '여기는 살기 좋아요'.",
    "key_expressions": [
      {
        "en": "This is a good place to live.",
        "ko": "여기는 살기 좋아요."
      },
      {
        "en": "This neighborhood is good for walking.",
        "ko": "이 동네는 걷기 좋아요."
      },
      {
        "en": "It's convenient because there are many stores nearby.",
        "ko": "근처에 가게가 많아서 편리해요."
      }
    ]
  },
