  },
  "context": {
    "explanation_en": "To say you dislike something, use « ~을/를 싫어해요 » (I dislike ~). To ask preference, use « ~와/과 ~ 중에 뭐가 더 좋아요? » (Which do you prefer, ~ or ~?).",
    "explanation_ko": "싫어함을 말할 때는 '~을/를 싫어해요', 선호를 물을 때는 '~와/과 ~ 중에 뭐가 더 좋아요?'를 씁니다.",
    "key_expressions": [
      {
        "en": "I dislike spicy food.",
        "ko": "저는 매운 음식을 싫어해요."
      },
      {
        "en": "Which do you prefer, coffee or tea?",
        "ko": "커피와 차 중에 뭐가 더 좋아요?"
      },
      {
        "en": "I like both.",
        "ko": "저는 둘 다 좋아해요."
      }
    ]
  },
