    "key_expressions": [
      {
        "en": "It's very cold in January.",
        "ko": "1월에는 정말 추워요."
      },
      {
        "en": "It's May 15th.",
        "ko": "5월 15일이에요."
      },
      {
        "en": "My favorite month is December.",
        "ko": "제가 가장 좋아하는 달은 12월이에요."
      }
    ]
  },
