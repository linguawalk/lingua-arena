      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about something you did yesterday using «-았/었어요» (past tense).",
        "ko": "'-았/었어요'(과거시제)를 사용해서 어제 한 일을 써 보세요."
      },
      "target_elements": [
        {
          "type": "expression",
