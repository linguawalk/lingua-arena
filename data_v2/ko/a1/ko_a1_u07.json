  "context": {
    "explanation_en": "To ask where something is, use « ~이/가 어디에 있어요? » (Where is ~?). To give directions, use « 똑바로 가세요 » (Go straight).",
    "explanation_ko": "위치를 물을 때는 '~이/가 어디에 있어요?', 길을 안내할 때는 '똑바로 가세요'를 씁니다.",
    "key_expressions": [
      {
        "en": "Where is the subway station?",
        "ko": "지하철역이 어디에 있어요?"
      },
      {
        "en": "Please go straight.",
        "ko": "똑바로 가세요."
      },
      {
        "en": "Please turn right.",
        "ko": "오른쪽으로 가세요."
      }
    ]
  },
