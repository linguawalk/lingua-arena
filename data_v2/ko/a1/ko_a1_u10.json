  "context": {
    "explanation_en": "To talk about pets, use « 저는 ~을/를 키워요 » (I raise/keep ~). To describe an animal, use « ~은/는 ~예요 ».",
    "explanation_ko": "반려동물을 말할 때는 '저는 ~을/를 키워요', 동물을 묘사할 때는 '~은/는 ~예요'를 씁니다.",
    "key_expressions": [
      {
        "en": "I have a dog.",
        "ko": "저는 강아지를 키워요."
      },
      {
        "en": "The cat is cute.",
        "ko": "고양이는 귀여워요."
      },
      {
        "en": "I don't have a pet.",
        "ko": "저는 반려동물이 없어요."
      }
    ]
  },
