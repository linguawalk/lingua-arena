    "title": "Family (가족, 있어요)",
    "title_ko": "가족",
    "focus_axis": "expression"
  },
  "context": {
    "explanation_en": "To talk about family members, use « 저는 ~이/가 있어요 » (I have ~). To describe them, use « 제 ~은/는 ~예요 » (My ~ is ~).",
    "explanation_ko": "가족을 말할 때는 '저는 ~이/가 있어요'(저는 ~이 있어요), 가족을 묘사할 때는 '제 ~은/는 ~예요'(제 ~은 ~예요)를 씁니다.",
    "key_expressions": [
      {
        "en": "I have an older brother.",
        "ko": "저는 오빠가 있어요."
      },
      {
        "en": "My mother is kind.",
        "ko": "제 어머니는 친절해요."
      },
      {
        "en": "I have two younger siblings.",
        "ko": "저는 동생이 두 명 있어요."
      }
    ]
  },
