    "key_expressions": [
      {
        "en": "In summer it's hot.",
        "ko": "여름에 더워요."
      },
      {
        "en": "In winter it snows.",
        "ko": "겨울에 눈이 와요."
      },
      {
        "en": "I like spring.",
        "ko": "저는 봄을 좋아해요."
      }
    ]
  },
