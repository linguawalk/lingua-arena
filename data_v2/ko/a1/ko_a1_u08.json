      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about your daily routine using «-아요/어요» (present tense).",
        "ko": "'-아요/어요'(현재시제)를 사용해서 하루 일과를 써 보세요."
      },
      "target_elements": [
        {
          "type": "expression",
          "id": "routine",
          "label_ko": "일과 표현",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "Does the verb end in 아요 or 어요?",
          "type": "pattern_regex",
          "target": "(아요|어요)[.]?$",
          "min_matches": 1,
          "points": 60,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "Is it a complete sentence?",
          "type": "pattern_regex",
          "target": "[.]$",
