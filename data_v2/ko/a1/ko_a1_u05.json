  "context": {
    "explanation_en": "To say you like food, use « ~을/를 좋아해요 » (I like ~). To say you want something, use « ~을/를 먹고 싶어요 » (I want to eat ~).",
    "explanation_ko": "음식을 좋아한다고 말할 때는 '~을/를 좋아해요', 먹고 싶다고 말할 때는 '~을/를 먹고 싶어요'를 씁니다.",
    "key_expressions": [
      {
        "en": "I like kimchi.",
        "ko": "저는 김치를 좋아해요."
      },
      {
        "en": "I want to eat rice.",
        "ko": "밥을 먹고 싶어요."
      },
      {
        "en": "I want to drink water.",
        "ko": "물을 마시고 싶어요."
      }
    ]
  },
