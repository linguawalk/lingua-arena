  "context": {
    "explanation_en": "To accept an invitation, use « 네, 좋아요 » (Yes, I'd love to). To decline, use « 죄송해요, 못 가요 » (Sorry, I can't go).",
    "explanation_ko": "초대를 수락할 때는 '네, 좋아요', 거절할 때는 '죄송해요, 못 가요'를 씁니다.",
    "key_expressions": [
      {
        "en": "Yes, I'd love to go.",
        "ko": "네, 가고 싶어요."
      },
      {
        "en": "Sorry, I can't go.",
        "ko": "죄송해요, 못 가요."
      },
      {
        "en": "Maybe another day.",
        "ko": "아마 다른 날에요."
      }
    ]
  },
