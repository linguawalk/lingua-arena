  "context": {
    "explanation_en": "To express feelings, use « 저는 ~해요 » (I am/feel ~). For example, « 행복해요 » (I am happy), « 슬퍼요 » (I am sad).",
    "explanation_ko": "기분을 표현할 때는 '저는 ~해요'를 씁니다. 예: '행복해요'(행복하다), '슬퍼요'(슬프다).",
    "key_expressions": [
      {
        "en": "I am happy.",
        "ko": "저는 행복해요."
      },
      {
        "en": "Why are you sad?",
        "ko": "왜 슬퍼요?"
      },
      {
        "en": "I am tired.",
        "ko": "저는 피곤해요."
      }
    ]
  },
