  "context": {
    "explanation_en": "To make a request, use « -아/어 주세요 » (Please do ~ for me). To ask for a favor, use « 부탁 하나 해도 돼요? » (Can I ask you a favor?).",
    "explanation_ko": "부탁할 때는 '-아/어 주세요', 도움을 요청할 때는 '부탁 하나 해도 돼요?'를 씁니다.",
    "key_expressions": [
      {
        "en": "Please help me.",
        "ko": "저를 도와주세요."
      },
      {
        "en": "Can I ask you a favor?",
        "ko": "부탁 하나 해도 돼요?"
      },
      {
        "en": "Please pass me the salt.",
        "ko": "소금 좀 건네주세요."
      }
    ]
  },
