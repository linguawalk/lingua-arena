  "context": {
    "explanation_en": "« ~하듯이 ~또한 » (just as ~, so too ~) is a sophisticated parallel structure used in formal comparisons.",
    "explanation_ko": "'~하듯이 ~또한'(~하듯이, 마찬가지로)은 격식 있는 비교에 사용되는 세련된 병렬 구조입니다.",
    "key_expressions": [
      {
        "an": "x",
        "en": "Just as the sun rises every day, so too do difficulties pass.",
        "ko": "해가 매일 뜨듯이 어려움도 또한 지나가요."
      },
      {
        "en": "Just as he learned quickly, so too he forgets quickly.",
        "ko": "그가 빨리 배우듯이 또한 빨리 잊어버려요."
      },
      {
        "en": "Just as she values hard work, so too she values rest.",
        "ko": "그녀가 노력을 중요시하듯이 또한 휴식도 중요시해요."
      }
    ]
  },
