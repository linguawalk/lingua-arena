  "context": {
    "explanation_en": "Public register uses formal, careful language, while private register is casual and can include slang or shorthand among close acquaintances.",
    "explanation_ko": "공적 언어역은 격식 있고 신중한 언어를 사용하고, 사적 언어역은 편안하며 가까운 지인들 사이에서 속어나 축약어를 포함할 수 있습니다.",
    "key_expressions": [
      {
        "en": "In public, he always maintains composure.",
        "ko": "공적으로는 그는 항상 침착함을 유지해요."
      },
      {
        "en": "In private, she's much more relaxed.",
        "ko": "사적으로는 그녀가 훨씬 더 편안해요."
      },
      {
        "en": "She switches her register depending on the situation.",
        "ko": "그녀는 상황에 따라 언어역을 바꿔요."
      }
    ]
  },
