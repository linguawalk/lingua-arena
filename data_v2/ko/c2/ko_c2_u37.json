    "key_expressions": [
      {
        "an": "x",
        "en": "Letting him manage the money is like leaving fish with a cat.",
        "ko": "그에게 돈 관리를 맡기는 건 고양이한테 생선을 맡기는 격이에요."
      },
      {
        "en": "That amount is nothing, a drop in the bucket.",
        "ko": "그 정도는 새 발의 피예요."
      },
      {
        "en": "More haste, less speed.",
        "ko": "급할수록 돌아가라."
      }
    ]
  },
