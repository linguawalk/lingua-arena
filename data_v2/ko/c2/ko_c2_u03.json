  "context": {
    "explanation_en": "« ~에 이르러 » (upon reaching/arriving at) and « 하물며 » (let alone/much less) are sophisticated literary connectors.",
    "explanation_ko": "'~에 이르러'(도달하여)와 '하물며'(~말할 것도 없이)는 세련된 문어체 접속사입니다.",
    "key_expressions": [
      {
        "an": "x",
        "en": "Upon reaching adulthood, he changed a lot.",
        "ko": "성인에 이르러 그는 많이 변했어요."
      },
      {
        "en": "I can't even do this, let alone that.",
        "ko": "이것도 못하는데 하물며 저것을 어떻게 해요."
      },
      {
        "en": "Even adults find it hard, let alone children.",
        "ko": "어른도 힘든데 하물며 아이들은 어떻겠어요."
      }
    ]
  },
