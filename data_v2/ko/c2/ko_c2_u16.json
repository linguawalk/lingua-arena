  "context": {
    "explanation_en": "« 참 잘한다 » (said sarcastically, meaning 'that's really smart' when it's not) and « 그것 참 대단하다 » (that's really something, sarcastic) are common irony markers.",
    "explanation_ko": "'참 잘한다'(반어법, 진짜 잘한다는 뜻이 아님)와 '그것 참 대단하다'(반어법)는 흔한 아이러니 표지입니다.",
    "key_expressions": [
      {
        "an": "x",
        "en": "Oh, well done (sarcastic, meaning the opposite).",
        "ko": "참 잘한다."
      },
      {
        "en": "That's really something (sarcastic).",
        "ko": "그것 참 대단하다."
      },
      {
        "en": "He said it sarcastically.",
        "ko": "그는 반어적으로 말했어요."
      }
    ]
  },
