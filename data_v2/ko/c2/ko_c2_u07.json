    "key_expressions": [
      {
        "en": "This design is practical.",
        "ko": "이 디자인은 실용적이에요."
      },
      {
        "en": "We need a realistic plan.",
        "ko": "현실적인 계획이 필요해요."
      },
      {
        "an": "x",
        "en": "He always thinks pragmatically rather than idealistically.",
        "ko": "그는 항상 이상적이기보다 실용적으로 생각해요."
      }
    ]
  },
