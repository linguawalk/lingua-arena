  "context": {
    "explanation_en": "« 진솔하다 » (candid/frank, honest in expression), « 진실되다 » (truthful, based on truth), « 진정하다 » (genuine/sincere at heart) form a nuanced trio.",
    "explanation_ko": "'진솔하다'(솔직한 표현), '진실되다'(사실에 기반), '진정하다'(진심 어린)는 뉘앙스 있는 세 단어입니다.",
    "key_expressions": [
      {
        "en": "His memoir is candid.",
        "ko": "그의 회고록이 진솔해요."
      },
      {
        "en": "This is a truthful account.",
        "ko": "이건 진실된 이야기예요."
      },
      {
        "en": "I want to give a sincere apology.",
        "ko": "저는 진정한 사과를 하고 싶어요."
      }
    ]
  },
