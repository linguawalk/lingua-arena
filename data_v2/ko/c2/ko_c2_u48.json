  "context": {
    "explanation_en": "« 끝까지 버티다 » (hold on to the end/persevere) and « 이를 악물다 » (grit one's teeth, endure with determination) are persistence idioms.",
    "explanation_ko": "'끝까지 버티다'(끝까지 견디다)와 '이를 악물다'(결의를 갖고 견디다)는 인내 관용구입니다.",
    "key_expressions": [
      {
        "en": "He held on to the end.",
        "ko": "그는 끝까지 버텼어요."
      },
      {
        "en": "She gritted her teeth and endured the pain.",
        "ko": "그녀는 이를 악물고 고통을 견뎠어요."
      },
      {
        "an": "x",
        "en": "No matter how hard it is, keep going.",
        "ko": "아무리 힘들어도 계속 나아가세요."
      }
    ]
  },
