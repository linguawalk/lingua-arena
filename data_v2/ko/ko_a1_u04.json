  "context": {
    "explanation_en": "To describe color, use « ~은/는 ~색이에요 » (~ is ~ color). To describe shape, use « ~은/는 ~모양이에요 » (~ is ~ shaped).",
    "explanation_ko": "색깔을 묘사할 때는 '~은/는 ~색이에요', 모양을 묘사할 때는 '~은/는 ~모양이에요'를 씁니다.",
    "key_expressions": [
      {
        "en": "The sky is blue.",
        "ko": "하늘은 파란색이에요."
      },
      {
        "en": "This is round.",
        "ko": "이것은 동그란 모양이에요."
      },
      {
        "en": "My bag is black.",
        "ko": "제 가방은 검은색이에요."
      }
    ]
  },
