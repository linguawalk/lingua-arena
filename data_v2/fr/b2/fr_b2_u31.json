  "context": {
    "explanation_en": "« Il se peut que » et « il semble que » sont des expressions impersonnelles suivies du subjonctif. Par exemple : « Il se peut qu'il pleuve demain ».",
    "explanation_ko": "'Il se peut que'와 'il semble que'는 비인칭 표현으로 뒤에 접속법이 옵니다. 예: 'Il se peut qu'il pleuve demain'(내일 비가 올 수도 있어요).",
    "key_expressions": [
      {
        "en": "Il se peut qu'il pleuve demain.",
        "ko": "내일 비가 올 수도 있어요."
      },
      {
        "en": "Il semble qu'elle soit fatiguée.",
        "ko": "그녀가 피곤한 것 같아요."
      },
      {
        "en": "Il est possible que nous soyons en retard.",
        "ko": "저희가 늦을 수도 있어요."
      }
    ]
  },
