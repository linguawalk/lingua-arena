    "key_expressions": [
      {
        "en": "Quoiqu'il soit fatigué, il continue.",
        "ko": "그는 피곤하지만 계속해요."
      },
      {
        "en": "Quoique ce soit difficile, elle réussit.",
        "ko": "어렵지만 그녀는 성공해요."
      },
      {
        "en": "Quoiqu'il pleuve, nous sortons.",
        "ko": "비가 오지만 저희는 나가요."
      }
    ]
  },
