    "key_expressions": [
      {
        "en": "Puisque tu es là, aide-moi.",
        "ko": "당신이 여기 있으니 도와주세요."
      },
      {
        "en": "Étant donné que le temps est limité, soyons efficaces.",
        "ko": "시간이 한정돼 있으니 효율적으로 합시다."
      },
      {
        "en": "Vu que tu es fatigué, repose-toi.",
        "ko": "피곤하니까 쉬세요."
      }
    ]
  },
