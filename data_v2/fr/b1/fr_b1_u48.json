    "key_expressions": [
      {
        "en": "C'est Marie qui a téléphoné.",
        "ko": "전화한 사람은 마리예요."
      },
      {
        "en": "C'est ce livre que je cherche.",
        "ko": "제가 찾는 건 이 책이에요."
      },
      {
        "en": "C'est demain que nous partons.",
        "ko": "저희가 떠나는 건 내일이에요."
      }
    ]
  },
