    "key_expressions": [
      {
        "en": "Une personne parlant français peut m'aider.",
        "ko": "프랑스어를 하는 사람이 도와줄 수 있어요."
      },
      {
        "en": "Les enfants jouant dans le parc sont heureux.",
        "ko": "공원에서 노는 아이들이 행복해 보여요."
      },
      {
        "en": "C'est une histoire intéressante.",
        "ko": "이건 흥미로운 이야기예요."
      }
    ]
  },
