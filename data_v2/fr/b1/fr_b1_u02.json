  "context": {
    "explanation_en": "Le subjonctif s'utilise après des expressions de doute ou d'émotion, comme « Je suis content(e) que... » ou « Je doute que... ».",
    "explanation_ko": "접속법은 의심이나 감정 표현 뒤에 씁니다. 'Je suis content(e) que...'(~해서 기뻐요), 'Je doute que...'(~인지 의심스러워요) 등이 있습니다.",
    "key_expressions": [
      {
        "en": "Je suis content que tu sois là.",
        "ko": "당신이 여기 있어서 기뻐요."
      },
      {
        "en": "Je doute qu'il vienne.",
        "ko": "그가 올지 의심스러워요."
      },
      {
        "en": "J'ai peur qu'il soit trop tard.",
        "ko": "너무 늦었을까 봐 걱정돼요."
      }
    ]
  },
