  "context": {
    "explanation_en": "« Y » remplace un lieu ou un complément avec « à », « en » remplace un complément avec « de » ou une quantité. Par exemple : « J'y vais » et « J'en veux ».",
    "explanation_ko": "'Y'는 장소나 'à'가 붙은 목적어를 대체하고, 'en'은 'de'가 붙은 목적어나 수량을 대체합니다. 예: 'J'y vais'(거기 가요), 'J'en veux'(그거 원해요).",
    "key_expressions": [
      {
        "en": "J'y vais demain.",
        "ko": "내일 거기 가요."
      },
      {
        "en": "J'en veux un peu plus.",
        "ko": "조금 더 원해요."
      },
      {
        "en": "Tu y penses souvent ?",
        "ko": "그것에 대해 자주 생각해요?"
      }
    ]
  },
