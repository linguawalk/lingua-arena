  "context": {
    "explanation_en": "Les adverbes en « -ment » se forment généralement à partir du féminin de l'adjectif. Par exemple : « lente » → « lentement ».",
    "explanation_ko": "'-ment'로 끝나는 부사는 대개 형용사의 여성형에서 만들어집니다. 예: 'lente'(느린, 여성형) → 'lentement'(느리게).",
    "key_expressions": [
      {
        "en": "Elle parle lentement.",
        "ko": "그녀는 천천히 말해요."
      },
      {
        "en": "Il a répondu rapidement.",
        "ko": "그는 빨리 대답했어요."
      },
      {
        "en": "Nous travaillons sérieusement.",
        "ko": "저희는 성실하게 일해요."
      }
    ]
  },
