    "key_expressions": [
      {
        "en": "Je partirai demain matin.",
        "ko": "내일 아침에 떠날 거예요."
      },
      {
        "en": "Dans dix ans, j'habiterai à l'étranger.",
        "ko": "10년 후에는 해외에 살 거예요."
      },
      {
        "en": "Il fera beau demain.",
        "ko": "내일은 날씨가 좋을 거예요."
      }
    ]
