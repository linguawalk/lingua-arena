    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "« Modestie » exprime la retenue naturelle sur ses qualités, « humilité » exprime une vertu plus profonde de reconnaissance de ses limites, « fausse modestie » exprime une modestie feinte pour obtenir des compliments.",
    "explanation_ko": "'Modestie'(겸손)는 자신의 장점에 대한 자연스러운 절제를, 'humilité'(겸허함)는 자신의 한계를 인정하는 더 깊은 미덕을, 'fausse modestie'(거짓 겸손)는 칭찬을 얻기 위해 가장하는 겸손을 나타냅니다.",
    "key_expressions": [
      {
        "en": "Il parle de son succès avec modestie.",
        "ko": "그는 자신의 성공에 대해 겸손하게 말해요."
      },
      {
        "en": "Son humilité est admirable.",
        "ko": "그의 겸허함은 존경스러워요."
      },
      {
        "en": "C'est de la fausse modestie, elle sait qu'elle a du talent.",
        "ko": "이건 거짓 겸손이에요, 그녀는 자신에게 재능이 있다는 걸 알아요."
      }
    ]
  },
