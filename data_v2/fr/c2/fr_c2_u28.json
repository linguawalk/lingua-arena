    "key_expressions": [
      {
        "en": "La situation politique est instable.",
        "ko": "정치 상황이 불안정해요."
      },
      {
        "en": "Sa santé est fragile.",
        "ko": "그의 건강이 연약해요."
      },
      {
        "en": "Son emploi est précaire.",
        "ko": "그의 일자리는 위태로워요."
      }
    ]
  },
