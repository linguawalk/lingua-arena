    "key_expressions": [
      {
        "en": "L'entreprise a acquis une nouvelle société. (formel)",
        "ko": "회사가 새로운 회사를 인수했어요 (격식)."
      },
      {
        "en": "J'ai acheté ce livre. (courant)",
        "ko": "저는 이 책을 샀어요 (일상)."
