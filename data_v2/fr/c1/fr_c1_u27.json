    "key_expressions": [
      {
        "en": "Je suis un peu inquiet pour l'examen.",
        "ko": "시험 때문에 좀 걱정돼요."
      },
      {
        "en": "Elle est angoissée à l'idée de parler en public.",
        "ko": "그녀는 대중 앞에서 말하는 것에 대해 불안해해요."
      },
      {
        "en": "Il était paniqué en pleine tempête.",
        "ko": "그는 폭풍 속에서 공황 상태였어요."
      }
    ]
