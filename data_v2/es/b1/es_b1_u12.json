    "title": "Conectores por eso/sin embargo",
    "title_ko": "접속사 (por eso/sin embargo)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "« Por eso » (that's why) expresses a consequence, « sin embargo » (however) expresses a contrast.",
    "explanation_ko": "'por eso'(그래서)는 결과를, 'sin embargo'(그러나)는 대조를 나타냅니다.",
    "key_expressions": [
      {
        "en": "Estaba cansado, por eso me fui temprano.",
        "ko": "저는 피곤해서 일찍 나갔어요."
      },
      {
        "en": "Es caro; sin embargo, lo voy a comprar.",
        "ko": "비싸지만 저는 살 거예요."
      },
      {
        "en": "Llovía, por eso no salimos.",
        "ko": "비가 와서 저희는 나가지 않았어요."
      }
    ]
  },
