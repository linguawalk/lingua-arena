  "context": {
    "explanation_en": "« Por lo tanto » (therefore) expresses a logical consequence, more formal than « por eso ».",
    "explanation_ko": "'por lo tanto'(따라서)는 'por eso'보다 더 격식 있는 논리적 결과를 나타냅니다.",
    "key_expressions": [
      {
        "en": "No estudié; por lo tanto, no aprobé.",
        "ko": "저는 공부하지 않았어요. 따라서 합격하지 못했어요."
      },
      {
        "en": "Llovió mucho; por lo tanto, cancelamos el evento.",
        "ko": "비가 많이 왔어요. 따라서 저희는 행사를 취소했어요."
      },
      {
        "en": "El precio subió; por lo tanto, compramos menos.",
        "ko": "가격이 올랐어요. 따라서 저희는 덜 샀어요."
      }
    ]
  },
