    "key_expressions": [
      {
        "en": "Mientras cocino, escucho música.",
        "ko": "요리하는 동안 저는 음악을 들어요."
      },
      {
        "en": "Desde que llegué, ha llovido todos los días.",
        "ko": "제가 도착한 이래로 매일 비가 왔어요."
      },
      {
        "en": "Mientras estudias, yo preparo la cena.",
        "ko": "당신이 공부하는 동안 저는 저녁을 준비할게요."
      }
    ]
  },
