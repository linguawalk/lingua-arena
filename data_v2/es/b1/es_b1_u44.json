  },
  "context": {
    "explanation_en": "« Puesto que » and « dado que » (given that) are more formal ways to express cause than « porque ».",
    "explanation_ko": "'puesto que'와 'dado que'(~이므로)는 'porque'보다 더 격식 있는 원인 표현 방법입니다.",
    "key_expressions": [
      {
        "en": "Puesto que llueve, cancelamos el picnic.",
        "ko": "비가 오므로 저희는 소풍을 취소했어요."
      },
      {
        "en": "Dado que es tarde, deberíamos irnos.",
        "ko": "늦었으므로 저희는 가야 해요."
      },
      {
        "en": "Puesto que no tenemos tiempo, seamos breves.",
        "ko": "시간이 없으므로 간단히 합시다."
      }
    ]
  },
