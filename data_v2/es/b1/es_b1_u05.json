  },
  "context": {
    "explanation_en": "« Que » is used for things and people, « quien » is used only for people, often after a preposition.",
    "explanation_ko": "'que'는 사물과 사람에 모두 사용되고, 'quien'은 사람에게만 사용되며 흔히 전치사 뒤에 옵니다.",
    "key_expressions": [
      {
        "en": "El libro que leí es interesante.",
        "ko": "제가 읽은 책은 흥미로워요."
      },
      {
        "en": "La persona con quien hablé es amable.",
        "ko": "제가 이야기 나눈 사람은 친절해요."
      },
      {
        "en": "Esa es la chica que conocí ayer.",
        "ko": "저 사람이 어제 제가 만난 여자예요."
      }
    ]
  },
