  "context": {
    "explanation_en": "The formal imperative uses « usted » forms, the informal imperative uses « tú » forms: « Espere aquí » vs « Espera aquí ».",
    "explanation_ko": "격식체 명령법은 'usted' 형태를, 비격식체 명령법은 'tú' 형태를 사용합니다: 'Espere aquí'(격식체) vs 'Espera aquí'(비격식체).",
    "key_expressions": [
      {
        "en": "Espere aquí, por favor. (formal)",
        "ko": "여기서 기다려 주세요 (격식체)."
      },
      {
        "en": "Espera aquí. (informal)",
        "ko": "여기서 기다려 (비격식체)."
      },
      {
        "en": "Ten cuidado.",
        "ko": "조심해."
      }
    ]
  },
