    "key_expressions": [
      {
        "en": "Está como pez en el agua en su nuevo trabajo.",
        "ko": "그녀는 새 직장에서 물 만난 물고기 같아요."
      },
      {
        "en": "Es un lobo con piel de cordero.",
        "ko": "그는 양의 탈을 쓴 늑대예요."
      },
      {
        "en": "Así matamos dos pájaros de un tiro.",
        "ko": "그렇게 하면 일석이조예요."
      }
    ]
  },
