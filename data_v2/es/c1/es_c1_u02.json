    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "« Satisfecho » is contentment from meeting expectations, « alegre » is a lively, moderate joy, « feliz » expresses deep happiness.",
    "explanation_ko": "'satisfecho'(만족한)는 기대를 충족시킨 것에서 오는 만족감을, 'alegre'(즐거운)는 활기차고 적당한 기쁨을, 'feliz'(행복한)는 깊은 행복을 나타냅니다.",
    "key_expressions": [
      {
        "en": "Estoy satisfecho con los resultados.",
        "ko": "결과에 만족해요."
      },
      {
        "en": "Ella está muy alegre hoy.",
        "ko": "그녀는 오늘 정말 즐거워요."
      },
      {
        "en": "Es feliz en su matrimonio.",
        "ko": "그는 결혼 생활에서 행복해요."
      }
    ]
  },
