  "context": {
    "explanation_en": "« Presumiblemente » (presumably), « supuestamente » (supposedly), « evidentemente » (evidently) express degrees of certainty.",
    "explanation_ko": "'presumiblemente'(아마도), 'supuestamente'(추정상), 'evidentemente'(명백히)는 확신의 정도를 표현합니다.",
    "key_expressions": [
      {
        "en": "Presumiblemente llegará mañana.",
        "ko": "아마 내일 도착할 거예요."
      },
      {
        "en": "Supuestamente es el mejor candidato.",
        "ko": "추정상 그가 최고의 후보예요."
      },
      {
        "en": "Evidentemente, hubo un malentendido.",
        "ko": "명백히 오해가 있었어요."
      }
    ]
  },
