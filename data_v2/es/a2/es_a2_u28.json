  "context": {
    "explanation_en": "To disagree politely, we use « No estoy de acuerdo ». To express your own view, we use « En mi opinión... ».",
    "explanation_ko": "정중하게 반대할 때는 'No estoy de acuerdo'(저는 의견이 달라요), 자신의 의견을 말할 때는 'En mi opinión...'(제 생각에는...)를 씁니다.",
    "key_expressions": [
      {
        "en": "No estoy de acuerdo contigo.",
        "ko": "저는 당신과 의견이 달라요."
      },
      {
        "en": "En mi opinión, eso no es correcto.",
        "ko": "제 생각에는 그건 맞지 않아요."
      },
      {
        "en": "Entiendo tu punto, pero...",
        "ko": "당신 입장은 이해하지만..."
      }
    ]
  },
