  "context": {
    "explanation_en": "To compare with « less than », we use « menos...que ». To say « as...as », we use « tan...como ».",
    "explanation_ko": "'~보다 덜'을 나타낼 때는 'menos...que', '~만큼'을 나타낼 때는 'tan...como'를 씁니다.",
    "key_expressions": [
      {
        "en": "Este trabajo es menos difícil que el anterior.",
        "ko": "이 일은 이전 일보다 덜 어려워요."
      },
      {
        "en": "Ella es tan alta como su hermano.",
        "ko": "그녀는 형제만큼 키가 커요."
      },
      {
        "en": "Hoy hace menos frío que ayer.",
        "ko": "오늘은 어제보다 덜 추워요."
      }
    ]
  },
