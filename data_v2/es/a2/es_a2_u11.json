    "key_expressions": [
      {
        "en": "Tengo fiebre desde ayer.",
        "ko": "저는 어제부터 열이 나요."
      },
      {
        "en": "Tengo dolor de espalda desde la semana pasada.",
        "ko": "저는 지난주부터 허리가 아파요."
      },
      {
        "en": "¿Desde cuándo tiene estos síntomas?",
        "ko": "언제부터 이 증상이 있었어요?"
      }
    ]
