    "key_expressions": [
      {
        "en": "El ruido me molesta.",
        "ko": "이 소음이 거슬려요."
      },
      {
        "en": "¿Podría bajar la voz, por favor?",
        "ko": "좀 더 조용히 해 주실 수 있어요?"
      },
      {
        "en": "Eso me molesta de verdad.",
        "ko": "그거 정말 거슬려요."
      }
    ]
  },
