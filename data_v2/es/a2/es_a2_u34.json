  "context": {
    "explanation_en": "To compare city and countryside, we use « En la ciudad..., pero en el campo... ». To express preference, we use « Prefiero... ».",
    "explanation_ko": "도시와 시골을 비교할 때는 'En la ciudad..., pero en el campo...'(도시에서는 ~하지만, 시골에서는...), 선호를 말할 때는 'Prefiero...'(저는 ~을 더 선호해요)를 씁니다.",
    "key_expressions": [
      {
        "en": "En la ciudad hay ruido, pero en el campo es tranquilo.",
        "ko": "도시는 시끄럽지만 시골은 조용해요."
      },
      {
        "en": "Prefiero la vida en el campo.",
        "ko": "저는 시골 생활을 더 선호해요."
      },
      {
        "en": "La ciudad tiene más oportunidades.",
        "ko": "도시는 기회가 더 많아요."
      }
    ]
  },
