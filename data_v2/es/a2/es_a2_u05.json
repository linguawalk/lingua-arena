    "key_expressions": [
      {
        "en": "A menudo llego tarde al trabajo.",
        "ko": "저는 자주 회사에 늦게 도착해요."
      },
      {
        "en": "A veces salgo con amigos.",
        "ko": "저는 가끔 친구들과 나가요."
      },
      {
        "en": "Nunca bebo café por la noche.",
        "ko": "저는 밤에는 절대 커피를 안 마셔요."
      }
    ]
