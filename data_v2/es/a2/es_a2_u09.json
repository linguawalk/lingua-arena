  "context": {
    "explanation_en": "To ask for something without an ingredient, we use « sin... ». To say you are allergic, we use « Soy alérgico/a a... ».",
    "explanation_ko": "재료를 빼달라고 할 때는 'sin...'(~빼고), 알레르기를 말할 때는 'Soy alérgico/a a...'(저는 ~에 알레르기가 있어요)를 씁니다.",
    "key_expressions": [
      {
        "en": "Quiero un café sin azúcar.",
        "ko": "설탕 빼고 커피 주세요."
      },
      {
        "en": "Soy alérgico a los cacahuetes.",
        "ko": "저는 땅콩 알레르기가 있어요."
      },
      {
        "en": "¿Puede hacerlo sin carne?",
        "ko": "고기 빼고 만들어 주실 수 있어요?"
      }
    ]
  },
