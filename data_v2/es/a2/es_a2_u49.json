  },
  "context": {
    "explanation_en": "To change topics casually, we use « Por cierto... ». To add information, we use « Además... ».",
    "explanation_ko": "자연스럽게 화제를 바꿀 때는 'Por cierto...'(그건 그렇고), 정보를 추가할 때는 'Además...'(게다가)를 씁니다.",
    "key_expressions": [
      {
        "en": "Por cierto, ¿viste el nuevo café?",
        "ko": "그건 그렇고, 새로 생긴 카페 봤어요?"
      },
      {
        "en": "Además, hace muy buen tiempo.",
        "ko": "게다가 날씨도 정말 좋아요."
      },
      {
        "en": "¿Qué tal todo lo demás?",
        "ko": "그 외에는 다 어때요?"
      }
    ]
  },
