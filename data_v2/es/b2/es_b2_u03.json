    "key_expressions": [
      {
        "en": "Terminado el trabajo, se fue a casa.",
        "ko": "일을 끝낸 후 그는 집에 갔어요."
      },
      {
        "en": "Una vez firmado el contrato, empezamos.",
        "ko": "계약서에 서명한 후 저희는 시작했어요."
