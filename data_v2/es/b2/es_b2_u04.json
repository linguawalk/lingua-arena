    "key_expressions": [
      {
        "en": "La construcción del puente tomó dos años.",
        "ko": "다리 건설은 2년이 걸렸어요."
      },
      {
        "en": "El aumento de precios preocupa a todos.",
        "ko": "가격 인상이 모두를 걱정시켜요."
      },
      {
        "en": "La toma de decisiones requiere tiempo.",
        "ko": "의사결정은 시간이 필요해요."
      }
