  "context": {
    "explanation_en": "« Por más que » (no matter how much) expresses strong concession, often with the subjunctive: « Por más que lo intente, no puedo ».",
    "explanation_ko": "'por más que'(아무리 ~해도)는 강한 양보를 나타내며 흔히 접속법과 함께 사용됩니다: 'Por más que lo intente, no puedo'(아무리 시도해도 저는 할 수 없어요).",
    "key_expressions": [
      {
        "en": "Por más que lo intente, no puedo.",
        "ko": "아무리 시도해도 저는 할 수 없어요."
      },
      {
        "en": "Por más que estudies, siempre hay más que aprender.",
        "ko": "아무리 공부해도 항상 배울 게 더 있어요."
      },
      {
        "en": "Por más que llueva, saldremos.",
        "ko": "아무리 비가 와도 저희는 나갈 거예요."
      }
    ]
  },
