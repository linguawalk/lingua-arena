    "key_expressions": [
      {
        "en": "¿Podría ayudarme, por favor?",
        "ko": "저 좀 도와주실 수 있을까요?"
      },
      {
        "en": "Quisiera saber si tiene tiempo.",
        "ko": "시간이 있으신지 여쭤보고 싶어요."
      },
      {
        "en": "¿Le importaría esperar un momento?",
        "ko": "잠깐 기다려주실 수 있으실까요?"
      }
