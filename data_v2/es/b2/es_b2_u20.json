  "context": {
    "explanation_en": "« Siempre que » (as long as) and « con tal de que » (provided that) introduce conditions with the subjunctive.",
    "explanation_ko": "'siempre que'(~하는 한)와 'con tal de que'(~하기만 하면)는 접속법과 함께 조건을 도입합니다.",
    "key_expressions": [
      {
        "en": "Iré siempre que tenga tiempo.",
        "ko": "시간이 있는 한 갈게요."
      },
      {
        "en": "Te ayudo con tal de que me escuches.",
        "ko": "제 말을 들어주기만 하면 도와드릴게요."
      },
      {
        "en": "Puedes venir siempre que avises antes.",
        "ko": "미리 알려주기만 하면 와도 돼요."
      }
    ]
  },
