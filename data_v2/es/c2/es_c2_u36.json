    "key_expressions": [
      {
        "en": "Respondió sin ninguna vacilación.",
        "ko": "그는 아무런 망설임 없이 답했어요."
      },
      {
        "en": "Optaron por una retirada estratégica.",
        "ko": "그들은 전략적 후퇴를 선택했어요."
      },
      {
        "en": "Actuó con mucha cautela.",
        "ko": "그녀는 매우 신중하게 행동했어요."
      }
    ]
  },
