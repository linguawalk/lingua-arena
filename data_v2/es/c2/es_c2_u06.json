  },
  "context": {
    "explanation_en": "« Ironía » (irony) is a contrast between expectation and reality, « sarcasmo » (sarcasm) is cutting mockery, « burla » (mockery) is ridiculing someone.",
    "explanation_ko": "'ironía'(아이러니)는 기대와 현실 사이의 대조이고, 'sarcasmo'(비꼼)는 신랄한 조롱이며, 'burla'(조롱)는 누군가를 놀리는 것입니다.",
    "key_expressions": [
      {
        "en": "Qué ironía que llegara justo cuando me iba.",
        "ko": "제가 막 떠나려던 참에 그가 도착하다니 참 아이러니해요."
      },
      {
        "en": "Su comentario fue puro sarcasmo.",
        "ko": "그의 발언은 순전한 비꼼이었어요."
      },
      {
        "en": "No soporto sus burlas.",
        "ko": "저는 그의 조롱을 참을 수 없어요."
      }
    ]
  },
