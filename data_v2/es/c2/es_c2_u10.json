  "context": {
    "explanation_en": "« En virtud de » (by virtue of) and « considerando » (whereas/considering) are formal legal register phrases used in official documents.",
    "explanation_ko": "'en virtud de'(~에 의거하여)와 'considerando'(~을 고려하여)는 공식 문서에서 사용되는 격식 있는 법률 언어역 표현입니다.",
    "key_expressions": [
      {
        "en": "En virtud de la ley, se aprueba la resolución.",
        "ko": "법률에 의거하여 결의안이 승인돼요."
      },
      {
        "en": "Considerando las circunstancias, se otorga el permiso.",
        "ko": "상황을 고려하여 허가가 부여돼요."
      },
      {
        "en": "En virtud del contrato, ambas partes deben cumplir.",
        "ko": "계약에 의거하여 양측은 이행해야 해요."
      }
    ]
  },
