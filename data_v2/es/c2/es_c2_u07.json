  "context": {
    "explanation_en": "« Pragmático » (pragmatic) focuses on practical results, « realista » (realistic) focuses on accepting things as they are.",
    "explanation_ko": "'pragmático'(실용적인)는 실제적인 결과에 초점을 맞추고, 'realista'(현실적인)는 있는 그대로를 받아들이는 것에 초점을 맞춥니다.",
    "key_expressions": [
      {
        "en": "Es una persona muy pragmática.",
        "ko": "그는 매우 실용적인 사람이에요."
      },
      {
        "en": "Hay que ser realista sobre las posibilidades.",
        "ko": "가능성에 대해 현실적이어야 해요."
      },
      {
        "en": "Su enfoque pragmático dio buenos resultados.",
        "ko": "그의 실용적인 접근 방식이 좋은 결과를 냈어요."
      }
    ]
  },
