    "key_expressions": [
      {
        "en": "La tecnología es omnipresente hoy en día.",
        "ko": "기술은 오늘날 어디에나 있어요."
      },
      {
        "en": "Esta torre es un edificio emblemático de la ciudad.",
        "ko": "이 탑은 도시의 상징적인 건물이에요."
      },
      {
        "en": "Su influencia es omnipresente en la industria.",
        "ko": "그의 영향력은 업계 어디에나 있어요."
      }
    ]
