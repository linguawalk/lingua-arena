    "key_expressions": [
      {
        "en": "Es un orador muy elocuente.",
        "ko": "그는 매우 달변인 연설가예요."
      },
      {
        "en": "Tiene mucha labia para vender.",
        "ko": "그는 파는 데 말솜씨가 정말 좋아요."
      },
      {
        "en": "Es demasiado hablador.",
        "ko": "그는 너무 말이 많아요."
      }
    ]
  },
