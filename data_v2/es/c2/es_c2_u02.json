  "context": {
    "explanation_en": "« Rígido » (rigid) describes inflexibility in approach or attitude, while « anticuado » (old-fashioned) describes something outdated in style or thinking.",
    "explanation_ko": "'rígido'(경직된)는 접근 방식이나 태도의 융통성 없음을 묘사하고, 'anticuado'(구식의)는 스타일이나 사고에서 시대에 뒤떨어짐을 묘사합니다.",
    "key_expressions": [
      {
        "en": "Su enfoque es demasiado rígido.",
        "ko": "그의 접근 방식은 너무 경직됐어요."
      },
      {
        "en": "Esa forma de pensar es anticuada.",
        "ko": "그런 사고방식은 구식이에요."
      },
      {
        "en": "El sistema es rígido, no anticuado.",
        "ko": "그 시스템은 경직됐지, 구식은 아니에요."
      }
    ]
  },
