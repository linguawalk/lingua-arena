  "context": {
    "explanation_en": "« Auténtico » (authentic) is true to origin, « sincero » (sincere) is honest in feeling, « genuino » (genuine) is real without pretense.",
    "explanation_ko": "'auténtico'(진짜의)는 출처에 충실함을, 'sincero'(진실한)는 감정의 정직함을, 'genuino'(순수한)는 가식 없는 진짜임을 나타냅니다.",
    "key_expressions": [
      {
        "en": "Es un cuadro auténtico.",
        "ko": "이건 진짜 그림이에요."
      },
      {
        "en": "Fue una disculpa sincera.",
        "ko": "진심 어린 사과였어요."
      },
      {
        "en": "Su interés es genuino.",
        "ko": "그의 관심은 순수해요."
      }
    ]
  },
