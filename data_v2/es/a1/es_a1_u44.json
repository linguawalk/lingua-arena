    "key_expressions": [
      {
        "en": "Mi vecino es muy amable.",
        "ko": "제 이웃은 정말 친절해요."
      },
      {
        "en": "Encantado de conocerlo.",
        "ko": "만나서 반가워요."
      },
      {
        "en": "Vivimos en el mismo edificio.",
        "ko": "저희는 같은 건물에 살아요."
      }
    ]
