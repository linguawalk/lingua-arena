{
  "meta": {
    "id": "en_b1_u37",
    "domain": "language",
    "lang": "en",
    "level": "b1",
    "unit": 37,
    "title": "Linking Words (because/since/so)",
    "title_ko": "이유 접속사 (because/since/so)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "'Because' and 'since' introduce a reason (since is slightly more formal and often starts a sentence): 'Since it was raining, we stayed home.' 'So' introduces the result, in the second clause: 'It was raining, so we stayed home.'",
    "explanation_ko": "'because'와 'since'는 이유를 나타냅니다(since가 조금 더 격식적이고 문장 앞에 자주 옴): 'Since it was raining, we stayed home.' 'so'는 결과를 나타내며 두 번째 절에 옵니다: 'It was raining, so we stayed home.'",
    "key_expressions": [
      {
        "en": "I was late because the bus didn't come.",
        "ko": "버스가 안 와서 저는 늦었어요."
      },
      {
        "en": "Since you're here, let's start.",
        "ko": "당신이 왔으니까 시작해요."
      },
      {
        "en": "I was tired, so I went to bed early.",
        "ko": "저는 피곤해서 일찍 잤어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u37_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a decision you made, giving the reason with 'because' and the result with 'so'.",
        "ko": "내린 결정에 대해, 이유는 'because'로, 결과는 'so'로 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "because",
          "label_ko": "because",
          "min_occurrences": 1
        },
        {
          "type": "grammar",
          "id": "so_result",
          "label_ko": "so(결과)",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'because'를 사용했는가",
          "type": "keyword_match",
          "target": [
            "because"
          ],
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'so'를 결과 접속사로 사용했는가",
          "type": "pattern_regex",
          "target": ",\\s*so\\s+\\w+",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
