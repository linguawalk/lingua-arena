    "unit": 25,
    "title": "Future Perfect",
    "title_ko": "미래완료",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Future perfect (will have + past participle) describes an action that will be completed before a specific point in the future: 'By next year, I will have finished my degree.'",
    "explanation_ko": "미래완료(will have + 과거분사)는 미래의 특정 시점 이전에 완료될 행동을 나타냅니다: 'By next year, I will have finished my degree.'",
    "key_expressions": [
      {
        "en": "By 2030, I will have paid off my loan.",
        "ko": "2030년까지는 대출을 다 갚았을 거예요."
      },
      {
        "en": "She will have graduated by next summer.",
        "ko": "그녀는 내년 여름까지는 졸업했을 거예요."
      },
      {
        "en": "We will have finished the project by Friday.",
        "ko": "우리는 금요일까지는 프로젝트를 끝냈을 거예요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u25_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about something you will have accomplished by a specific future date, using future perfect.",
        "ko": "미래완료를 사용해서, 특정 미래 시점까지 이뤄냈을 일에 대해 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "future_perfect",
          "label_ko": "미래완료",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'will have + 과거분사'를 사용했는가",
          "type": "pattern_regex",
          "target": "will\\s+have\\s+\\w+ed\\b|will\\s+have\\s+(finished|graduated|paid|moved|completed|saved)",
          "min_matches": 1,
          "points": 50,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "미래 시점 표현(by ~)을 사용했는가",
          "type": "keyword_match",
          "target": [
            "by"
          ],
          "min_matches": 1,
          "points": 30,
          "required": false
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
    {
      "id": "en_b1_u25_w2",
      "skill": "writing",
      "task_type": "qa_response",
      "prompt": {
