    "unit": 13,
    "title": "Modals of Deduction",
    "title_ko": "추측을 나타내는 조동사",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Modals of deduction express how certain you are about something. 'Must' = strong certainty (positive), 'can't' = strong certainty (negative), 'might/may/could' = possibility: 'She must be tired.' 'That can't be true.' 'He might be at work.'",
    "explanation_ko": "추측 조동사는 어떤 일에 대한 확신 정도를 나타냅니다. 'must'=강한 확신(긍정), 'can't'=강한 확신(부정), 'might/may/could'=가능성: 'She must be tired.' 'That can't be true.' 'He might be at work.'",
    "key_expressions": [
      {
        "en": "He must be at home; the lights are on.",
        "ko": "불이 켜져 있으니 그는 집에 있는 게 틀림없어요."
      },
      {
        "en": "She can't be angry; she's smiling.",
        "ko": "웃고 있으니 그녀가 화났을 리 없어요."
      },
      {
        "en": "They might be stuck in traffic.",
        "ko": "그들은 교통 체증에 걸렸을 수도 있어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u13_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Your friend isn't answering their phone. Write two guesses about why, using 'must', 'might', or 'can't'.",
        "ko": "친구가 전화를 안 받습니다. 'must', 'might', 'can't'를 사용해서 이유를 추측하는 문장 두 개를 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "modal_deduction",
          "label_ko": "추측 조동사",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'must', 'might', 'may', 'could', 'can't' 중 2개 이상 사용했는가",
          "type": "pattern_regex",
          "target": "\\b(must|might|may|could|can't|cannot)\\b",
          "min_matches": 2,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "문장이 2개 이상인가",
          "type": "pattern_regex",
          "target": "[.!]",
          "min_matches": 2,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
