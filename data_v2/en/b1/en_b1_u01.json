{
  "meta": {
    "id": "en_b1_u01",
    "domain": "language",
    "lang": "en",
    "level": "b1",
    "unit": 1,
    "title": "Present Perfect vs Past Simple",
    "title_ko": "현재완료 vs 과거시제",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Use past simple for a finished action at a specific past time ('I visited Paris in 2019'). Use present perfect for an experience with no specific time, or a result that matters now ('I have visited Paris'). Adding a specific time word (yesterday, in 2019, last week) forces past simple.",
    "explanation_ko": "특정 과거 시점에 끝난 행동에는 과거시제('I visited Paris in 2019'), 특정 시점 없는 경험이나 지금 중요한 결과에는 현재완료('I have visited Paris')를 씁니다. yesterday, in 2019, last week 같은 구체적 시간 표현이 있으면 반드시 과거시제를 씁니다.",
    "key_expressions": [
      {
        "en": "I have visited three countries this year.",
        "ko": "저는 올해 세 나라를 방문했어요."
      },
      {
        "en": "I visited Japan in 2022.",
        "ko": "저는 2022년에 일본을 방문했어요."
      },
      {
        "en": "Have you ever tried sushi?",
        "ko": "초밥 먹어본 적 있어요?"
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u01_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about your life experiences, using present perfect for general experience and past simple for one specific event with a date or time.",
        "ko": "인생 경험에 대해 써 보세요. 일반적 경험은 현재완료로, 구체적 시점이 있는 사건 하나는 과거시제로 쓰세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "present_perfect",
          "label_ko": "현재완료",
          "min_occurrences": 1
        },
        {
          "type": "grammar",
          "id": "past_simple",
          "label_ko": "과거시제",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "현재완료(have/has + 과거분사)를 사용했는가",
          "type": "pattern_regex",
          "target": "\\b(have|has)\\s+\\w+ed\\b|\\b(have|has)\\s+(been|done|seen|gone|had|made|taken)\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "구체적 시간 표현과 함께 과거시제를 사용했는가",
          "type": "pattern_regex",
          "target": "\\b(in|on|last)\\s+\\w+.{0,20}\\b(ed)\\b|\\b\\w+ed\\b.{0,20}(ago|last|in \\d{4})",
          "min_matches": 1,
          "points": 35,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "분량이 충분한가 (최소 20단어)",
          "type": "length_check",
          "unit": "words",
          "min": 20,
          "points": 25,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
