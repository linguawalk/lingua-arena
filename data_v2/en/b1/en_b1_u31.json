    "level": "b1",
    "unit": 31,
    "title": "Past Continuous vs Past Simple",
    "title_ko": "과거진행형 vs 과거시제",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Past continuous (was/were + -ing) describes a background action in progress, often interrupted by a shorter action in past simple: 'I was cooking dinner when the phone rang.' The continuous sets the scene; the simple past is the interrupting event.",
    "explanation_ko": "과거진행형(was/were + -ing)은 진행 중이던 배경 행동을 나타내며, 보통 과거시제로 표현된 더 짧은 행동에 의해 중단됩니다: 'I was cooking dinner when the phone rang.' 진행형이 배경을, 과거시제가 끼어든 사건을 나타냅니다.",
    "key_expressions": [
      {
        "en": "I was walking home when it started to rain.",
        "ko": "집에 걸어가고 있을 때 비가 오기 시작했어요."
      },
      {
        "en": "She was sleeping when I called.",
        "ko": "제가 전화했을 때 그녀는 자고 있었어요."
      },
      {
        "en": "What were you doing at 9pm last night?",
        "ko": "어젯밤 9시에 뭐 하고 있었어요?"
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u31_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a moment when something unexpected interrupted what you were doing, using past continuous and past simple together.",
        "ko": "하고 있던 일을 예상치 못한 일이 방해했던 순간을, 과거진행형과 과거시제를 함께 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "past_continuous",
          "label_ko": "과거진행형",
          "min_occurrences": 1
