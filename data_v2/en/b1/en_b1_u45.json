  "context": {
    "explanation_en": "'What + clause + is/was ...' puts strong emphasis on what follows: 'What I really need is more time.' This structure highlights the most important part of a sentence, useful for expressing priorities and strong opinions.",
    "explanation_ko": "'What + 절 + is/was ...' 구조는 뒤따르는 내용을 강하게 강조합니다: 'What I really need is more time.' 이 구조는 문장에서 가장 중요한 부분을 부각시키며, 우선순위나 강한 의견을 표현할 때 유용합니다.",
    "key_expressions": [
      {
        "en": "What I love most about my job is the people.",
        "ko": "제 일에서 가장 좋아하는 건 사람들이에요."
      },
      {
        "en": "What surprised me was how quickly it happened.",
        "ko": "저를 놀라게 한 건 얼마나 빨리 일어났는지였어요."
      },
      {
        "en": "What we need to do is start over.",
        "ko": "우리가 해야 할 건 다시 시작하는 거예요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u45_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about your top priority right now, using 'What I need/want is ...' for emphasis.",
        "ko": "지금 가장 중요한 우선순위를 'What I need/want is ...' 강조 구문을 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "emphasis_what",
          "label_ko": "What 강조구문",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'What I' + 동사 + is/was 구조를 사용했는가",
          "type": "pattern_regex",
          "target": "what\\s+i\\s+\\w+\\s+is\\b|what\\s+i\\s+\\w+\\s+was\\b",
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
