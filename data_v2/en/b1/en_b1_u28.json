      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'Could you tell me' 또는 'Do you know'를 사용했는가",
          "type": "keyword_match",
          "target": [
            "could you tell me",
            "do you know"
          ],
          "min_matches": 1,
          "points": 50,
