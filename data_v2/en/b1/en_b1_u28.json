    "unit": 28,
    "title": "Indirect Questions",
    "title_ko": "간접의문문 (정중한 질문)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Indirect questions sound more polite, especially with strangers. Start with a polite phrase ('Could you tell me...', 'Do you know...') and use statement word order, not question order: 'Where is the bank?' → 'Could you tell me where the bank is?'",
    "explanation_ko": "간접의문문은 특히 낯선 사람에게 더 정중하게 들립니다. 정중한 표현('Could you tell me...', 'Do you know...')으로 시작하고, 의문문 어순이 아닌 평서문 어순을 씁니다: 'Where is the bank?' → 'Could you tell me where the bank is?'",
    "key_expressions": [
      {
        "en": "Could you tell me what time it is?",
        "ko": "몇 시인지 알려주시겠어요?"
      },
      {
        "en": "Do you know where the nearest ATM is?",
        "ko": "가장 가까운 ATM이 어디 있는지 아세요?"
      },
      {
        "en": "I was wondering if you could help me.",
        "ko": "혹시 도와주실 수 있을까 해서요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u28_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a polite indirect question you would ask a stranger about the nearest subway station.",
        "ko": "낯선 사람에게 가장 가까운 지하철역에 대해 물어볼 정중한 간접의문문을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "indirect_question",
          "label_ko": "간접의문문",
