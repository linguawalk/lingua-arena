    "title": "Modals of Possibility",
    "title_ko": "가능성을 나타내는 조동사",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Modals of possibility speculate about the future: 'may/might/could + base verb' (I might travel next year), or 'may/might/could + be + -ing' for a possible ongoing action (She might be sleeping right now).",
    "explanation_ko": "가능성 조동사는 미래에 대해 추측할 때 씁니다: 'may/might/could + 동사원형'(I might travel next year), 또는 진행 중일 수 있는 일에는 'may/might/could + be + -ing'(She might be sleeping right now).",
    "key_expressions": [
      {
        "en": "I might visit my parents next weekend.",
        "ko": "다음 주말에 부모님을 방문할지도 몰라요."
      },
      {
        "en": "It could rain later today.",
        "ko": "오늘 나중에 비가 올 수도 있어요."
      },
      {
        "en": "She may be working late tonight.",
        "ko": "그녀는 오늘 밤 늦게까지 일하고 있을지도 몰라요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u34_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about your uncertain plans for next month, using 'might', 'may', or 'could'.",
        "ko": "'might', 'may', 'could'를 사용해서 아직 불확실한 다음 달 계획을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "modal_possibility",
          "label_ko": "가능성 조동사",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'might/may/could'를 2회 이상 사용했는가",
          "type": "pattern_regex",
