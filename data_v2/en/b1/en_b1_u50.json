  "context": {
    "explanation_en": "This review unit brings together B1's key grammar areas: perfect tenses, passive voice, conditionals, reported speech, relative clauses, and modals — the structures needed to narrate, speculate, report, and express nuanced opinions.",
    "explanation_ko": "이번 복습 유닛은 B1의 핵심 문법 영역을 종합합니다: 완료시제, 수동태, 조건문, 간접화법, 관계대명사절, 조동사 — 서술하고, 추측하고, 전달하고, 미묘한 의견을 표현하는 데 필요한 구조들입니다.",
    "key_expressions": [
      {
        "en": "If I hadn't decided to study abroad, I wouldn't have met so many people.",
        "ko": "유학을 결정하지 않았다면 이렇게 많은 사람을 못 만났을 거예요."
      },
      {
        "en": "She told me that she had already finished the report.",
        "ko": "그녀는 보고서를 벌써 끝냈다고 저에게 말했어요."
      },
      {
        "en": "In my view, the person who influenced me most was my grandmother.",
        "ko": "제 견해로는, 저에게 가장 큰 영향을 준 사람은 할머니였어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u50_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a paragraph about a major life decision: describe it with past perfect or third conditional, mention someone's advice using reported speech, and give your current opinion using a formal opinion phrase.",
        "ko": "인생의 중요한 결정에 대한 문단을 써 보세요: 과거완료나 3형 조건문으로 설명하고, 간접화법으로 누군가의 조언을 언급하고, 격식체 의견 표현으로 지금의 생각을 밝히세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "reported_speech",
          "label_ko": "간접화법",
          "min_occurrences": 1
        },
        {
          "type": "grammar",
          "id": "formal_opinion",
          "label_ko": "격식체 의견",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'said/told (that)'를 사용했는가",
          "type": "keyword_match",
          "target": [
            "said that",
            "told me",
            "said she",
            "said he"
          ],
          "min_matches": 1,
          "points": 30,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'In my view' 또는 'I would argue'를 사용했는가",
          "type": "keyword_match",
          "target": [
            "in my view",
            "i would argue",
            "from my perspective"
          ],
          "min_matches": 1,
          "points": 30,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "과거완료 또는 조건문을 사용했는가",
          "type": "pattern_regex",
          "target": "had\\s+\\w+|if\\s+i\\s+(had|were)",
          "min_matches": 1,
          "points": 20,
          "required": false
        },
        {
          "id": "r4",
          "criterion_ko": "분량이 충분한가 (최소 30단어)",
          "type": "length_check",
          "unit": "words",
          "min": 30,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
