    "lang": "en",
    "level": "b1",
    "unit": 26,
    "title": "Third Conditional",
    "title_ko": "3형 조건문",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Third conditional (If + past perfect, ... would have + past participle) describes an imagined different past and its imagined result. It's often used to express regret: 'If I had studied harder, I would have passed the exam' (I didn't study, and I didn't pass).",
    "explanation_ko": "3형 조건문(If + 과거완료, ... would have + 과거분사)은 실제와 다른 상상 속 과거와 그 결과를 나타냅니다. 후회를 표현할 때 자주 씁니다: 'If I had studied harder, I would have passed the exam'(실제로는 공부 안 했고 시험도 떨어짐).",
    "key_expressions": [
      {
        "en": "If I had known, I would have come earlier.",
        "ko": "알았더라면 더 일찍 왔을 텐데요."
      },
      {
        "en": "She wouldn't have been late if she had left on time.",
        "ko": "제때 나갔다면 그녀는 늦지 않았을 텐데요."
      },
      {
        "en": "We would have missed the flight if we hadn't hurried.",
        "ko": "서두르지 않았다면 비행기를 놓쳤을 거예요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u26_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a past decision you regret, using third conditional to describe what would have happened differently.",
        "ko": "후회하는 과거의 결정에 대해, 3형 조건문을 사용해서 다르게 됐을 일을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "third_conditional",
          "label_ko": "3형 조건문",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'If + had + 과거분사'를 사용했는가",
          "type": "pattern_regex",
