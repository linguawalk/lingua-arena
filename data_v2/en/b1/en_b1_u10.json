          "min_matches": 1,
          "points": 35,
          "required": false
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "^[A-Z]",
          "min_matches": 1,
          "points": 20,
          "required": false
