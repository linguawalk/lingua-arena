    "unit": 10,
    "title": "Reported Speech (Questions)",
    "title_ko": "간접화법 (의문문)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Reported questions drop the question word order and question mark, and use statement word order instead. Yes/No questions add 'if' or 'whether': 'Are you okay?' → 'She asked if I was okay.' Wh-questions keep the question word: 'Where do you live?' → 'He asked where I lived.'",
    "explanation_ko": "간접 의문문은 의문문 어순과 물음표를 없애고 평서문 어순을 씁니다. Yes/No 의문문은 'if'나 'whether'를 붙입니다: 'Are you okay?' → 'She asked if I was okay.' Wh-의문문은 의문사를 유지합니다: 'Where do you live?' → 'He asked where I lived.'",
    "key_expressions": [
      {
        "en": "She asked if I was free tonight.",
        "ko": "그녀는 오늘 밤 시간이 되냐고 물었어요."
      },
      {
        "en": "He asked where I had parked the car.",
        "ko": "그는 차를 어디에 주차했는지 물었어요."
      },
      {
        "en": "They asked whether we wanted to join.",
        "ko": "그들은 우리가 참여하고 싶은지 물었어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u10_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "A stranger asked you: 'Do you know where the station is?' Write what the stranger asked, using reported speech.",
        "ko": "낯선 사람이 'Do you know where the station is?'라고 물었습니다. 간접화법으로 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "reported_question",
          "label_ko": "간접화법 의문문",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'asked if/whether' 또는 의문사를 사용했는가",
