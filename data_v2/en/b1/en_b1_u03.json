    "level": "b1",
    "unit": 3,
    "title": "Past Perfect",
    "title_ko": "과거완료",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Past perfect (had + past participle) describes an action that happened before another past action. It clarifies the order of two past events: 'When I arrived, the meeting had already started' (meeting started first).",
    "explanation_ko": "과거완료(had + 과거분사)는 다른 과거 행동보다 먼저 일어난 일을 나타냅니다. 두 과거 사건의 순서를 명확히 합니다: 'When I arrived, the meeting had already started'(회의가 먼저 시작됨).",
    "key_expressions": [
      {
        "en": "By the time I got there, they had left.",
        "ko": "제가 도착했을 때는 이미 떠난 후였어요."
      },
      {
        "en": "I had never seen snow before that day.",
        "ko": "그날 전에는 눈을 본 적이 없었어요."
      },
      {
        "en": "She realized she had forgotten her keys.",
        "ko": "그녀는 열쇠를 두고 온 걸 깨달았어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u03_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a time you arrived somewhere and something had already happened, using past perfect.",
        "ko": "어딘가에 도착했을 때 이미 무슨 일이 일어나 있었던 경험을 과거완료를 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "past_perfect",
          "label_ko": "과거완료",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'had + 과거분사'를 사용했는가",
          "type": "pattern_regex",
          "target": "\\bhad\\s+\\w+ed\\b|\\bhad\\s+(been|gone|left|started|finished|done)\\b",
          "min_matches": 1,
          "points": 50,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "두 과거 시점의 순서가 드러나는가 (when/by the time)",
          "type": "keyword_match",
          "target": [
            "when",
            "by the time",
            "after"
          ],
          "min_matches": 1,
          "points": 30,
          "required": false
        },
        {
          "id": "r3",
          "criterion_ko": "분량이 충분한가 (최소 18단어)",
          "type": "length_check",
          "unit": "words",
