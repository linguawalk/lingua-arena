      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about what you would do if you had a million dollars, using second conditional.",
        "ko": "백만 달러가 생긴다면 무엇을 할지, 2형 조건문을 사용해서 써 보세요."
      },
