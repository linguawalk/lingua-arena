  "context": {
    "explanation_en": "Common relationship phrasal verbs: 'get along with' (have a good relationship), 'fall out with' (have a disagreement), 'look up to' (admire), 'grow apart' (become distant), 'make up' (reconcile after a fight).",
    "explanation_ko": "흔한 인간관계 구동사: 'get along with'(사이가 좋다), 'fall out with'(사이가 틀어지다), 'look up to'(존경하다), 'grow apart'(멀어지다), 'make up'(화해하다).",
    "key_expressions": [
      {
        "en": "I get along well with my coworkers.",
        "ko": "저는 동료들과 사이가 좋아요."
      },
      {
        "en": "I really look up to my grandmother.",
        "ko": "저는 할머니를 정말 존경해요."
      },
      {
        "en": "We made up after the argument.",
        "ko": "우리는 다툼 후에 화해했어요."
      }
    ]
  },
