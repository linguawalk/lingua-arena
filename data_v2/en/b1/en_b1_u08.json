    "title": "Zero Conditional",
    "title_ko": "0형 조건문",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Zero conditional (If/When + present simple, ... present simple) describes general truths and things that always happen: 'If you heat water to 100°C, it boils.' 'If' and 'when' are often interchangeable here.",
    "explanation_ko": "0형 조건문(If/When + 현재시제, ... 현재시제)은 일반적 진리와 항상 일어나는 일을 나타냅니다: 'If you heat water to 100°C, it boils.' 여기서는 'if'와 'when'을 종종 바꿔 쓸 수 있습니다.",
    "key_expressions": [
      {
        "en": "If you don't sleep enough, you feel tired.",
        "ko": "잠을 충분히 안 자면 피곤해요."
      },
      {
        "en": "Water freezes when the temperature drops.",
        "ko": "기온이 떨어지면 물이 얼어요."
      },
      {
        "en": "If people are kind, others usually respond kindly.",
        "ko": "사람들이 친절하면 보통 다른 사람들도 친절하게 반응해요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u08_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write two general truths using zero conditional (about nature, health, or human behavior).",
        "ko": "0형 조건문을 사용해서(자연, 건강, 인간 행동에 관한) 일반적 진리 두 개를 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "zero_conditional",
          "label_ko": "0형 조건문",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'If/When + 현재시제, 현재시제' 구조를 2회 이상 사용했는가",
          "type": "pattern_regex",
          "target": "(if|when)\\s+\\w+\\s+\\w+.{0,30}[,.]",
