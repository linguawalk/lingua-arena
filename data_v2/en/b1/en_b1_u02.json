    "unit": 2,
    "title": "Present Perfect Continuous",
    "title_ko": "현재완료 진행형",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Present perfect continuous (have/has been + verb-ing) emphasizes the duration of an activity that started in the past and continues, or has just stopped with visible results. Compare: 'I have written three reports' (result/count) vs 'I have been writing reports all day' (duration/process).",
    "explanation_ko": "현재완료 진행형(have/has been + 동사-ing)은 과거에 시작해 계속되거나 방금 끝났지만 결과가 남아있는 활동의 '지속 기간'을 강조합니다. 비교: 'I have written three reports'(결과/개수) vs 'I have been writing reports all day'(지속/과정).",
    "key_expressions": [
      {
        "en": "I've been working on this project for two months.",
        "ko": "저는 2개월째 이 프로젝트를 하고 있어요."
      },
      {
        "en": "She's been studying since morning.",
        "ko": "그녀는 아침부터 공부하고 있어요."
      },
      {
        "en": "How long have you been waiting?",
        "ko": "얼마나 오래 기다리고 있었어요?"
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u02_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a project or task you have been working on, including how long you've been doing it.",
        "ko": "진행 중인 프로젝트나 업무에 대해, 얼마나 오래 해오고 있는지 포함해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "present_perfect_continuous",
          "label_ko": "현재완료 진행형",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'have/has been + -ing'를 사용했는가",
          "type": "pattern_regex",
          "target": "(have|has)\\s+been\\s+\\w+ing",
          "min_matches": 1,
          "points": 50,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "기간 표현(for/since)을 사용했는가",
          "type": "keyword_match",
          "target": [
            "for",
            "since"
          ],
          "min_matches": 1,
          "points": 30,
          "required": false
        },
        {
          "id": "r3",
          "criterion_ko": "분량이 충분한가 (최소 15단어)",
          "type": "length_check",
          "unit": "words",
          "min": 15,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
