{
  "meta": {
    "id": "en_b1_u30",
    "domain": "language",
    "lang": "en",
    "level": "b1",
    "unit": 30,
    "title": "Present Perfect with Just/Already/Yet",
    "title_ko": "현재완료 + Just/Already/Yet",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "'Just' (in the middle) means very recently: 'I've just finished.' 'Already' (in the middle, or end for emphasis) means sooner than expected: 'I've already eaten.' 'Yet' (at the end, in negatives and questions) means 'up to now': 'I haven't finished yet.' 'Have you finished yet?'",
    "explanation_ko": "'just'(문장 중간)는 방금이라는 뜻입니다: 'I've just finished.' 'already'(중간, 강조 시 끝)는 예상보다 이르다는 뜻입니다: 'I've already eaten.' 'yet'(끝, 부정문·의문문)은 '아직까지'라는 뜻입니다: 'I haven't finished yet.' 'Have you finished yet?'",
    "key_expressions": [
      {
        "en": "I've just arrived home.",
        "ko": "저는 방금 집에 도착했어요."
      },
      {
        "en": "She's already left for work.",
        "ko": "그녀는 이미 출근했어요."
      },
      {
        "en": "Have you eaten lunch yet?",
        "ko": "점심 아직 안 드셨어요?"
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u30_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about your day so far, using 'just' for something you did very recently and 'already' for something you did sooner than expected.",
        "ko": "'just'로 방금 한 일, 'already'로 예상보다 일찍 한 일을 사용해서 오늘 하루에 대해 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "just",
          "label_ko": "just",
          "min_occurrences": 1
        },
        {
          "type": "grammar",
          "id": "already",
          "label_ko": "already",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'just'를 현재완료와 함께 사용했는가",
          "type": "pattern_regex",
          "target": "(have|has|'ve|'s)\\s+just\\s+\\w+",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'already'를 현재완료와 함께 사용했는가",
          "type": "pattern_regex",
