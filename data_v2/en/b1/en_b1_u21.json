    "title": "Comparatives & Superlatives (Advanced)",
    "title_ko": "고급 비교급·최상급",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Beyond basic forms, use 'much/a lot/far + comparative' to intensify a difference ('much more expensive'), and 'by far the + superlative' to emphasize a top ranking ('by far the best'). 'The more..., the more...' expresses a parallel increase.",
    "explanation_ko": "기본형을 넘어서, 차이를 강조할 때는 'much/a lot/far + 비교급'('much more expensive'), 최고 순위를 강조할 때는 'by far the + 최상급'('by far the best')을 씁니다. 'The more..., the more...'는 병행 증가를 나타냅니다.",
    "key_expressions": [
      {
        "en": "This year has been far busier than last year.",
        "ko": "올해가 작년보다 훨씬 더 바빴어요."
      },
      {
        "en": "It's by far the best restaurant in town.",
        "ko": "여기가 마을에서 단연 최고의 식당이에요."
      },
      {
        "en": "The more I practice, the more confident I feel.",
        "ko": "연습할수록 더 자신감이 생겨요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u21_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about something that is much better or far more important than an alternative, using an intensified comparative.",
        "ko": "어떤 대안보다 훨씬 낫거나 훨씬 더 중요한 것에 대해, 강조된 비교급을 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "intensified_comparative",
          "label_ko": "강조 비교급",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'much/far/a lot + 비교급'을 사용했는가",
          "type": "pattern_regex",
          "target": "(much|far|a lot)\\s+(more\\s+\\w+|\\w+er)",
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "^[A-Z].*[.!]$",
          "min_matches": 1,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
