    "title": "Question Tags",
    "title_ko": "부가의문문",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Question tags confirm information or invite agreement. A positive statement takes a negative tag, and a negative statement takes a positive tag: 'You're tired, aren't you?' 'You don't like coffee, do you?'",
    "explanation_ko": "부가의문문은 정보를 확인하거나 동의를 구할 때 씁니다. 긍정문에는 부정 부가의문문, 부정문에는 긍정 부가의문문을 씁니다: 'You're tired, aren't you?' 'You don't like coffee, do you?'",
    "key_expressions": [
      {
        "en": "This is your first time here, isn't it?",
        "ko": "여기 처음이시죠, 그렇죠?"
      },
      {
        "en": "You haven't finished yet, have you?",
        "ko": "아직 안 끝나셨죠, 그렇죠?"
      },
      {
        "en": "It's a nice day, isn't it?",
        "ko": "날씨 좋죠, 그렇죠?"
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u18_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write two sentences with question tags: one from a positive statement, one from a negative statement.",
        "ko": "부가의문문 문장 두 개를 써 보세요: 하나는 긍정문에서, 하나는 부정문에서 만드세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "question_tag",
          "label_ko": "부가의문문",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "부가의문문 구조(isn't it/don't you 등)를 2회 이상 사용했는가",
          "type": "pattern_regex",
          "target": ",\\s*(isn't|aren't|don't|doesn't|didn't|haven't|hasn't|wasn't|weren't|is|are|do|does|did|have|has|was|were)\\s+\\w+\\?",
          "min_matches": 2,
          "points": 60,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "문장이 2개 이상인가",
          "type": "pattern_regex",
          "target": "\\?",
          "min_matches": 2,
          "points": 40,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
