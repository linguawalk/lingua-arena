    "level": "b1",
    "unit": 22,
    "title": "So / Such",
    "title_ko": "So / Such (정도 강조)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "'So' goes directly before an adjective or adverb ('so tired', 'so quickly'). 'Such' goes before a noun (with an optional adjective): 'such a good idea', 'such nice weather'. Both are often followed by 'that' to show a result: 'It was so hot that we stayed inside.'",
    "explanation_ko": "'so'는 형용사·부사 바로 앞에 옵니다('so tired', 'so quickly'). 'such'는 명사 앞에 옵니다(형용사와 함께 쓰일 수도 있음): 'such a good idea', 'such nice weather'. 둘 다 결과를 나타내는 'that'과 자주 함께 쓰입니다: 'It was so hot that we stayed inside.'",
    "key_expressions": [
      {
        "en": "The movie was so boring that I fell asleep.",
        "ko": "영화가 너무 지루해서 잠들어버렸어요."
      },
      {
        "en": "It was such a great trip.",
        "ko": "정말 멋진 여행이었어요."
      },
      {
        "en": "She speaks so fast that I can't understand.",
        "ko": "그녀는 말이 너무 빨라서 못 알아듣겠어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u22_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write two sentences describing recent experiences: one using 'so + adjective', one using 'such a/an + noun'.",
        "ko": "최근 경험을 묘사하는 문장 두 개를 써 보세요: 하나는 'so + 형용사', 하나는 'such a/an + 명사'를 사용하세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "so_such",
          "label_ko": "so/such",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'so + 형용사'를 사용했는가",
          "type": "pattern_regex",
          "target": "\\bso\\s+\\w+",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'such a/an'을 사용했는가",
          "type": "pattern_regex",
          "target": "such\\s+(a|an)\\s+\\w+",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "문장이 2개 이상인가",
          "type": "pattern_regex",
          "target": "[.!]",
          "min_matches": 2,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
