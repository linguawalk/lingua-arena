    "title": "Reported Speech (Statements)",
    "title_ko": "간접화법 (평서문)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Reported speech relays what someone said without quoting directly. Verb tenses usually shift back one step: present→past, past→past perfect. 'I am tired' becomes 'She said (that) she was tired.'",
    "explanation_ko": "간접화법은 누군가 한 말을 직접 인용 없이 전달합니다. 시제가 보통 한 단계 뒤로 이동합니다: 현재→과거, 과거→과거완료. 'I am tired'는 'She said (that) she was tired'가 됩니다.",
    "key_expressions": [
      {
        "en": "She said (that) she was busy.",
        "ko": "그녀는 바쁘다고 말했어요."
      },
      {
        "en": "He told me he had already eaten.",
        "ko": "그는 벌써 먹었다고 저에게 말했어요."
      },
      {
        "en": "They said they would call back.",
        "ko": "그들은 다시 전화하겠다고 했어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u09_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "A friend told you: 'I'm moving to another city next month.' Write what your friend said, using reported speech.",
        "ko": "친구가 'I'm moving to another city next month.'라고 말했습니다. 간접화법으로 친구가 한 말을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "reported_statement",
          "label_ko": "간접화법 평서문",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'said (that)' 또는 'told me (that)'를 사용했는가",
          "type": "keyword_match",
          "target": [
            "said that",
            "said she",
            "said he",
            "told me"
          ],
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "시제가 한 단계 뒤로 이동했는가 (was/were 등)",
          "type": "pattern_regex",
          "target": "\\b(was|were|had)\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "^[A-Z].*[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
