    "title": "First Conditional",
    "title_ko": "1형 조건문",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "First conditional (If + present simple, ... will + base verb) describes a realistic future possibility and its likely result: 'If it rains tomorrow, I will stay home.'",
    "explanation_ko": "1형 조건문(If + 현재시제, ... will + 동사원형)은 현실적인 미래 가능성과 그 결과를 나타냅니다: 'If it rains tomorrow, I will stay home.'",
    "key_expressions": [
      {
        "en": "If I finish early, I'll call you.",
        "ko": "일찍 끝나면 전화할게요."
      },
      {
        "en": "If you don't hurry, we'll be late.",
        "ko": "서두르지 않으면 늦을 거예요."
      },
      {
        "en": "What will you do if it rains?",
        "ko": "비가 오면 뭐 할 거예요?"
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u06_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write two sentences about realistic future plans using first conditional (if + present, will + verb).",
        "ko": "1형 조건문(if + 현재, will + 동사)을 사용해서 현실적인 미래 계획 문장 두 개를 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "first_conditional",
          "label_ko": "1형 조건문",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'If + 현재시제'를 사용했는가",
          "type": "pattern_regex",
          "target": "\\bif\\s+\\w+\\s+\\w+",
          "min_matches": 1,
          "points": 35,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'will'을 사용했는가",
          "type": "keyword_match",
          "target": [
            "will",
            "'ll"
          ],
          "min_matches": 2,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "문장이 2개 이상인가",
          "type": "pattern_regex",
          "target": "[.!]",
          "min_matches": 2,
          "points": 25,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
