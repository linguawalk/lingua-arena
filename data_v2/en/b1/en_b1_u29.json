{
  "meta": {
    "id": "en_b1_u29",
    "domain": "language",
    "lang": "en",
    "level": "b1",
    "unit": 29,
    "title": "Defining vs Non-defining Relative Clauses",
    "title_ko": "한정적 vs 비한정적 관계절",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Defining relative clauses give essential information (no commas): 'The teacher who taught me math was strict.' Non-defining clauses add extra, non-essential information (with commas): 'My mother, who is 65, still works full-time.' Non-defining clauses cannot use 'that'.",
    "explanation_ko": "한정적 관계절은 필수 정보를 줍니다(콤마 없음): 'The teacher who taught me math was strict.' 비한정적 관계절은 부가적이고 필수는 아닌 정보를 더합니다(콤마 있음): 'My mother, who is 65, still works full-time.' 비한정적 관계절에는 'that'을 쓸 수 없습니다.",
    "key_expressions": [
      {
        "en": "The book that I recommended is on sale.",
        "ko": "제가 추천한 책이 세일 중이에요."
      },
      {
        "en": "My brother, who lives in Busan, is visiting this week.",
        "ko": "부산에 사는 제 남동생이 이번 주에 방문해요."
      },
      {
        "en": "This is the restaurant where we had our first date.",
        "ko": "여기가 우리가 첫 데이트를 한 식당이에요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u29_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write one sentence with a defining relative clause (no commas) and one with a non-defining relative clause (with commas), about people you know.",
        "ko": "아는 사람들에 대해, 한정적 관계절(콤마 없음) 문장 하나와 비한정적 관계절(콤마 있음) 문장 하나를 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "defining_clause",
          "label_ko": "한정적 관계절",
          "min_occurrences": 1
        },
        {
          "type": "grammar",
          "id": "nondefining_clause",
          "label_ko": "비한정적 관계절",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "콤마 없는 관계절을 사용했는가",
          "type": "pattern_regex",
          "target": "[a-z]\\s+(who|which|that)\\s+\\w+",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "콤마로 구분된 관계절을 사용했는가",
          "type": "pattern_regex",
          "target": ",\\s+(who|which)\\s+\\w+.{0,40},",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "문장이 2개 이상인가",
          "type": "pattern_regex",
          "target": "[.!]",
          "min_matches": 2,
          "points": 20,
          "required": false
        }
      ],
