    "title": "Passive Reporting Verbs",
    "title_ko": "수동태 보고 동사",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "News and academic English often report general beliefs impersonally: 'It is said that ...', 'It is believed that ...', or with the subject moved forward: 'She is thought to be the best candidate.' This avoids naming who exactly holds the belief.",
    "explanation_ko": "뉴스나 학술 영어는 일반적인 통념을 비인칭으로 보도하는 경우가 많습니다: 'It is said that ...', 'It is believed that ...', 또는 주어를 앞으로 옮겨서: 'She is thought to be the best candidate.' 누가 정확히 그렇게 믿는지 밝히지 않습니다.",
    "key_expressions": [
      {
        "en": "It is said that this restaurant has the best pasta in town.",
        "ko": "이 식당이 마을에서 최고의 파스타를 만든다고 해요."
      },
      {
        "en": "He is believed to have left the country.",
        "ko": "그는 출국한 것으로 알려져 있어요."
      },
      {
        "en": "It is reported that the road will be closed.",
        "ko": "그 도로가 폐쇄될 거라고 보도됐어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u07_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a popular belief or rumor about something (a place, a person, a trend), using 'It is said that' or 'It is believed that'.",
        "ko": "어떤 대상(장소, 사람, 트렌드)에 대한 통념이나 소문을 'It is said that' 또는 'It is believed that'을 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "passive_reporting",
          "label_ko": "수동태 보고 동사",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'It is said that' 또는 'It is believed that'를 사용했는가",
          "type": "keyword_match",
          "target": [
            "it is said that",
            "it is believed that",
            "it is reported that"
          ],
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
