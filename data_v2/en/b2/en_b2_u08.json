    "level": "b2",
    "unit": 8,
    "title": "Cleft Sentences",
    "title_ko": "분열문 (강조 구문)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Cleft sentences split a simple sentence into two parts to add emphasis. 'It was ... that ...' emphasizes a specific detail: 'It was John who called, not Mary.' 'What ... is/was ...' emphasizes an idea: 'What surprised me was the price.'",
    "explanation_ko": "분열문은 단순한 문장을 두 부분으로 나눠서 강조합니다. 'It was ... that ...'는 특정 세부사항을 강조합니다: 'It was John who called, not Mary.' 'What ... is/was ...'는 하나의 생각을 강조합니다: 'What surprised me was the price.'",
    "key_expressions": [
      {
        "en": "It was the manager who made the final decision.",
        "ko": "최종 결정을 내린 사람은 매니저였어요."
      },
      {
        "en": "What bothers me most is the noise.",
        "ko": "저를 가장 신경 쓰이게 하는 건 소음이에요."
      },
      {
        "en": "It wasn't until last year that I understood.",
        "ko": "작년이 되어서야 저는 이해했어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u08_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a specific person or detail that made a difference in a situation, using 'It was ... that/who ...'.",
        "ko": "어떤 상황에서 차이를 만들었던 특정 인물이나 세부사항을 'It was ... that/who ...'를 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "cleft_it",
          "label_ko": "It was...that 강조",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'It was ... that/who' 구조를 사용했는가",
          "type": "pattern_regex",
          "target": "it\\s+was\\s+\\w+.{0,20}(that|who)",
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
    {
