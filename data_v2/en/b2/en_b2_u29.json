      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about something you are looking forward to, using 'look forward to + -ing' correctly.",
        "ko": "'look forward to + -ing'를 올바르게 사용해서, 기대하고 있는 일에 대해 써 보세요."
      },
      "target_elements": [
