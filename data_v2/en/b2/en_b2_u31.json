    "level": "b2",
    "unit": 31,
    "title": "Advanced Passive in Academic Writing",
    "title_ko": "학술적 수동태",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Academic and formal writing uses passive voice to sound objective, avoiding 'I' or 'we': 'It has been observed that ...', 'It can be argued that ...', 'The data were analyzed using ...'. This shifts focus to the process or finding, not the researcher.",
    "explanation_ko": "학술적·격식적 글쓰기는 'I'나 'we'를 피하고 객관적으로 들리도록 수동태를 씁니다: 'It has been observed that ...', 'It can be argued that ...', 'The data were analyzed using ...'. 연구자가 아니라 과정이나 발견에 초점을 맞춥니다.",
    "key_expressions": [
      {
        "en": "It has been observed that habits change slowly.",
        "ko": "습관은 천천히 바뀐다는 것이 관찰되었어요."
      },
      {
        "en": "It can be argued that this approach is more effective.",
        "ko": "이 방식이 더 효과적이라고 주장할 수 있어요."
      },
      {
        "en": "The results were analyzed carefully.",
        "ko": "결과는 신중하게 분석되었어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u31_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a formal, objective-sounding statement about a trend you've noticed, using 'It has been observed that' or 'It can be argued that'.",
        "ko": "눈치챈 트렌드에 대해 'It has been observed that' 또는 'It can be argued that'를 사용해서 격식체·객관적인 문장을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "academic_passive",
          "label_ko": "학술적 수동태",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'It has been observed that' 또는 'It can be argued that'를 사용했는가",
          "type": "keyword_match",
          "target": [
            "it has been observed that",
            "it can be argued that",
            "it is believed that"
          ],
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
