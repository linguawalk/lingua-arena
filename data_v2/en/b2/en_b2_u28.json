    "title": "Advanced Gerund/Infinitive",
    "title_ko": "동명사·부정사 심화 (의미 차이)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Some verbs change meaning depending on gerund or infinitive: 'remember to do' (don't forget beforehand) vs 'remember doing' (recall a memory); 'stop to do' (pause in order to) vs 'stop doing' (quit an activity); 'try to do' (attempt) vs 'try doing' (experiment).",
    "explanation_ko": "일부 동사는 동명사냐 to부정사냐에 따라 뜻이 바뀝니다: 'remember to do'(미리 잊지 않고 하기) vs 'remember doing'(했던 것을 기억하기); 'stop to do'(하기 위해 멈추기) vs 'stop doing'(하던 것을 그만두기); 'try to do'(시도하다) vs 'try doing'(한번 해보다).",
    "key_expressions": [
      {
        "en": "I remember locking the door.",
        "ko": "저는 문을 잠갔던 걸 기억해요."
      },
      {
        "en": "Please remember to lock the door.",
        "ko": "문 잠그는 거 잊지 마세요."
      },
      {
        "en": "We stopped to take a photo.",
        "ko": "우리는 사진을 찍으려고 멈췄어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u28_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write two sentences: one using 'remember doing' (a memory) and one using 'remember to do' (a reminder), both correctly.",
        "ko": "'remember doing'(기억)과 'remember to do'(할 일 잊지 않기)를 각각 올바르게 사용한 문장 두 개를 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "remember_gerund_infinitive",
          "label_ko": "remember 동명사/부정사",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'remember + -ing'를 사용했는가",
          "type": "pattern_regex",
