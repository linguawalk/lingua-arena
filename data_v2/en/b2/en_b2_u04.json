{
  "meta": {
    "id": "en_b2_u04",
    "domain": "language",
    "lang": "en",
    "level": "b2",
    "unit": 4,
    "title": "Subjunctive Mood",
    "title_ko": "가정법 (격식체 제안)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "After verbs like 'suggest', 'recommend', 'insist', 'demand', use the base form of the verb (subjunctive), not -s or past tense, even in third person: 'I suggest that he call you' (not 'calls'). This is more common in formal English.",
    "explanation_ko": "'suggest', 'recommend', 'insist', 'demand' 같은 동사 뒤에는 3인칭이라도 동사원형(가정법)을 씁니다, -s나 과거형이 아닙니다: 'I suggest that he call you'('calls'가 아님). 격식체 영어에서 더 자주 쓰입니다.",
    "key_expressions": [
      {
        "en": "I recommend that she see a doctor.",
        "ko": "저는 그녀가 병원에 가보길 권해요."
      },
      {
        "en": "It's essential that everyone be on time.",
        "ko": "모두가 제시간에 오는 게 필수예요."
      },
      {
        "en": "They insisted that he apologize.",
        "ko": "그들은 그가 사과해야 한다고 주장했어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u04_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a formal recommendation to a colleague, using 'I recommend that' or 'I suggest that' with the subjunctive.",
        "ko": "동료에게 격식체 권고를, 가정법을 사용한 'I recommend that' 또는 'I suggest that'로 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "subjunctive",
          "label_ko": "가정법",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'recommend that' 또는 'suggest that'를 사용했는가",
          "type": "keyword_match",
          "target": [
            "recommend that",
            "suggest that"
          ],
          "min_matches": 1,
          "points": 45,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "동사원형(가정법)을 사용했는가",
          "type": "pattern_regex",
          "target": "that\\s+(he|she|it)\\s+\\b[a-z]+\\b(?!s\\b)",
          "min_matches": 1,
          "points": 35,
          "required": false
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
