    "unit": 11,
    "title": "Modals of Past Speculation",
    "title_ko": "과거 추측 조동사",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "To speculate about the past, use 'must/might/could/can't + have + past participle': 'She must have forgotten' (strong certainty), 'He might have left already' (possibility), 'They can't have known' (strong negative certainty).",
    "explanation_ko": "과거에 대해 추측할 때는 'must/might/could/can't + have + 과거분사'를 씁니다: 'She must have forgotten'(강한 확신), 'He might have left already'(가능성), 'They can't have known'(강한 부정적 확신).",
    "key_expressions": [
      {
        "en": "He must have missed the train.",
        "ko": "그는 기차를 놓친 게 틀림없어요."
      },
      {
        "en": "She might have forgotten about the meeting.",
        "ko": "그녀는 회의를 잊어버렸을 수도 있어요."
      },
      {
        "en": "They can't have left already; it's too early.",
        "ko": "그들이 벌써 떠났을 리가 없어요, 너무 일러요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u11_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "A colleague didn't show up to a meeting. Write two guesses about why, using 'must have' and 'might have'.",
        "ko": "동료가 회의에 안 왔습니다. 'must have'와 'might have'를 사용해서 이유를 두 가지 추측해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "past_modal_deduction",
          "label_ko": "과거 추측 조동사",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'must have + 과거분사'를 사용했는가",
          "type": "pattern_regex",
          "target": "must\\s+have\\s+\\w+",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'might have + 과거분사'를 사용했는가",
          "type": "pattern_regex",
          "target": "might\\s+have\\s+\\w+",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "문장이 2개 이상인가",
          "type": "pattern_regex",
          "target": "[.!]",
          "min_matches": 2,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
