      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write constructive feedback about a mistake a coworker made, combining empathy with 'should have'.",
        "ko": "동료가 저지른 실수에 대해, 공감과 'should have'를 결합해서 건설적인 피드백을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "constructive_criticism",
          "label_ko": "건설적 비판",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'I understand ..., but'를 사용했는가",
          "type": "keyword_match",
          "target": [
            "i understand",
