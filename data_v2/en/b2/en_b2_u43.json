    "level": "b2",
    "unit": 43,
    "title": "Advanced Modals for Past Deduction",
    "title_ko": "과거 추측 조동사 종합",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Combining modals of past deduction with continuous forms adds nuance: 'must have been doing' (an ongoing past action), 'can't have known' (strong negative certainty), 'should have arrived by now' (an expectation that hasn't been met).",
    "explanation_ko": "과거 추측 조동사와 진행형을 결합하면 뉘앙스가 더해집니다: 'must have been doing'(진행 중이던 과거 행동), 'can't have known'(강한 부정적 확신), 'should have arrived by now'(충족되지 않은 기대).",
    "key_expressions": [
      {
        "en": "She must have been sleeping when I called.",
        "ko": "제가 전화했을 때 그녀는 자고 있었던 게 틀림없어요."
      },
      {
        "en": "He can't have known about the change.",
        "ko": "그는 변경 사항을 알았을 리가 없어요."
      },
      {
        "en": "They should have arrived by now.",
        "ko": "그들은 지금쯤 도착했어야 해요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u43_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a delayed friend, using 'should have arrived by now' and a guess with 'must have been'.",
        "ko": "늦는 친구에 대해, 'should have arrived by now'와 'must have been'을 사용한 추측을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "advanced_past_modal",
          "label_ko": "과거 추측 조동사",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'should have + 과거분사'를 사용했는가",
          "type": "pattern_regex",
          "target": "should\\s+have\\s+\\w+",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'must have been + -ing'를 사용했는가",
          "type": "pattern_regex",
          "target": "must\\s+have\\s+been\\s+\\w+ing",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
