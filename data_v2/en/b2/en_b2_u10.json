    "level": "b2",
    "unit": 10,
    "title": "Ellipsis and Substitution",
    "title_ko": "생략과 대용 표현",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Native speakers avoid repeating verbs by using substitution: 'So' agrees with a positive statement ('I think so'), 'neither/nor' agrees with a negative one ('Neither do I'), and 'do so' replaces a repeated action ('If you want to leave, you may do so').",
    "explanation_ko": "원어민은 동사 반복을 피하기 위해 대용 표현을 씁니다: 'so'는 긍정문에 동의할 때('I think so'), 'neither/nor'는 부정문에 동의할 때('Neither do I'), 'do so'는 반복되는 행동을 대신합니다('If you want to leave, you may do so').",
    "key_expressions": [
      {
        "en": "I hope so.",
        "ko": "그러길 바라요."
      },
      {
        "en": "I don't like it either. — Neither do I.",
        "ko": "저도 그거 안 좋아해요. — 저도요."
      },
      {
        "en": "If you'd like to comment, please do so.",
        "ko": "의견이 있으시면 그렇게 해주세요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u10_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a short exchange (2 lines) where one person makes a statement and the other agrees using 'so' or 'neither'.",
        "ko": "한 사람이 말하고 다른 사람이 'so' 또는 'neither'로 동의하는 짧은 대화(2줄)를 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "ellipsis_so",
          "label_ko": "so/neither 대용",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'I think so' 또는 'Neither do I' 유형 구조를 사용했는가",
          "type": "keyword_match",
          "target": [
