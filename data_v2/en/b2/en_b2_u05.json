{
  "meta": {
    "id": "en_b2_u05",
    "domain": "language",
    "lang": "en",
    "level": "b2",
    "unit": 5,
    "title": "Mixed Conditionals",
    "title_ko": "혼합 조건문",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Mixed conditionals combine different time frames within one sentence: a past condition with a present result ('If I had taken that job, I would be living abroad now'), or a present/general condition with a past result ('If she weren't so shy, she would have spoken up yesterday').",
    "explanation_ko": "혼합 조건문은 한 문장 안에서 서로 다른 시간대를 결합합니다: 과거 조건 + 현재 결과('If I had taken that job, I would be living abroad now'), 또는 현재·일반 조건 + 과거 결과('If she weren't so shy, she would have spoken up yesterday').",
    "key_expressions": [
      {
        "en": "If I had studied harder, I would have a better job now.",
        "ko": "더 열심히 공부했다면 지금 더 좋은 직업을 가졌을 거예요."
      },
      {
        "en": "If he weren't so busy, he would have come to the party.",
        "ko": "그가 그렇게 바쁘지 않았다면 파티에 왔을 거예요."
      },
      {
        "en": "If I were more confident, I would have applied for that job.",
        "ko": "제가 더 자신감이 있었다면 그 일자리에 지원했을 거예요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u05_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about how your past decisions affect your present life, using a mixed conditional (past condition, present result).",
        "ko": "과거의 결정이 지금 삶에 어떤 영향을 미쳤는지, 혼합 조건문(과거 조건, 현재 결과)을 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "mixed_conditional",
          "label_ko": "혼합 조건문",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'If + had + 과거분사'를 사용했는가",
          "type": "pattern_regex",
          "target": "if\\s+i\\s+had\\s+\\w+ed\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'would + 동사원형' (현재 결과)을 사용했는가",
          "type": "pattern_regex",
          "target": "would\\s+(be|have|live|know)\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
    {
      "id": "en_b2_u05_w2",
      "skill": "writing",
      "task_type": "qa_response",
      "prompt": {
        "en": "Someone asks: 'If your personality were different, how might your past have gone differently?' Write your answer using a mixed conditional.",
        "ko": "'If your personality were different, how might your past have gone differently?'라는 질문에 혼합 조건문을 사용해서 답을 써 보세요."
