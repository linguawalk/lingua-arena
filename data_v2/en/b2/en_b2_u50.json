  "context": {
    "explanation_en": "This review unit brings together B2's advanced grammar areas: inversion, participle clauses, mixed conditionals, advanced modals, cleft sentences, and formal discourse markers — the tools needed to argue, persuade, and write or speak with sophistication and precision.",
    "explanation_ko": "이번 복습 유닛은 B2의 고급 문법 영역을 종합합니다: 도치, 분사구문, 혼합 조건문, 고급 조동사, 분열문, 격식체 담화 표지 — 논증하고, 설득하고, 세련되고 정교하게 글쓰기·말하기를 하는 데 필요한 도구들입니다.",
    "key_expressions": [
      {
        "en": "Having considered all the options, we concluded that the risks far outweighed the benefits.",
        "ko": "모든 선택지를 고려한 후, 우리는 위험이 이익을 훨씬 능가한다고 결론지었어요."
      },
      {
        "en": "Never have I seen such a well-argued proposal.",
        "ko": "이렇게 논리정연한 제안은 본 적이 없어요."
      },
      {
        "en": "In conclusion, it is clear that further discussion is needed.",
        "ko": "결론적으로, 추가 논의가 필요하다는 게 명확해요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u50_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a formal paragraph presenting an argument: use a participle clause to open, a signposting phrase, a piece of evidence with a complex noun phrase, and a formal conclusion.",
        "ko": "논증을 제시하는 격식체 문단을 써 보세요: 분사구문으로 시작하고, 담화 표지를 쓰고, 복합 명사구로 근거를 제시하고, 격식체 결론으로 마무리하세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "participle_present",
          "label_ko": "분사구문",
          "min_occurrences": 1
        },
        {
          "type": "grammar",
          "id": "conclusion_phrase",
          "label_ko": "결론 표현",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "-ing로 시작하는 분사구문을 사용했는가",
          "type": "pattern_regex",
          "target": "^\\w+ing\\b",
          "min_matches": 1,
          "points": 25,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "담화 표지(Firstly/A further point)를 사용했는가",
          "type": "keyword_match",
          "target": [
            "firstly",
            "a further point",
            "in addition"
          ],
          "min_matches": 1,
          "points": 25,
          "required": false
        },
        {
          "id": "r3",
          "criterion_ko": "'In conclusion' 또는 'To sum up'을 사용했는가",
          "type": "keyword_match",
          "target": [
            "in conclusion",
            "to sum up",
            "overall"
          ],
          "min_matches": 1,
          "points": 30,
          "required": true
        },
        {
          "id": "r4",
          "criterion_ko": "분량이 충분한가 (최소 35단어)",
          "type": "length_check",
          "unit": "words",
          "min": 35,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
