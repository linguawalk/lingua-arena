    "title": "Advanced Passive",
    "title_ko": "고급 수동태",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Passive voice combines with modals ('The issue must be fixed'), and causative passive expresses arranging for something to be done ('I had my car serviced'). These are common in professional and formal contexts.",
    "explanation_ko": "수동태는 조동사와 결합하기도 하고('The issue must be fixed'), 사역 수동태는 무언가를 맡겨서 처리하는 것을 나타냅니다('I had my car serviced'). 전문적·격식적 맥락에서 흔합니다.",
    "key_expressions": [
      {
        "en": "This issue should be resolved immediately.",
        "ko": "이 문제는 즉시 해결되어야 해요."
      },
      {
        "en": "The contract needs to be signed by Friday.",
        "ko": "계약서는 금요일까지 서명되어야 해요."
      },
      {
        "en": "All applications will be reviewed carefully.",
        "ko": "모든 지원서는 신중하게 검토될 거예요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u06_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a task at work that must be completed soon, using passive voice with a modal (should be, must be, needs to be).",
        "ko": "곧 완료되어야 하는 업무에 대해, 조동사가 결합된 수동태(should be, must be, needs to be)를 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "passive_modal",
          "label_ko": "조동사+수동태",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'조동사 + be + 과거분사' 구조를 사용했는가",
          "type": "pattern_regex",
          "target": "(should|must|needs to|has to|will)\\s+be\\s+\\w+ed\\b",
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
