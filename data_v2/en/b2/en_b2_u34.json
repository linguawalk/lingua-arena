    "title": "Advanced Conditionals Review",
    "title_ko": "조건문 종합복습",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "At this level, review means choosing the exact right conditional (zero, first, second, third, or mixed) for a nuanced situation, and combining conditionals with other advanced structures like inversion: 'Had I known, I would have acted differently' (inverted third conditional, more formal than 'If I had known').",
    "explanation_ko": "이 레벨에서 복습은 미묘한 상황에 정확히 맞는 조건문(0형, 1형, 2형, 3형, 혼합형)을 고르고, 도치 같은 다른 고급 구조와 결합하는 것을 뜻합니다: 'Had I known, I would have acted differently'(3형 조건문 도치, 'If I had known'보다 더 격식적).",
    "key_expressions": [
      {
        "en": "Had I known about the traffic, I would have left earlier.",
        "ko": "교통 상황을 알았다면 더 일찍 나섰을 거예요."
      },
      {
        "en": "Were I in your position, I would take the offer.",
        "ko": "제가 당신 입장이라면 그 제안을 받아들일 거예요."
      },
      {
        "en": "Should you need anything, please let me know.",
        "ko": "필요한 게 있으시면 알려주세요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u34_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a formal sentence using inverted conditional structure ('Had I ...', 'Were I ...', or 'Should you ...').",
        "ko": "도치 조건문 구조('Had I ...', 'Were I ...', 또는 'Should you ...')를 사용해서 격식체 문장을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "inverted_conditional",
          "label_ko": "도치 조건문",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'Had I', 'Were I', 'Should you' 도치 구조를 사용했는가",
          "type": "pattern_regex",
          "target": "^(had|were|should)\\s+(i|you|he|she|we|they)\\b",
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
    {
