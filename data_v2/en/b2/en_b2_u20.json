    "unit": 20,
    "title": "Nominalization",
    "title_ko": "명사화 (격식체 글쓰기)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Nominalization turns verbs/adjectives into nouns for more formal, academic-sounding writing: 'decide' → 'decision', 'analyze' → 'analysis', 'improve' → 'improvement'. Compare: 'We decided quickly' (casual) vs 'Our decision was made quickly' (formal).",
    "explanation_ko": "명사화는 동사·형용사를 명사로 바꿔 더 격식적이고 학술적으로 들리게 합니다: 'decide' → 'decision', 'analyze' → 'analysis', 'improve' → 'improvement'. 비교: 'We decided quickly'(캐주얼) vs 'Our decision was made quickly'(격식).",
    "key_expressions": [
      {
        "en": "The improvement in sales was significant.",
        "ko": "매출의 개선이 상당했어요."
      },
      {
        "en": "Our analysis shows a clear trend.",
        "ko": "저희 분석은 명확한 추세를 보여줘요."
      },
      {
        "en": "The decision will be announced tomorrow.",
        "ko": "그 결정은 내일 발표될 거예요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u20_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a formal sentence about a recent change or improvement at your work or school, using a nominalized noun (improvement, decision, analysis, development).",
        "ko": "직장이나 학교의 최근 변화·개선에 대해, 명사화된 명사(improvement, decision, analysis, development)를 사용해서 격식체 문장을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "nominalization",
          "label_ko": "명사화",
          "min_occurrences": 1
        }
      ],
