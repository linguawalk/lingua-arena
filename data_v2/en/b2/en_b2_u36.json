    "title": "Hypothetical Past with Modals",
    "title_ko": "가정법 과거의 조동사",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "'Would have', 'could have', and 'might have' express different degrees of certainty about hypothetical past outcomes: 'I would have helped' (definite intention), 'I could have helped' (ability, unused), 'I might have helped' (uncertain possibility).",
    "explanation_ko": "'would have', 'could have', 'might have'는 가정 속 과거 결과에 대해 서로 다른 확신 정도를 나타냅니다: 'I would have helped'(확실한 의도), 'I could have helped'(가능했지만 안 함), 'I might have helped'(불확실한 가능성).",
    "key_expressions": [
      {
        "en": "I would have called, but my phone died.",
        "ko": "전화하려 했는데 휴대폰이 꺼졌어요."
      },
      {
        "en": "We could have won if we had tried harder.",
        "ko": "더 열심히 했다면 이길 수도 있었어요."
      },
      {
        "en": "She might have said yes if you had asked nicely.",
        "ko": "정중하게 부탁했다면 그녀가 그러겠다고 했을지도 몰라요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u36_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a missed opportunity, using 'could have' and 'would have' to show the difference between ability and intention.",
        "ko": "놓친 기회에 대해, 'could have'와 'would have'를 사용해서 가능성과 의도의 차이를 보여주며 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "could_have",
          "label_ko": "could have",
          "min_occurrences": 1
        },
        {
          "type": "grammar",
