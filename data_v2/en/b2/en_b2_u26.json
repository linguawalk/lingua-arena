  "context": {
    "explanation_en": "Very polite or tentative questions: 'I wonder if you could help me' (softer than 'Can you help me?'), 'Would you mind if I opened the window?' (asking permission very politely, followed by past simple).",
    "explanation_ko": "매우 정중하거나 조심스러운 질문: 'I wonder if you could help me'('Can you help me?'보다 부드러움), 'Would you mind if I opened the window?'(아주 정중하게 허락을 구함, 뒤에 과거시제).",
    "key_expressions": [
      {
        "en": "I wonder if you could send me the file.",
        "ko": "혹시 파일을 보내주실 수 있을까 해서요."
      },
      {
        "en": "Would you mind if I asked a question?",
        "ko": "질문 하나 드려도 될까요?"
      },
      {
        "en": "I was wondering whether you'd have time this week.",
        "ko": "혹시 이번 주에 시간이 있으실까 해서요."
      }
    ]
  },
