    "unit": 2,
    "title": "Participle Clauses (Present)",
    "title_ko": "분사구문 (현재분사)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Present participle clauses (-ing) combine two related actions into one sentence, making writing more concise and sophisticated: 'Having finished the report, she left the office' (= After she finished, she left). They often replace 'because', 'after', or 'and'.",
    "explanation_ko": "현재분사구문(-ing)은 관련된 두 행동을 한 문장으로 결합해 글을 더 간결하고 세련되게 만듭니다: 'Having finished the report, she left the office'(끝낸 후 떠남). 'because', 'after', 'and'를 대체하는 경우가 많습니다.",
    "key_expressions": [
      {
        "en": "Feeling tired, I decided to go to bed early.",
        "ko": "피곤함을 느껴서 저는 일찍 자기로 했어요."
      },
      {
        "en": "Having finished the project, we celebrated.",
        "ko": "프로젝트를 끝낸 후 우리는 축하했어요."
      },
      {
        "en": "Not knowing what to say, she stayed quiet.",
        "ko": "뭐라고 해야 할지 몰라서 그녀는 조용히 있었어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u02_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a decision you made, using a present participle clause ('Feeling ~, I ...' or 'Having ~, I ...').",
        "ko": "내린 결정에 대해 현재분사구문('Feeling ~, I ...' 또는 'Having ~, I ...')을 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "participle_present",
          "label_ko": "현재분사구문",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "문장이 -ing로 시작하는가",
          "type": "pattern_regex",
          "target": "^\\w+ing\\b",
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
