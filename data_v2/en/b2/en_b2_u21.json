{
  "meta": {
    "id": "en_b2_u21",
    "domain": "language",
    "lang": "en",
    "level": "b2",
    "unit": 21,
    "title": "Complex Sentences with Multiple Clauses",
    "title_ko": "복합절 (다중절 문장)",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Advanced speakers combine multiple clause types in one sentence for sophistication: a relative clause + a time clause + a main clause: 'The book that I mentioned, which was written by a friend, will be published when the editing is finished.'",
    "explanation_ko": "고급 화자는 한 문장에 여러 절 유형을 결합해 세련되게 표현합니다: 관계절 + 시간절 + 주절: 'The book that I mentioned, which was written by a friend, will be published when the editing is finished.'",
    "key_expressions": [
      {
        "en": "The project, which took months to complete, was praised by everyone who saw it.",
        "ko": "몇 달이 걸린 그 프로젝트는 본 모든 사람에게 칭찬받았어요."
      },
      {
        "en": "When I finally found the file that I had lost, I was relieved.",
        "ko": "잃어버렸던 파일을 드디어 찾았을 때 저는 안심했어요."
      },
      {
        "en": "Although it was late, we stayed because the discussion, which was important, wasn't finished.",
        "ko": "늦었지만, 중요했던 논의가 끝나지 않아서 우리는 남았어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u21_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write one complex sentence about a project or event, combining a relative clause and a time clause (when/while/after).",
        "ko": "프로젝트나 사건에 대해, 관계절과 시간절(when/while/after)을 결합한 복합절 문장 하나를 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "complex_sentence",
          "label_ko": "복합절",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "관계대명사(who/which/that)를 사용했는가",
          "type": "pattern_regex",
          "target": "\\b(who|which|that)\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "시간절 접속사(when/while/after/before)를 사용했는가",
          "type": "keyword_match",
          "target": [
            "when",
            "while",
            "after",
            "before"
          ],
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "분량이 충분한가 (최소 18단어)",
          "type": "length_check",
          "unit": "words",
          "min": 18,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
