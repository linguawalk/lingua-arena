      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Describe a colleague or professional contact using a formal relative clause with 'with whom' or 'for whom'.",
        "ko": "동료나 업무상 인맥을 'with whom' 또는 'for whom'을 사용한 격식체 관계절로 묘사해 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "preposition_relative",
          "label_ko": "전치사+관계대명사",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'전치사 + whom/which' 구조를 사용했는가",
