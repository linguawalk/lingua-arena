    "unit": 14,
    "title": "Purpose Clauses",
    "title_ko": "목적절",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "'So that' + subject + verb expresses purpose with a full clause: 'I left early so that I wouldn't be late.' 'In order to' and 'so as to' + base verb are more formal and require the same subject in both clauses: 'I left early in order to avoid traffic.'",
    "explanation_ko": "'so that' + 주어 + 동사는 완전한 절로 목적을 나타냅니다: 'I left early so that I wouldn't be late.' 'in order to'와 'so as to' + 동사원형은 더 격식적이며 두 절의 주어가 같아야 합니다: 'I left early in order to avoid traffic.'",
    "key_expressions": [
      {
        "en": "I saved money so that I could travel.",
        "ko": "저는 여행할 수 있도록 돈을 모았어요."
      },
      {
        "en": "She studied hard in order to pass the exam.",
        "ko": "그녀는 시험에 합격하기 위해 열심히 공부했어요."
      },
      {
        "en": "We left early so as not to miss the train.",
        "ko": "우리는 기차를 놓치지 않으려고 일찍 나섰어요."
      }
    ]
  },
