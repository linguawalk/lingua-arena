    "title": "Future in the Past",
    "title_ko": "과거 속의 미래",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "'Was/were going to' and 'would' describe a plan or prediction made in the past, viewed from a past perspective — often something that didn't happen: 'I was going to call you, but I forgot.' 'She said she would help, but she never did.'",
    "explanation_ko": "'was/were going to'와 'would'는 과거 관점에서 세워진 계획이나 예측을 나타내며, 자주 실현되지 않은 일을 표현합니다: 'I was going to call you, but I forgot.' 'She said she would help, but she never did.'",
    "key_expressions": [
      {
        "en": "We were going to travel, but the trip got canceled.",
        "ko": "우리는 여행 갈 예정이었지만 여행이 취소됐어요."
      },
      {
        "en": "He said he would finish it by Friday.",
        "ko": "그는 금요일까지 끝내겠다고 했어요."
      },
      {
        "en": "I was about to leave when the phone rang.",
        "ko": "막 나가려던 참에 전화가 울렸어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u18_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a plan that didn't work out as expected, using 'was/were going to' + but.",
        "ko": "예상대로 되지 않았던 계획에 대해 'was/were going to' + but을 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "future_in_past",
          "label_ko": "과거 속의 미래",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'was/were going to'를 사용했는가",
          "type": "pattern_regex",
          "target": "(was|were)\\s+going\\s+to",
          "min_matches": 1,
          "points": 45,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'but'을 사용했는가",
          "type": "keyword_match",
          "target": [
            "but"
          ],
          "min_matches": 1,
          "points": 35,
          "required": false
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
