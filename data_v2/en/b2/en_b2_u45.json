    "title": "Advanced Passive with Get",
    "title_ko": "Get 수동태",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "'Get + past participle' is an informal passive alternative to 'be + past participle', often implying something sudden, unexpected, or the subject's involvement: 'I got promoted!' (more dynamic than 'I was promoted') 'The window got broken during the storm.'",
    "explanation_ko": "'get + 과거분사'는 'be + 과거분사'의 비격식적 대안이며, 갑작스럽거나 예상치 못한 일, 또는 주어의 관여를 암시합니다: 'I got promoted!'('I was promoted'보다 더 역동적) 'The window got broken during the storm.'",
    "key_expressions": [
      {
        "en": "I got promoted last month!",
        "ko": "저 지난달에 승진했어요!"
      },
      {
        "en": "My phone got stolen on the subway.",
        "ko": "제 휴대폰을 지하철에서 도둑맞았어요."
      },
      {
        "en": "We got invited to the wedding.",
        "ko": "우리는 결혼식에 초대받았어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u45_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about something sudden or unexpected that happened to you, using 'get/got + past participle'.",
        "ko": "당신에게 일어난 갑작스럽거나 예상치 못한 일을 'get/got + 과거분사'를 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "get_passive",
          "label_ko": "get 수동태",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'got + 과거분사'를 사용했는가",
          "type": "pattern_regex",
          "target": "got\\s+\\w+ed\\b|got\\s+(stolen|invited|promoted|hurt|fired)",
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
