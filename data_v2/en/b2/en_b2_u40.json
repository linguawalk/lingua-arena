    "unit": 40,
    "title": "Advanced Preposition + Gerund Combinations",
    "title_ko": "전치사 + 동명사 조합",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "After a preposition, English always uses a gerund (-ing), never a base verb or infinitive: 'interested in learning', 'good at solving', 'worried about losing', 'instead of waiting'. This applies even when the meaning feels like 'to + verb' in other languages.",
    "explanation_ko": "전치사 뒤에는 영어에서 항상 동명사(-ing)를 씁니다, 동사원형이나 to부정사가 아닙니다: 'interested in learning', 'good at solving', 'worried about losing', 'instead of waiting'. 다른 언어에서는 'to + 동사'처럼 느껴져도 마찬가지입니다.",
    "key_expressions": [
      {
        "en": "I'm interested in learning Spanish next.",
        "ko": "저는 다음에 스페인어를 배우는 데 관심 있어요."
      },
      {
        "en": "She's good at solving problems quickly.",
        "ko": "그녀는 문제를 빨리 해결하는 데 능해요."
      },
      {
        "en": "Instead of complaining, he found a solution.",
        "ko": "불평하는 대신 그는 해결책을 찾았어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b2_u40_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a skill you're good at and something you're interested in learning, using 'good at + -ing' and 'interested in + -ing'.",
        "ko": "'good at + -ing'와 'interested in + -ing'를 사용해서 잘하는 것과 배우고 싶은 것에 대해 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "preposition_gerund",
          "label_ko": "전치사+동명사",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'good at + -ing'를 사용했는가",
          "type": "pattern_regex",
          "target": "good\\s+at\\s+\\w+ing",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'interested in + -ing'를 사용했는가",
          "type": "pattern_regex",
          "target": "interested\\s+in\\s+\\w+ing",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
