      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "You are in a clothing store. Write what you would say to ask about a shirt you like (size, color).",
        "ko": "당신은 옷 가게에 있습니다. 마음에 드는 셔츠에 대해(사이즈, 색깔) 물어볼 말을 써 보세요."
      },
      "target_elements": [
        {
          "type": "expression",
