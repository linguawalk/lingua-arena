  "context": {
    "explanation_en": "This unit's key expressions: talking about what you want to buy using demonstratives (this/that).",
    "explanation_ko": "이번 유닛의 핵심 표현: 지시대명사(this/that)로 사고 싶은 것 말하기",
    "key_expressions": [
      {
        "en": "I want to buy this/that.",
        "ko": "저는 이것을/저것을 사고 싶어요."
      },
      {
        "en": "Do you have a bigger size?",
        "ko": "더 큰 사이즈 있어요?"
      },
      {
        "en": "I'll take it.",
        "ko": "이걸로 살게요."
      }
    ]
  },
  "tasks": [
