    "key_expressions": [
      {
        "en": "After breakfast, I go to work.",
        "ko": "아침 식사 후에 저는 출근해요."
      },
      {
        "en": "Before I sleep, I read a book.",
        "ko": "자기 전에 저는 책을 읽어요."
      },
      {
        "en": "When I get home, I cook dinner.",
        "ko": "집에 도착하면 저는 저녁을 요리해요."
      }
