          "min_matches": 1,
          "points": 25,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "취미 표현(like/enjoy + -ing)을 사용했는가",
          "type": "pattern_regex",
          "target": "(like|enjoy)\\s+\\w+ing",
          "min_matches": 1,
          "points": 25,
          "required": true
