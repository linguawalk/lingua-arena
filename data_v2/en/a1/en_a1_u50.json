          "id": "name_intro",
          "label_ko": "이름 소개",
          "min_occurrences": 1
        },
        {
          "type": "expression",
          "id": "past_verb",
          "label_ko": "과거시제 동사",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'My name is'를 사용했는가",
