      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a short self-introduction paragraph including your name, job or school, a hobby, and one thing you did recently.",
        "ko": "이름, 직업/학교, 취미, 최근에 한 일을 포함한 짧은 자기소개 문단을 써 보세요."
      },
      "target_elements": [
