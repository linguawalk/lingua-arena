      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "A tourist asks you where the nearest bank is. Write directions using at least two direction words.",
        "ko": "관광객이 가장 가까운 은행이 어디인지 묻습니다. 방향 표현을 두 개 이상 사용해서 길을 알려 주세요."
      },
      "target_elements": [
