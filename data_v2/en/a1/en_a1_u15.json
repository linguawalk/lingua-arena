  "context": {
    "explanation_en": "This unit's key expressions: small talk about weather and giving simple weather-based suggestions.",
    "explanation_ko": "이번 유닛의 핵심 표현: 날씨에 대한 스몰토크, 날씨 관련 간단한 제안하기",
    "key_expressions": [
      {
        "en": "Nice weather today, isn't it?",
        "ko": "오늘 날씨 좋죠, 그렇죠?"
      },
      {
        "en": "You should take an umbrella.",
        "ko": "우산을 챙기는 게 좋겠어요."
      },
      {
        "en": "I hope it doesn't rain.",
        "ko": "비가 안 오면 좋겠어요."
      }
    ]
  },
