      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a short weather-related small talk exchange (2-3 lines) between two people meeting outside.",
        "ko": "밖에서 만난 두 사람이 나누는 날씨 스몰토크 대화(2~3줄)를 써 보세요."
      },
      "target_elements": [
        {
          "type": "expression",
          "id": "small_talk",
          "label_ko": "스몰토크 표현",
