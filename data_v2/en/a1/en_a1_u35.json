  "context": {
    "explanation_en": "This unit's key expressions: talking about past events using simple past verbs (went, ate, saw).",
    "explanation_ko": "이번 유닛의 핵심 표현: 과거시제 동사(went, ate, saw)로 지난 일 말하기",
    "key_expressions": [
      {
        "en": "I went to ~ yesterday.",
        "ko": "저는 어제 ~에 갔어요."
      },
      {
        "en": "I ate/saw ~.",
        "ko": "저는 ~을 먹었어요/봤어요."
      },
      {
        "en": "It was fun/great.",
        "ko": "재미있었어요/좋았어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_a1_u35_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about something you did last weekend. Use at least two past tense verbs.",
        "ko": "지난 주말에 한 일에 대해 써 보세요. 과거시제 동사를 두 개 이상 사용하세요."
      },
      "target_elements": [
        {
          "type": "expression",
          "id": "past_verb",
          "label_ko": "과거시제 동사",
          "min_occurrences": 2
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "과거시제 동사를 2개 이상 사용했는가",
          "type": "pattern_regex",
          "target": "\\b(went|ate|saw|played|watched|visited|had)\\b",
          "min_matches": 2,
          "points": 50,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'last weekend' 또는 시간 표현을 사용했는가",
          "type": "keyword_match",
          "target": [
            "last weekend",
            "yesterday",
            "last week"
          ],
          "min_matches": 1,
          "points": 30,
          "required": false
        },
        {
          "id": "r3",
