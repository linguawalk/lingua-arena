    "lang": "en",
    "level": "b1",
    "unit": 35,
    "title": "Adjective Order",
    "title_ko": "형용사 순서",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "When using multiple adjectives, English follows a rough order: opinion, size, age, shape, color, origin, material, purpose + noun: 'a beautiful, small, old, round, blue, Italian, glass vase.' Native speakers rarely use all of these at once, but getting 2-3 in order matters.",
    "explanation_ko": "형용사를 여러 개 쓸 때 영어는 대략 이런 순서를 따릅니다: 의견-크기-나이-모양-색깔-출신-재료-용도+명사: 'a beautiful, small, old, round, blue, Italian, glass vase.' 원어민도 이걸 다 한 번에 쓰는 일은 드물지만, 2~3개 순서는 중요합니다.",
    "key_expressions": [
      {
        "en": "She has a beautiful old wooden table.",
        "ko": "그녀는 아름답고 오래된 나무 탁자를 가지고 있어요."
      },
      {
        "en": "I bought a small red Italian car.",
        "ko": "저는 작고 빨간 이탈리아 자동차를 샀어요."
      },
      {
        "en": "He wore a nice new blue jacket.",
        "ko": "그는 멋진 새 파란 재킷을 입었어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_b1_u35_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Describe an object you own using at least three adjectives in the correct order (opinion, size/age, color, etc.).",
        "ko": "소유한 물건 하나를 형용사 세 개 이상 올바른 순서(의견, 크기·나이, 색깔 등)로 묘사해 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "adjective_order",
          "label_ko": "형용사 순서",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "형용사가 3개 이상 연속으로 나열되었는가",
          "type": "pattern_regex",
          "target": "\\b\\w+,\\s*\\w+\\s+\\w+\\b",
          "min_matches": 1,
          "points": 55,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 45,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
