{
  "meta": {
    "id": "en_c1_u08",
    "domain": "language",
    "lang": "en",
    "level": "c1",
    "unit": 8,
    "title": "Collocations with \"Have\"",
    "title_ko": "\"Have\" 콜로케이션",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "'Have' forms abstract collocations often used in analysis and argument: 'have an impact on' (affect), 'have a tendency to' (usually do), 'have an advantage over' (be better positioned than). These sound more analytical than simpler verbs.",
    "explanation_ko": "'have'는 분석·논증에서 자주 쓰이는 추상적 콜로케이션을 만듭니다: 'have an impact on'(영향을 미치다), 'have a tendency to'(보통 ~하는 경향이 있다), 'have an advantage over'(~보다 유리한 위치에 있다). 단순한 동사보다 더 분석적으로 들립니다.",
    "key_expressions": [
      {
        "en": "Social media has a huge impact on teenagers.",
        "ko": "SNS는 십대들에게 큰 영향을 미쳐요."
      },
      {
        "en": "I have a tendency to overthink things.",
        "ko": "저는 생각을 지나치게 많이 하는 경향이 있어요."
      },
      {
        "en": "Bigger companies have an advantage over startups.",
        "ko": "대기업은 스타트업보다 유리한 위치에 있어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u08_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about how something (technology, exercise, sleep) has an impact on your life, and a personal tendency you have, using both expressions.",
        "ko": "무언가(기술, 운동, 수면)가 삶에 미치는 영향과, 당신의 개인적 경향을 두 표현 모두 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
          "id": "have_an_impact",
          "label_ko": "have an impact",
          "min_occurrences": 1
        },
