    "level": "c1",
    "unit": 20,
    "title": "Vocabulary for Describing Change",
    "title_ko": "변화 묘사 어휘 (뉘앙스)",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "'Transform' (a dramatic, often positive complete change), 'evolve' (gradual change over time, natural), 'shift' (a change in position or emphasis, can be subtle), 'revolutionize' (change something fundamentally and rapidly, often technology-related).",
    "explanation_ko": "'transform'(극적이고 종종 긍정적인 완전한 변화), 'evolve'(시간에 걸친 점진적, 자연스러운 변화), 'shift'(위치·강조점의 변화, 미묘할 수 있음), 'revolutionize'(무언가를 근본적이고 급속하게 바꿈, 주로 기술 관련).",
    "key_expressions": [
      {
        "en": "The therapy transformed her outlook on life.",
        "ko": "그 치료는 그녀의 인생관을 완전히 바꿔놓았어요."
      },
      {
        "en": "Our relationship has evolved over the years.",
        "ko": "우리 관계는 몇 년에 걸쳐 발전해왔어요."
      },
      {
        "en": "There's been a shift in public opinion.",
        "ko": "여론에 변화가 있었어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u20_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about how something in your life has evolved gradually, and something that transformed suddenly, using both words.",
        "ko": "삶에서 점진적으로 진화한 것과 갑자기 완전히 바뀐 것에 대해 두 단어를 모두 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
          "id": "evolve",
          "label_ko": "evolve",
          "min_occurrences": 1
        },
        {
