    "level": "c1",
    "unit": 12,
    "title": "Academic Vocabulary: Describing Data",
    "title_ko": "데이터를 나타내는 학술 어휘",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "'Correlate' (two things move together, not necessarily causing each other), 'indicate' (data points toward a conclusion, tentative), 'suggest' (weaker than indicate, more cautious). Academic writing distinguishes these carefully to avoid overstating certainty.",
    "explanation_ko": "'correlate'(두 가지가 함께 움직임, 반드시 인과관계는 아님), 'indicate'(데이터가 결론을 가리킴, 잠정적), 'suggest'(indicate보다 약하고 더 조심스러움). 학술적 글쓰기는 확신을 과장하지 않기 위해 이들을 신중히 구분합니다.",
    "key_expressions": [
      {
        "en": "Higher income correlates with better health outcomes.",
        "ko": "높은 소득은 더 나은 건강 결과와 상관관계가 있어요."
      },
      {
        "en": "The data indicates a clear upward trend.",
        "ko": "데이터는 명확한 상승 추세를 나타내요."
      },
      {
        "en": "This suggests that the theory may be correct.",
        "ko": "이는 그 이론이 맞을 수도 있다는 것을 시사해요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u12_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a sentence about two things that seem related in your life or observations, using 'correlate with' (without claiming causation).",
        "ko": "삶이나 관찰에서 관련 있어 보이는 두 가지에 대해, (인과관계를 주장하지 않고) 'correlate with'를 사용해서 문장을 써 보세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
          "id": "correlate",
          "label_ko": "correlate",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'correlat(e/es)'를 사용했는가",
