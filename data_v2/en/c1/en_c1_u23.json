    "title": "Idioms Related to Time",
    "title_ko": "시간 관용구",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "'Down to the wire' (until the very last moment), 'in the nick of time' (just before it's too late), 'against the clock' (racing to meet a deadline), 'once in a blue moon' (very rarely).",
    "explanation_ko": "'down to the wire'(마지막 순간까지), 'in the nick of time'(늦기 직전에), 'against the clock'(마감을 맞추려 시간과 싸움), 'once in a blue moon'(아주 드물게).",
    "key_expressions": [
      {
        "en": "We finished the project down to the wire.",
        "ko": "우리는 마감 직전까지 프로젝트를 끝냈어요."
      },
      {
        "en": "We arrived just in the nick of time.",
        "ko": "우리는 아슬아슬하게 딱 맞춰 도착했어요."
      },
      {
        "en": "I only see him once in a blue moon.",
        "ko": "저는 그를 아주 가끔 봐요."
      }
    ]
  },
