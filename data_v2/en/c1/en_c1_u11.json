    "level": "c1",
    "unit": 11,
    "title": "Academic Vocabulary: Describing Trends",
    "title_ko": "추세를 나타내는 학술 어휘",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "Precise verbs describe how a trend moves: 'surge' (sudden sharp rise), 'plummet' (sudden sharp drop), 'fluctuate' (go up and down repeatedly). These are far more specific than 'increase' or 'change' and are common in reports and news.",
    "explanation_ko": "정밀한 동사는 추세가 어떻게 움직이는지 나타냅니다: 'surge'(갑작스럽고 급격한 상승), 'plummet'(갑작스럽고 급격한 하락), 'fluctuate'(반복해서 오르내림). 'increase'나 'change'보다 훨씬 구체적이며 보고서·뉴스에서 흔합니다.",
    "key_expressions": [
      {
        "en": "Sales surged after the new product launch.",
        "ko": "신제품 출시 후 매출이 급증했어요."
      },
      {
        "en": "The stock price plummeted overnight.",
        "ko": "주가가 하룻밤 사이에 폭락했어요."
      },
      {
        "en": "Prices have fluctuated a lot this year.",
        "ko": "올해 가격이 많이 오르내렸어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u11_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a trend you've noticed (prices, popularity, temperature), using 'surge' and 'fluctuate' correctly.",
        "ko": "눈치챈 추세(가격, 인기, 기온)에 대해 'surge'와 'fluctuate'를 정확히 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
          "id": "surge",
          "label_ko": "surge",
          "min_occurrences": 1
        },
        {
          "type": "vocabulary",
          "id": "fluctuate",
          "label_ko": "fluctuate",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'surge(d)'를 사용했는가",
          "type": "pattern_regex",
          "target": "\\bsurge[ds]?\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "'fluctuat(e/ed)'를 사용했는가",
          "type": "pattern_regex",
          "target": "\\bfluctuat(e|ed|ing)\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
