    "title": "Phrasal Verb Nuance: Look into/up/after",
    "title_ko": "구동사 뉘앙스: Look into/up/after",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "'Look into' (investigate a matter), 'look up' (search for information, or improve — 'things are looking up'), 'look after' (take care of someone/something). Same base verb, completely different meanings depending on the particle.",
    "explanation_ko": "'look into'(사안을 조사하다), 'look up'(정보를 찾다, 또는 상황이 나아지다 — 'things are looking up'), 'look after'(누군가·무언가를 돌보다). 기본 동사는 같아도 붙는 전치사에 따라 뜻이 완전히 다릅니다.",
    "key_expressions": [
      {
        "en": "I'll look into the issue right away.",
        "ko": "그 문제를 바로 조사해볼게요."
      },
      {
        "en": "Let me look up the address.",
        "ko": "주소를 찾아볼게요."
      },
      {
        "en": "Who's looking after the kids tonight?",
        "ko": "오늘 밤 누가 아이들을 돌봐요?"
      }
    ]
  },
