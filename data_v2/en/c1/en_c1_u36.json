{
  "meta": {
    "id": "en_c1_u36",
    "domain": "language",
    "lang": "en",
    "level": "c1",
    "unit": 36,
    "title": "Word Choice for Objective/Academic Writing",
    "title_ko": "객관적·학술적 글쓰기 어휘",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "Objective writing avoids emotionally loaded words in favor of neutral, precise ones: 'notable' (worth noting, neutral) instead of 'amazing', 'considerable' instead of 'huge', 'appears to' instead of definite claims. This hedges appropriately and sounds measured.",
    "explanation_ko": "객관적 글쓰기는 감정적인 단어 대신 중립적이고 정밀한 단어를 씁니다: 'amazing' 대신 'notable'(주목할 만한, 중립적), 'huge' 대신 'considerable', 단정적 주장 대신 'appears to'. 이는 적절히 완곡하게 표현하며 절제된 느낌을 줍니다.",
    "key_expressions": [
      {
        "en": "There is a notable difference between the two groups.",
        "ko": "두 그룹 간에 주목할 만한 차이가 있어요."
      },
      {
        "en": "The results appear to support the hypothesis.",
        "ko": "결과는 가설을 뒷받침하는 것으로 보여요."
      },
      {
        "en": "A considerable number of participants dropped out.",
        "ko": "상당수의 참가자가 중도 탈락했어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u36_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Rewrite an exciting personal opinion into a neutral, academic-sounding observation, using 'notable' and 'appears to'.",
        "ko": "흥미로운 개인적 의견을, 'notable'과 'appears to'를 사용해서 중립적이고 학술적으로 들리는 관찰로 바꿔 써 보세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
          "id": "notable",
          "label_ko": "notable",
          "min_occurrences": 1
        },
        {
          "type": "vocabulary",
          "id": "appears_to",
          "label_ko": "appears to",
          "min_occurrences": 1
        }
      ],
      "rubric": [
