    "level": "c1",
    "unit": 41,
    "title": "Understatement and Overstatement",
    "title_ko": "과장·축소 표현",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "'Not bad' or 'somewhat' understate for modesty or British-style irony ('not bad' can mean 'excellent'). 'The best thing ever' or 'a total disaster' overstate for emphasis. Recognizing these prevents misreading tone, and using them adds emotional color.",
    "explanation_ko": "'not bad'나 'somewhat'는 겸손함이나 영국식 반어법으로 축소해서 말합니다('not bad'가 '훌륭하다'는 뜻일 수도 있음). 'the best thing ever'나 'a total disaster'는 강조를 위해 과장합니다. 이를 알아보면 어조를 잘못 읽지 않게 되고, 사용하면 감정적 색채가 더해집니다.",
    "key_expressions": [
      {
        "en": "The food was not bad at all.",
        "ko": "음식이 꽤 괜찮았어요 (겸손한 표현)."
      },
      {
        "en": "It was the best meal of my life!",
        "ko": "제 인생 최고의 식사였어요! (과장)"
      },
      {
        "en": "The meeting was a total disaster.",
        "ko": "그 회의는 완전 재앙이었어요 (과장)."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u41_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a great experience using overstatement ('the best ever'), and a good but modest one using understatement ('not bad').",
        "ko": "훌륭한 경험을 과장('the best ever')으로, 좋지만 겸손하게 말할 경험을 축소('not bad')로 써 보세요."
      },
