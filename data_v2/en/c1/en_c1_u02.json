    "lang": "en",
    "level": "c1",
    "unit": 2,
    "title": "Synonyms for \"Happy\"",
    "title_ko": "\"Happy\"의 유의어",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "Degrees of happiness carry different intensity and formality: 'content' (calm satisfaction), 'elated' (intense joy, often sudden), 'gratified' (satisfied because a need was met, more formal). Choosing precisely avoids the overused 'happy' or 'very happy'.",
    "explanation_ko": "행복의 정도는 강도와 격식이 다릅니다: 'content'(차분한 만족), 'elated'(강렬하고 갑작스러운 기쁨), 'gratified'(필요가 충족되어 만족스러움, 더 격식적). 정확히 고르면 남용되는 'happy'나 'very happy'를 피할 수 있어요.",
    "key_expressions": [
      {
        "en": "I feel content with my current life.",
        "ko": "저는 지금 삶에 만족해요."
      },
      {
        "en": "She was elated when she got the news.",
        "ko": "그녀는 소식을 듣고 몹시 기뻐했어요."
      },
      {
        "en": "We were gratified by the positive response.",
        "ko": "우리는 긍정적인 반응에 만족스러웠어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u02_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about two different happy moments in your life: one using 'content' (calm satisfaction) and one using 'elated' (intense joy).",
        "ko": "인생의 행복한 순간 두 가지에 대해 써 보세요: 하나는 'content'(차분한 만족), 하나는 'elated'(강렬한 기쁨)를 사용하세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
          "id": "content",
          "label_ko": "content",
          "min_occurrences": 1
        },
        {
          "type": "vocabulary",
          "id": "elated",
          "label_ko": "elated",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'content'를 감정 형용사로 사용했는가",
          "type": "pattern_regex",
          "target": "\\b(feel|felt|was|am)\\s+content\\b",
          "min_matches": 1,
          "points": 40,
          "required": true
        },
