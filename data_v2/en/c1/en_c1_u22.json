  "context": {
    "explanation_en": "'Get to the point' (stop delaying, say the main thing), 'read between the lines' (understand hidden meaning), 'beat around the bush' (avoid saying something directly), 'on the same page' (in agreement, understanding each other).",
    "explanation_ko": "'get to the point'(미루지 말고 핵심을 말하다), 'read between the lines'(숨은 의미를 이해하다), 'beat around the bush'(직접 말하기를 피하다), 'on the same page'(합의된 상태, 서로 이해함).",
    "key_expressions": [
      {
        "en": "Please get to the point.",
        "ko": "본론만 말씀해주세요."
      },
      {
        "en": "You need to read between the lines here.",
        "ko": "여기서는 행간을 읽어야 해요."
      },
      {
        "en": "Let's make sure we're on the same page.",
        "ko": "우리 의견이 일치하는지 확인해봐요."
      }
    ]
  },
