    "title": "Vocabulary for Politics and Society",
    "title_ko": "정치·사회 중립 어휘",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "Neutral, precise vocabulary for discussing society: 'policy' (a course of action by a government/organization), 'implement' (put a plan into action), 'stakeholder' (someone affected by or invested in a decision), 'consensus' (general agreement among a group).",
    "explanation_ko": "사회를 논할 때 쓰는 중립적이고 정밀한 어휘: 'policy'(정부·단체의 행동 방침), 'implement'(계획을 실행에 옮기다), 'stakeholder'(결정에 영향을 받거나 이해관계가 있는 사람), 'consensus'(집단 내 전반적 합의).",
    "key_expressions": [
      {
        "en": "The new policy takes effect next month.",
        "ko": "새 정책은 다음 달부터 시행돼요."
      },
      {
        "en": "It will take time to implement these changes.",
        "ko": "이 변화들을 실행하는 데 시간이 걸릴 거예요."
      },
      {
        "en": "All stakeholders were consulted before the decision.",
        "ko": "결정 전에 모든 이해관계자와 협의했어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u32_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a policy (at work, school, or in society) and how it was or should be implemented, using both words.",
        "ko": "어떤 정책(직장, 학교, 사회의)과 그것이 어떻게 시행됐거나 시행되어야 하는지에 대해 두 단어를 모두 사용해서 써 보세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
          "id": "policy",
          "label_ko": "policy",
          "min_occurrences": 1
        },
        {
          "type": "vocabulary",
