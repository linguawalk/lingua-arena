{
  "meta": {
    "id": "en_c1_u06",
    "domain": "language",
    "lang": "en",
    "level": "c1",
    "unit": 6,
    "title": "Collocations with \"Make\" vs \"Do\"",
    "title_ko": "\"Make\"와 \"Do\" 콜로케이션",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "'Make' generally pairs with creating or producing something (make a decision, make progress, make an effort), while 'do' pairs with performing tasks or activities (do homework, do business, do a favor). These collocations must be memorized, not derived from logic alone.",
    "explanation_ko": "'make'는 보통 무언가를 만들거나 생산하는 것과 짝을 이루고(make a decision, make progress, make an effort), 'do'는 과업이나 활동을 수행하는 것과 짝을 이룹니다(do homework, do business, do a favor). 이 콜로케이션은 논리만으로는 유추할 수 없어 외워야 합니다.",
    "key_expressions": [
      {
        "en": "We need to make a decision soon.",
        "ko": "우리는 곧 결정을 내려야 해요."
      },
      {
        "en": "Could you do me a favor?",
        "ko": "부탁 하나 들어주실 수 있어요?"
      },
      {
        "en": "She's made a lot of progress this month.",
        "ko": "그녀는 이번 달에 많은 진전을 이뤘어요."
      }
    ]
  },
  "tasks": [
