{
  "meta": {
    "id": "en_c1_u05",
    "domain": "language",
    "lang": "en",
    "level": "c1",
    "unit": 5,
    "title": "Connotation: Positive vs Negative",
    "title_ko": "함축 의미: 긍정 vs 부정",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "Words with similar denotation can carry opposite connotation: 'thrifty' (positive: wise with money) vs 'stingy' (negative: unwilling to spend), 'confident' (positive) vs 'arrogant' (negative), 'curious' (positive) vs 'nosy' (negative). Word choice reveals your attitude toward the subject.",
    "explanation_ko": "뜻은 비슷해도 함축 의미가 반대인 단어들이 있습니다: 'thrifty'(긍정: 돈을 현명하게 씀) vs 'stingy'(부정: 돈 쓰기 싫어함), 'confident'(긍정) vs 'arrogant'(부정), 'curious'(긍정) vs 'nosy'(부정). 단어 선택이 대상에 대한 당신의 태도를 드러냅니다.",
    "key_expressions": [
      {
        "en": "My grandmother is thrifty, not stingy.",
        "ko": "제 할머니는 알뜰하시지, 인색하신 게 아니에요."
      },
      {
        "en": "He's confident, but some see it as arrogant.",
        "ko": "그는 자신감이 있는데, 어떤 사람은 그걸 오만하다고 봐요."
      },
      {
        "en": "She's curious about everyone, though it can seem nosy.",
        "ko": "그녀는 모두에게 호기심이 많은데, 참견하는 것처럼 보일 수도 있어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c1_u05_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Describe the same person's trait using both a positive word (thrifty/confident/curious) and its negative counterpart (stingy/arrogant/nosy), showing the connotation difference.",
        "ko": "같은 사람의 특징을 긍정 단어(thrifty/confident/curious)와 그 부정적 대응어(stingy/arrogant/nosy)를 모두 사용해서, 함축 의미 차이를 보여주며 묘사해 보세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
