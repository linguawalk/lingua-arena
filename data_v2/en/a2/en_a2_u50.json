  "tasks": [
    {
      "id": "en_a2_u50_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a short paragraph about a memorable past experience, comparing it to what you expected beforehand.",
        "ko": "기억에 남는 과거 경험에 대해, 사전에 예상했던 것과 비교하며 짧은 문단을 써 보세요."
      },
      "target_elements": [
        {
          "type": "expression",
          "id": "past_experience",
          "label_ko": "경험 표현",
          "min_occurrences": 1
        },
        {
          "type": "expression",
          "id": "comparative",
          "label_ko": "비교급 표현",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "과거시제 동사를 사용했는가",
          "type": "pattern_regex",
          "target": "\\b(went|saw|had|did|tried)\\b",
          "min_matches": 1,
          "points": 30,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "비교급(-er/more)을 사용했는가",
          "type": "pattern_regex",
          "target": "\\w+er\\b|more\\s+\\w+",
          "min_matches": 1,
          "points": 30,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "'than'을 사용했는가",
          "type": "keyword_match",
          "target": [
            "than"
          ],
          "min_matches": 1,
          "points": 20,
          "required": false
        },
        {
          "id": "r4",
          "criterion_ko": "분량이 충분한가 (최소 25단어)",
          "type": "length_check",
          "unit": "words",
          "min": 25,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
