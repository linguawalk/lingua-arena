  "context": {
    "explanation_en": "This unit's key expressions: describing fitness routines and progress using present perfect continuous.",
    "explanation_ko": "이번 유닛의 핵심 표현: 현재완료 진행형으로 운동 루틴과 진행 상황 설명하기",
    "key_expressions": [
      {
        "en": "I've been going to the gym for three months.",
        "ko": "저는 3개월째 헬스장에 다니고 있어요."
      },
      {
        "en": "I'm trying to build a habit of exercising.",
        "ko": "저는 운동 습관을 만들려고 노력 중이에요."
      },
      {
        "en": "I've gotten stronger since I started.",
        "ko": "시작한 이후로 더 강해졌어요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_a2_u25_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about a fitness routine you have been doing, using 'have been ~ing'.",
        "ko": "'have been ~ing'를 사용해서 해오고 있는 운동 루틴을 써 보세요."
      },
      "target_elements": [
        {
          "type": "expression",
          "id": "present_perfect_continuous",
          "label_ko": "현재완료 진행형",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "'have been ~ing'를 사용했는가",
          "type": "pattern_regex",
          "target": "have\\s+been\\s+\\w+ing",
          "min_matches": 1,
          "points": 50,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "기간 표현(for/since)을 사용했는가",
          "type": "keyword_match",
          "target": [
            "for",
            "since"
          ],
          "min_matches": 1,
          "points": 30,
          "required": false
        },
        {
          "id": "r3",
          "criterion_ko": "완전한 문장인가",
          "type": "pattern_regex",
          "target": "^[A-Z].*[.!]$",
          "min_matches": 1,
          "points": 20,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
