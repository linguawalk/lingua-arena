  "context": {
    "explanation_en": "This unit's key expressions: comparing people, places, or things using comparative and superlative forms.",
    "explanation_ko": "이번 유닛의 핵심 표현: 비교급·최상급으로 사람·장소·사물 비교하기",
    "key_expressions": [
      {
        "en": "This city is more crowded than mine.",
        "ko": "이 도시는 제가 사는 곳보다 더 붐벼요."
      },
      {
        "en": "She is the tallest in our class.",
        "ko": "그녀는 우리 반에서 가장 키가 커요."
      },
      {
        "en": "It's not as expensive as I thought.",
        "ko": "생각보다 비싸지 않아요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_a2_u04_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Compare two cities or countries you know, using at least one comparative and one superlative.",
        "ko": "아는 두 도시나 나라를, 비교급 하나와 최상급 하나를 사용해서 비교해 보세요."
      },
      "target_elements": [
        {
          "type": "expression",
          "id": "comparative",
          "label_ko": "비교급 표현",
          "min_occurrences": 1
        },
        {
          "type": "expression",
          "id": "superlative",
          "label_ko": "최상급 표현",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "비교급(-er/more)을 사용했는가",
          "type": "pattern_regex",
          "target": "\\w+er\\b|more\\s+\\w+",
          "min_matches": 1,
          "points": 35,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "최상급(the -est/the most)을 사용했는가",
          "type": "pattern_regex",
          "target": "the\\s+\\w+est\\b|the\\s+most\\s+\\w+",
          "min_matches": 1,
          "points": 35,
          "required": true
        },
        {
          "id": "r3",
          "criterion_ko": "분량이 충분한가 (최소 15단어)",
