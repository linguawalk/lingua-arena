    "unit": 15,
    "title": "Wordplay and Puns in English",
    "title_ko": "언어유희와 말장난",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "Puns rely on words with double meanings or similar sounds: 'I'm reading a book about anti-gravity — it's impossible to put down' (double meaning of 'put down'). Recognizing and appreciating puns, even groan-worthy ones, is a sign of deep vocabulary awareness.",
    "explanation_ko": "말장난은 이중 의미나 비슷한 소리를 가진 단어에 의존합니다: 'I'm reading a book about anti-gravity — it's impossible to put down'('put down'의 이중 의미). 말장난을(신음 나올 정도라도) 알아채고 즐길 수 있는 것은 깊은 어휘 인식의 표시입니다.",
    "key_expressions": [
      {
        "en": "I used to be a baker, but I couldn't make enough dough.",
        "ko": "저 예전에 제빵사였는데, 돈을(반죽을) 충분히 못 벌었어요."
      },
      {
        "en": "The math teacher called in sick with algebra.",
        "ko": "수학 선생님이 대수학(아파서) 결근했어요."
      },
      {
        "en": "I'm on a seafood diet — I see food and I eat it.",
        "ko": "저는 시푸드(음식을 보면) 다이어트 중이에요."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c2_u15_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write a short pun of your own, using a word with a double meaning, and explain briefly what makes it work.",
        "ko": "이중 의미를 가진 단어를 사용해서 자신만의 짧은 말장난을 만들고, 왜 그게 성립하는지 간단히 설명해 보세요."
      },
      "target_elements": [
        {
          "type": "vocabulary",
          "id": "pun",
          "label_ko": "말장난",
          "min_occurrences": 1
        }
      ],
      "rubric": [
        {
          "id": "r1",
          "criterion_ko": "두 개 이상의 문장으로 구성됐는가 (말장난+설명)",
          "type": "pattern_regex",
          "target": "[.!?]",
          "min_matches": 2,
          "points": 50,
          "required": true
        },
        {
          "id": "r2",
          "criterion_ko": "분량이 충분한가 (최소 12단어)",
          "type": "length_check",
          "unit": "words",
          "min": 12,
          "points": 50,
          "required": false
        }
      ],
      "scoring": {
        "max_score": 100,
        "pass_threshold": 60,
        "tie_break_rule": "partial_match_ratio_geq_0.8_counts_as_met",
        "flag_for_spot_check": {
          "condition": "total_score_within_confidence_band_of_pass_threshold",
          "confidence_band": 3,
          "blocking": false
        }
      }
    },
