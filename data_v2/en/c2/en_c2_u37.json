  "context": {
    "explanation_en": "'Keep someone at arm's length' (avoid getting emotionally close), 'have a change of heart' (change one's opinion or feeling), 'get cold feet' (become nervous about a big decision at the last minute), 'put your foot in your mouth' (say something embarrassing or tactless).",
    "explanation_ko": "'keep someone at arm's length'(감정적으로 가까워지는 걸 피하다), 'have a change of heart'(의견이나 감정을 바꾸다), 'get cold feet'(중요한 결정 직전에 불안해지다), 'put your foot in your mouth'(당황스럽거나 눈치 없는 말을 하다).",
    "key_expressions": [
      {
        "en": "She keeps most colleagues at arm's length.",
        "ko": "그녀는 대부분의 동료들과 거리를 둬요."
      },
      {
        "en": "He had a change of heart at the last minute.",
        "ko": "그는 막판에 마음이 바뀌었어요."
      },
      {
        "en": "I got cold feet right before the wedding.",
        "ko": "저는 결혼식 직전에 겁이 났어요."
      }
    ]
  },
