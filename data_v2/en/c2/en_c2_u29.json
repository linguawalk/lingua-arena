    "level": "c2",
    "unit": 29,
    "title": "Advanced Collocations: account for / dispense with",
    "title_ko": "고급 콜로케이션: account for / dispense with",
    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "'Account for' means to explain or make up a proportion of something (this accounts for 30% of sales; how do you account for the delay?). 'Dispense with' means to do without something, or to skip a formality (let's dispense with the introductions).",
    "explanation_ko": "'account for'는 무언가를 설명하거나 어떤 비율을 차지한다는 뜻입니다(이게 매출의 30%를 차지해요; 지연을 어떻게 설명하시겠어요?). 'dispense with'는 무언가 없이 지내거나 격식을 생략한다는 뜻입니다(소개는 생략합시다).",
    "key_expressions": [
      {
        "en": "Rent accounts for half of my monthly expenses.",
        "ko": "월세가 제 월 지출의 절반을 차지해요."
      },
      {
        "en": "How do you account for the missing funds?",
        "ko": "누락된 자금을 어떻게 설명하시겠어요?"
      },
      {
        "en": "Let's dispense with formalities and get started.",
        "ko": "격식은 생략하고 시작합시다."
      }
    ]
  },
  "tasks": [
    {
      "id": "en_c2_u29_w1",
      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Write about what accounts for a large part of your monthly spending, and a formality you'd like to dispense with, using both expressions.",
        "ko": "월 지출의 큰 부분을 차지하는 것과, 생략하고 싶은 격식에 대해 두 표현을 사용해서 써 보세요."
      },
      "target_elements": [
        {
