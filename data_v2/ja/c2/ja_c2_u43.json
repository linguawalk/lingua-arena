    "key_expressions": [
      {
        "en": "そういういけんもあるだろうが、わたしはちがうとおもいます。",
        "ko": "그런 의견도 있겠지만, 저는 다르게 생각해요."
      },
      {
        "en": "しかしながら、げんじつはことなります。",
        "ko": "그렇지만 현실은 달라요."
      },
      {
        "en": "そうはいっても、じかんはひつようです。",
        "ko": "그렇다고 해도 시간은 필요해요."
      }
    ]
  },
