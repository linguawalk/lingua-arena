    "key_expressions": [
      {
        "en": "かれはしんせつな人です。",
        "ko": "그는 친절한 사람이에요."
      },
      {
        "en": "せがたかくて、めがねをかけています。",
        "ko": "키가 크고 안경을 쓰고 있어요."
      },
      {
        "en": "いつもわらっています。",
        "ko": "항상 웃고 있어요."
      }
    ]
