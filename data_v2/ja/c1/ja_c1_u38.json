  "context": {
    "explanation_en": "同じ内容でも、丁寧語（です・ます）、謙譲語（申す・いただく）、カジュアル（だ・である）の三つの格式で表現が変わります。",
    "explanation_ko": "같은 내용이라도, 정중어(です·ます), 겸양어(申す·いただく), 캐주얼(だ·である)의 세 가지 격식으로 표현이 달라집니다.",
    "key_expressions": [
      {
        "en": "これはたべものです。（ていねいご）",
        "ko": "이건 음식이에요 (정중어)."
      },
      {
        "en": "これはたべものだ。（カジュアル）",
        "ko": "이건 음식이다 (캐주얼)."
      },
      {
        "en": "しょうちいたしました。（けんじょうご）",
        "ko": "알겠습니다 (겸양어)."
      }
    ]
  },
