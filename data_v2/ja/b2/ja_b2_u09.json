  "context": {
    "explanation_en": "「〜一方で」は、対照的な二つの側面を表します。「かれはきびしい一方で、やさしいです」のように使います。",
    "explanation_ko": "'〜一方で'는 대조적인 두 측면을 나타냅니다. 'かれはきびしい一方で、やさしいです'(그는 엄격한 한편 친절해요)처럼 씁니다.",
    "key_expressions": [
      {
        "en": "かれはきびしい一方で、やさしいです。",
        "ko": "그는 엄격한 한편 친절해요."
      },
      {
        "en": "べんりになった一方で、もんだいもあります。",
        "ko": "편리해진 반면 문제도 있어요."
      },
      {
        "en": "しごとがいそがしい一方で、じゅうじつしています。",
        "ko": "일이 바쁜 한편 충실해요."
      }
    ]
  },
