    "key_expressions": [
      {
        "en": "にほんごがぜんぜんできないわけではありません。",
        "ko": "일본어를 전혀 못하는 건 아니에요."
      },
      {
        "en": "かれがきらいなわけではありません。",
        "ko": "그를 싫어하는 건 아니에요."
      },
      {
        "en": "いつもいそがしいわけではありません。",
        "ko": "항상 바쁜 건 아니에요."
      }
    ]
