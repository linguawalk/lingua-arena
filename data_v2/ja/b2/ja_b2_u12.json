    "key_expressions": [
      {
        "en": "はじめてにしては、じょうずです。",
        "ko": "처음치고는 잘해요."
      },
      {
        "en": "がくせいにしては、ふくがおしゃれです。",
        "ko": "학생치고는 옷이 세련됐어요."
      },
      {
        "en": "なつにしては、すずしいです。",
        "ko": "여름치고는 시원해요."
      }
    ]
  },
