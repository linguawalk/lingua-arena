    "key_expressions": [
      {
        "en": "うちにかえったら、でんわします。",
        "ko": "집에 돌아가면 전화할게요."
      },
      {
        "en": "じかんがあったら、てつだってください。",
        "ko": "시간이 있으면 도와주세요."
      },
      {
        "en": "もしあめがふったら、ちゅうしします。",
        "ko": "만약 비가 오면 중지할게요."
      }
    ]
  },
