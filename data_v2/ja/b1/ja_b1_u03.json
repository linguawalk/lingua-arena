  "context": {
    "explanation_en": "「〜てみる」は、なにかを試してみることを表します。「たべてみます」「いってみます」のように使います。",
    "explanation_ko": "'〜てみる'는 무언가를 시도해 본다는 것을 나타냅니다. 'たべてみます'(먹어봐요), 'いってみます'(가봐요)처럼 씁니다.",
    "key_expressions": [
      {
        "en": "あたらしいレストランにいってみます。",
        "ko": "새 식당에 가볼게요."
      },
      {
        "en": "このふくをきてみてもいいですか。",
        "ko": "이 옷을 입어봐도 될까요?"
      },
      {
        "en": "やってみないとわかりません。",
        "ko": "해보지 않으면 몰라요."
      }
    ]
  },
