        "en": "これはあかいくつです。",
        "ko": "이건 빨간 신발이에요."
      },
      {
        "en": "空はあおいろです。",
        "ko": "하늘은 파란색이에요."
      },
      {
        "en": "この形はまるいです。",
        "ko": "이 모양은 둥글어요."
      }
    ]
  },
