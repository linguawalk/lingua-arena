    "key_expressions": [
      {
        "en": "Der Lärm stört mich.",
        "ko": "이 소음이 거슬려요."
      },
      {
        "en": "Könnten Sie bitte leiser sein?",
        "ko": "좀 더 조용히 해 주실 수 있어요?"
      },
      {
        "en": "Das stört mich wirklich.",
        "ko": "그거 정말 거슬려요."
      }
    ]
