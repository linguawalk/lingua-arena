  "context": {
    "explanation_en": "To describe frequency of habits, we use « oft » (often), « manchmal » (sometimes), and « nie » (never).",
    "explanation_ko": "습관의 빈도를 말할 때는 'oft'(자주), 'manchmal'(가끔), 'nie'(절대 안)를 씁니다.",
    "key_expressions": [
      {
        "en": "Ich trinke oft Kaffee.",
        "ko": "저는 커피를 자주 마셔요."
      },
      {
        "en": "Ich gehe manchmal ins Fitnessstudio.",
        "ko": "저는 가끔 헬스장에 가요."
      },
      {
        "en": "Ich rauche nie.",
        "ko": "저는 절대 담배를 안 피워요."
      }
    ]
  },
