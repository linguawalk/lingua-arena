    "focus_axis": "expression"
  },
  "context": {
    "explanation_en": "To say something is less, we use « weniger... als ». To say two things are equal, we use « genauso... wie ».",
    "explanation_ko": "덜하다는 것을 말할 때는 'weniger...als'(~보다 덜 ~해요), 같다는 것을 말할 때는 'genauso...wie'(~만큼 ~해요)를 씁니다.",
    "key_expressions": [
      {
        "en": "Dieses Buch ist weniger interessant als das andere.",
        "ko": "이 책은 다른 책보다 덜 재미있어요."
      },
      {
        "en": "Sie ist genauso groß wie ich.",
        "ko": "그녀는 저만큼 키가 커요."
      },
      {
        "en": "Das kostet genauso viel wie das andere.",
        "ko": "이건 다른 것만큼 비싸요."
      }
    ]
  },
