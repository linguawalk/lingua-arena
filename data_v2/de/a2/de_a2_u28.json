  "context": {
    "explanation_en": "To disagree politely, we use « Ich bin anderer Meinung ». To express your own view, we use « Meiner Meinung nach... ».",
    "explanation_ko": "정중하게 반대할 때는 'Ich bin anderer Meinung'(저는 의견이 달라요), 자신의 의견을 말할 때는 'Meiner Meinung nach...'(제 생각에는...)를 씁니다.",
    "key_expressions": [
      {
        "en": "Ich bin anderer Meinung.",
        "ko": "저는 의견이 달라요."
      },
      {
        "en": "Meiner Meinung nach ist das nicht richtig.",
        "ko": "제 생각에는 그건 맞지 않아요."
      },
      {
        "en": "Ich verstehe Ihren Standpunkt, aber...",
        "ko": "당신 입장은 이해하지만..."
      }
    ]
  },
