    "title": "Small Talk (übrigens/sonst)",
    "title_ko": "스몰토크 (그건 그렇고/그 외에는)",
    "focus_axis": "expression"
  },
  "context": {
    "explanation_en": "To change topics casually, we use « Übrigens... ». To ask if there's anything else, we use « Sonst noch etwas? ».",
    "explanation_ko": "자연스럽게 화제를 바꿀 때는 'Übrigens...'(그건 그렇고), 다른 일이 있는지 물을 때는 'Sonst noch etwas?'(그 외에 다른 일 있어요?)를 씁니다.",
    "key_expressions": [
      {
        "en": "Übrigens, hast du das neue Café gesehen?",
        "ko": "그건 그렇고, 새로 생긴 카페 봤어요?"
      },
      {
        "en": "Sonst noch etwas Neues?",
        "ko": "그 외에 다른 새로운 일 있어요?"
      },
      {
        "en": "Wie läuft sonst alles?",
        "ko": "그 외에는 다 어때요?"
      }
    ]
  },
