    "key_expressions": [
      {
        "en": "Anscheinend wird es morgen regnen.",
        "ko": "아마 내일 비가 올 것 같아요."
      },
      {
        "en": "Wie wird das Wetter morgen?",
        "ko": "내일 날씨 어때요?"
      },
      {
        "en": "Es sieht nach Regen aus.",
        "ko": "비가 올 것처럼 보여요."
      }
    ]
