  "context": {
    "explanation_en": "To compare city and countryside, we use « In der Stadt..., aber auf dem Land... ». To express preference, we use « Ich bevorzuge... ».",
    "explanation_ko": "도시와 시골을 비교할 때는 'In der Stadt..., aber auf dem Land...'(도시에서는 ~하지만, 시골에서는...), 선호를 말할 때는 'Ich bevorzuge...'(저는 ~을 더 선호해요)를 씁니다.",
    "key_expressions": [
      {
        "en": "In der Stadt ist es laut, aber auf dem Land ist es ruhig.",
        "ko": "도시는 시끄럽지만 시골은 조용해요."
      },
      {
        "en": "Ich bevorzuge das Landleben.",
        "ko": "저는 시골 생활을 더 선호해요."
      },
      {
        "en": "Die Stadt hat mehr Möglichkeiten.",
        "ko": "도시는 기회가 더 많아요."
      }
    ]
  },
