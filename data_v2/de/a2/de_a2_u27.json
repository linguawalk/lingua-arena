    "key_expressions": [
      {
        "en": "Mein bester Freund ist sehr treu.",
        "ko": "제 가장 친한 친구는 정말 의리 있어요."
      },
      {
        "en": "Wir kennen uns seit der Schulzeit.",
        "ko": "저희는 학창시절부터 알고 지냈어요."
      },
      {
        "en": "Ich vertraue ihr sehr.",
        "ko": "저는 그녀를 정말 신뢰해요."
      }
    ]
  },
