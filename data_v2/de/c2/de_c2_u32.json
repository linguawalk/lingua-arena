    "focus_axis": "vocabulary"
  },
  "context": {
    "explanation_en": "« Kritisieren » is neutral: making a judgment (positive or negative), « herumnörgeln » expresses complaining about small things, « mäkeln » expresses excessive nitpicking about details.",
    "explanation_ko": "'kritisieren'(비판하다)은 중립적: 판단을 내림(긍정적이거나 부정적), 'herumnörgeln'(트집잡다)은 사소한 것에 대해 불평함을, 'mäkeln'(흠잡다)은 세부사항에 대한 과도한 지적을 나타냅니다.",
    "key_expressions": [
      {
        "en": "Der Kritiker kritisiert den neuen Film.",
        "ko": "그 평론가는 새 영화를 비평해요."
      },
      {
        "en": "Er nörgelt ständig über Kleinigkeiten herum.",
        "ko": "그는 항상 사소한 것들에 대해 트집을 잡아요."
      },
      {
        "en": "Sie mäkelt an jedem Detail.",
        "ko": "그녀는 모든 세부사항을 흠잡아요."
      }
    ]
  },
