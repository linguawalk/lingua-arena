  "context": {
    "explanation_en": "« Wie originell » (said sarcastically) and « Bravo » (said ironically to criticize) are typical German irony markers.",
    "explanation_ko": "'Wie originell'(정말 독창적이네요, 냉소적으로 말함)과 'Bravo'(잘했어요, 비판하려고 반어적으로 말함)는 독일어의 전형적인 반어법 표지입니다.",
    "key_expressions": [
      {
        "en": "Ach, wie originell!",
        "ko": "아, 정말 독창적이네요! (반어)"
      },
      {
        "en": "Bravo, du hast alles wieder kaputt gemacht.",
        "ko": "잘했어, 또 다 망가뜨렸네 (반어)."
      },
      {
        "en": "Was für eine Überraschung... (ohne jede Überraschung gesagt)",
        "ko": "정말 놀랍네요... (전혀 놀랍지 않다는 뜻)."
      }
    ]
  },
