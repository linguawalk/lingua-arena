  "context": {
    "explanation_en": "Classic register uses forms like « man höre und staune » (behold, listen up), modern register prefers direct, casual phrases like « stell dir vor ».",
    "explanation_ko": "고전체는 'man höre und staune'(들어보시라) 같은 형태를 사용하고, 현대체는 'stell dir vor'(상상해봐) 같은 직접적이고 캐주얼한 표현을 선호합니다.",
    "key_expressions": [
      {
        "en": "Man höre und staune: er hat die Prüfung bestanden.",
        "ko": "들어보시라: 그가 시험에 합격했어요 (고전체)."
      },
      {
        "en": "Stell dir vor, er hat die Prüfung bestanden.",
        "ko": "상상해봐, 그가 시험에 합격했어 (현대체)."
      },
      {
        "en": "Der Unterschied im Register ist bemerkenswert.",
        "ko": "언어역의 차이가 눈에 띄어요."
      }
    ]
  },
