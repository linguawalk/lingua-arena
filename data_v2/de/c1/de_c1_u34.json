    "key_expressions": [
      {
        "en": "Laut dieser Studie ist die Quote gestiegen.",
        "ko": "이 연구에 따르면 비율이 증가했어요."
      },
      {
        "en": "Darüber hinaus müssen wir andere Faktoren berücksichtigen.",
        "ko": "게다가 다른 요인들도 고려해야 해요."
      },
      {
        "en": "Es ist zu beachten, dass die Ergebnisse variieren.",
        "ko": "결과가 다양하다는 점에 주목할 필요가 있어요."
      }
    ]
