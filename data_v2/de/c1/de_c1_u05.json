  "context": {
    "explanation_en": "« Stur » (stubborn) is negative — refusing to change despite good reasons. « Entschlossen » (determined) is positive — firm resolve toward a goal.",
    "explanation_ko": "'stur'(고집스러운)는 부정적: 타당한 이유에도 바꾸기를 거부함, 'entschlossen'(단호한)은 긍정적: 목표를 향한 확고한 의지를 나타냅니다.",
    "key_expressions": [
      {
        "en": "Er ist zu stur, um seine Meinung zu ändern.",
        "ko": "그는 의견을 바꾸기에는 너무 고집스러워요."
      },
      {
        "en": "Sie ist entschlossen, ihr Ziel zu erreichen.",
        "ko": "그녀는 목표를 달성하겠다는 결의가 확고해요."
      },
      {
        "en": "Stur zu sein ist nicht dasselbe wie entschlossen zu sein.",
        "ko": "고집스러운 것과 단호한 것은 다른 거예요."
      }
    ]
  },
