    "key_expressions": [
      {
        "en": "Diese Methode ist sehr effektiv.",
        "ko": "이 방법은 정말 효과적이에요."
      },
      {
        "en": "Wir müssen effizienter arbeiten.",
        "ko": "저희는 더 효율적으로 일해야 해요."
      },
      {
        "en": "Verwechseln Sie nicht effektiv und effizient.",
        "ko": "effektiv와 effizient를 헷갈리지 마세요."
      }
    ]
  },
