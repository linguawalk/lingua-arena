  "context": {
    "explanation_en": "« In letzter Minute » (at the last minute), « seine Zeit verschwenden » (waste one's time), « von heute auf morgen » (overnight) are time-related idioms.",
    "explanation_ko": "'in letzter Minute'(막판에), 'seine Zeit verschwenden'(시간을 낭비하다), 'von heute auf morgen'(하루아침에)은 시간 관련 관용구입니다.",
    "key_expressions": [
      {
        "en": "Er kam in letzter Minute an.",
        "ko": "그는 막판에 도착했어요."
      },
      {
        "en": "Verschwende nicht deine Zeit damit!",
        "ko": "그것에 시간을 낭비하지 마세요!"
      },
      {
        "en": "Alles änderte sich von heute auf morgen.",
        "ko": "모든 게 하루아침에 바뀌었어요."
      }
    ]
  },
