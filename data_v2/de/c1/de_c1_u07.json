  "context": {
    "explanation_en": "« Vertrauen haben » (to have trust), « Sinn haben für » (to have a sense/feel for) are fixed collocations with « haben ».",
    "explanation_ko": "'Vertrauen haben'(신뢰를 갖다), 'Sinn haben für'(~에 감각이 있다)는 'haben'을 사용하는 고정된 콜로케이션입니다.",
    "key_expressions": [
      {
        "en": "Ich habe Vertrauen in dich.",
        "ko": "저는 당신을 신뢰해요."
      },
      {
        "en": "Sie hat einen guten Sinn für Humor.",
        "ko": "그녀는 유머 감각이 좋아요."
      },
      {
        "en": "Er hat keine Ahnung, was passiert ist.",
        "ko": "그는 무슨 일이 일어났는지 전혀 몰라요."
      }
    ]
  },
