  "context": {
    "explanation_en": "« Besorgt » (worried) is mild, « ängstlich » (anxious) is moderate, « panisch » (panicked) is extreme anxiety.",
    "explanation_ko": "'besorgt'(걱정하는)는 약한 정도, 'ängstlich'(불안한)는 중간 정도, 'panisch'(공황 상태의)는 극단적인 불안을 나타냅니다.",
    "key_expressions": [
      {
        "en": "Ich bin besorgt um meine Gesundheit.",
        "ko": "저는 제 건강이 걱정돼요."
      },
      {
        "en": "Sie ist ängstlich vor Prüfungen.",
        "ko": "그녀는 시험을 불안해해요."
      },
      {
        "en": "Er geriet in Panik, als er die Nachricht hörte.",
        "ko": "그는 그 소식을 듣고 패닉에 빠졌어요."
      }
    ]
  },
