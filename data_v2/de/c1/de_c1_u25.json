    "key_expressions": [
      {
        "en": "Ich bin genervt von diesem Lärm.",
        "ko": "이 소음에 짜증나요."
      },
      {
        "en": "Er war wütend über die Entscheidung.",
        "ko": "그는 그 결정에 화가 났어요."
      },
      {
        "en": "Sie war außer sich vor Wut.",
        "ko": "그녀는 분노로 제정신이 아니었어요."
      }
    ]
  },
