    "title": "Relativsätze mit was/wo",
    "title_ko": "was/wo 관계문",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "« Was » is used as a relative pronoun after indefinite pronouns (alles, etwas, nichts) or a whole clause. « Wo » refers to places.",
    "explanation_ko": "'was'는 부정대명사(alles, etwas, nichts) 뒤나 전체 절 뒤에서 관계대명사로 쓰입니다. 'wo'는 장소를 가리킵니다.",
    "key_expressions": [
      {
        "en": "Das ist alles, was ich weiß.",
        "ko": "이게 제가 아는 전부예요."
      },
      {
        "en": "Er kam zu spät, was mich ärgerte.",
        "ko": "그가 늦게 왔는데, 그게 저를 짜증나게 했어요."
      },
      {
        "en": "Das ist die Stadt, wo ich geboren wurde.",
        "ko": "이곳이 제가 태어난 도시예요."
      }
    ]
  },
