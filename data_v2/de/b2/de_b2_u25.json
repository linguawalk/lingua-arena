    "key_expressions": [
      {
        "en": "Die trotz aller Widerstände durchgeführte Reform war erfolgreich.",
        "ko": "모든 저항에도 불구하고 실시된 개혁은 성공적이었어요."
      },
      {
        "en": "Der schon lange erwartete Bericht wurde endlich veröffentlicht.",
        "ko": "오랫동안 기다려온 보고서가 드디어 발표됐어요."
