    "key_expressions": [
      {
        "en": "Je nachdem, wie das Wetter ist, gehen wir raus oder bleiben zu Hause.",
        "ko": "날씨에 따라 저희는 밖에 나가거나 집에 있을 거예요."
      },
      {
        "en": "Je nachdem, wann Sie ankommen, holen wir Sie ab.",
        "ko": "언제 도착하시는지에 따라 저희가 마중 나갈게요."
      },
      {
        "en": "Das hängt davon ab, je nachdem was Sie brauchen.",
        "ko": "필요한 것에 따라 달라져요."
      }
