    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "The same idea can be expressed with different registers: passive (formal), « man » (neutral/spoken), or « sich lassen » (possibility-focused).",
    "explanation_ko": "같은 아이디어를 다른 언어역으로 표현할 수 있습니다: 수동태(격식체), 'man'(중립적/구어체), 'sich lassen'(가능성 중심).",
    "key_expressions": [
      {
        "en": "Das Problem wird gelöst. (Passiv)",
        "ko": "그 문제가 해결돼요 (수동태)."
      },
      {
        "en": "Man löst das Problem. (man)",
        "ko": "그 문제를 해결해요 (man)."
      },
      {
        "en": "Das Problem lässt sich lösen. (sich lassen)",
        "ko": "그 문제는 해결될 수 있어요 (sich lassen)."
      }
    ]
  },
