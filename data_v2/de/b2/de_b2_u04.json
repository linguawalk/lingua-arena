    "title": "Nominalstil vs Verbalstil",
    "title_ko": "명사문체 vs 동사문체",
    "focus_axis": "grammar"
  },
  "context": {
    "explanation_en": "Nominal style (« die Durchführung der Untersuchung ») is more formal/written, verbal style (« die Untersuchung durchführen ») is more conversational.",
    "explanation_ko": "명사문체('die Durchführung der Untersuchung')는 더 격식 있는 문어체이고, 동사문체('die Untersuchung durchführen')는 더 구어체입니다.",
    "key_expressions": [
      {
        "en": "Die Durchführung der Untersuchung dauert lange. (Nominalstil)",
        "ko": "조사의 실시는 오래 걸려요 (명사문체)."
      },
      {
        "en": "Wir führen die Untersuchung durch. (Verbalstil)",
        "ko": "저희는 조사를 실시해요 (동사문체)."
      },
      {
        "en": "Die Entscheidung des Ministers erfolgte schnell.",
        "ko": "장관의 결정은 신속하게 이루어졌어요."
      }
    ]
  },
  "tasks": [
