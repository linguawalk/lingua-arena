      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Schreiben Sie einen Satz im Nominalstil (z.B. „die Durchführung der...“).",
        "ko": "명사문체(예: 'die Durchführung der...')를 사용해서 문장을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "nominalstil",
          "label_ko": "명사문체",
          "min_occurrences": 1
