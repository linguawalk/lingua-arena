    "key_expressions": [
      {
        "en": "Er übersetzt das Buch. (untrennbar: to translate)",
        "ko": "그는 책을 번역해요 (비분리: 번역하다)."
      },
      {
        "en": "Er setzt mit dem Boot über. (trennbar: to cross over)",
        "ko": "그는 보트로 건너요 (분리: 건너다)."
      },
      {
        "en": "Sie umfährt die Baustelle. (untrennbar: to drive around)",
        "ko": "그녀는 공사장을 우회해요 (비분리: 돌아가다)."
      }
    ]
  },
