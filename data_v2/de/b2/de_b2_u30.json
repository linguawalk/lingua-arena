  "context": {
    "explanation_en": "« Wenn nur... » and « hätte ich doch... » express strong wishes or regrets, using Konjunktiv II.",
    "explanation_ko": "'Wenn nur...'와 'hätte ich doch...'는 접속법 2식을 사용해서 강한 소망이나 후회를 나타냅니다.",
    "key_expressions": [
      {
        "en": "Wenn ich nur mehr Zeit hätte!",
        "ko": "시간이 더 있으면 좋을 텐데!"
      },
      {
        "en": "Hätte ich doch früher angefangen!",
        "ko": "더 일찍 시작했더라면 좋았을 텐데!"
      },
      {
        "en": "Wenn ich nur besser Deutsch sprechen könnte!",
        "ko": "독일어를 더 잘 할 수 있으면 좋을 텐데!"
      }
    ]
  },
