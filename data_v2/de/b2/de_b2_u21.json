    "key_expressions": [
      {
        "en": "Wenngleich es schwierig ist, versuchen wir es.",
        "ko": "어렵지만 저희는 시도해봐요."
      },
      {
        "en": "Obgleich er müde war, arbeitete er weiter.",
        "ko": "그는 피곤했지만 계속 일했어요."
      },
      {
        "en": "Wenngleich die Kritik berechtigt war, änderte sich nichts.",
        "ko": "비판이 타당했지만 아무것도 바뀌지 않았어요."
      }
    ]
  },
