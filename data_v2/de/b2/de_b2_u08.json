  "context": {
    "explanation_en": "Modal particles like « doch, ja, eben, halt » add nuance to a sentence without changing its literal meaning, common in spoken German.",
    "explanation_ko": "'doch, ja, eben, halt' 같은 화용 불변화사는 문장의 문자적 의미를 바꾸지 않으면서 뉘앙스를 더하며, 구어체 독일어에서 흔합니다.",
    "key_expressions": [
      {
        "en": "Das ist doch klar!",
        "ko": "그건 당연하잖아요!"
      },
      {
        "en": "Das ist ja toll!",
        "ko": "그거 정말 멋지네요!"
      },
      {
        "en": "Das ist eben so.",
        "ko": "그냥 그런 거예요."
      }
    ]
  },
