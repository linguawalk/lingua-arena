  "context": {
    "explanation_en": "« Ungeachtet » (regardless of, notwithstanding) is a formal genitive preposition expressing concession, similar to « trotz ».",
    "explanation_ko": "'ungeachtet'(~에 상관없이)는 'trotz'와 비슷하게 양보를 나타내는 격식 있는 2격지배 전치사입니다.",
    "key_expressions": [
      {
        "en": "Ungeachtet der Kritik setzte er seinen Plan fort.",
        "ko": "비판에도 불구하고 그는 계획을 계속 진행했어요."
      },
      {
        "en": "Ungeachtet aller Schwierigkeiten haben wir es geschafft.",
        "ko": "모든 어려움에도 불구하고 저희는 해냈어요."
      },
      {
        "en": "Ungeachtet des Wetters findet die Veranstaltung statt.",
        "ko": "날씨와 상관없이 행사는 진행돼요."
      }
    ]
  },
