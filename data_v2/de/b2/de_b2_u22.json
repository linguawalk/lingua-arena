  "context": {
    "explanation_en": "« Indem » (by doing) and « dadurch, dass » (through the fact that) express the means by which something is achieved.",
    "explanation_ko": "'indem'(~함으로써)과 'dadurch, dass'(~라는 사실을 통해)는 어떤 것을 달성하는 수단을 나타냅니다.",
    "key_expressions": [
      {
        "en": "Ich lerne Deutsch, indem ich viel übe.",
        "ko": "저는 많이 연습함으로써 독일어를 배워요."
      },
      {
        "en": "Dadurch, dass sie hart arbeitete, wurde sie erfolgreich.",
        "ko": "열심히 일했다는 사실을 통해 그녀는 성공했어요."
      },
      {
        "en": "Er verbessert sein Deutsch, indem er Bücher liest.",
        "ko": "그는 책을 읽음으로써 독일어를 향상시켜요."
      }
    ]
  },
