    "key_expressions": [
      {
        "en": "Er sagte, er sei gestern angekommen.",
        "ko": "그는 어제 도착했다고 말했어요."
      },
      {
        "en": "Sie berichtete, sie habe das Buch gelesen.",
        "ko": "그녀는 그 책을 읽었다고 보고했어요."
      },
