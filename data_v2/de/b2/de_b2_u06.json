  "context": {
    "explanation_en": "« Je... umso » is a more formal variant of « je... desto », used in written or elevated register.",
    "explanation_ko": "'je...umso'는 'je...desto'의 더 격식 있는 변형으로, 문어체나 고급 언어역에서 사용됩니다.",
    "key_expressions": [
      {
        "en": "Je komplexer das Problem, umso mehr Zeit brauchen wir.",
        "ko": "문제가 복잡할수록 시간이 더 필요해요."
      },
      {
        "en": "Je näher der Termin rückt, umso nervöser wird sie.",
        "ko": "마감일이 다가올수록 그녀는 더 긴장해요."
      },
      {
        "en": "Je mehr man liest, umso klüger wird man.",
        "ko": "많이 읽을수록 더 똑똑해져요."
      }
    ]
  },
