  "context": {
    "explanation_en": "Rhetorical questions like « Wer weiß das schon? » (Who knows, really?) don't expect an answer but make a point.",
    "explanation_ko": "'Wer weiß das schon?'(누가 그걸 알겠어요?) 같은 수사의문문은 답을 기대하지 않고 요점을 전달합니다.",
    "key_expressions": [
      {
        "en": "Wer weiß das schon genau?",
        "ko": "그걸 누가 정확히 알겠어요?"
      },
      {
        "en": "Ist das nicht offensichtlich?",
        "ko": "그거 명백하지 않아요?"
      },
      {
        "en": "Wozu soll das gut sein?",
        "ko": "그게 무슨 소용이 있겠어요?"
      }
    ]
  },
