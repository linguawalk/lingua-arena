  "context": {
    "explanation_en": "« Zumal » (especially since) adds emphasis to a reason. « Angesichts » (in view of, given) is a formal genitive preposition.",
    "explanation_ko": "'zumal'(특히 ~이기 때문에)은 이유에 강조를 더합니다. 'angesichts'(~을 고려하면)는 격식 있는 2격지배 전치사입니다.",
    "key_expressions": [
      {
        "en": "Ich bleibe zu Hause, zumal es regnet.",
        "ko": "저는 집에 있어요, 특히 비가 오니까요."
      },
      {
        "en": "Angesichts der Lage müssen wir handeln.",
        "ko": "상황을 고려하면 저희는 행동해야 해요."
      },
      {
        "en": "Angesichts der hohen Kosten haben wir den Plan geändert.",
        "ko": "높은 비용을 고려해서 저희는 계획을 바꿨어요."
      }
    ]
  },
