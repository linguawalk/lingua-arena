    "key_expressions": [
      {
        "en": "Mein Lieblingsmonat ist April.",
        "ko": "제가 좋아하는 달은 4월이에요."
      },
      {
        "en": "Meine Lieblingsjahreszeit ist der Herbst.",
        "ko": "제가 좋아하는 계절은 가을이에요."
      },
      {
        "en": "Im Mai reise ich oft.",
        "ko": "5월에는 여행을 자주 가요."
      }
