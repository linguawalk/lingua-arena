    "key_expressions": [
      {
        "en": "Ich spiele Fußball.",
        "ko": "저는 축구를 해요."
      },
      {
        "en": "Ich gehe zweimal pro Woche schwimmen.",
        "ko": "저는 주 2회 수영해요."
      },
      {
        "en": "Ich spiele nicht gern Basketball.",
        "ko": "저는 농구는 안 좋아해요."
      }
