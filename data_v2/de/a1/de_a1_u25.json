    "key_expressions": [
      {
        "en": "Ich möchte Ärztin werden.",
        "ko": "저는 의사가 되고 싶어요."
      },
      {
        "en": "Wie lange arbeiten Sie schon hier?",
        "ko": "여기서 일한 지 얼마나 됐어요?"
      },
      {
        "en": "Ich arbeite seit drei Jahren hier.",
        "ko": "저는 여기서 3년째 일해요."
      }
    ]
  },
