  "context": {
    "explanation_en": "To compare two things, we use « ... ist ... als ... ». To say something is the best, we use « ... ist am ... ».",
    "explanation_ko": "두 가지를 비교할 때는 '...ist...als...'(~은 ~보다 더 ~해요), 최상급을 말할 때는 '...ist am...'(~이 가장 ~해요)를 씁니다.",
    "key_expressions": [
      {
        "en": "Mein Bruder ist größer als ich.",
        "ko": "제 오빠가 저보다 키가 커요."
      },
      {
        "en": "Dieses Café ist am besten.",
        "ko": "이 카페가 가장 좋아요."
      },
      {
        "en": "Der Zug ist schneller als der Bus.",
        "ko": "기차가 버스보다 빨라요."
      }
    ]
  },
