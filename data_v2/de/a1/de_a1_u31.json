    "key_expressions": [
      {
        "en": "Hallo, hier ist Kim.",
        "ko": "여보세요, 저는 김이에요."
      },
      {
        "en": "Kann ich mit Anna sprechen?",
        "ko": "안나와 통화할 수 있을까요?"
      },
      {
        "en": "Ich schicke Ihnen eine SMS.",
        "ko": "문자 보낼게요."
      }
    ]
  },
