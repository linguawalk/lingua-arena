    "key_expressions": [
      {
        "en": "Wir sind vier in meiner Familie.",
        "ko": "저희 가족은 네 명이에요."
      },
      {
        "en": "Ich habe einen Bruder.",
        "ko": "저는 남자 형제가 한 명 있어요."
      },
      {
        "en": "Das ist mein Vater.",
        "ko": "이분은 저희 아버지예요."
      }
    ]
  },
