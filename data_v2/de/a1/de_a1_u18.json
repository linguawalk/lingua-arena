  "context": {
    "explanation_en": "To talk about housework, we use « Ich putze... ». To say something needs to be done, we use « Ich muss... ».",
    "explanation_ko": "집안일을 말할 때는 'Ich putze...'(저는 ~을 청소해요), 해야 할 일을 말할 때는 'Ich muss...'(저는 ~해야 해요)를 씁니다.",
    "key_expressions": [
      {
        "en": "Ich putze das Badezimmer.",
        "ko": "저는 욕실을 청소해요."
      },
      {
        "en": "Ich muss die Küche aufräumen.",
        "ko": "저는 부엌을 정리해야 해요."
      },
      {
        "en": "Ich wasche die Wäsche.",
        "ko": "저는 빨래를 해요."
      }
    ]
  },
