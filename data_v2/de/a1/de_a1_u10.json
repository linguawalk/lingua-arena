    "key_expressions": [
      {
        "en": "Ich habe einen Hund.",
        "ko": "저는 강아지가 있어요."
      },
      {
        "en": "Ich mag Katzen.",
        "ko": "저는 고양이를 좋아해요."
      },
      {
        "en": "Mein Hund heißt Coco.",
        "ko": "제 강아지 이름은 코코예요."
      }
    ]
