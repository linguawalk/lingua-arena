    "key_expressions": [
      {
        "en": "Im Sommer ist es heiß.",
        "ko": "여름에는 날씨가 더워요."
      },
      {
        "en": "Man muss einen Mantel tragen.",
        "ko": "코트를 입어야 해요."
      },
      {
        "en": "Im Winter schneit es oft.",
        "ko": "겨울에는 눈이 자주 와요."
      }
    ]
  },
