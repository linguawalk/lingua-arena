  "context": {
    "explanation_en": "To describe cooking a dish, we use « Ich koche... ». To give simple cooking instructions, we use « Zuerst..., dann... ».",
    "explanation_ko": "요리하는 것을 말할 때는 'Ich koche...'(저는 ~을 요리해요), 간단한 조리 순서를 말할 때는 'Zuerst..., dann...'(먼저 ~하고, 그다음 ~해요)를 씁니다.",
    "key_expressions": [
      {
        "en": "Ich koche heute Suppe.",
        "ko": "저는 오늘 수프를 요리해요."
      },
      {
        "en": "Zuerst schneide ich das Gemüse, dann koche ich es.",
        "ko": "먼저 채소를 썰고, 그다음 끓여요."
      },
      {
        "en": "Das Rezept ist einfach.",
        "ko": "이 레시피는 간단해요."
      }
    ]
  },
