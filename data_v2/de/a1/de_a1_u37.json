  "context": {
    "explanation_en": "To ask for permission, we use « Darf ich...? ». To give permission, we use « Ja, das dürfen Sie ».",
    "explanation_ko": "허락을 구할 때는 'Darf ich...?'(제가 ~해도 될까요?), 허락할 때는 'Ja, das dürfen Sie'(네, 하셔도 돼요)를 씁니다.",
    "key_expressions": [
      {
        "en": "Darf ich das Fenster öffnen?",
        "ko": "창문 열어도 될까요?"
      },
      {
        "en": "Ja, das dürfen Sie.",
        "ko": "네, 하셔도 돼요."
      },
      {
        "en": "Nein, das dürfen Sie leider nicht.",
        "ko": "아니요, 죄송하지만 안 돼요."
      }
    ]
  },
