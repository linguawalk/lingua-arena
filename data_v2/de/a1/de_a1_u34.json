  "context": {
    "explanation_en": "To talk about past experiences, we use « Ich habe... gemacht ». To ask about experience, we use « Haben Sie schon... gemacht? ».",
    "explanation_ko": "과거 경험을 말할 때는 'Ich habe... gemacht'(저는 ~했어요), 경험을 물을 때는 'Haben Sie schon... gemacht?'(~해본 적 있어요?)를 씁니다.",
    "key_expressions": [
      {
        "en": "Ich habe letztes Jahr Deutschland besucht.",
        "ko": "작년에 독일을 방문했어요."
      },
      {
        "en": "Haben Sie schon Sushi gegessen?",
        "ko": "초밥 먹어본 적 있어요?"
      },
      {
        "en": "Ich habe das noch nie gemacht.",
        "ko": "저는 그거 아직 해본 적 없어요."
      }
    ]
  },
