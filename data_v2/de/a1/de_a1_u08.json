  "context": {
    "explanation_en": "To talk about habits, we use « Jeden Tag... ». To say when you wake up/go to bed, we use « Ich stehe um... auf / Ich gehe um... ins Bett ».",
    "explanation_ko": "일상 습관을 말할 때는 'Jeden Tag...'(저는 매일 ~해요), 기상/취침 시간을 말할 때는 'Ich stehe um... auf'(저는 ~시에 일어나요) / 'Ich gehe um... ins Bett'(저는 ~시에 자요)를 씁니다.",
    "key_expressions": [
      {
        "en": "Ich stehe jeden Tag um sieben Uhr auf.",
        "ko": "저는 매일 7시에 일어나요."
      },
      {
        "en": "Ich gehe um elf Uhr abends ins Bett.",
        "ko": "저는 밤 11시에 자요."
      },
      {
        "en": "Ich arbeite jeden Tag.",
        "ko": "저는 매일 출근해요."
      }
    ]
  },
