    "key_expressions": [
      {
        "en": "Mein Hobby ist Lesen.",
        "ko": "제 취미는 독서예요."
      },
      {
        "en": "Ich koche gern.",
        "ko": "저는 요리하는 걸 좋아해요."
      },
      {
        "en": "Ich spiele gern Gitarre.",
        "ko": "저는 기타 치는 걸 좋아해요."
      }
    ]
