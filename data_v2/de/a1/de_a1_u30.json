    "key_expressions": [
      {
        "en": "Ja, gerne! Ich komme.",
        "ko": "네, 좋아요! 갈게요."
      },
      {
        "en": "Tut mir leid, ich kann nicht kommen.",
        "ko": "죄송해요, 못 가요."
      },
      {
        "en": "Vielleicht ein anderes Mal.",
        "ko": "다음에 갈게요."
      }
    ]
  },
