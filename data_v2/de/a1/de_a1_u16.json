  "context": {
    "explanation_en": "To say how you feel, we use « Ich bin... ». To ask how someone is, we use « Wie geht es Ihnen? ».",
    "explanation_ko": "기분을 말할 때는 'Ich bin...'(저는 ~해요), 상대방의 상태를 물을 때는 'Wie geht es Ihnen?'(어떻게 지내세요?)를 씁니다.",
    "key_expressions": [
      {
        "en": "Ich bin heute glücklich.",
        "ko": "저는 오늘 기뻐요."
      },
      {
        "en": "Wie geht es Ihnen? Mir geht es gut, danke.",
        "ko": "어떻게 지내세요? 네, 잘 지내요, 감사해요."
      },
      {
        "en": "Ich bin müde.",
        "ko": "저는 피곤해요."
      }
    ]
  },
