  "context": {
    "explanation_en": "To make a polite request, we use « Könnten Sie...? ». To respond, we use « Natürlich » or « Tut mir leid, das geht nicht ».",
    "explanation_ko": "정중하게 부탁할 때는 'Könnten Sie...?'(~해 주실 수 있어요?), 응답할 때는 'Natürlich'(물론이죠) 또는 'Tut mir leid, das geht nicht'(죄송해요, 안 될 것 같아요)를 씁니다.",
    "key_expressions": [
      {
        "en": "Könnten Sie mir helfen?",
        "ko": "저 좀 도와주실 수 있어요?"
      },
      {
        "en": "Natürlich, kein Problem.",
        "ko": "물론이죠, 문제없어요."
      },
      {
        "en": "Tut mir leid, das geht gerade nicht.",
        "ko": "죄송해요, 지금은 안 될 것 같아요."
      }
    ]
  },
