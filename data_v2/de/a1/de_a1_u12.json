  "context": {
    "explanation_en": "To ask for an item, we use « Ich suche... ». To ask to try something on, we use « Kann ich das anprobieren? ».",
    "explanation_ko": "물건을 찾을 때는 'Ich suche...'(~을 찾고 있어요), 입어봐도 되는지 물을 때는 'Kann ich das anprobieren?'(입어봐도 돼요?)를 씁니다.",
    "key_expressions": [
      {
        "en": "Ich suche eine Jacke.",
        "ko": "재킷을 찾고 있어요."
      },
      {
        "en": "Kann ich dieses Hemd anprobieren?",
        "ko": "이 셔츠 입어봐도 돼요?"
      },
      {
        "en": "Haben Sie eine kleinere Größe?",
        "ko": "더 작은 사이즈 있어요?"
      }
    ]
  },
