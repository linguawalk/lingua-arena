  "context": {
    "explanation_en": "« Je... desto » expresses a proportional relationship: the more X, the more Y. Both clauses use comparative adjectives.",
    "explanation_ko": "'je...desto'는 비례 관계를 나타냅니다: ~할수록 더 ~하다. 양쪽 절 모두 비교급 형용사를 사용합니다.",
    "key_expressions": [
      {
        "en": "Je mehr ich lerne, desto besser werde ich.",
        "ko": "많이 배울수록 저는 더 나아져요."
      },
      {
        "en": "Je älter man wird, desto weiser wird man.",
        "ko": "나이가 들수록 더 지혜로워져요."
      },
      {
        "en": "Je früher, desto besser.",
        "ko": "빠를수록 좋아요."
      }
    ]
