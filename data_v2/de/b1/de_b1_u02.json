  "context": {
    "explanation_en": "« Ich hätte gern » and « Ich wäre gern » express polite wishes. « Es wäre schön, wenn... » expresses a hope.",
    "explanation_ko": "'Ich hätte gern'과 'Ich wäre gern'은 정중한 소망을 나타냅니다. 'Es wäre schön, wenn...'은 희망을 나타냅니다.",
    "key_expressions": [
      {
        "en": "Ich hätte gern einen Kaffee.",
        "ko": "커피 한 잔 주세요."
      },
      {
        "en": "Es wäre schön, wenn du kommen könntest.",
        "ko": "당신이 올 수 있으면 좋겠어요."
      },
      {
        "en": "Ich wäre gern früher gegangen.",
        "ko": "더 일찍 갔으면 좋았을 텐데요."
      }
    ]
  },
