  "context": {
    "explanation_en": "« Bevor » (before) and « nachdem » (after) express temporal relationships. « Nachdem » often requires the Plusquamperfekt.",
    "explanation_ko": "'bevor'(~하기 전에)와 'nachdem'(~한 후에)은 시간 관계를 나타냅니다. 'nachdem'은 종종 과거완료를 필요로 합니다.",
    "key_expressions": [
      {
        "en": "Bevor ich schlafen gehe, lese ich ein Buch.",
        "ko": "자러 가기 전에 저는 책을 읽어요."
      },
      {
        "en": "Nachdem ich gegessen hatte, bin ich spazieren gegangen.",
        "ko": "밥을 먹은 후에 저는 산책을 갔어요."
      },
      {
        "en": "Bevor du gehst, ruf mich an.",
        "ko": "가기 전에 저에게 전화하세요."
      }
    ]
  },
