  "context": {
    "explanation_en": "« Entweder... oder » (either...or) presents two alternative options.",
    "explanation_ko": "'entweder...oder'(둘 중 하나)는 두 대안 중 하나를 제시합니다.",
    "key_expressions": [
      {
        "en": "Entweder gehe ich ins Kino, oder ich bleibe zu Hause.",
        "ko": "저는 영화관에 가거나 집에 있을 거예요."
      },
      {
        "en": "Entweder du kommst, oder du bleibst hier.",
        "ko": "당신은 오거나 여기 남거나 둘 중 하나예요."
      },
      {
        "en": "Wir können entweder Pizza oder Pasta bestellen.",
        "ko": "저희는 피자나 파스타 중 하나를 주문할 수 있어요."
      }
    ]
