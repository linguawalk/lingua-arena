  "context": {
    "explanation_en": "The genitive case (des/der) expresses possession, similar to « 's » in English, and is used mainly in formal/written German.",
    "explanation_ko": "2격(des/der)은 영어의 's'와 비슷하게 소유를 나타내며, 주로 격식체·문어체에서 씁니다.",
    "key_expressions": [
      {
        "en": "Das ist das Auto des Lehrers.",
        "ko": "이건 선생님의 차예요."
      },
      {
        "en": "Die Farbe der Wand gefällt mir.",
        "ko": "벽 색깔이 마음에 들어요."
      },
      {
        "en": "Das ist das Ende des Films.",
        "ko": "이건 영화의 결말이에요."
      }
    ]
