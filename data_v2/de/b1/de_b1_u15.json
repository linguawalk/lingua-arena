  "context": {
    "explanation_en": "After a definite article (der/die/das), the adjective ending is usually « -e » in the nominative singular or « -en » in other cases.",
    "explanation_ko": "정관사(der/die/das) 뒤에서 형용사 어미는 단수 주격에서 보통 '-e', 다른 격에서는 '-en'입니다.",
    "key_expressions": [
      {
        "en": "Der große Mann steht dort.",
        "ko": "그 키 큰 남자가 저기 서 있어요."
      },
      {
        "en": "Ich sehe den großen Mann.",
        "ko": "저는 그 키 큰 남자를 봐요."
      },
      {
        "en": "Die kleine Katze schläft.",
        "ko": "그 작은 고양이가 자고 있어요."
      }
    ]
  },
