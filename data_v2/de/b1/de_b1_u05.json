  "context": {
    "explanation_en": "Relative clauses use « der/die/das » to describe a noun. The relative pronoun agrees in gender and number with the noun.",
    "explanation_ko": "관계문은 명사를 설명하기 위해 'der/die/das'를 사용합니다. 관계대명사는 명사의 성과 수에 일치합니다.",
    "key_expressions": [
      {
        "en": "Das ist der Mann, der neben mir wohnt.",
        "ko": "이분은 제 옆에 사는 남자예요."
      },
      {
        "en": "Das ist die Frau, die mir geholfen hat.",
        "ko": "이분은 저를 도와준 여자예요."
      },
      {
        "en": "Das ist das Buch, das ich gelesen habe.",
        "ko": "이건 제가 읽은 책이에요."
      }
    ]
  },
