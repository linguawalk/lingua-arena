  "context": {
    "explanation_en": "When the relative pronoun follows a preposition, we use « mit dem/der », « für den/die », etc.",
    "explanation_ko": "관계대명사가 전치사 뒤에 올 때는 'mit dem/der', 'für den/die' 등을 사용합니다.",
    "key_expressions": [
      {
        "en": "Das ist der Freund, mit dem ich reise.",
        "ko": "이 사람은 저와 함께 여행하는 친구예요."
      },
      {
        "en": "Das ist die Arbeit, für die ich mich interessiere.",
        "ko": "이건 제가 관심 있는 일이에요."
      },
      {
        "en": "Das ist das Thema, über das wir sprechen.",
        "ko": "이건 저희가 이야기하는 주제예요."
      }
    ]
  },
