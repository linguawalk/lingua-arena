  "context": {
    "explanation_en": "Indirect speech in the past uses « Er hat gesagt, dass... ». The tense in the subordinate clause usually stays the same.",
    "explanation_ko": "과거의 간접화법은 'Er hat gesagt, dass...'를 사용합니다. 종속절의 시제는 대개 그대로 유지됩니다.",
    "key_expressions": [
      {
        "en": "Er hat gesagt, dass er müde war.",
        "ko": "그는 피곤했다고 말했어요."
      },
      {
        "en": "Sie hat gesagt, dass sie kommen würde.",
        "ko": "그녀는 올 거라고 말했어요."
      },
      {
        "en": "Er hat erklärt, dass er es nicht wusste.",
        "ko": "그는 몰랐다고 설명했어요."
      }
    ]
  },
