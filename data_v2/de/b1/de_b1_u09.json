  "context": {
    "explanation_en": "« Wenn » is used for repeated or general situations in the present/future, « als » is used for a single event in the past.",
    "explanation_ko": "'wenn'은 현재·미래의 반복되거나 일반적인 상황에, 'als'는 과거의 단일 사건에 씁니다.",
    "key_expressions": [
      {
        "en": "Wenn ich Zeit habe, lese ich Bücher.",
        "ko": "시간이 있을 때 저는 책을 읽어요."
      },
      {
        "en": "Als ich klein war, wohnte ich in Berlin.",
        "ko": "어렸을 때 저는 베를린에 살았어요."
      },
      {
        "en": "Wenn es regnet, bleibe ich zu Hause.",
        "ko": "비가 올 때 저는 집에 있어요."
      }
    ]
  },
