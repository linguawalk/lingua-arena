  "context": {
    "explanation_en": "« Deshalb » (therefore) expresses a consequence, « trotzdem » (nevertheless) expresses a contrast. Both trigger inverted word order.",
    "explanation_ko": "'deshalb'(그래서)는 결과를, 'trotzdem'(그럼에도 불구하고)은 대조를 나타냅니다. 둘 다 도치 어순을 유발합니다.",
    "key_expressions": [
      {
        "en": "Es regnet, deshalb bleibe ich zu Hause.",
        "ko": "비가 와서 저는 집에 있어요."
      },
      {
        "en": "Es regnet, trotzdem gehe ich raus.",
        "ko": "비가 오지만 저는 밖에 나가요."
      },
      {
        "en": "Ich war müde, trotzdem habe ich weitergearbeitet.",
        "ko": "저는 피곤했지만 계속 일했어요."
      }
    ]
  },
