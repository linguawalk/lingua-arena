  "context": {
    "explanation_en": "The superlative in front of a noun uses « der/die/das + -ste/-ste ». Some adjectives have irregular forms like « gut, besser, am besten ».",
    "explanation_ko": "명사 앞의 최상급은 'der/die/das + -ste/-ste'를 사용합니다. 일부 형용사는 'gut, besser, am besten'처럼 불규칙 형태를 가집니다.",
    "key_expressions": [
      {
        "en": "Das ist der schnellste Zug.",
        "ko": "이건 가장 빠른 기차예요."
      },
      {
        "en": "Dieses Restaurant ist am besten.",
        "ko": "이 식당이 가장 좋아요."
      },
      {
        "en": "Er ist der älteste in der Familie.",
        "ko": "그는 가족 중 가장 나이가 많아요."
      }
    ]
  },
