  "context": {
    "explanation_en": "« Außerdem » (moreover) adds information, « allerdings » (however) expresses a limitation or contrast.",
    "explanation_ko": "'außerdem'(게다가)은 정보를 추가하고, 'allerdings'(하지만)는 제한이나 대조를 나타냅니다.",
    "key_expressions": [
      {
        "en": "Das Hotel ist günstig, außerdem ist es zentral gelegen.",
        "ko": "그 호텔은 저렴해요, 게다가 중심가에 있어요."
      },
      {
        "en": "Das Essen war gut, allerdings war der Service langsam.",
        "ko": "음식은 좋았지만, 서비스가 느렸어요."
      },
      {
        "en": "Ich mag ihn, allerdings vertraue ich ihm nicht ganz.",
        "ko": "그를 좋아하지만, 완전히 믿지는 않아요."
      }
    ]
  },
