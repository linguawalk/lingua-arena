      "skill": "writing",
      "task_type": "situation_response",
      "prompt": {
        "en": "Schreiben Sie einen Satz mit einem Nomen, das von einem Verb abgeleitet ist (z.B. „die Entscheidung“).",
        "ko": "동사에서 파생된 명사(예: 'die Entscheidung')를 사용해서 문장을 써 보세요."
      },
      "target_elements": [
        {
          "type": "grammar",
          "id": "nominalisierung",
          "label_ko": "동사 명사화",
          "min_occurrences": 1
        }
      ],
      "rubric": [
